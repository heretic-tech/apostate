 namespace base::apostate {
+
+// Launch-only transport credentials. These are not profile identity.
+struct ProxyCredentials {
+  std::string username;
+  std::string password;
+};
+
+// Upper bound on how many times launch-supplied proxy credentials are fed to
+// one connect job or transaction. Enough for a full NTLM/Negotiate handshake
+// or a Digest nonce rotation; bounded so a genuinely rejected credential
+// still reaches the delegate instead of looping against the proxy.
