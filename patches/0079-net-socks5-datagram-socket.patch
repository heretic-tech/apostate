 using DatagramsMetadata = std::vector<DatagramMetadata>;
+
+// An encapsulation a socket applies to every datagram that passes through it,
+// such as the RFC 1928 §7 header of a SOCKS5 UDP relay. A plain UDP socket
+// applies none, which is the default this struct describes.
+//
+// Callers that size packets or advertise transport capabilities must consult
+// this rather than assume a bare datagram: `overhead` reduces the usable
+// packet size, and `preserves_ecn` says whether the ECN bits of a written
+// payload can reach the far end at all.
+struct NET_EXPORT_PRIVATE DatagramEncapsulation {
+  size_t overhead = 0;
+  bool preserves_ecn = true;
+};
 
