+
+// --- Relay-address substitution ---------------------------------------------
+
+class SOCKS5DatagramRelayAddressTest : public SOCKS5DatagramClientSocketTest {
+ protected:
+  std::unique_ptr<SOCKS5DatagramClientSocket> Associate(
+      const std::string& reply) {
+    auto socket = Build({MockRead(ASYNC, 1, GreetReply(0x00)),
+                         MockRead(ASYNC, 3, reply),
+                         MockRead(SYNCHRONOUS, ERR_IO_PENDING, 4)},
+                        {MockWrite(ASYNC, 0, GreetNoAuth()),
+                         MockWrite(ASYNC, 2, AssociateRequest())},
+                        {}, {});
+    EXPECT_THAT(socket->ConnectAsync(ProxyEndPoint(), callback_.callback()),
+                IsError(ERR_IO_PENDING));
+    EXPECT_THAT(callback_.WaitForResult(), IsOk());
+    return socket;
+  }
+};
+
+TEST_F(SOCKS5DatagramRelayAddressTest, UnspecifiedAddressUsesProxyAddress) {
+  auto socket = Associate(AssociateReplyUnspecified());
+  EXPECT_TRUE(socket->relay_address_was_substituted_for_testing());
+  EXPECT_EQ(EndPoint(kProxyIp, kRelayPort),
+            socket->relay_endpoint_for_testing());
+}
+
+TEST_F(SOCKS5DatagramRelayAddressTest, RoutableAddressIsHonoured) {
+  auto socket = Associate(AssociateReply(0x00, {0x01, 10, 9, 9, 9}));
+  EXPECT_FALSE(socket->relay_address_was_substituted_for_testing());
+  EXPECT_EQ(EndPoint("10.9.9.9", kRelayPort),
+            socket->relay_endpoint_for_testing());
+}
+
+TEST_F(SOCKS5DatagramRelayAddressTest, LoopbackAddressIsSubstituted) {
+  auto socket = Associate(AssociateReply(0x00, {0x01, 127, 0, 0, 1}));
+  EXPECT_TRUE(socket->relay_address_was_substituted_for_testing());
+  EXPECT_EQ(EndPoint(kProxyIp, kRelayPort),
+            socket->relay_endpoint_for_testing());
+}
+
+TEST_F(SOCKS5DatagramRelayAddressTest, MismatchedFamilyIsSubstituted) {
+  auto socket = Associate(AssociateReply(
+      0x00, {0x04, 0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+             0x00, 0x00, 0x00, 0x00, 0x00, 0x01}));
+  EXPECT_TRUE(socket->relay_address_was_substituted_for_testing());
+  EXPECT_EQ(EndPoint(kProxyIp, kRelayPort),
+            socket->relay_endpoint_for_testing());
+}
+
+// A named relay cannot be used: resolving it here would be a DNS query the
+// stream path never makes.
+TEST_F(SOCKS5DatagramRelayAddressTest, DomainNameIsSubstituted) {
+  auto socket = Associate(AssociateReply(0x00, {0x03, 0x03, 'a', 'b', 'c'}));
+  EXPECT_TRUE(socket->relay_address_was_substituted_for_testing());
+  EXPECT_EQ(EndPoint(kProxyIp, kRelayPort),
+            socket->relay_endpoint_for_testing());
+}
+
+// --- Framing ----------------------------------------------------------------
+
+class SOCKS5DatagramFramingTest : public SOCKS5DatagramClientSocketTest {
+ protected:
+  std::unique_ptr<SOCKS5DatagramClientSocket> Associate(
+      std::vector<MockRead> udp_reads,
+      std::vector<MockWrite> udp_writes,
+      const HostPortPair& destination =
+          HostPortPair(kDestinationHost, kDestinationPort),
+      int watch_read = -1) {
+    std::vector<MockRead> reads = {MockRead(ASYNC, 1, GreetReply(0x00)),
+                                   MockRead(ASYNC, 3,
+                                            AssociateReplyUnspecified())};
+    if (watch_read < 0) {
+      reads.push_back(MockRead(SYNCHRONOUS, ERR_IO_PENDING, 4));
+    } else {
+      // Pause, so a test can decide exactly when the control connection dies.
+      reads.push_back(MockRead(ASYNC, ERR_IO_PENDING, 4));
+      reads.push_back(MockRead(ASYNC, watch_read, 5));
+    }
+    auto socket = Build(std::move(reads),
+                        {MockWrite(ASYNC, 0, GreetNoAuth()),
+                         MockWrite(ASYNC, 2, AssociateRequest())},
+                        std::move(udp_reads), std::move(udp_writes),
+                        std::nullopt, destination);
+    EXPECT_THAT(socket->ConnectAsync(ProxyEndPoint(), callback_.callback()),
+                IsError(ERR_IO_PENDING));
+    EXPECT_THAT(callback_.WaitForResult(), IsOk());
+    return socket;
+  }
+};
+
+TEST_F(SOCKS5DatagramFramingTest, WritePrependsDomainHeader) {
+  const std::string& framed = Own(ExpectedDomainHeader() + "quic-packet");
+  auto socket = Associate({}, {MockWrite(SYNCHRONOUS, 0, framed)});
+
+  auto buf = base::MakeRefCounted<StringIOBuffer>("quic-packet");
+  // The caller is told how many of *its* bytes went out, never the framed
+  // length, or QuicChromiumPacketWriter would see a short write.
+  EXPECT_EQ(11, socket->Write(buf.get(), buf->size(), callback_.callback(),
+                              TRAFFIC_ANNOTATION_FOR_TESTS));
+}
+
+TEST_F(SOCKS5DatagramFramingTest, WriteUsesIpv4HeaderForAnIpLiteral) {
+  const std::string& framed =
+      Own(Bytes({0x00, 0x00, 0x00, 0x01, 10, 11, 12, 13, 0x01, 0xBB}) +
+          "packet");
+  auto socket = Associate({}, {MockWrite(SYNCHRONOUS, 0, framed)},
+                          HostPortPair("10.11.12.13", kDestinationPort));
+
+  auto buf = base::MakeRefCounted<StringIOBuffer>("packet");
+  EXPECT_EQ(6, socket->Write(buf.get(), buf->size(), callback_.callback(),
+                             TRAFFIC_ANNOTATION_FOR_TESTS));
+  EXPECT_EQ(10u, socket->GetEncapsulation().overhead);
+}
+
+// The overhead the writer sizes packets from is the header actually framed,
+// and it is the same value every time it is asked.
+TEST_F(SOCKS5DatagramFramingTest, ReportedOverheadMatchesTheFramedHeader) {
+  auto socket = Associate({}, {});
+  EXPECT_EQ(ExpectedDomainHeader().size(),
+            socket->GetEncapsulation().overhead);
+  EXPECT_EQ(ExpectedDomainHeader().size(),
+            socket->GetEncapsulation().overhead);
+  // A relay cannot carry the inner packet's ECN either way, so the socket says
+  // so instead of letting QUIC advertise it.
+  EXPECT_FALSE(socket->GetEncapsulation().preserves_ecn);
+}
+
+TEST_F(SOCKS5DatagramFramingTest, ReadStripsTheHeader) {
+  auto socket =
+      Associate({MockRead(SYNCHRONOUS, 0, Own(RelayedDatagram("inner-quic")))},
+                {});
+
+  auto buf = base::MakeRefCounted<IOBufferWithSize>(size_t{64});
+  ASSERT_EQ(10, socket->Read(buf.get(), buf->size(), callback_.callback()));
+  EXPECT_EQ("inner-quic", std::string(base::as_string_view(
+                              buf->span().first(size_t{10}))));
+}
+
+TEST_F(SOCKS5DatagramFramingTest, ReadDropsFragmentedAndMalformedDatagrams) {
+  auto socket = Associate(
+      {// FRAG != 0: fragmentation is not implemented, and dropping is
+       // indistinguishable from loss, which QUIC already handles.
+       MockRead(ASYNC, 0, Own(RelayedDatagram("fragment", 0x01))),
+       // An unknown ATYP is dropped too.
+       MockRead(ASYNC, 1, Own(Bytes({0x00, 0x00, 0x00, 0x09, 0x01, 0x02}))),
+       MockRead(ASYNC, 2, Own(RelayedDatagram("good")))},
+      {});
+
+  auto buf = base::MakeRefCounted<IOBufferWithSize>(size_t{64});
+  EXPECT_THAT(socket->Read(buf.get(), buf->size(), callback_.callback()),
+              IsError(ERR_IO_PENDING));
+  // The two junk datagrams are skipped and the read resolves with the third.
+  ASSERT_EQ(4, callback_.WaitForResult());
+  EXPECT_EQ("good", std::string(
+                        base::as_string_view(buf->span().first(size_t{4}))));
+}
+
+TEST_F(SOCKS5DatagramFramingTest, ReadMultiplePacksPayloadsWithoutHeaders) {
+  auto socket =
+      Associate({MockRead(SYNCHRONOUS, 0, Own(RelayedDatagram("aaaa"))),
+                 MockRead(SYNCHRONOUS, 1, Own(RelayedDatagram("bbbbbb"))),
+                 MockRead(SYNCHRONOUS, ERR_IO_PENDING, 2)},
+                {});
+
+  auto buf =
+      base::MakeRefCounted<IOBufferWithSize>(kMinimumReadMultipleBufferSize);
+  base::expected<DatagramsMetadata, Error> result = socket->ReadMultiple(
+      buf.get(), kMinimumReadMultipleBufferSize, 1024u,
+      base::BindOnce([](base::expected<DatagramsMetadata, Error>) {
+        ADD_FAILURE() << "the callback ran for a synchronous read";
+      }));
+  ASSERT_TRUE(result.has_value());
+  ASSERT_EQ(2u, result->size());
+  // Offsets index the caller's buffer and are packed: no header bytes and no
+  // gaps, so a stale offset from the inner buffer cannot be handed back.
+  EXPECT_EQ(0u, (*result)[0].offset);
+  EXPECT_EQ(4u, (*result)[0].length);
+  EXPECT_EQ(4u, (*result)[1].offset);
+  EXPECT_EQ(6u, (*result)[1].length);
+  // The only TOS byte available belongs to the relay-to-client hop, so it is
+  // reported as zero rather than as the destination's.
+  EXPECT_EQ(0u, (*result)[0].tos);
+  EXPECT_EQ(0u, (*result)[1].tos);
+  EXPECT_EQ("aaaabbbbbb", std::string(base::as_string_view(
+                              buf->span().first(size_t{10}))));
+}
+
+TEST_F(SOCKS5DatagramFramingTest, GetLastTosReportsNoEcn) {
+  auto socket = Associate({}, {});
+  EXPECT_EQ(DSCP_DEFAULT, socket->GetLastTos().dscp);
+  EXPECT_EQ(ECN_NOT_ECT, socket->GetLastTos().ecn);
+  // Failing here would abort session creation, so it succeeds without
+  // enabling receive-side TOS.
+  EXPECT_THAT(socket->SetRecvTos(), IsOk());
+}
+
+// --- Addresses --------------------------------------------------------------
+
+TEST_F(SOCKS5DatagramFramingTest, PeerAddressIsTheProxyNotTheRelay) {
+  auto socket = Associate({}, {});
+  IPEndPoint peer;
+  ASSERT_THAT(socket->GetPeerAddress(&peer), IsOk());
+  // Must equal the address the QUIC connection was built with, or every packet
+  // looks like a server address change.
+  EXPECT_EQ(ProxyEndPoint(), peer);
+  EXPECT_NE(socket->relay_endpoint_for_testing(), peer);
+}
+
+TEST_F(SOCKS5DatagramClientSocketTest, PeerAddressBeforeConnectFails) {
+  auto socket = Build({}, {}, {}, {});
+  IPEndPoint peer;
+  EXPECT_THAT(socket->GetPeerAddress(&peer), IsError(ERR_SOCKET_NOT_CONNECTED));
+}
+
+TEST_F(SOCKS5DatagramClientSocketTest, SynchronousConnectIsNotImplemented) {
+  auto socket = Build({}, {}, {}, {});
+  EXPECT_THAT(socket->Connect(ProxyEndPoint()), IsError(ERR_NOT_IMPLEMENTED));
+}
+
+TEST_F(SOCKS5DatagramClientSocketTest, ReadBeforeAssociationFails) {
+  auto socket = Build({}, {}, {}, {});
+  auto buf = base::MakeRefCounted<IOBufferWithSize>(size_t{64});
+  EXPECT_THAT(socket->Read(buf.get(), buf->size(), callback_.callback()),
+              IsError(ERR_SOCKET_NOT_CONNECTED));
+}
+
+// --- Control-connection lifetime --------------------------------------------
+
+// RFC 1928 §7 ends the association with the control connection, so a write
+// after it closes must fail rather than succeed into a relay that has stopped
+// listening: QUIC would otherwise only notice at its idle timeout.
+TEST_F(SOCKS5DatagramFramingTest, ControlClosureFailsSubsequentWrites) {
+  auto socket = Associate({}, {}, HostPortPair(kDestinationHost,
+                                               kDestinationPort),
+                          /*watch_read=*/0);
+  control_data_->Resume();
+  base::RunLoop().RunUntilIdle();
+
+  auto buf = base::MakeRefCounted<StringIOBuffer>("packet");
+  EXPECT_THAT(socket->Write(buf.get(), buf->size(), callback_.callback(),
+                            TRAFFIC_ANNOTATION_FOR_TESTS),
+              IsError(ERR_CONNECTION_CLOSED));
+  auto read_buf = base::MakeRefCounted<IOBufferWithSize>(size_t{64});
+  EXPECT_THAT(
+      socket->Read(read_buf.get(), read_buf->size(), callback_.callback()),
+      IsError(ERR_CONNECTION_CLOSED));
+}
+
+// A pending read is failed at once rather than left waiting for a datagram
+// that can no longer arrive.
+TEST_F(SOCKS5DatagramFramingTest, ControlClosureFailsAPendingRead) {
+  auto socket = Associate({MockRead(SYNCHRONOUS, ERR_IO_PENDING, 0)}, {},
+                          HostPortPair(kDestinationHost, kDestinationPort),
+                          /*watch_read=*/0);
+
+  TestCompletionCallback read_callback;
+  auto read_buf = base::MakeRefCounted<IOBufferWithSize>(size_t{64});
+  ASSERT_THAT(
+      socket->Read(read_buf.get(), read_buf->size(), read_callback.callback()),
+      IsError(ERR_IO_PENDING));
+
+  control_data_->Resume();
+  EXPECT_THAT(read_callback.WaitForResult(), IsError(ERR_CONNECTION_CLOSED));
+}
+
+// Unexpected stream data from the proxy is terminal too: a conforming proxy
+// sends nothing after the ASSOCIATE reply.
+TEST_F(SOCKS5DatagramFramingTest, UnexpectedControlDataIsTerminal) {
+  std::vector<MockRead> reads = {
+      MockRead(ASYNC, 1, GreetReply(0x00)),
+      MockRead(ASYNC, 3, AssociateReplyUnspecified()),
+      MockRead(ASYNC, ERR_IO_PENDING, 4),
+      MockRead(ASYNC, 5, Own(Bytes({0x05})))};
+  auto socket = Build(std::move(reads),
+                      {MockWrite(ASYNC, 0, GreetNoAuth()),
+                       MockWrite(ASYNC, 2, AssociateRequest())},
+                      {}, {});
+  ASSERT_THAT(socket->ConnectAsync(ProxyEndPoint(), callback_.callback()),
+              IsError(ERR_IO_PENDING));
+  ASSERT_THAT(callback_.WaitForResult(), IsOk());
+
+  control_data_->Resume();
+  base::RunLoop().RunUntilIdle();
+
+  auto buf = base::MakeRefCounted<StringIOBuffer>("packet");
+  EXPECT_THAT(socket->Write(buf.get(), buf->size(), callback_.callback(),
+                            TRAFFIC_ANNOTATION_FOR_TESTS),
+              IsError(ERR_SOCKS_CONNECTION_FAILED));
+}
