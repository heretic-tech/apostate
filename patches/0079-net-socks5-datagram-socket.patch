+// --- The chain predicate -----------------------------------------------------
+
+TEST_F(SOCKS5DatagramClientSocketTest, OnlySingleHopSocks5ChainsCarryQuic) {
+  const ProxyServer socks5 = ProxyServer::FromSchemeHostAndPort(
+      ProxyServer::SCHEME_SOCKS5, "proxy.test", 1080);
+  const ProxyServer socks4 = ProxyServer::FromSchemeHostAndPort(
+      ProxyServer::SCHEME_SOCKS4, "proxy.test", 1080);
+  const ProxyServer https = ProxyServer::FromSchemeHostAndPort(
+      ProxyServer::SCHEME_HTTPS, "proxy.test", 443);
+
+  EXPECT_TRUE(IsQuicOverSocks5Chain(ProxyChain(socks5)));
+  EXPECT_FALSE(IsQuicOverSocks5Chain(ProxyChain::Direct()));
+  EXPECT_FALSE(IsQuicOverSocks5Chain(ProxyChain()));
+  EXPECT_FALSE(IsQuicOverSocks5Chain(ProxyChain(socks4)));
+  EXPECT_FALSE(IsQuicOverSocks5Chain(ProxyChain(https)));
+  // A chain with more than one proxy is never accepted: there is no way to
+  // frame an inner hop's association, and ProxyChain rejects a mixed chain
+  // outright, so neither form reaches the datagram path.
+  EXPECT_FALSE(IsQuicOverSocks5Chain(ProxyChain({https, socks5})));
+  EXPECT_FALSE(IsQuicOverSocks5Chain(ProxyChain({socks5, socks5})));
+}
