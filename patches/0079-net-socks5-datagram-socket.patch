+constexpr char kProxyIp[] = "10.0.0.1";
+constexpr uint16_t kProxyPort = 1080;
+constexpr uint16_t kRelayPort = 40000;  // 0x9C40
+constexpr char kDestinationHost[] = "www.example.test";
+constexpr uint16_t kDestinationPort = 443;  // 0x01BB
+
+IPEndPoint ProxyEndPoint() {
+  IPAddress address;
+  CHECK(address.AssignFromIPLiteral(kProxyIp));
+  return IPEndPoint(address, kProxyPort);
+}
+
+IPEndPoint EndPoint(std::string_view literal, uint16_t port) {
+  IPAddress address;
+  CHECK(address.AssignFromIPLiteral(literal));
+  return IPEndPoint(address, port);
+}
+
+std::string Bytes(std::initializer_list<uint8_t> bytes) {
+  std::string out;
+  out.reserve(bytes.size());
+  for (uint8_t byte : bytes) {
+    out.push_back(static_cast<char>(byte));
+  }
+  return out;
+}
+
+// The 5 + 16 + 2 byte header this socket frames for kDestinationHost:443.
+std::string ExpectedDomainHeader() {
+  const std::string_view host(kDestinationHost);
+  std::string header =
+      Bytes({0x00, 0x00, 0x00, 0x03, static_cast<uint8_t>(host.size())});
+  header.append(host);
+  header.append(Bytes({kDestinationPort >> 8, kDestinationPort & 0xff}));
+  return header;
+}
+
+// A datagram as a relay delivers it: an RFC 1928 §7 header plus the payload.
+std::string RelayedDatagram(std::string_view payload, uint8_t frag = 0x00) {
+  std::string out = Bytes({0x00, 0x00, frag, 0x01, 93, 184, 216, 34,
+                           kDestinationPort >> 8, kDestinationPort & 0xff});
+  out.append(payload);
+  return out;
+}
+
+class SOCKS5DatagramClientSocketTest : public PlatformTest,
+                                       public WithTaskEnvironment {
+ public:
+  // Stores `value` where it outlives every mock that points into it.
+  const std::string& Own(std::string value) {
+    owned_.push_back(std::move(value));
+    return owned_.back();
+  }
+
+  // Builds the socket over a mock TCP control connection carrying `reads` and
+  // `writes`, and a mock UDP socket carrying `udp_reads` and `udp_writes`.
+  std::unique_ptr<SOCKS5DatagramClientSocket> Build(
+      std::vector<MockRead> reads,
+      std::vector<MockWrite> writes,
+      std::vector<MockRead> udp_reads,
+      std::vector<MockWrite> udp_writes,
+      std::optional<SOCKS5Credentials> credentials = std::nullopt,
+      const HostPortPair& destination =
+          HostPortPair(kDestinationHost, kDestinationPort)) {
+    control_reads_ = std::move(reads);
+    control_writes_ = std::move(writes);
+    udp_reads_ = std::move(udp_reads);
+    udp_writes_ = std::move(udp_writes);
+    control_data_ = std::make_unique<SequencedSocketData>(control_reads_,
+                                                          control_writes_);
+    factory_.AddTcpSocketDataProvider(control_data_.get());
+    udp_data_ = std::make_unique<SequencedSocketData>(udp_reads_, udp_writes_);
+    return std::make_unique<SOCKS5DatagramClientSocket>(
+        std::make_unique<MockUDPClientSocket>(udp_data_.get()), &factory_,
+        destination, std::move(credentials), TRAFFIC_ANNOTATION_FOR_TESTS);
+  }
+
+  // 05 01 00 — the unauthenticated greeting, byte-identical to upstream's.
+  const std::string& GreetNoAuth() { return Own(Bytes({0x05, 0x01, 0x00})); }
+  // 05 02 00 02 — offers both methods, and the proxy chooses.
+  const std::string& GreetWithAuth() {
+    return Own(Bytes({0x05, 0x02, 0x00, 0x02}));
+  }
+  const std::string& GreetReply(uint8_t method) {
+    return Own(Bytes({0x05, method}));
+  }
+  // RFC 1929: VER=1, ULEN, UNAME, PLEN, PASSWD.
+  const std::string& AuthRequest() {
+    return Own(Bytes({0x01, 0x02, 'i', 'd', 0x03, 'p', 'w', 'd'}));
+  }
+  const std::string& AuthReply(uint8_t status) {
+    return Own(Bytes({0x01, status}));
+  }
+  // 05 03 00 01 00000000 0000 — UDP ASSOCIATE naming the all-zero source that
+  // RFC 1928 §4 requires when the client cannot know its own address yet.
+  const std::string& AssociateRequest() {
+    return Own(Bytes({0x05, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+                      0x00}));
+  }
+  const std::string& AssociateReply(uint8_t rep,
+                                    std::initializer_list<uint8_t> address) {
+    std::string reply = Bytes({0x05, rep, 0x00});
+    reply.append(Bytes(address));
+    reply.append(Bytes({kRelayPort >> 8, kRelayPort & 0xff}));
+    return Own(std::move(reply));
+  }
+  // BND.ADDR 0.0.0.0: the most common real answer.
+  const std::string& AssociateReplyUnspecified() {
+    return AssociateReply(0x00, {0x01, 0x00, 0x00, 0x00, 0x00});
+  }
+
+ protected:
+  // Declared before the providers so the providers are destroyed first: a
+  // SocketDataProvider holds a raw span over its mock arrays.
+  std::deque<std::string> owned_;
+  std::vector<MockRead> control_reads_;
+  std::vector<MockWrite> control_writes_;
+  std::vector<MockRead> udp_reads_;
+  std::vector<MockWrite> udp_writes_;
+  MockClientSocketFactory factory_;
+  std::unique_ptr<SequencedSocketData> control_data_;
+  std::unique_ptr<SequencedSocketData> udp_data_;
+  TestCompletionCallback callback_;
+};
