@@ -0,0 +1,1135 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "net/socket/socks5_datagram_client_socket.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/notreached.h"
+#include "base/numerics/safe_conversions.h"
+#include "net/base/address_list.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/base/proxy_chain.h"
+#include "net/base/proxy_server.h"
+#include "net/log/net_log_with_source.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/socket/socket_tag.h"
+#include "net/socket/stream_socket.h"
+
+namespace net {
+
+namespace {
+
+constexpr uint8_t kSOCKS5Version = 0x05;
+constexpr uint8_t kUdpAssociateCommand = 0x03;
+constexpr uint8_t kAuthMethodNone = 0x00;
+constexpr uint8_t kAuthMethodUserPass = 0x02;
+constexpr uint8_t kAuthSubnegotiationVersion = 0x01;
+constexpr uint8_t kAuthStatusSuccess = 0x00;
+constexpr uint8_t kReplySuccess = 0x00;
+constexpr uint8_t kAddressTypeIPv4 = 0x01;
+constexpr uint8_t kAddressTypeDomain = 0x03;
+constexpr uint8_t kAddressTypeIPv6 = 0x04;
+
+// VER + METHOD for the greeting reply, VER + STATUS for the RFC 1929 reply.
+constexpr size_t kTwoByteReplySize = 2;
+// VER, REP, RSV, ATYP and the first address byte: enough to size the rest.
+constexpr size_t kReplyPrefixSize = 5;
+
+// RSV(2) + FRAG(1) + ATYP(1) before the address, DST.PORT(2) after it.
+constexpr size_t kHeaderPrefixSize = 4;
+constexpr size_t kPortSize = 2;
+
+void AppendPort(uint16_t port, std::vector<uint8_t>* out) {
+  out->push_back(static_cast<uint8_t>(port >> 8));
+  out->push_back(static_cast<uint8_t>(port & 0xff));
+}
+
+uint16_t ReadPort(base::span<const uint8_t> bytes) {
+  return static_cast<uint16_t>((static_cast<uint16_t>(bytes[0]) << 8) |
+                               bytes[1]);
+}
+
+// The constant per-datagram prefix for `destination`, or an empty vector when
+// the destination cannot be framed within kMaxSocks5DatagramHeaderSize.
+std::vector<uint8_t> BuildDatagramHeader(const HostPortPair& destination) {
+  std::vector<uint8_t> header;
+  IPAddress literal;
+  if (literal.AssignFromIPLiteral(destination.host())) {
+    header.reserve(kHeaderPrefixSize + literal.size() + kPortSize);
+    header.insert(header.end(),
+                  {0x00, 0x00, 0x00,
+                   literal.IsIPv4() ? kAddressTypeIPv4 : kAddressTypeIPv6});
+    header.insert(header.end(), literal.bytes().begin(), literal.bytes().end());
+  } else {
+    const std::string& host = destination.host();
+    // RFC 1928 encodes the name length in a single octet.
+    if (host.empty() || host.size() > 255u) {
+      return {};
+    }
+    header.reserve(kHeaderPrefixSize + 1u + host.size() + kPortSize);
+    header.insert(header.end(), {0x00, 0x00, 0x00, kAddressTypeDomain,
+                                 static_cast<uint8_t>(host.size())});
+    header.insert(header.end(), host.begin(), host.end());
+  }
+  AppendPort(destination.port(), &header);
+  if (header.size() > kMaxSocks5DatagramHeaderSize) {
+    return {};
+  }
+  return header;
+}
+
+// Credentials that RFC 1929 cannot encode are dropped rather than truncated,
+// which makes the socket behave as if none were configured.
+std::optional<SOCKS5Credentials> SanitizeCredentials(
+    std::optional<SOCKS5Credentials> credentials) {
+  if (credentials && !credentials->IsValid()) {
+    return std::nullopt;
+  }
+  return credentials;
+}
+
+// The length of the RFC 1928 §7 header on a received datagram, or std::nullopt
+// when the datagram must be dropped. Dropping rather than erroring is right:
+// it is indistinguishable from packet loss, which QUIC already handles.
+std::optional<size_t> InboundHeaderLength(base::span<const uint8_t> datagram) {
+  if (datagram.size() < kReplyPrefixSize) {
+    return std::nullopt;
+  }
+  // RSV must be zero, and fragmentation is not implemented, so a fragment is
+  // dropped rather than reassembled.
+  if (datagram[0] != 0x00 || datagram[1] != 0x00 || datagram[2] != 0x00) {
+    return std::nullopt;
+  }
+  size_t header_length = 0;
+  switch (datagram[3]) {
+    case kAddressTypeIPv4:
+      header_length = kHeaderPrefixSize + 4u + kPortSize;
+      break;
+    case kAddressTypeIPv6:
+      header_length = kHeaderPrefixSize + 16u + kPortSize;
+      break;
+    case kAddressTypeDomain:
+      header_length = kHeaderPrefixSize + 1u + size_t{datagram[4]} + kPortSize;
+      break;
+    default:
+      return std::nullopt;
+  }
+  if (header_length > datagram.size()) {
+    return std::nullopt;
+  }
+  return header_length;
+}
+
+}  // namespace
+
+bool IsQuicOverSocks5Chain(const ProxyChain& chain) {
+  return chain.is_single_proxy() &&
+         chain.First().scheme() == ProxyServer::SCHEME_SOCKS5;
+}
+
+SOCKS5DatagramClientSocket::SOCKS5DatagramClientSocket(
+    std::unique_ptr<DatagramClientSocket> datagram_socket,
+    ClientSocketFactory* client_socket_factory,
+    const HostPortPair& destination,
+    std::optional<SOCKS5Credentials> credentials,
+    const NetworkTrafficAnnotationTag& traffic_annotation)
+    : datagram_socket_(std::move(datagram_socket)),
+      client_socket_factory_(client_socket_factory),
+      credentials_(SanitizeCredentials(std::move(credentials))),
+      traffic_annotation_(traffic_annotation),
+      datagram_header_(BuildDatagramHeader(destination)),
+      header_error_(datagram_header_.empty() ? ERR_SOCKS_CONNECTION_FAILED
+                                             : OK) {
+  CHECK(datagram_socket_);
+  CHECK(client_socket_factory_);
+}
+
+SOCKS5DatagramClientSocket::~SOCKS5DatagramClientSocket() {
+  Close();
+}
+
+// ---------------------------------------------------------------------------
+// Connect
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramClientSocket::Connect(const IPEndPoint& address) {
+  // An association needs at least three round trips, which a synchronous API
+  // cannot run. Unreachable in practice: QuicSessionAttempt is forced onto the
+  // asynchronous session-creation path for a SOCKS5 chain.
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingNetwork(
+    handles::NetworkHandle network,
+    const IPEndPoint& address) {
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingDefaultNetwork(
+    const IPEndPoint& address) {
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5DatagramClientSocket::ConnectAsync(const IPEndPoint& address,
+                                             CompletionOnceCallback callback) {
+  return ConnectInternal(ConnectMode::kAny, handles::kInvalidNetworkHandle,
+                         address, std::move(callback));
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingNetworkAsync(
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectInternal(ConnectMode::kNetwork, network, address,
+                         std::move(callback));
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingDefaultNetworkAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectInternal(ConnectMode::kDefaultNetwork,
+                         handles::kInvalidNetworkHandle, address,
+                         std::move(callback));
+}
+
+int SOCKS5DatagramClientSocket::ConnectInternal(
+    ConnectMode mode,
+    handles::NetworkHandle network,
+    const IPEndPoint& proxy_endpoint,
+    CompletionOnceCallback callback) {
+  CHECK(!connect_started_);
+  CHECK(!callback.is_null());
+  connect_started_ = true;
+  if (header_error_ != OK) {
+    // The destination cannot be framed inside a relayed datagram that still
+    // leaves room for a 1200-byte Initial packet. Declining is required: a
+    // handshake started here could not complete.
+    return header_error_;
+  }
+  connect_mode_ = mode;
+  network_ = network;
+  proxy_endpoint_ = proxy_endpoint;
+  connect_callback_ = std::move(callback);
+  next_state_ = STATE_CONTROL_CONNECT;
+  int rv = DoLoop(OK);
+  if (rv == ERR_IO_PENDING) {
+    return ERR_IO_PENDING;
+  }
+  connect_callback_.Reset();
+  return rv;
+}
+
+void SOCKS5DatagramClientSocket::OnIOComplete(int result) {
+  CHECK_NE(STATE_NONE, next_state_);
+  int rv = DoLoop(result);
+  if (rv == ERR_IO_PENDING) {
+    return;
+  }
+  if (!connect_callback_.is_null()) {
+    std::move(connect_callback_).Run(rv);
+  }
+}
+
+int SOCKS5DatagramClientSocket::DoLoop(int last_io_result) {
+  CHECK_NE(next_state_, STATE_NONE);
+  int rv = last_io_result;
+  do {
+    State state = next_state_;
+    next_state_ = STATE_NONE;
+    switch (state) {
+      case STATE_CONTROL_CONNECT:
+        CHECK_EQ(OK, rv);
+        rv = DoControlConnect();
+        break;
+      case STATE_CONTROL_CONNECT_COMPLETE:
+        rv = DoControlConnectComplete(rv);
+        break;
+      case STATE_GREET_WRITE:
+        CHECK_EQ(OK, rv);
+        rv = DoGreetWrite();
+        break;
+      case STATE_GREET_WRITE_COMPLETE:
+        rv = DoGreetWriteComplete(rv);
+        break;
+      case STATE_GREET_READ:
+        CHECK_EQ(OK, rv);
+        rv = DoGreetRead();
+        break;
+      case STATE_GREET_READ_COMPLETE:
+        rv = DoGreetReadComplete(rv);
+        break;
+      case STATE_AUTH_WRITE:
+        CHECK_EQ(OK, rv);
+        rv = DoAuthWrite();
+        break;
+      case STATE_AUTH_WRITE_COMPLETE:
+        rv = DoAuthWriteComplete(rv);
+        break;
+      case STATE_AUTH_READ:
+        CHECK_EQ(OK, rv);
+        rv = DoAuthRead();
+        break;
+      case STATE_AUTH_READ_COMPLETE:
+        rv = DoAuthReadComplete(rv);
+        break;
+      case STATE_ASSOCIATE_WRITE:
+        CHECK_EQ(OK, rv);
+        rv = DoAssociateWrite();
+        break;
+      case STATE_ASSOCIATE_WRITE_COMPLETE:
+        rv = DoAssociateWriteComplete(rv);
+        break;
+      case STATE_ASSOCIATE_READ:
+        CHECK_EQ(OK, rv);
+        rv = DoAssociateRead();
+        break;
+      case STATE_ASSOCIATE_READ_COMPLETE:
+        rv = DoAssociateReadComplete(rv);
+        break;
+      case STATE_DATAGRAM_CONNECT:
+        CHECK_EQ(OK, rv);
+        rv = DoDatagramConnect();
+        break;
+      case STATE_DATAGRAM_CONNECT_COMPLETE:
+        rv = DoDatagramConnectComplete(rv);
+        break;
+      case STATE_NONE:
+        NOTREACHED();
+    }
+  } while (rv != ERR_IO_PENDING && next_state_ != STATE_NONE);
+  return rv;
+}
+
+int SOCKS5DatagramClientSocket::DoControlConnect() {
+  next_state_ = STATE_CONTROL_CONNECT_COMPLETE;
+  const NetLogWithSource& net_log = datagram_socket_->NetLog();
+  control_socket_ = client_socket_factory_->CreateTransportClientSocket(
+      AddressList(proxy_endpoint_), network_,
+      /*socket_performance_watcher=*/nullptr,
+      /*network_quality_estimator=*/nullptr, net_log.net_log(),
+      net_log.source());
+  return control_socket_->Connect(base::BindOnce(
+      &SOCKS5DatagramClientSocket::OnIOComplete, weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5DatagramClientSocket::DoControlConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  next_state_ = STATE_GREET_WRITE;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoGreetWrite() {
+  // Without credentials the greeting is byte-identical to Chromium's, so a
+  // proxy cannot tell the two clients apart.
+  std::vector<uint8_t> greeting;
+  if (credentials_) {
+    greeting = {kSOCKS5Version, 0x02, kAuthMethodNone, kAuthMethodUserPass};
+  } else {
+    greeting = {kSOCKS5Version, 0x01, kAuthMethodNone};
+  }
+  return StartControlWrite(std::move(greeting), STATE_GREET_WRITE_COMPLETE,
+                           STATE_GREET_READ);
+}
+
+int SOCKS5DatagramClientSocket::DoGreetWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  control_write_buf_->DidConsume(result);
+  return ContinueControlWrite(STATE_GREET_WRITE_COMPLETE, STATE_GREET_READ);
+}
+
+int SOCKS5DatagramClientSocket::DoGreetRead() {
+  return StartControlRead(kTwoByteReplySize, STATE_GREET_READ_COMPLETE);
+}
+
+int SOCKS5DatagramClientSocket::DoGreetReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buf_->DidConsume(result);
+  if (control_read_buf_->RemainingCapacity() > 0) {
+    return ContinueControlRead(STATE_GREET_READ_COMPLETE);
+  }
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  if (reply[0] != kSOCKS5Version) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (reply[1] == kAuthMethodNone) {
+    next_state_ = STATE_ASSOCIATE_WRITE;
+    return OK;
+  }
+  if (reply[1] == kAuthMethodUserPass && credentials_) {
+    next_state_ = STATE_AUTH_WRITE;
+    return OK;
+  }
+  // Includes 0xFF ("no acceptable methods"), which is what a proxy requiring
+  // credentials answers when none were configured.
+  return ERR_SOCKS_CONNECTION_FAILED;
+}
+
+int SOCKS5DatagramClientSocket::DoAuthWrite() {
+  CHECK(credentials_);
+  std::vector<uint8_t> request;
+  request.reserve(3u + credentials_->username.size() +
+                  credentials_->password.size());
+  request.push_back(kAuthSubnegotiationVersion);
+  request.push_back(static_cast<uint8_t>(credentials_->username.size()));
+  request.insert(request.end(), credentials_->username.begin(),
+                 credentials_->username.end());
+  request.push_back(static_cast<uint8_t>(credentials_->password.size()));
+  request.insert(request.end(), credentials_->password.begin(),
+                 credentials_->password.end());
+  return StartControlWrite(std::move(request), STATE_AUTH_WRITE_COMPLETE,
+                           STATE_AUTH_READ);
+}
+
+int SOCKS5DatagramClientSocket::DoAuthWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  control_write_buf_->DidConsume(result);
+  return ContinueControlWrite(STATE_AUTH_WRITE_COMPLETE, STATE_AUTH_READ);
+}
+
+int SOCKS5DatagramClientSocket::DoAuthRead() {
+  return StartControlRead(kTwoByteReplySize, STATE_AUTH_READ_COMPLETE);
+}
+
+int SOCKS5DatagramClientSocket::DoAuthReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buf_->DidConsume(result);
+  if (control_read_buf_->RemainingCapacity() > 0) {
+    return ContinueControlRead(STATE_AUTH_READ_COMPLETE);
+  }
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  // The sub-negotiation carries its own version, which is not the SOCKS
+  // version.
+  if (reply[0] != kAuthSubnegotiationVersion ||
+      reply[1] != kAuthStatusSuccess) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  next_state_ = STATE_ASSOCIATE_WRITE;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateWrite() {
+  // DST.ADDR and DST.PORT of an ASSOCIATE request name the address the client
+  // will send datagrams from. The datagram socket is not bound yet, so it is
+  // not known, and RFC 1928 §4 requires zeros in exactly that case.
+  std::vector<uint8_t> request = {kSOCKS5Version, kUdpAssociateCommand,
+                                  0x00,           kAddressTypeIPv4,
+                                  0x00,           0x00,
+                                  0x00,           0x00,
+                                  0x00,           0x00};
+  return StartControlWrite(std::move(request), STATE_ASSOCIATE_WRITE_COMPLETE,
+                           STATE_ASSOCIATE_READ);
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  control_write_buf_->DidConsume(result);
+  return ContinueControlWrite(STATE_ASSOCIATE_WRITE_COMPLETE,
+                              STATE_ASSOCIATE_READ);
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateRead() {
+  return StartControlRead(kReplyPrefixSize, STATE_ASSOCIATE_READ_COMPLETE);
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buf_->DidConsume(result);
+  if (control_read_buf_->RemainingCapacity() > 0) {
+    return ContinueControlRead(STATE_ASSOCIATE_READ_COMPLETE);
+  }
+  if (static_cast<size_t>(control_read_buf_->offset()) == kReplyPrefixSize) {
+    // The prefix is in: size the remainder from ATYP and keep reading.
+    std::optional<size_t> remainder = AssociateReplyRemainder();
+    if (!remainder.has_value()) {
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    if (*remainder > 0) {
+      control_read_buf_->SetCapacity(
+          base::checked_cast<int>(kReplyPrefixSize + *remainder));
+      return ContinueControlRead(STATE_ASSOCIATE_READ_COMPLETE);
+    }
+  }
+  int rv = ResolveRelayEndpoint();
+  if (rv != OK) {
+    return rv;
+  }
+  next_state_ = STATE_DATAGRAM_CONNECT;
+  return OK;
+}
+
+std::optional<size_t> SOCKS5DatagramClientSocket::AssociateReplyRemainder()
+    const {
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  if (reply[0] != kSOCKS5Version || reply[2] != 0x00) {
+    return std::nullopt;
+  }
+  // The prefix already holds one address byte, so that byte is not counted
+  // again. For a domain name it is the length octet.
+  switch (reply[3]) {
+    case kAddressTypeIPv4:
+      return 4u - 1u + kPortSize;
+    case kAddressTypeIPv6:
+      return 16u - 1u + kPortSize;
+    case kAddressTypeDomain:
+      return size_t{reply[4]} + kPortSize;
+    default:
+      return std::nullopt;
+  }
+}
+
+int SOCKS5DatagramClientSocket::ResolveRelayEndpoint() {
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  if (reply[1] != kReplySuccess) {
+    // Includes 0x07 (command not supported), which is what a proxy without UDP
+    // ASSOCIATE answers. Failing fast is what lets the TCP job resume.
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  IPAddress reported;
+  uint16_t port = 0;
+  bool usable = false;
+  switch (reply[3]) {
+    case kAddressTypeIPv4:
+      reported = IPAddress(reply.subspan(kHeaderPrefixSize, 4u));
+      port = ReadPort(reply.subspan(kHeaderPrefixSize + 4u, kPortSize));
+      usable = true;
+      break;
+    case kAddressTypeIPv6:
+      reported = IPAddress(reply.subspan(kHeaderPrefixSize, 16u));
+      port = ReadPort(reply.subspan(kHeaderPrefixSize + 16u, kPortSize));
+      usable = true;
+      break;
+    case kAddressTypeDomain: {
+      // A datagram socket has no resolver, and resolving the relay's name here
+      // would be a DNS query the stream path never makes.
+      const size_t name_length = size_t{reply[4]};
+      port = ReadPort(
+          reply.subspan(kHeaderPrefixSize + 1u + name_length, kPortSize));
+      usable = false;
+      break;
+    }
+    default:
+      return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (port == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  // Substitution rules. Only the address is ever replaced; the port always
+  // comes from BND.PORT.
+  const IPAddress& proxy_address = proxy_endpoint_.address();
+  if (usable) {
+    if (reported.IsZero()) {
+      usable = false;  // "This host", and the most common real reply.
+    } else if (reported.IsLoopback() && !proxy_address.IsLoopback()) {
+      usable = false;  // The proxy reported its inside-the-box address.
+    } else if (reported.size() != proxy_address.size()) {
+      usable = false;  // Unreachable from the socket the caller created.
+    }
+  }
+  if (usable) {
+    relay_endpoint_ = IPEndPoint(reported, port);
+    relay_address_substituted_ = false;
+  } else {
+    relay_endpoint_ = IPEndPoint(proxy_address, port);
+    relay_address_substituted_ = true;
+  }
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoDatagramConnect() {
+  next_state_ = STATE_DATAGRAM_CONNECT_COMPLETE;
+  CompletionOnceCallback callback = base::BindOnce(
+      &SOCKS5DatagramClientSocket::OnIOComplete, weak_factory_.GetWeakPtr());
+  switch (connect_mode_) {
+    case ConnectMode::kAny:
+      return datagram_socket_->ConnectAsync(relay_endpoint_,
+                                            std::move(callback));
+    case ConnectMode::kNetwork:
+      return datagram_socket_->ConnectUsingNetworkAsync(
+          network_, relay_endpoint_, std::move(callback));
+    case ConnectMode::kDefaultNetwork:
+      return datagram_socket_->ConnectUsingDefaultNetworkAsync(
+          relay_endpoint_, std::move(callback));
+  }
+  NOTREACHED();
+}
+
+int SOCKS5DatagramClientSocket::DoDatagramConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  associated_ = true;
+  control_read_buf_.reset();
+  // The datagram socket is connected rather than bound, so the kernel now
+  // drops datagrams from any source but the relay. That restores exactly the
+  // source filtering a direct QUIC socket has.
+  StartControlWatch();
+  return latched_error_ == OK ? OK : latched_error_;
+}
+
+// ---------------------------------------------------------------------------
+// Control-connection I/O helpers
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramClientSocket::StartControlWrite(std::vector<uint8_t> bytes,
+                                                  State write_complete_state,
+                                                  State done_state) {
+  const size_t size = bytes.size();
+  control_write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(
+      base::MakeRefCounted<VectorIOBuffer>(std::move(bytes)), size);
+  return ContinueControlWrite(write_complete_state, done_state);
+}
+
+int SOCKS5DatagramClientSocket::ContinueControlWrite(
+    State write_complete_state,
+    State done_state) {
+  while (control_write_buf_->BytesRemaining() > 0) {
+    next_state_ = write_complete_state;
+    int rv = control_socket_->Write(
+        control_write_buf_.get(), control_write_buf_->BytesRemaining(),
+        base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                       weak_factory_.GetWeakPtr()),
+        traffic_annotation_);
+    if (rv == ERR_IO_PENDING) {
+      return ERR_IO_PENDING;
+    }
+    if (rv <= 0) {
+      return rv == 0 ? ERR_SOCKS_CONNECTION_FAILED : rv;
+    }
+    control_write_buf_->DidConsume(rv);
+  }
+  control_write_buf_.reset();
+  next_state_ = done_state;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::StartControlRead(size_t capacity,
+                                                 State complete_state) {
+  if (!control_read_buf_) {
+    control_read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+  }
+  control_read_buf_->set_offset(0);
+  control_read_buf_->SetCapacity(base::checked_cast<int>(capacity));
+  return ContinueControlRead(complete_state);
+}
+
+int SOCKS5DatagramClientSocket::ContinueControlRead(State complete_state) {
+  next_state_ = complete_state;
+  return control_socket_->Read(
+      control_read_buf_.get(), control_read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+// ---------------------------------------------------------------------------
+// Control-connection watch
+// ---------------------------------------------------------------------------
+
+void SOCKS5DatagramClientSocket::StartControlWatch() {
+  control_watch_buf_ = base::MakeRefCounted<IOBufferWithSize>(size_t{1});
+  int rv = control_socket_->Read(
+      control_watch_buf_.get(), 1,
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnControlWatchComplete,
+                     weak_factory_.GetWeakPtr()));
+  if (rv != ERR_IO_PENDING) {
+    OnControlWatchComplete(rv);
+  }
+}
+
+void SOCKS5DatagramClientSocket::OnControlWatchComplete(int result) {
+  // RFC 1928 §7: the association ends with the control connection, so anything
+  // other than "still pending" is terminal. Latching it here is what makes the
+  // next Write() fail instead of succeeding into a relay that has stopped
+  // listening.
+  if (result > 0) {
+    // A conforming proxy sends nothing after the ASSOCIATE reply.
+    LatchError(ERR_SOCKS_CONNECTION_FAILED);
+  } else if (result == 0) {
+    LatchError(ERR_CONNECTION_CLOSED);
+  } else {
+    LatchError(result);
+  }
+}
+
+void SOCKS5DatagramClientSocket::LatchError(int error) {
+  CHECK_LT(error, 0);
+  CHECK_NE(error, ERR_IO_PENDING);
+  if (latched_error_ != OK) {
+    return;
+  }
+  latched_error_ = error;
+  if (!read_user_callback_.is_null()) {
+    CompletionOnceCallback callback = std::move(read_user_callback_);
+    ClearReadState();
+    std::move(callback).Run(error);
+    return;
+  }
+  if (!read_multiple_user_callback_.is_null()) {
+    auto callback = std::move(read_multiple_user_callback_);
+    ClearReadMultipleState();
+    std::move(callback).Run(base::unexpected(static_cast<Error>(error)));
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Read
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramClientSocket::Read(IOBuffer* buf,
+                                     int buf_len,
+                                     CompletionOnceCallback callback) {
+  if (latched_error_ != OK) {
+    return latched_error_;
+  }
+  if (!associated_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  CHECK_GT(buf_len, 0);
+  CHECK(read_user_callback_.is_null());
+  read_user_buffer_ = buf;
+  read_user_buffer_len_ = static_cast<size_t>(buf_len);
+  read_user_callback_ = std::move(callback);
+
+  const size_t frame_len = read_user_buffer_len_ + kMaxSocks5InboundHeaderSize;
+  if (!read_frame_buffer_ ||
+      static_cast<size_t>(read_frame_buffer_->size()) < frame_len) {
+    read_frame_buffer_ = base::MakeRefCounted<IOBufferWithSize>(frame_len);
+  }
+
+  int rv = ReadLoop();
+  if (rv == ERR_IO_PENDING) {
+    return ERR_IO_PENDING;
+  }
+  read_user_callback_.Reset();
+  ClearReadState();
+  return rv;
+}
+
+int SOCKS5DatagramClientSocket::ReadLoop() {
+  for (;;) {
+    int rv = datagram_socket_->Read(
+        read_frame_buffer_.get(),
+        base::checked_cast<int>(read_user_buffer_len_ +
+                                kMaxSocks5InboundHeaderSize),
+        base::BindOnce(&SOCKS5DatagramClientSocket::OnDatagramReadComplete,
+                       weak_factory_.GetWeakPtr()));
+    if (rv == ERR_IO_PENDING) {
+      return ERR_IO_PENDING;
+    }
+    int out = OK;
+    if (DeframeSingle(rv, &out)) {
+      return out;
+    }
+    // Dropped. The caller still has no result and a dropped datagram is loss,
+    // so read again. Each iteration needs a datagram to have arrived, so the
+    // loop is bounded by the relay's send rate.
+  }
+}
+
+void SOCKS5DatagramClientSocket::OnDatagramReadComplete(int result) {
+  if (read_user_callback_.is_null()) {
+    // Close(), or a latched control error, already resolved this read.
+    return;
+  }
+  int out = OK;
+  if (!DeframeSingle(result, &out)) {
+    int rv = ReadLoop();
+    if (rv == ERR_IO_PENDING) {
+      return;
+    }
+    out = rv;
+  }
+  CompletionOnceCallback callback = std::move(read_user_callback_);
+  ClearReadState();
+  std::move(callback).Run(out);
+}
+
+bool SOCKS5DatagramClientSocket::DeframeSingle(int result, int* out_result) {
+  if (result <= 0) {
+    *out_result = result == 0 ? ERR_CONNECTION_CLOSED : result;
+    return true;
+  }
+  base::span<const uint8_t> datagram =
+      read_frame_buffer_->span().first(static_cast<size_t>(result));
+  std::optional<size_t> header_length = InboundHeaderLength(datagram);
+  if (!header_length.has_value()) {
+    return false;
+  }
+  const size_t payload_len = datagram.size() - *header_length;
+  // A header-only datagram carries nothing, and returning 0 from Read() would
+  // mean end-of-file to the caller.
+  if (payload_len == 0 || payload_len > read_user_buffer_len_) {
+    return false;
+  }
+  read_user_buffer_->span().first(payload_len).copy_from(
+      datagram.subspan(*header_length, payload_len));
+  *out_result = base::checked_cast<int>(payload_len);
+  return true;
+}
+
+void SOCKS5DatagramClientSocket::ClearReadState() {
+  read_user_buffer_ = nullptr;
+  read_user_buffer_len_ = 0;
+}
+
+// ---------------------------------------------------------------------------
+// ReadMultiple
+// ---------------------------------------------------------------------------
+
+base::expected<DatagramsMetadata, Error>
+SOCKS5DatagramClientSocket::ReadMultiple(
+    IOBuffer* buf,
+    size_t buf_len,
+    size_t max_message_size,
+    base::OnceCallback<void(base::expected<DatagramsMetadata, Error>)>
+        callback) {
+  if (latched_error_ != OK) {
+    return base::unexpected(static_cast<Error>(latched_error_));
+  }
+  if (!associated_) {
+    return base::unexpected(ERR_SOCKET_NOT_CONNECTED);
+  }
+  CHECK_GT(max_message_size, 0u);
+  CHECK_GE(buf_len, max_message_size);
+  CHECK(!callback.is_null());
+  CHECK(read_multiple_user_callback_.is_null());
+
+  read_multiple_user_buffer_ = buf;
+  read_multiple_user_buffer_len_ = buf_len;
+  read_multiple_user_callback_ = std::move(callback);
+
+  // One inner slot per payload the caller can hold, each large enough for the
+  // payload plus the largest header a relay can put in front of it. The total
+  // is raised to the 64KiB floor UDPSocketPosix::ReadMultiple CHECKs.
+  const size_t slots = std::max(size_t{1}, buf_len / max_message_size);
+  read_multiple_message_size_ = max_message_size + kMaxSocks5InboundHeaderSize;
+  read_multiple_frame_len_ = std::max(slots * read_multiple_message_size_,
+                                      kMinimumReadMultipleBufferSize);
+  if (!read_multiple_frame_buffer_ ||
+      static_cast<size_t>(read_multiple_frame_buffer_->size()) <
+          read_multiple_frame_len_) {
+    read_multiple_frame_buffer_ =
+        base::MakeRefCounted<IOBufferWithSize>(read_multiple_frame_len_);
+  }
+
+  base::expected<DatagramsMetadata, Error> result = ReadMultipleLoop();
+  if (!result.has_value() && result.error() == ERR_IO_PENDING) {
+    return result;
+  }
+  read_multiple_user_callback_.Reset();
+  ClearReadMultipleState();
+  return result;
+}
+
+base::expected<DatagramsMetadata, Error>
+SOCKS5DatagramClientSocket::ReadMultipleLoop() {
+  for (;;) {
+    base::expected<DatagramsMetadata, Error> raw =
+        datagram_socket_->ReadMultiple(
+            read_multiple_frame_buffer_.get(), read_multiple_frame_len_,
+            read_multiple_message_size_,
+            base::BindOnce(
+                &SOCKS5DatagramClientSocket::OnDatagramReadMultipleComplete,
+                weak_factory_.GetWeakPtr()));
+    if (!raw.has_value() && raw.error() == ERR_IO_PENDING) {
+      return raw;
+    }
+    std::optional<base::expected<DatagramsMetadata, Error>> deframed =
+        DeframeMultiple(std::move(raw));
+    if (deframed.has_value()) {
+      return std::move(*deframed);
+    }
+    // Every datagram in the batch was dropped. QuicChromiumPacketReader CHECKs
+    // that a successful result is non-empty, so read again rather than return
+    // an empty batch.
+  }
+}
+
+void SOCKS5DatagramClientSocket::OnDatagramReadMultipleComplete(
+    base::expected<DatagramsMetadata, Error> result) {
+  if (read_multiple_user_callback_.is_null()) {
+    return;
+  }
+  std::optional<base::expected<DatagramsMetadata, Error>> deframed =
+      DeframeMultiple(std::move(result));
+  if (!deframed.has_value()) {
+    base::expected<DatagramsMetadata, Error> again = ReadMultipleLoop();
+    if (!again.has_value() && again.error() == ERR_IO_PENDING) {
+      return;
+    }
+    deframed = std::move(again);
+  }
+  auto callback = std::move(read_multiple_user_callback_);
+  ClearReadMultipleState();
+  std::move(callback).Run(std::move(*deframed));
+}
+
+std::optional<base::expected<DatagramsMetadata, Error>>
+SOCKS5DatagramClientSocket::DeframeMultiple(
+    base::expected<DatagramsMetadata, Error> result) {
+  if (!result.has_value()) {
+    return result;
+  }
+  base::span<const uint8_t> frame = read_multiple_frame_buffer_->span();
+  base::span<uint8_t> out = read_multiple_user_buffer_->span();
+  // The caller's declared length, never more than its buffer actually holds.
+  const size_t capacity = std::min(read_multiple_user_buffer_len_, out.size());
+  DatagramsMetadata deframed;
+  size_t written = 0;
+  for (const DatagramMetadata& datagram : result.value()) {
+    if (datagram.offset > frame.size() ||
+        datagram.length > frame.size() - datagram.offset) {
+      continue;
+    }
+    base::span<const uint8_t> bytes =
+        frame.subspan(datagram.offset, datagram.length);
+    std::optional<size_t> header_length = InboundHeaderLength(bytes);
+    if (!header_length.has_value()) {
+      continue;
+    }
+    const size_t payload_len = bytes.size() - *header_length;
+    // Truncating would corrupt a packet; dropping is loss, which QUIC handles.
+    if (payload_len == 0 || payload_len > capacity - written) {
+      continue;
+    }
+    out.subspan(written, payload_len)
+        .copy_from(bytes.subspan(*header_length, payload_len));
+    // The TOS byte is reported as zero: the only TOS available here belongs to
+    // the relay-to-client hop, not to the packet the destination sent.
+    deframed.push_back(DatagramMetadata{written, payload_len, 0});
+    written += payload_len;
+  }
+  if (deframed.empty()) {
+    return std::nullopt;
+  }
+  return base::expected<DatagramsMetadata, Error>(std::move(deframed));
+}
+
+void SOCKS5DatagramClientSocket::ClearReadMultipleState() {
+  read_multiple_user_buffer_ = nullptr;
+  read_multiple_user_buffer_len_ = 0;
+}
+
+// ---------------------------------------------------------------------------
+// Write
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramClientSocket::Write(
+    IOBuffer* buf,
+    int buf_len,
+    CompletionOnceCallback callback,
+    const NetworkTrafficAnnotationTag& traffic_annotation) {
+  if (latched_error_ != OK) {
+    return latched_error_;
+  }
+  if (!associated_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  CHECK_GT(buf_len, 0);
+  CHECK(write_user_callback_.is_null());
+  const size_t payload_len = static_cast<size_t>(buf_len);
+  const size_t framed_len = datagram_header_.size() + payload_len;
+  if (!write_frame_buffer_ ||
+      static_cast<size_t>(write_frame_buffer_->size()) < framed_len) {
+    write_frame_buffer_ = base::MakeRefCounted<IOBufferWithSize>(framed_len);
+  }
+  // Socket::Write forbids modifying the caller's buffer, so the frame is
+  // assembled in this socket's own buffer.
+  base::span<uint8_t> frame = write_frame_buffer_->span();
+  frame.first(datagram_header_.size())
+      .copy_from(base::span<const uint8_t>(datagram_header_));
+  frame.subspan(datagram_header_.size(), payload_len)
+      .copy_from(buf->span().first(payload_len));
+
+  write_payload_len_ = payload_len;
+  write_user_callback_ = std::move(callback);
+  int rv = datagram_socket_->Write(
+      write_frame_buffer_.get(), base::checked_cast<int>(framed_len),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnDatagramWriteComplete,
+                     weak_factory_.GetWeakPtr()),
+      traffic_annotation);
+  if (rv == ERR_IO_PENDING) {
+    return ERR_IO_PENDING;
+  }
+  write_user_callback_.Reset();
+  return TranslateWriteResult(rv);
+}
+
+void SOCKS5DatagramClientSocket::OnDatagramWriteComplete(int result) {
+  if (write_user_callback_.is_null()) {
+    return;
+  }
+  CompletionOnceCallback callback = std::move(write_user_callback_);
+  std::move(callback).Run(TranslateWriteResult(result));
+}
+
+int SOCKS5DatagramClientSocket::TranslateWriteResult(int result) const {
+  if (result < 0) {
+    return result;
+  }
+  // The result must be reported in the caller's frame, or the writer sees a
+  // short write for a packet that was in fact sent whole.
+  if (static_cast<size_t>(result) !=
+      datagram_header_.size() + write_payload_len_) {
+    // A datagram is written whole or not at all, and the tail of a framed
+    // packet cannot be resent because it carries no header.
+    return ERR_MSG_TOO_BIG;
+  }
+  return base::checked_cast<int>(write_payload_len_);
+}
+
+// ---------------------------------------------------------------------------
+// Socket options and addresses
+// ---------------------------------------------------------------------------
+
+void SOCKS5DatagramClientSocket::Close() {
+  next_state_ = STATE_NONE;
+  associated_ = false;
+  connect_callback_.Reset();
+  // A read or write in flight is abandoned without running its callback, which
+  // is what Close() means for every other socket.
+  read_user_callback_.Reset();
+  read_multiple_user_callback_.Reset();
+  write_user_callback_.Reset();
+  ClearReadState();
+  ClearReadMultipleState();
+  control_write_buf_.reset();
+  control_read_buf_.reset();
+  control_watch_buf_.reset();
+  // Destroying the control connection is what ends the association.
+  if (control_socket_) {
+    control_socket_->Disconnect();
+    control_socket_.reset();
+  }
+  datagram_socket_->Close();
+}
+
+int SOCKS5DatagramClientSocket::GetPeerAddress(IPEndPoint* address) const {
+  if (!proxy_endpoint_.address().IsValid()) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  // The proxy's endpoint, not the relay's: QuicChromiumPacketReader reports
+  // this as every packet's peer address and QuicConnection compares it against
+  // the address the connection was built with.
+  *address = proxy_endpoint_;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::GetLocalAddress(IPEndPoint* address) const {
+  return datagram_socket_->GetLocalAddress(address);
+}
+
+void SOCKS5DatagramClientSocket::UseNonBlockingIO() {
+  datagram_socket_->UseNonBlockingIO();
+}
+
+int SOCKS5DatagramClientSocket::SetDoNotFragment() {
+  // Applies to the outer datagram on the client-to-relay hop, which is the hop
+  // whose MTU this host can discover. ERR_NOT_IMPLEMENTED is passed through
+  // because callers already tolerate exactly that one error.
+  return datagram_socket_->SetDoNotFragment();
+}
+
+int SOCKS5DatagramClientSocket::SetRecvTos() {
+  // Deliberately not enabled. The TOS byte of a relayed datagram belongs to
+  // the relay-to-client hop; reporting it as the destination's would be worse
+  // than reporting none. GetLastTos() and every datagram's metadata report
+  // ECN_NOT_ECT instead, which is consistent with GetEncapsulation() saying
+  // this socket does not preserve ECN.
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::SetTos(DiffServCodePoint dscp,
+                                       EcnCodePoint ecn) {
+  // The DSCP of the outer datagram is this host's to set. The ECN bits are
+  // not: a relay cannot carry them to the destination, so they are never
+  // marked.
+  return datagram_socket_->SetTos(dscp, ECN_NO_CHANGE);
+}
+
+void SOCKS5DatagramClientSocket::SetMsgConfirm(bool confirm) {
+  datagram_socket_->SetMsgConfirm(confirm);
+}
+
+const NetLogWithSource& SOCKS5DatagramClientSocket::NetLog() const {
+  // No new NetLog source or event type is introduced for the relay.
+  return datagram_socket_->NetLog();
+}
+
+DscpAndEcn SOCKS5DatagramClientSocket::GetLastTos() const {
+  return DscpAndEcn{DSCP_DEFAULT, ECN_NOT_ECT};
+}
+
+int SOCKS5DatagramClientSocket::SetReceiveBufferSize(int32_t size) {
+  return datagram_socket_->SetReceiveBufferSize(size);
+}
+
+int SOCKS5DatagramClientSocket::SetSendBufferSize(int32_t size) {
+  return datagram_socket_->SetSendBufferSize(size);
+}
+
+handles::NetworkHandle SOCKS5DatagramClientSocket::GetBoundNetwork() const {
+  return datagram_socket_->GetBoundNetwork();
+}
+
+void SOCKS5DatagramClientSocket::ApplySocketTag(const SocketTag& tag) {
+  datagram_socket_->ApplySocketTag(tag);
+  if (control_socket_) {
+    control_socket_->ApplySocketTag(tag);
+  }
+}
+
+void SOCKS5DatagramClientSocket::EnableRecvOptimization() {
+  datagram_socket_->EnableRecvOptimization();
+}
+
+int SOCKS5DatagramClientSocket::SetMulticastInterface(
+    uint32_t interface_index) {
+  return datagram_socket_->SetMulticastInterface(interface_index);
+}
+
+void SOCKS5DatagramClientSocket::SetIOSNetworkServiceType(
+    int ios_network_service_type) {
+  datagram_socket_->SetIOSNetworkServiceType(ios_network_service_type);
+}
+
+DatagramEncapsulation SOCKS5DatagramClientSocket::GetEncapsulation() const {
+  // Derived once at construction, so a maximum packet size computed from it
+  // cannot go stale relative to the bytes actually written.
+  return DatagramEncapsulation{datagram_header_.size(),
+                               /*preserves_ecn=*/false};
+}
+
+}  // namespace net

