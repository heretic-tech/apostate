+
+CommandLine Launch(std::vector<std::string> switches) {
+  CommandLine command_line(CommandLine::NO_PROGRAM);
+  for (const std::string& argument : switches) {
+    const size_t separator = argument.find('=');
+    command_line.AppendSwitchASCII(argument.substr(0, separator),
+                                   argument.substr(separator + 1));
+  }
+  return command_line;
+}
+
+// The probe is what every servability clamp is measured against, so a probe
+// that silently returns nothing would make every clamp a no-op and every claim
+// unfalsifiable-by-accident.
+TEST(ApostateHostCapabilityTest, ProbeReportsRealHostCapacity) {
+  const HostCapability host = ProbeHostCapability(Launch({}));
+
+  EXPECT_GT(host.logical_cores, 0);
+  EXPECT_GT(host.total_memory_bytes, 0u);
+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  EXPECT_FALSE(host.platform.empty());
+  EXPECT_FALSE(host.graphics_backend.empty());
+  // Nothing named the backend, so it is the platform default and the probe
+  // must say so rather than implying a measurement happened. A real backend
+  // probe needs the GPU process, and the GPU process is a child: the profile
+  // is materialised before the first child starts.
+  EXPECT_TRUE(host.graphics_backend_is_inferred);
+#endif
+}
+
+TEST(ApostateHostCapabilityTest, UseAngleMakesTheBackendAnObservedFact) {
+  const HostCapability vulkan =
+      ProbeHostCapability(Launch({"use-angle=vulkan"}));
+  EXPECT_EQ("vulkan", vulkan.graphics_backend);
+  EXPECT_FALSE(vulkan.graphics_backend_is_inferred);
+
+  const HostCapability metal = ProbeHostCapability(Launch({"use-angle=metal"}));
+  EXPECT_EQ("metal", metal.graphics_backend);
+  EXPECT_FALSE(metal.graphics_backend_is_inferred);
+
+  // d3d11on12 is D3D11 as far as a capability cluster is concerned.
+  EXPECT_EQ("d3d11",
+            ProbeHostCapability(Launch({"use-angle=d3d11on12"})).graphics_backend);
+
+  // "default" names no backend, and neither do the null/warp test backends.
+  // Treating them as a real one would make an anchor selectable that the host
+  // cannot actually produce, which is the failure the anchor model exists to
+  // stop -- so they fall through to the platform default and stay inferred.
+  const HostCapability defaulted =
+      ProbeHostCapability(Launch({"use-angle=default"}));
+  EXPECT_TRUE(defaulted.graphics_backend_is_inferred);
+  const HostCapability null_backend =
+      ProbeHostCapability(Launch({"use-angle=d3d11-null"}));
+  EXPECT_TRUE(null_backend.graphics_backend_is_inferred);
+}
+
+TEST(ApostateHostCapabilityTest, WindowBoundsComeFromTheLaunch) {
+  const HostCapability sized =
+      ProbeHostCapability(Launch({"window-size=1280,720"}));
+  EXPECT_EQ(1280, sized.window_width);
+  EXPECT_EQ(720, sized.window_height);
+
+  // Unconstrained until something constrains it: a zero bound drops no panel.
+  EXPECT_EQ(0, ProbeHostCapability(Launch({})).window_width);
+
+  // Garbage is not a constraint either. Half-parsing "1280" into a width with
+  // no height would silently drop every panel narrower than 1280.
+  EXPECT_EQ(0, ProbeHostCapability(Launch({"window-size=1280"})).window_width);
+  EXPECT_EQ(0, ProbeHostCapability(Launch({"window-size=a,b"})).window_width);
+  EXPECT_EQ(0, ProbeHostCapability(Launch({"window-size=-5,-5"})).window_width);
+}
+
+// §3: capacity is only ever reduced. A claim below host capability survives
+// every probe a page can run; a claim above it fails the first.
+TEST(ApostateHostCapabilityTest, ClampsReduceAndNeverRaise) {
+  EXPECT_EQ(1, ClampLogicalCores(1, 64));
+  EXPECT_EQ(8, ClampLogicalCores(8, 8));
+  EXPECT_EQ(8, ClampLogicalCores(9, 8));
+  EXPECT_EQ(1, ClampLogicalCores(64, 1));
+
+  constexpr uint64_t kGib = uint64_t{1} << 30;
+  EXPECT_EQ(8 * kGib, ClampMemoryBytes(8 * kGib, 32 * kGib));
+  EXPECT_EQ(32 * kGib, ClampMemoryBytes(64 * kGib, 32 * kGib));
+  EXPECT_EQ(std::numeric_limits<uint64_t>::max(),
+            ClampMemoryBytes(std::numeric_limits<uint64_t>::max(), 0));
+}
+
+// An unknown host capability is not evidence of a small host, so it cannot
+// justify reducing a claim. Reducing on unknown would quietly shrink every
+// profile on any platform whose probe is not implemented.
+TEST(ApostateHostCapabilityTest, AnUnknownHostCapacityReducesNothing) {
+  EXPECT_EQ(12, ClampLogicalCores(12, 0));
+  EXPECT_EQ(12, ClampLogicalCores(12, -1));
+  EXPECT_EQ(4096u, ClampMemoryBytes(4096, 0));
+}
