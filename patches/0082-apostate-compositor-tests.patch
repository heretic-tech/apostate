+HostCapability CapableHost() {
+  HostCapability host;
+  host.logical_cores = 32;
+  host.total_memory_bytes = uint64_t{64} * 1024 * 1024 * 1024;
+  host.graphics_backend = "metal";
+  host.graphics_backend_is_inferred = false;
+  host.platform = "macos";
+  return host;
+}
+
+ComposeRequest RequestFor(std::string seed,
+                          span<const DispersionAxis> axes,
+                          const HostCapability& host) {
+  ComposeRequest request;
+  request.seed = std::move(seed);
+  request.platform = "windows";
+  request.host = host;
+  request.axes = axes;
+  request.anchors = span<const Anchor>(kAnchors);
+  request.locale_policies = span<const PolicyOption>(kLocalePolicies);
+  request.theme_policies = span<const PolicyOption>(kThemePolicies);
+  request.union_array_paths = span<const std::string_view>(kUnionPaths);
+  request.profile_schema_version = "3";
+  request.catalogue_version = "2";
+  request.chromium_version = "152.0.7977.83";
+  request.catalogue_digest = "test-digest";
+  request.default_accept_languages = "en-US,en";
+  return request;
+}
+
+std::string ChosenId(const Composition& composition, std::string_view surface) {
+  for (const SurfaceRecord& record : composition.surfaces) {
+    if (record.surface == surface) {
+      return record.value;
+    }
+  }
+  return "(absent)";
+}
+
+const SurfaceRecord* Record(const Composition& composition,
+                            std::string_view surface) {
+  for (const SurfaceRecord& record : composition.surfaces) {
+    if (record.surface == surface) {
+      return &record;
+    }
+  }
+  return nullptr;
+}
+
+// The same serialisation the entry point ships, so these comparisons reflect
+// the bytes a launch actually carries.
+std::string ProfileJson(const Composition& composition) {
+  return WriteJsonWithOptions(composition.profile,
+                              JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION)
+      .value_or("<unserialisable>");
+}
