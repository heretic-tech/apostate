 std::string GetWebKitVersion() {
@@ -460,6 +519,16 @@
 
 void ServerWrapper::OnHttpRequest(int connection_id,
                                   const net::HttpServerRequestInfo& info) {
+  // Apostate: a page gets nothing back, not even an error. Any HTTP response
+  // at all resolves a no-cors fetch and tells the page the port is open, so
+  // the connection is closed instead. What remains is one loopback accept
+  // followed by a FIN, which fetch, Image and script all surface as the same
+  // generic failure a refused connection produces.
+  if (RequestIsFromWebPage(info)) {
+    Close(connection_id);
+    return;
+  }
+
   if (!RequestIsSafeToServe(info)) {
     Send500(connection_id,
             "Host header is specified and is not an IP address or localhost.");
@@ -515,6 +584,14 @@
 void ServerWrapper::OnWebSocketRequest(
     int connection_id,
     const net::HttpServerRequestInfo& request) {
+  // Apostate: same reasoning as OnHttpRequest. A handshake that gets a 404 and
+  // one that never connects both arrive at the page as a bare error event, but
+  // only if we decline to speak.
+  if (RequestIsFromWebPage(request)) {
+    Close(connection_id);
+    return;
+  }
+
   if (!RequestIsSafeToServe(request)) {
     Send500(connection_id,
             "Host header is specified and is not an IP address or localhost.");
