+++ b/third_party/blink/renderer/platform/network/network_state_notifier.cc
@@ -25,9 +25,13 @@
 
 #include "third_party/blink/renderer/platform/network/network_state_notifier.h"
 
+#include <algorithm>
 #include <array>
 #include <memory>
+#include <optional>
+#include <utility>
 
+#include "base/apostate/profile.h"
 #include "base/synchronization/lock.h"
 #include "base/task/single_thread_task_runner.h"
 #include "net/nqe/effective_connection_type.h"
@@ -69,6 +73,82 @@
     kTypicalDownlinkMbpsEffectiveConnectionType = {0,     0,     0.040,
                                                    0.075, 0.400, 1.600};
 
+base::TimeDelta HttpRttThresholdFor(EffectiveConnectionType type) {
+  return net::kHttpRttEffectiveConnectionTypeThresholds[static_cast<size_t>(
+      type)];
+}
+
+// The effective connection type Chromium itself would report for a given HTTP
+// round trip, using the same thresholds SetNetworkConnectionInfoOverride uses.
+WebEffectiveConnectionType EffectiveTypeForHttpRtt(base::TimeDelta http_rtt) {
+  if (http_rtt >= HttpRttThresholdFor(
+                      EffectiveConnectionType::kEffectiveConnectionSlow2GType)) {
+    return WebEffectiveConnectionType::kTypeSlow2G;
+  }
+  if (http_rtt >=
+      HttpRttThresholdFor(EffectiveConnectionType::kEffectiveConnection2GType)) {
+    return WebEffectiveConnectionType::kType2G;
+  }
+  if (http_rtt >=
+      HttpRttThresholdFor(EffectiveConnectionType::kEffectiveConnection3GType)) {
+    return WebEffectiveConnectionType::kType3G;
+  }
+  return WebEffectiveConnectionType::kType4G;
+}
+
+// The inclusive HTTP round-trip band that implies a given effective connection
+// type, read off the same threshold table. The 4G band has no lower bound and
+// the slow-2G band's upper bound is RoundRtt's own 3 s ceiling, above which
+// nothing is observable.
+std::pair<base::TimeDelta, base::TimeDelta> HttpRttBandFor(
+    WebEffectiveConnectionType type) {
+  constexpr base::TimeDelta kOneMs = base::Milliseconds(1);
+  switch (type) {
+    case WebEffectiveConnectionType::kTypeSlow2G:
+      return {HttpRttThresholdFor(
+                  EffectiveConnectionType::kEffectiveConnectionSlow2GType),
+              base::Seconds(3)};
+    case WebEffectiveConnectionType::kType2G:
+      return {HttpRttThresholdFor(
+                  EffectiveConnectionType::kEffectiveConnection2GType),
+              HttpRttThresholdFor(
+                  EffectiveConnectionType::kEffectiveConnectionSlow2GType) -
+                  kOneMs};
+    case WebEffectiveConnectionType::kType3G:
+      return {HttpRttThresholdFor(
+                  EffectiveConnectionType::kEffectiveConnection3GType),
+              HttpRttThresholdFor(
+                  EffectiveConnectionType::kEffectiveConnection2GType) -
+                  kOneMs};
+    case WebEffectiveConnectionType::kType4G:
+    case WebEffectiveConnectionType::kTypeUnknown:
+    case WebEffectiveConnectionType::kTypeOffline:
+      return {base::TimeDelta(),
+              HttpRttThresholdFor(
+                  EffectiveConnectionType::kEffectiveConnection3GType) -
+                  kOneMs};
+  }
+  NOTREACHED();
+}
+
+// The profile spells the effective connection type the way the JS enum does.
+std::optional<WebEffectiveConnectionType> ParseProfileEffectiveType(
+    const std::string& name) {
+  if (name == "slow-2g") {
+    return WebEffectiveConnectionType::kTypeSlow2G;
+  }
+  if (name == "2g") {
+    return WebEffectiveConnectionType::kType2G;
+  }
+  if (name == "3g") {
+    return WebEffectiveConnectionType::kType3G;
+  }
+  if (name == "4g") {
+    return WebEffectiveConnectionType::kType4G;
+  }
+  return std::nullopt;
+}
+
 }  // namespace
 
