+// static
+void NetworkStateNotifier::ApplyProfileNetworkQuality(NetworkState& state) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile) {
+    return;
+  }
+
+  if (std::optional<bool> save_data = profile->network_save_data()) {
+    state.save_data = *save_data;
+  }
+
+  const std::optional<std::string>& type_name =
+      profile->network_effective_type();
+  const std::optional<int> profile_rtt_ms = profile->network_http_rtt_ms();
+  const std::optional<double> profile_downlink_mbps =
+      profile->network_downlink_mbps();
+  if (!type_name && !profile_rtt_ms && !profile_downlink_mbps) {
+    return;
+  }
+
+  std::optional<WebEffectiveConnectionType> effective_type;
+  if (type_name) {
+    effective_type = ParseProfileEffectiveType(*type_name);
+  }
+  std::optional<base::TimeDelta> http_rtt;
+  if (profile_rtt_ms) {
+    http_rtt = base::Milliseconds(*profile_rtt_ms);
+  }
+
+  // Each half of the pair pins the other, so the two cannot end up saying
+  // different things whatever the profile was written to say. A named type
+  // holds the round trip inside that type's band; a round trip on its own
+  // selects the type Chromium would have derived from it.
+  if (effective_type && http_rtt) {
+    const std::pair<base::TimeDelta, base::TimeDelta> band =
+        HttpRttBandFor(*effective_type);
+    http_rtt = std::clamp(*http_rtt, band.first, band.second);
+  } else if (effective_type) {
+    http_rtt = kTypicalHttpRttEffectiveConnectionType[static_cast<size_t>(
+        *effective_type)];
+  } else if (http_rtt) {
+    effective_type = EffectiveTypeForHttpRtt(*http_rtt);
+  }
+
+  if (effective_type) {
+    state.effective_type = *effective_type;
+    // Throughput under the claimed type's own typical value is the same
+    // contradiction seen from the other side, so the floor comes from
+    // Chromium's table rather than from a number of ours. Nothing caps the
+    // value here: RoundMbps stops at 10 Mbps, so a larger estimate is not
+    // observable and the stored figure stays the one the profile stated.
+    const double typical_downlink_mbps =
+        kTypicalDownlinkMbpsEffectiveConnectionType[static_cast<size_t>(
+            *effective_type)];
+    state.downlink_throughput_mbps =
+        std::max(profile_downlink_mbps.value_or(typical_downlink_mbps),
+                 typical_downlink_mbps);
+  } else if (profile_downlink_mbps) {
+    state.downlink_throughput_mbps = *profile_downlink_mbps;
+  }
+
+  if (http_rtt) {
+    state.http_rtt = *http_rtt;
+  }
+
+  // transport_rtt is deliberately left on the host's value. Nothing outside
+  // this class's own tests reads it in this build, so serving it would be a
+  // change with no observable and no way to check it stayed right.
+}
+
 double NetworkStateNotifier::GetRandomMultiplier(const String& host) const {
   // The random number should be a function of the hostname to reduce
   // cross-origin fingerprinting. The random number should also be a function
