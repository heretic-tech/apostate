 namespace content {
 namespace {
+
+// The provider that speaks for a composed voice.
+//
+// A profile names the machine's voices; this build's providers are whatever
+// the host actually has. Where the two agree the real record is used verbatim,
+// so a Windows persona on a Windows host keeps its native identifiers. Where
+// they do not, the page is shown the persona's voice and a real provider is
+// chosen to synthesise it, because the alternative answers are both wrong: the
+// host's own list under a foreign persona says which machine this is, and an
+// empty list says nothing real does.
+//
+// Selection is by language, closest first, and deterministic: the provider
+// list arrives in the platform's own order and the first match in it wins, so
+// one profile on one host resolves the same way on every launch.
+const VoiceData* SubstituteProvider(const base::apostate::Profile::SpeechVoice&
+                                        requested,
+                                    const std::vector<VoiceData>& providers) {
+  if (providers.empty()) {
+    return nullptr;
+  }
+  for (const VoiceData& provider : providers) {
+    if (provider.lang == requested.lang) {
+      return &provider;
+    }
+  }
+  const std::string_view requested_primary =
+      std::string_view(requested.lang).substr(0, requested.lang.find('-'));
+  for (const VoiceData& provider : providers) {
+    if (std::string_view(provider.lang).substr(0, provider.lang.find('-')) ==
+        requested_primary) {
+      return &provider;
+    }
+  }
+  return &providers.front();
+}
+
+// True when a real provider is this exact voice rather than a stand-in.
+bool ProviderIsRequestedVoice(
+    const VoiceData& provider,
+    const base::apostate::Profile::SpeechVoice& requested) {
+  return provider.name == requested.name && provider.lang == requested.lang &&
+         (!requested.local_service ||
+          *requested.local_service == !provider.remote);
+}
+
+// The voice list a page sees under a profile, in the profile's own order.
+//
+// `out_providers`, when given, is filled with the record that will actually
+// synthesise each entry, parallel to the returned list. A requested voice with
+// no provider at all is dropped rather than listed, because a voice that
+// cannot speak is a wrong answer to a question a page can ask cheaply.
+std::vector<VoiceData> ComposeProfileVoices(
+    const std::vector<base::apostate::Profile::SpeechVoice>& requested_voices,
+    const std::vector<VoiceData>& providers,
+    std::vector<VoiceData>* out_providers) {
+  // A record that is neither native nor an engine's routes nowhere, so it can
+  // neither be a voice nor stand in for one.
+  std::vector<VoiceData> routable;
+  routable.reserve(providers.size());
+  for (const VoiceData& provider : providers) {
+    if (provider.native || !provider.engine_id.empty()) {
+      routable.push_back(provider);
+    }
+  }
+  std::vector<VoiceData> composed;
+  composed.reserve(requested_voices.size());
+  for (const auto& requested : requested_voices) {
+    const VoiceData* provider = nullptr;
+    for (const VoiceData& candidate : routable) {
+      if (ProviderIsRequestedVoice(candidate, requested)) {
+        provider = &candidate;
+        break;
+      }
+    }
+    const bool is_real = provider != nullptr;
+    if (!is_real) {
+      provider = SubstituteProvider(requested, routable);
+    }
+    if (!provider) {
+      continue;
+    }
+    VoiceData voice = *provider;
+    if (!is_real) {
+      // Everything a page reads comes from the profile; everything that routes
+      // and reports capability comes from the provider that will speak.
+      voice.name = requested.name;
+      voice.lang = requested.lang;
+      if (requested.local_service) {
+        voice.remote = !*requested.local_service;
+      }
+    }
+    composed.push_back(std::move(voice));
+    if (out_providers) {
+      out_providers->push_back(*provider);
+    }
+  }
+  return composed;
+}
+
