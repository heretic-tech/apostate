+// A persona's voice is listed whether or not this host has a provider of that
+// name. The alternatives are both readable: the host's own voices under a
+// foreign persona say which machine this is, and an empty list says nothing
+// real does.
+TEST_F(TtsControllerTest, ProfileVoiceWithoutItsOwnProviderIsStillListed) {
+  ScopedSpeechProfile profile(R"json({"speech":{"voices":[
+      {"name":"Microsoft David - English (United States)","lang":"en-US",
+       "local_service":true}]}})json");
+  VoiceData host_voice;
+  host_voice.name = "Samantha";
+  host_voice.lang = "en-US";
+  host_voice.native = true;
+  host_voice.native_voice_identifier = "com.apple.voice.samantha";
+  host_voice.events = {TTS_EVENT_START, TTS_EVENT_END};
+  platform_impl()->set_voices({host_voice});
+
+  std::vector<VoiceData> voices;
+  controller()->GetVoices(browser_context(), GURL(), &voices);
+  ASSERT_EQ(1u, voices.size());
+  EXPECT_EQ("Microsoft David - English (United States)", voices[0].name);
+  EXPECT_EQ("en-US", voices[0].lang);
+  EXPECT_FALSE(voices[0].remote);
+}
 
+// The host's own voices are never page-visible under a profile, whatever the
+// profile asked for and however many the host has.
+TEST_F(TtsControllerTest, ProfileVoicesReplaceTheHostList) {
+  ScopedSpeechProfile profile(R"json({"speech":{"voices":[
+      {"name":"Microsoft Zira - English (United States)","lang":"en-US",
+       "local_service":true}]}})json");
+  VoiceData first;
+  first.name = "Albert";
+  first.lang = "en-US";
+  first.native = true;
+  VoiceData second(first);
+  second.name = "Alva";
+  second.lang = "sv-SE";
+  platform_impl()->set_voices({first, second});
+
+  std::vector<VoiceData> voices;
+  controller()->GetVoices(browser_context(), GURL(), &voices);
+  ASSERT_EQ(1u, voices.size());
+  EXPECT_EQ("Microsoft Zira - English (United States)", voices[0].name);
+}
+
+// Speaking a composed voice reaches the platform as the provider that can
+// actually synthesise it. The page chose a name this host has never heard of,
+// and something real still speaks.
+TEST_F(TtsControllerTest, ComposedVoiceSpeaksThroughItsProvider) {
+  ScopedSpeechProfile profile(R"json({"speech":{"voices":[
+      {"name":"Microsoft David - English (United States)","lang":"en-US",
+       "local_service":true}]}})json");
+  VoiceData host_voice;
+  host_voice.name = "Samantha";
+  host_voice.lang = "en-US";
+  host_voice.native = true;
+  host_voice.native_voice_identifier = "com.apple.voice.samantha";
+  host_voice.events = {TTS_EVENT_START, TTS_EVENT_END};
+  platform_impl()->set_voices({host_voice});
+
+  auto utterance = CreateUtteranceImpl();
+  utterance->SetText("spoken by a substitute");
+  utterance->SetVoiceName("Microsoft David - English (United States)");
+  controller()->SpeakOrEnqueue(std::move(utterance));
+
+  EXPECT_EQ(1, platform_impl()->speak_called());
+  EXPECT_EQ("Samantha", platform_impl()->get_utterance_voice().name);
+  EXPECT_EQ("com.apple.voice.samantha",
+            platform_impl()->get_utterance_voice().native_voice_identifier);
+}
+
+// The substitute is chosen by language, so a persona's French voice is spoken
+// by the host's French one rather than by whichever came first.
+TEST_F(TtsControllerTest, SubstituteProviderFollowsTheLanguage) {
+  ScopedSpeechProfile profile(R"json({"speech":{"voices":[
+      {"name":"Microsoft Hortense - French (France)","lang":"fr-FR",
+       "local_service":true}]}})json");
+  VoiceData english;
+  english.name = "Samantha";
+  english.lang = "en-US";
+  english.native = true;
+  VoiceData french(english);
+  french.name = "Thomas";
+  french.lang = "fr-FR";
+  platform_impl()->set_voices({english, french});
+
+  auto utterance = CreateUtteranceImpl();
+  utterance->SetText("parlé par un remplaçant");
+  utterance->SetVoiceName("Microsoft Hortense - French (France)");
+  controller()->SpeakOrEnqueue(std::move(utterance));
+
+  EXPECT_EQ(1, platform_impl()->speak_called());
+  EXPECT_EQ("Thomas", platform_impl()->get_utterance_voice().name);
+}
