Subject: [PATCH] webgpu: no adapter when the profile describes none

Some measured GPUs have no WebGPU adapter in their capture, and their
profiles carry no WebGPU section. For those profiles
navigator.gpu.requestAdapter() resolves to null on a GPU-less host, in
place of a SwiftShader adapter that names itself as software beside a
GeForce renderer string. Stock Chrome on a GPU-less Linux host also
returns null. Profiles that describe an adapter keep it, taken from the
same measured GPU as the WebGL values.

--- a/gpu/command_buffer/service/profile_software_webgpu_policy.h
+++ b/gpu/command_buffer/service/profile_software_webgpu_policy.h
@@ -4,6 +4,7 @@
 #define GPU_COMMAND_BUFFER_SERVICE_PROFILE_SOFTWARE_WEBGPU_POLICY_H_
 
 #include <string_view>
+#include "base/apostate/profile.h"
 #include "gpu/config/gpu_preferences.h"
 #include "gpu/config/webgpu_blocklist_impl.h"
 #include "third_party/dawn/include/dawn/webgpu_cpp.h"
@@ -17,12 +18,39 @@
   bool has_dawn_overrides = false;
   bool force_compat = false;
   WebGPUAdapterName requested_adapter = WebGPUAdapterName::kDefault;
+
+  // Whether the composed profile describes a WebGPU adapter at all.
+  //
+  // Required, because admitting the software adapter is what makes
+  // navigator.gpu answer at all on a host with no GPU. A profile whose resolved
+  // GPU identity measured no adapter must not be given one: serving an adapter
+  // the claimed device did not have is an assertion nothing measured, and the
+  // identity strings overlaid on it would then be the only honest part of it.
+  //
+  // Defaults false so that a caller which does not consider the question gets
+  // stock behaviour rather than an adapter by omission.
+  bool profile_declares_webgpu_adapter = false;
 };
 
+// True when `profile` describes a WebGPU adapter.
+//
+// Any one populated field counts. Compose merges a member's WebGPU fragment
+// whole or not at all, so for a composed profile this is all-or-nothing; the
+// any-field form matters for a hand-written --apostate-profile, where refusing
+// on a partial fragment would silently drop a claim the user did make. The
+// direction is deliberate: a partial claim is served as far as it goes, and an
+// absent one is not invented.
+inline bool ProfileDeclaresWebGPUAdapter(const base::apostate::Profile& profile) {
+  return !profile.webgpu_vendor().empty() ||
+         !profile.webgpu_architecture().empty() ||
+         !profile.webgpu_features().empty() || !profile.webgpu_limits().empty();
+}
+
 inline bool CanUseProfileSoftwareWebGPU(const ProfileSoftwareWebGPUContext& context) {
   return (context.platform == "Windows" || context.platform == "macOS") &&
          context.angle_is_swiftshader && context.shared_context_is_gl && context.safe &&
-         !context.has_dawn_overrides && !context.force_compat &&
+         context.profile_declares_webgpu_adapter && !context.has_dawn_overrides &&
+         !context.force_compat &&
          (context.requested_adapter == WebGPUAdapterName::kDefault ||
           context.requested_adapter == WebGPUAdapterName::kSwiftShader);
 }
--- a/gpu/command_buffer/service/webgpu_decoder_impl.cc
+++ b/gpu/command_buffer/service/webgpu_decoder_impl.cc
@@ -1162,6 +1162,7 @@
                               !require_disabled_toggles_.empty() || !runtime_unsafe_features_.empty(),
         .force_compat = force_webgpu_compat_,
         .requested_adapter = use_webgpu_adapter_,
+        .profile_declares_webgpu_adapter = ProfileDeclaresWebGPUAdapter(*profile),
     });
   }
 #endif
--- a/gpu/command_buffer/service/shared_image/gl_texture_image_backing_factory.cc
+++ b/gpu/command_buffer/service/shared_image/gl_texture_image_backing_factory.cc
@@ -78,6 +78,8 @@
                 !features::kWebGPUUnsafeFeatures.Get().empty(),
             .force_compat = gpu_preferences.force_webgpu_compat,
             .requested_adapter = gpu_preferences.use_webgpu_adapter,
+            .profile_declares_webgpu_adapter =
+                webgpu::ProfileDeclaresWebGPUAdapter(*profile),
         });
 #else
         return false;
--- a/gpu/config/webgpu_blocklist_unittest.cc
+++ b/gpu/config/webgpu_blocklist_unittest.cc
@@ -213,6 +213,7 @@
   context.angle_is_swiftshader = true;
   context.shared_context_is_gl = true;
   context.safe = true;
+  context.profile_declares_webgpu_adapter = true;
   EXPECT_TRUE(webgpu::CanUseProfileSoftwareWebGPU(context));
   context.platform = "macOS";
   EXPECT_TRUE(webgpu::CanUseProfileSoftwareWebGPU(context));
@@ -232,6 +233,7 @@
   webgpu::ProfileSoftwareWebGPUContext context;
   context.platform = "Windows";
   context.angle_is_swiftshader = context.shared_context_is_gl = context.safe = true;
+  context.profile_declares_webgpu_adapter = true;
   context.safe = false;
   EXPECT_FALSE(webgpu::CanUseProfileSoftwareWebGPU(context));
   context.safe = true;
@@ -249,6 +251,21 @@
   EXPECT_TRUE(webgpu::CanUseProfileSoftwareWebGPU(context));
 }
 
+// A profile whose resolved GPU identity measured no WebGPU adapter must not be
+// given one. Admitting the software adapter is what makes navigator.gpu answer
+// at all on a host with no GPU, so refusing admission reproduces what the
+// member measured -- and what stock Chrome reports on such a host, which is no
+// adapter. Two of linux-vulkan-nvidia-adf287b8f0ee's members are in this state.
+TEST(ProfileSoftwareWebGPUPolicyTest, RefusesWhenTheProfileDeclaresNoAdapter) {
+  webgpu::ProfileSoftwareWebGPUContext context;
+  context.platform = "Windows";
+  context.angle_is_swiftshader = context.shared_context_is_gl = context.safe = true;
+  context.profile_declares_webgpu_adapter = false;
+  EXPECT_FALSE(webgpu::CanUseProfileSoftwareWebGPU(context));
+  context.profile_declares_webgpu_adapter = true;
+  EXPECT_TRUE(webgpu::CanUseProfileSoftwareWebGPU(context));
+}
+
 TEST(ProfileSoftwareWebGPUPolicyTest, OnlyApprovedCPUReasonIsIgnored) {
   auto make_info = [](WGPUAdapterType type, uint32_t vendor) {
     WGPUAdapterInfo raw = {};
