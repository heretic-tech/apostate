Subject: [PATCH] compose: the GPU cluster follows the host CPU family

Patch 0138 makes a Windows or Linux persona claim the CPU family the
browser runs on, because a page can tell it from arithmetic. The anchor
draw did not look at it, so on an ARM host a Windows persona paired arm
with a desktop Intel or NVIDIA GPU. No real Windows machine has that
pair, and iphey.com flags it.

An anchor now names the CPU family of the machines it was measured on:
arm, x86, or none for either. The draw skips an anchor from the other
family, so a Windows persona on an ARM host draws the Qualcomm Adreno
cluster and one on an x86 host draws Intel or NVIDIA as before. The
candidate list on x86 hosts is unchanged, so no seed moves there. A
pinned anchor is still served on any host.

diff --git a/base/apostate/compose.cc b/base/apostate/compose.cc
index edebc1123c..8ba4c7f461 100644
--- a/base/apostate/compose.cc
+++ b/base/apostate/compose.cc
@@ -70,6 +70,14 @@ constexpr char kStateDirectoryName[] = "apostate";
 // draw has to treat it as a special case rather than as one more backend.
 constexpr std::string_view kSoftwareBackend = "swiftshader";
 
+// The CPU family this browser was built for, which is the one it runs on and
+// the one patch 0138 claims for a Windows or Linux persona.
+#if defined(ARCH_CPU_ARM_FAMILY)
+constexpr std::string_view kHostArchitecture = "arm";
+#else
+constexpr std::string_view kHostArchitecture = "x86";
+#endif
+
 constexpr std::string_view kLayerAnchor = "anchor";
 constexpr std::string_view kLayerDispersion = "dispersion";
 constexpr std::string_view kLayerHostInherited = "host-inherited";
@@ -1032,6 +1040,14 @@ std::optional<Composition> Compose(const ComposeRequest& request,
       if (candidate.backend == kSoftwareBackend) {
         continue;
       }
+      // The persona claims the host's CPU family, so its GPU has to come from
+      // a machine with that CPU family: an ARM Windows machine has a Qualcomm
+      // Adreno, and an x86 one has an Intel or NVIDIA GPU. Pairing arm with a
+      // desktop GPU is a machine that does not exist, and iphey.com flags it.
+      if (!candidate.host_architecture.empty() &&
+          candidate.host_architecture != kHostArchitecture) {
+        continue;
+      }
       if (candidate.platform == composition.platform) {
         servable.push_back(&candidate);
       }
diff --git a/base/apostate/compose_unittest.cc b/base/apostate/compose_unittest.cc
index dd8f108553..63a2c812f8 100644
--- a/base/apostate/compose_unittest.cc
+++ b/base/apostate/compose_unittest.cc
@@ -806,6 +806,52 @@ TEST(ApostateComposeTest, TheSoftwareAnchorIsNeverDrawn) {
   EXPECT_EQ("test-swiftshader", ChosenId(*composition, "anchor"));
 }
 
+// A persona claims the CPU family the browser runs on (patch 0138), so the
+// draw takes only anchors measured on that CPU family. The other family's
+// anchor is weighted far above so that a draw which considered it would pick
+// it.
+TEST(ApostateComposeTest, TheAnchorFollowsTheHostCpuFamily) {
+#if defined(ARCH_CPU_ARM_FAMILY)
+  constexpr std::string_view kSameFamily = "arm";
+  constexpr std::string_view kOtherFamily = "x86";
+#else
+  constexpr std::string_view kSameFamily = "x86";
+  constexpr std::string_view kOtherFamily = "arm";
+#endif
+  const Anchor anchors[] = {
+      {"test-same-cpu", "windows", "d3d11", "Test", "physical-ground-truth",
+       "dd", "ee", "ff", 1, span<const AnchorMember>(kD3d11Members),
+       R"({"gl_limits":{"MAX_TEXTURE_SIZE":8192}})", kSameFamily},
+      {"test-other-cpu", "windows", "d3d11", "Test", "physical-ground-truth",
+       "jj", "kk", "ll", 1000, span<const AnchorMember>(kD3d11Members),
+       R"({"gl_limits":{"MAX_TEXTURE_SIZE":8192}})", kOtherFamily},
+      {"test-any-cpu", "windows", "d3d11", "Test", "physical-ground-truth",
+       "mm", "nn", "oo", 1, span<const AnchorMember>(kD3d11Members),
+       R"({"gl_limits":{"MAX_TEXTURE_SIZE":8192}})"},
+  };
+  constexpr DispersionAxis kAxes[] = {kOsReleaseAxis};
+  HostCapability host = CapableHost();
+  host.platform = "linux";
+
+  for (int seed = 0; seed < 24; ++seed) {
+    ComposeRequest request =
+        RequestFor("cpu-family-" + NumberToString(seed), kAxes, host);
+    request.anchors = span<const Anchor>(anchors);
+    const std::optional<Composition> composition = Compose(request);
+    ASSERT_TRUE(composition.has_value()) << "seed " << seed;
+    EXPECT_NE("test-other-cpu", ChosenId(*composition, "anchor"))
+        << "seed " << seed;
+  }
+
+  // A pin is an explicit request and still serves the other family.
+  ComposeRequest pinned = RequestFor("cpu-family-pinned", kAxes, host);
+  pinned.anchors = span<const Anchor>(anchors);
+  pinned.pinned_anchor = "test-other-cpu";
+  const std::optional<Composition> composition = Compose(pinned);
+  ASSERT_TRUE(composition.has_value());
+  EXPECT_EQ("test-other-cpu", ChosenId(*composition, "anchor"));
+}
+
 // WebGPU is the one part of a capability cluster that is not anchor-wide.
 // `capability_cluster.webgpu.uniform` is false for the Linux/Vulkan anchor: two
 // members report nvidia/lovelace and two returned no adapter at all. Handing
diff --git a/base/apostate/dispersion_table.h b/base/apostate/dispersion_table.h
index 36266b5eb6..2a94af6627 100644
--- a/base/apostate/dispersion_table.h
+++ b/base/apostate/dispersion_table.h
@@ -155,6 +155,12 @@ struct Anchor {
   uint32_t weight = 1;
   span<const AnchorMember> members;
   std::string_view value_json;
+  // The CPU family of the machines this cluster was measured on: "arm", "x86",
+  // or empty for either. The draw skips an anchor whose CPU family differs
+  // from the one the browser runs on, because patch 0138 claims the host's
+  // family and no real Windows machine pairs an ARM CPU with a desktop Intel
+  // or NVIDIA GPU, or an x86 CPU with a Qualcomm Adreno.
+  std::string_view host_architecture;
 
   // The member that measured this identity pair, or null.
   //
