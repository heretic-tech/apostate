index affe606..1be796d 100644
--- a/base/apostate/profile.cc
+++ b/base/apostate/profile.cc
@@ -237,6 +237,36 @@ Profile* Profile::ParseOrNull(const std::string& encoded) {
     }
   }
 
+  if (const DictValue* precs = dict->FindDict("gl_precisions")) {
+    for (const auto [name, value] : *precs) {
+      const DictValue* entry = value.GetIfDict();
+      if (!entry) {
+        continue;
+      }
+      std::optional<int> lo = entry->FindInt("rangeMin");
+      std::optional<int> hi = entry->FindInt("rangeMax");
+      std::optional<int> bits = entry->FindInt("precision");
+      // All three or none. A partial entry would mix the claim with the host
+      // on one query, which is the incoherence this whole field exists to
+      // remove.
+      if (!lo || !hi || !bits) {
+        LOG(ERROR) << "apostate: gl_precisions." << name
+                   << " needs rangeMin, rangeMax and precision; ignoring";
+        continue;
+      }
+      // getShaderPrecisionFormat reports log2 of the exponent range and a
+      // mantissa bit count. IEEE binary32 is the largest thing any GL type
+      // describes, so nothing legitimate exceeds these.
+      if (*lo < 0 || *lo > 127 || *hi < 0 || *hi > 127 || *bits < 0 ||
+          *bits > 23) {
+        LOG(ERROR) << "apostate: gl_precisions." << name
+                   << " out of range; ignoring";
+        continue;
+      }
+      profile->gl_precisions_[name] = ShaderPrecision{*lo, *hi, *bits};
+    }
+  }
+
   if (const DictValue* keyboard = dict->FindDict("keyboard")) {
     if (const DictValue* map = keyboard->FindDict("layout_map")) {
       for (const auto [code, value] : *map) {
