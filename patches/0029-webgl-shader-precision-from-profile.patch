index 1df38a4..9aa8325 100644
--- a/ui/gl/gl_gl_api_implementation.h
+++ b/ui/gl/gl_gl_api_implementation.h
@@ -55,6 +55,10 @@ class GL_EXPORT RealGLApi : public GLApiBase {
