diff --git a/ui/gl/gl_gl_api_implementation.cc b/ui/gl/gl_gl_api_implementation.cc
index 5af1eda..136e3ea 100644
--- a/ui/gl/gl_gl_api_implementation.cc
+++ b/ui/gl/gl_gl_api_implementation.cc
@@ -317,6 +317,99 @@ void RealGLApi::glGetIntegervFn(GLenum pname, GLint* params) {
   }
 }
 
+void RealGLApi::glGetShaderPrecisionFormatFn(GLenum shadertype,
+                                             GLenum precisiontype,
+                                             GLint* range,
+                                             GLint* precision) {
+  GLApiBase::glGetShaderPrecisionFormatFn(shadertype, precisiontype, range,
+                                          precision);
+
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || profile->gl_precisions().empty() || !range || !precision) {
+    return;
+  }
+
+  const char* shader = nullptr;
+  switch (shadertype) {
+    case GL_VERTEX_SHADER:
+      shader = "VERTEX_SHADER";
+      break;
+    case GL_FRAGMENT_SHADER:
+      shader = "FRAGMENT_SHADER";
+      break;
+    default:
+      return;
+  }
+
+  const char* qualifier = nullptr;
+  switch (precisiontype) {
+    case GL_LOW_FLOAT:
+      qualifier = "LOW_FLOAT";
+      break;
+    case GL_MEDIUM_FLOAT:
+      qualifier = "MEDIUM_FLOAT";
+      break;
+    case GL_HIGH_FLOAT:
+      qualifier = "HIGH_FLOAT";
+      break;
+    case GL_LOW_INT:
+      qualifier = "LOW_INT";
+      break;
+    case GL_MEDIUM_INT:
+      qualifier = "MEDIUM_INT";
+      break;
+    case GL_HIGH_INT:
+      qualifier = "HIGH_INT";
+      break;
+    default:
+      return;
+  }
+
+  auto it = profile->gl_precisions().find(std::string(shader) + "." +
+                                          std::string(qualifier));
+  if (it == profile->gl_precisions().end()) {
+    return;
+  }
+
+  // Unlike the limits above this is served without clamping, and the reason is
+  // measured rather than assumed. A limit is falsified by using it — allocate
+  // past the reported size and an over-claim collapses. A precision claim is
+  // falsified only if the backend actually computes at the lower precision, so
+  // the question is whether ours does.
+  //
+  // It does not. Running the same 2^-16 residual through lowp, mediump and
+  // highp on ANGLE/SwiftShader returns an identical non-zero result from all
+  // three: SwiftShader declares lowp and mediump as 10-bit with a range of 15
+  // and then computes every one of them in float32. Reporting 23/127/127 for
+  // those qualifiers is therefore truthful about what the shader will do, and
+  // no shader can catch it out. Clamping here would instead force us to keep
+  // publishing a declaration that contradicts the backend's own arithmetic.
+  //
+  // The warning still fires when a claim exceeds what the host declares,
+  // because that reasoning is specific to backends that compute at float32
+  // throughout. A backend that genuinely rounds to its declared precision
+  // would make the claim falsifiable again, and the log line is how that shows
+  // up rather than being discovered at V4.
+  if (it->second.precision > *precision) {
+    LOG(WARNING) << "apostate: profile claims " << shader << "." << qualifier
+                 << " precision " << it->second.precision
+                 << " but this driver declares " << *precision
+                 << ". Serving the claim: verified on ANGLE/SwiftShader, whose "
+                    "reduced qualifiers compute at float32 regardless. Confirm "
+                    "the same holds on any other backend.";
+  }
+
+  // Written through std::copy_n rather than range[0]/range[1]. The GL entry
+  // point contract guarantees two elements and GLApiBase has just filled both,
+  // but raw indexing past [0] trips -Wunsafe-buffer-usage, and nothing in
+  // ui/gl uses the UNSAFE_BUFFERS escape hatch — no reason to be the first.
+  const std::array<GLint, 2> claimed_range = {
+      static_cast<GLint>(it->second.range_min),
+      static_cast<GLint>(it->second.range_max)};
+  std::copy_n(claimed_range.begin(), claimed_range.size(), range);
+  *precision = static_cast<GLint>(it->second.precision);
+}
+
 const GLubyte* RealGLApi::glGetStringFn(GLenum name) {
   if (name == GL_EXTENSIONS && disabled_exts_.size()) {
     InitializeFilteredExtensionsIfNeeded();
