+#if !BUILDFLAG(IS_CHROMEOS)
+// Apostate: a Windows persona's window fills the work area the profile claims,
+// as a maximized window does on real Windows, whatever the host display. So
+// does the next window; a saved placement is kept.
+TEST(WindowSizerTest, WindowsPersonaFillsTheClaimedWorkArea) {
+  constexpr char kWindows[] =
+      R"({"platform":{"name":"Windows"},"screen":{"width":1536,"height":864,)"
+      R"("avail_left":0,"avail_top":48,"avail_width":1536,"avail_height":816}})";
+  const gfx::Rect claimed(0, 48, 1536, 816);
+
+  {  // The first window.
+    EXPECT_EQ(claimed, WindowSizerTestUtil()
+                           .WithMonitorBounds(p1920x1200)
+                           .WithProfile(kWindows)
+                           .GetWindowBounds());
+  }
+
+  {  // A new window beside one already open.
+    EXPECT_EQ(claimed, WindowSizerTestUtil()
+                           .WithMonitorBounds(p1920x1200)
+                           .WithLastActiveBounds(claimed)
+                           .WithProfile(kWindows)
+                           .GetWindowBounds());
+  }
+
+  {  // A saved placement.
+    const gfx::Rect saved(50, 60, 700, 500);
+    EXPECT_EQ(saved, WindowSizerTestUtil()
+                         .WithMonitorBounds(p1920x1200)
+                         .WithPersistedBounds(saved)
+                         .WithProfile(kWindows)
+                         .GetWindowBounds());
+  }
+}
+#endif  // !BUILDFLAG(IS_CHROMEOS)
+
 // Test that the window opened is sized appropriately given persisted sizes.
 TEST(WindowSizerTest, MAYBE_PersistedBoundsCase) {
   {  // normal, in the middle of the screen somewhere.
