+// Apostate: where a new tabbed window goes on the screen the profile claims,
+// or nullopt to place it as upstream does.
+//
+// Pages read the screen from the profile (ScreenInfo, display_util.cc), not
+// from the host display the window sits on. Placed by the host display, every
+// persona got 945x1060 at (10,10) on a 1920x1080 Xvfb, taller than a claimed
+// 1536x864 screen. So the work area here is the one ScreenInfo reports, taken
+// the same way: the profile's, or the display's own when headless built it
+// from the profile's screen.displays. A Windows persona gets all of it, as
+// real Windows Chrome runs maximized: outerWidth and outerHeight equal
+// availWidth and availHeight, screenX and screenY equal availLeft and
+// availTop. macOS and Linux get their own default placement on it, which is
+// GetDefaultWindowBounds() with the constants of window_sizer_mac.mm and
+// window_sizer_aura.cc.
+//
+// A null browser is a caller asking for a new window's bounds before there is
+// a Browser. Other window types, and the switches that decide where a window
+// goes, keep upstream placement.
+std::optional<gfx::Rect> ClaimedWindowBounds(const Browser* browser,
+                                             const display::Display& display,
+                                             bool* fills_work_area) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || (browser && !browser->is_type_normal())) {
+    return std::nullopt;
+  }
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(switches::kWindowSize) ||
+      command_line.HasSwitch(switches::kWindowPosition) ||
+      command_line.HasSwitch(switches::kStartMaximized)) {
+    return std::nullopt;
+  }
+
+  const bool from_profile = !display.has_profile_geometry();
+  gfx::Rect work_area = display.work_area();
+  if (from_profile) {
+    if (!profile->screen_avail_width() || !profile->screen_avail_height()) {
+      return std::nullopt;
+    }
+    work_area = gfx::Rect(profile->screen_avail_left().value_or(work_area.x()),
+                          profile->screen_avail_top().value_or(work_area.y()),
+                          *profile->screen_avail_width(),
+                          *profile->screen_avail_height());
+  }
+  if (work_area.IsEmpty()) {
+    return std::nullopt;
+  }
+
+  const std::string platform = profile->ua_platform().value_or(std::string());
+  *fills_work_area = platform == "Windows";
+  if (*fills_work_area) {
+    return work_area;
+  }
+
+  // GetDefaultWindowBounds() also reads the primary display's size and the
+  // display's orientation, which the profile's screen replaces as well.
+  gfx::Size screen_size = display::Screen::Get()->GetPrimaryDisplay().size();
+  bool landscape = display.is_landscape();
+  if (from_profile && profile->screen_width() && profile->screen_height()) {
+    screen_size =
+        gfx::Size(*profile->screen_width(), *profile->screen_height());
+    landscape = screen_size.width() >= screen_size.height();
+  }
+
+  // A profile that claims no platform gets this build's own placement.
+  int tile = WindowSizer::kWindowTilePixels;
+  int max_width = WindowSizer::kWindowMaxDefaultWidth;
+  bool halve_wide_screen = !BUILDFLAG(IS_MAC);
+  if (platform == "macOS") {
+    tile = 22;
+    max_width = 1200;
+    halve_wide_screen = false;
+  } else if (platform == "Linux") {
+    tile = 10;
+    max_width = 1050;
+    halve_wide_screen = true;
+  }
+  int width = std::min(work_area.width() - 2 * tile, max_width);
+  int height = work_area.height() - 2 * tile;
+  if (halve_wide_screen &&
+      static_cast<double>(screen_size.width()) / screen_size.height() * 10 >=
+          16 &&
+      work_area.width() > 1600) {
+    width = static_cast<int>(work_area.width() / 2. - 1.5 * tile);
+  }
+  if (!landscape && height > width) {
+    height = (width / 4) * 3;
+  }
+  return gfx::Rect(work_area.x() + tile, work_area.y() + tile, width, height);
+}
+
 }  // namespace
 
 WindowSizer::WindowSizer(std::unique_ptr<StateProvider> state_provider,
@@ -252,8 +346,18 @@ void WindowSizer::DetermineWindowBoundsAndShowState(
     gfx::Rect* bounds,
     ui::mojom::WindowShowState* show_state) {
   if (bounds->IsEmpty()) {
+    // Apostate: a new tabbed window goes on the screen the profile claims.
+    const display::Display display = GetDisplayForNewWindow();
+    bool fills_work_area = false;
+    const std::optional<gfx::Rect> claimed =
+        ClaimedWindowBounds(browser(), display, &fills_work_area);
     // See if there's last active window's placement information.
     if (GetLastActiveWindowBounds(bounds, show_state)) {
+      // Windows opens a window maximized from a maximized one, so a Windows
+      // persona fills the work area with every new window, not only the first.
+      if (claimed && fills_work_area) {
+        *bounds = *claimed;
+      }
       return;
     }
     // See if there's saved placement information.
@@ -263,7 +367,7 @@ void WindowSizer::DetermineWindowBoundsAndShowState(
 
     // No saved placement, figure out some sensible default size based on
     // the user's screen size.
-    *bounds = GetDefaultWindowBounds(GetDisplayForNewWindow());
+    *bounds = claimed ? *claimed : GetDefaultWindowBounds(display);
     return;
   }
 
