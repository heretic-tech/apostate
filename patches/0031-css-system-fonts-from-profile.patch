+  if (const DictValue* theme = dict->FindDict("theme")) {
+    if (const DictValue* fonts = theme->FindDict("system_fonts")) {
+      for (const auto [name, value] : *fonts) {
+        const DictValue* entry = value.GetIfDict();
+        if (!entry) {
+          continue;
+        }
+        const std::string* family = entry->FindString("family");
+        std::optional<double> size = entry->FindDouble("size_px");
+        if (!size) {
+          if (std::optional<int> as_int = entry->FindInt("size_px")) {
+            size = *as_int;
+          }
+        }
+        // Both or neither. A family without a size resolves at the host's
+        // default size, which is the mismatch this exists to remove.
+        if (!family || family->empty() || !size) {
+          LOG(ERROR) << "apostate: theme.system_fonts." << name
+                     << " needs family and size_px; ignoring";
+          continue;
+        }
+        if (*size <= 0 || *size > 200) {
+          LOG(ERROR) << "apostate: theme.system_fonts." << name
+                     << ".size_px out of range; ignoring";
+          continue;
+        }
+        profile->css_system_fonts_[name] = SystemFont{*family, *size};
+      }
+    }
+  }
+
   if (const DictValue* keyboard = dict->FindDict("keyboard")) {
     if (const DictValue* map = keyboard->FindDict("layout_map")) {
