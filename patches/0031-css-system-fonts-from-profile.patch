diff --git a/third_party/blink/renderer/core/layout/layout_theme_font_provider_default.cc b/third_party/blink/renderer/core/layout/layout_theme_font_provider_default.cc
index 383ae4e..493b41d 100644
--- a/third_party/blink/renderer/core/layout/layout_theme_font_provider_default.cc
+++ b/third_party/blink/renderer/core/layout/layout_theme_font_provider_default.cc
@@ -25,23 +25,107 @@
 
 #include "third_party/blink/renderer/core/layout/layout_theme_font_provider.h"
 
+#include "base/apostate/profile.h"
 #include "third_party/blink/renderer/core/css_value_keywords.h"
 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
 #include "third_party/blink/renderer/platform/fonts/font_description.h"
+#include "third_party/blink/renderer/platform/wtf/hash_map.h"
 #include "third_party/blink/renderer/platform/wtf/std_lib_extras.h"
 #include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
 
 namespace blink {
 
+namespace {
+
+// Apostate: CSS system fonts from the profile.
+//
+// This file is the default provider, compiled on every platform that has no
+// native one — Linux included. It answers every system font keyword with
+// Arial at the default size, because on Linux there is nothing to ask. Windows
+// compiles layout_theme_font_provider_win.cc instead, which routes exactly
+// three keywords to the shell's non-client metrics.
+//
+// That is a compile-time platform gate, so a Linux build claiming Windows
+// cannot reach the right answer by any runtime path: the code that would have
+// produced it is not in the binary. The profile carries the resolved values and
+// this provider serves them, which keeps one file correct for any claimed
+// platform instead of compiling in a second per-platform table.
+//
+// Measured against the reference Windows machine: menu, small-caption and
+// status-bar are "Segoe UI" at 12px while caption, icon and message-box are
+// Arial at 16px — the same three that Chromium's Windows provider special-cases
+// and the same three we were getting wrong.
+
+const char* ApostateFontKey(CSSValueID id) {
+  switch (id) {
+    case CSSValueID::kCaption:
+      return "caption";
+    case CSSValueID::kIcon:
+      return "icon";
+    case CSSValueID::kMenu:
+      return "menu";
+    case CSSValueID::kMessageBox:
+      return "message-box";
+    case CSSValueID::kSmallCaption:
+      return "small-caption";
+    case CSSValueID::kStatusBar:
+      return "status-bar";
+    default:
+      return nullptr;
+  }
+}
+
+// The profile is immutable for the life of the process, so the AtomicStrings
+// are built once and handed out by reference. SystemFontFamily returns a
+// reference, so the storage has to outlive every caller.
+struct ApostateFontTable {
+  HashMap<String, AtomicString> family;
+};
+
+ApostateFontTable BuildApostateFontTable() {
+  ApostateFontTable table;
+  if (const base::apostate::Profile* profile = base::apostate::Profile::Get()) {
+    for (const auto& [key, font] : profile->css_system_fonts()) {
+      table.family.Set(String::FromUtf8(key),
+                       AtomicString(String::FromUtf8(font.family)));
+    }
+  }
+  return table;
+}
+
+const ApostateFontTable& GetApostateFontTable() {
+  DEFINE_THREAD_SAFE_STATIC_LOCAL(ApostateFontTable, table,
+                                  (BuildApostateFontTable()));
+  return table;
+}
+
+}  // namespace
+
 // static
 const AtomicString& LayoutThemeFontProvider::SystemFontFamily(
     CSSValueID system_font_id) {
+  if (const char* key = ApostateFontKey(system_font_id)) {
+    const ApostateFontTable& table = GetApostateFontTable();
+    auto it = table.family.find(String::FromUtf8(key));
+    if (it != table.family.end()) {
+      return it->value;
+    }
+  }
   return DefaultGUIFont();
 }
 
 // static
 float LayoutThemeFontProvider::SystemFontSize(CSSValueID system_font_id,
                                               const Document* document) {
+  if (const char* key = ApostateFontKey(system_font_id)) {
+    if (const base::apostate::Profile* profile =
+            base::apostate::Profile::Get()) {
+      auto it = profile->css_system_fonts().find(key);
+      if (it != profile->css_system_fonts().end()) {
+        return static_cast<float>(it->second.size_px);
+      }
+    }
+  }
   switch (system_font_id) {
     case CSSValueID::kWebkitMiniControl:
     case CSSValueID::kWebkitSmallControl:
