+// Characters a second of speech at rate 1.0, about the pace of a desktop
+// voice at its normal rate.
+constexpr double kTimedSpeechCharactersPerSecond = 15.0;
+
+// A real engine never finishes at once, however short the text.
+constexpr base::TimeDelta kShortestTimedSpeech = base::Milliseconds(120);
+
+// How long real speech of `utterance` takes: its characters at about fifteen
+// a second, scaled by its rate. The same text at the same rate always takes
+// the same time.
+base::TimeDelta TimedSpeechDuration(TtsUtterance* utterance) {
+  // Characters, not UTF-8 bytes: every byte but a continuation byte starts
+  // one.
+  const auto characters =
+      std::ranges::count_if(utterance->GetText(), [](char c) {
+        return (static_cast<unsigned char>(c) & 0xC0) != 0x80;
+      });
+  const double rate = utterance->GetContinuousParameters().rate;
+  return std::max(
+      base::Seconds(characters / (kTimedSpeechCharactersPerSecond *
+                                  (rate > 0.0 ? rate : 1.0))),
+      kShortestTimedSpeech);
+}
