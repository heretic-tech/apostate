+  task_environment().FastForwardBy(base::Milliseconds(999));
+  EXPECT_EQ(std::vector<TtsEventType>{TTS_EVENT_START}, events);
+  task_environment().FastForwardBy(base::Milliseconds(1));
+  EXPECT_EQ((std::vector<TtsEventType>{TTS_EVENT_START, TTS_EVENT_END}),
