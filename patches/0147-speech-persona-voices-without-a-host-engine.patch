+  // A timed utterance's clock belongs to that utterance alone.
+  timed_speech_.reset();
+  timed_speech_end_.Stop();
   current_utterance_ = std::move(utterance);
   Observe(current_utterance_
               ? AsUtteranceImpl(current_utterance_.get())->GetWebContents()
