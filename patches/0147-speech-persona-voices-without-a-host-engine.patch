+  utterance->SetText("Hello, persona!");
+  utterance->SetVoiceName("Google US English");
+  utterance->SetEventDelegate(std::make_unique<RecordingSpeechEvents>(events));
+  controller()->SpeakOrEnqueue(std::move(utterance));
+  EXPECT_EQ(0, platform_impl()->speak_called());
+
+  controller()->Pause();
+  task_environment().FastForwardBy(base::Seconds(5));
+  controller()->Resume();
+  EXPECT_EQ(std::vector<TtsEventType>{TTS_EVENT_START}, events);
+  task_environment().FastForwardBy(base::Seconds(1));
+  EXPECT_EQ((std::vector<TtsEventType>{TTS_EVENT_START, TTS_EVENT_END}),
+            events);
+  EXPECT_EQ(0, platform_impl()->pause_called());
+  EXPECT_EQ(0, platform_impl()->resume_called());
 }
 
