+void TtsControllerImpl::SpeakTimed(std::unique_ptr<TtsUtterance> utterance,
+                                   const VoiceData& voice) {
+  // The page's voice list is the profile's, so a voice it lists has to speak
+  // like one: an error or an utterance that never ends would say the list is
+  // only a list. Start fires now and end once the text would have been said.
+  // Nothing is audible, and no page can hear speech output.
+  SetCurrentUtterance(std::move(utterance));
+  const int utterance_id = current_utterance_->GetId();
+  timed_speech_.emplace();
+  timed_speech_->reports_pause = voice.events.contains(TTS_EVENT_PAUSE);
+  timed_speech_end_.Start(
+      FROM_HERE, TimedSpeechDuration(current_utterance_.get()),
+      base::BindOnce(&TtsControllerImpl::OnTimedSpeechEnd,
+                     base::Unretained(this), utterance_id));
+  OnTtsEvent(utterance_id, TTS_EVENT_START, 0, kInvalidLength, std::string());
+}
+
+void TtsControllerImpl::PauseTimedSpeech() {
+  DCHECK(timed_speech_end_.IsRunning());
+  timed_speech_->remaining =
+      std::max(timed_speech_end_.desired_run_time() - base::TimeTicks::Now(),
+               base::TimeDelta());
+  timed_speech_end_.Stop();
+  if (timed_speech_->reports_pause) {
+    OnTtsEvent(current_utterance_->GetId(), TTS_EVENT_PAUSE, kInvalidCharIndex,
+               kInvalidLength, std::string());
+  }
+}
+
+void TtsControllerImpl::ResumeTimedSpeech() {
+  const int utterance_id = current_utterance_->GetId();
+  timed_speech_end_.Start(
+      FROM_HERE, timed_speech_->remaining,
+      base::BindOnce(&TtsControllerImpl::OnTimedSpeechEnd,
+                     base::Unretained(this), utterance_id));
+  if (timed_speech_->reports_pause) {
+    OnTtsEvent(utterance_id, TTS_EVENT_RESUME, kInvalidCharIndex,
+               kInvalidLength, std::string());
+  }
+}
+
+void TtsControllerImpl::OnTimedSpeechEnd(int utterance_id) {
+  // SetCurrentUtterance() stops this clock whenever the utterance changes.
+  DCHECK(current_utterance_ && current_utterance_->GetId() == utterance_id);
+  OnTtsEvent(utterance_id, TTS_EVENT_END,
+             static_cast<int>(current_utterance_->GetText().size()), 0,
+             std::string());
+}
+
 void TtsControllerImpl::OnSpeakFinished(int utterance_id, bool success) {
   if (success)
     return;
@@ -1064,6 +1192,9 @@ int TtsControllerImpl::GetMatchingVoice(TtsUtterance* utterance,
 
