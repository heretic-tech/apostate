+// speak it with the host's own events, such as word boundaries, which
+// Chrome's network voices never send. Like them it reports no pause or
+// resume, and its end still waits out a pause.
+TEST_F(TtsControllerTest, NetworkVoiceWithoutItsEngineIsTimedNotStoodIn) {
+  ScopedSpeechProfile profile(R"json({"speech":{"voices":[
