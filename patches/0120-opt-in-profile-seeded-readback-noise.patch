+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/canvas_interventions/apostate_readback_noise.h"
+
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <string_view>
+
+#include "base/apostate/profile.h"
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/hash/hash.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/strcat.h"
+#include "cc/paint/paint_image.h"
+#include "third_party/blink/public/common/fingerprinting_protection/noise_token.h"
+#include "third_party/blink/renderer/core/canvas_interventions/noise_hash.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink::apostate_readback_noise {
+
+namespace {
+
+constexpr uint64_t kFnvOffset = 0xcbf29ce484222325ull;
+constexpr uint64_t kFnvPrime = 0x00000100000001b3ull;
+
+// The switch, the profile and the seed, resolved once. Nothing here can change
+// during a launch: the command line is fixed before the renderer starts and
+// Profile::Get() is installed before the first page loads.
+struct Policy {
+  bool enabled = false;
+  uint64_t seed = 0;
+};
+
+Policy ResolvePolicy() {
+  Policy policy;
+  if (!base::CommandLine::InitializedForCurrentProcess() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kFingerprintNoise)) {
+    return policy;
+  }
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || profile->source_id().empty()) {
+    // --fingerprint=host, no profile, or an authored profile with no id. There
+    // is nothing profile-bound to key on, and a host-derived seed would be a
+    // host fact leaking into the pixels, so the policy stays off and the
+    // output is stock.
+    return policy;
+  }
+  // The NUL keeps the domain from running into the identity. PersistentHash is
+  // stable across builds and processes, which is what makes the same profile
+  // perturb the same way on the next launch; the two halves are the
+  // SyntheticDeviceSeed construction in base/apostate/media_devices.cc.
+  static constexpr std::string_view kDomain("apostate/canvas-noise/v1\0", 25);
+  const std::string material = base::StrCat({kDomain, profile->source_id()});
+  policy.seed =
+      (static_cast<uint64_t>(base::PersistentHash(material)) << 32) |
+      base::PersistentHash(base::StrCat({material, "/2"}));
+  policy.enabled = true;
+  return policy;
+}
+
+const Policy& GetPolicy() {
+  static const Policy policy = ResolvePolicy();
+  return policy;
+}
+
+template <typename T>
+T Load(base::span<const uint8_t> pixel, size_t index) {
+  T value;
+  base::byte_span_from_ref(value).copy_from(
+      pixel.subspan(index * sizeof(T), sizeof(T)));
+  return value;
+}
+
+template <typename T>
+void Store(base::span<uint8_t> pixel, size_t index, T value) {
+  pixel.subspan(index * sizeof(T), sizeof(T))
+      .copy_from(base::byte_span_from_ref(value));
+}
+
+// The packed integer a kBitFields pixel is.
+uint32_t LoadPacked(base::span<const uint8_t> pixel, const Channels& channels) {
+  return channels.packed_bytes == 2 ? Load<uint16_t>(pixel, 0)
+                                    : Load<uint32_t>(pixel, 0);
+}
+
+void StorePacked(base::span<uint8_t> pixel,
+                 const Channels& channels,
+                 uint32_t packed) {
+  if (channels.packed_bytes == 2) {
+    Store<uint16_t>(pixel, 0, static_cast<uint16_t>(packed));
+  } else {
+    Store<uint32_t>(pixel, 0, packed);
+  }
+}
+
+uint32_t FieldShift(const Channels& channels, uint8_t index) {
+  uint32_t shift = 0;
+  for (uint8_t i = 0; i < index; ++i) {
+    shift += channels.field_bits[i];
+  }
+  return shift;
+}
+
+// Largest value a channel can hold, for the storages where that is meaningful.
+// Zero for the signed and floating-point ones, which have no normalised range
+// and are never premultiplied here.
+int64_t ChannelMax(const Channels& channels, uint8_t storage_index) {
+  switch (channels.storage) {
+    case Storage::kUint8:
+      return 0xFF;
+    case Storage::kUint16:
+      return 0xFFFF;
+    case Storage::kUint32:
+      return 0xFFFFFFFF;
+    case Storage::kBitFields: {
+      const uint32_t bits = channels.field_bits[storage_index];
+      return bits == 0 || bits >= 32 ? 0 : (int64_t{1} << bits) - 1;
+    }
+    default:
+      return 0;
+  }
+}
+
+// The value held in storage, without interpretation. For a floating-point
+// channel this is the bit pattern, which is what a step of one moves.
+int64_t LoadStored(base::span<const uint8_t> pixel,
+                   const Channels& channels,
+                   uint8_t storage_index) {
+  switch (channels.storage) {
+    case Storage::kUint8:
+      return Load<uint8_t>(pixel, storage_index);
+    case Storage::kInt8:
+      return Load<int8_t>(pixel, storage_index);
+    case Storage::kUint16:
+    case Storage::kFloat16:
+      return Load<uint16_t>(pixel, storage_index);
+    case Storage::kInt16:
+      return Load<int16_t>(pixel, storage_index);
+    case Storage::kUint32:
+    case Storage::kFloat32:
+      return Load<uint32_t>(pixel, storage_index);
+    case Storage::kInt32:
+      return Load<int32_t>(pixel, storage_index);
+    case Storage::kBitFields: {
+      const int64_t mask = ChannelMax(channels, storage_index);
+      if (mask == 0) {
+        return 0;
+      }
+      return (LoadPacked(pixel, channels) >>
+              FieldShift(channels, storage_index)) &
+             static_cast<uint32_t>(mask);
+    }
+  }
+}
+
+void StoreStored(base::span<uint8_t> pixel,
+                 const Channels& channels,
+                 uint8_t storage_index,
+                 int64_t value) {
+  switch (channels.storage) {
+    case Storage::kUint8:
+      Store<uint8_t>(pixel, storage_index, static_cast<uint8_t>(value));
+      return;
+    case Storage::kInt8:
+      Store<int8_t>(pixel, storage_index, static_cast<int8_t>(value));
+      return;
+    case Storage::kUint16:
+    case Storage::kFloat16:
+      Store<uint16_t>(pixel, storage_index, static_cast<uint16_t>(value));
+      return;
+    case Storage::kInt16:
+      Store<int16_t>(pixel, storage_index, static_cast<int16_t>(value));
+      return;
+    case Storage::kUint32:
+    case Storage::kFloat32:
+      Store<uint32_t>(pixel, storage_index, static_cast<uint32_t>(value));
+      return;
+    case Storage::kInt32:
+      Store<int32_t>(pixel, storage_index, static_cast<int32_t>(value));
+      return;
+    case Storage::kBitFields: {
+      const int64_t mask = ChannelMax(channels, storage_index);
+      if (mask == 0) {
+        return;
+      }
+      const uint32_t shift = FieldShift(channels, storage_index);
+      const uint32_t packed = LoadPacked(pixel, channels);
+      StorePacked(pixel, channels,
+                  (packed & ~(static_cast<uint32_t>(mask) << shift)) |
+                      (static_cast<uint32_t>(value) << shift));
+      return;
+    }
+  }
+}
+
+bool IsUnsignedNormalised(Storage storage) {
+  return storage == Storage::kUint8 || storage == Storage::kUint16 ||
+         storage == Storage::kBitFields;
+}
+
+// True when the colour channels of this pixel have to be divided by alpha to
+// get the value a page reads.
+bool HasStraightConversion(const Channels& channels) {
+  return channels.premultiplied && IsUnsignedNormalised(channels.storage) &&
+         channels.logical[3] != Channels::kAbsent;
+}
+
+// The value of a logical channel as a page sees it: straight alpha, in the
+// storage's own units. Two surfaces holding one image in different layouts
+// agree here, which is the whole point of the canonical form.
+int64_t CanonicalValue(base::span<const uint8_t> pixel,
+                       const Channels& channels,
+                       uint8_t logical_index) {
+  const uint8_t storage_index = channels.logical[logical_index];
+  if (storage_index == Channels::kAbsent) {
+    // A surface with no alpha reads as opaque, and a missing colour as zero,
+    // so an opaque RGBA pixel and the same colour in an RGBx store key alike.
+    return logical_index == 3 ? ChannelMax(channels, channels.logical[0]) : 0;
+  }
+  const int64_t raw = LoadStored(pixel, channels, storage_index);
+  if (logical_index == 3 || !HasStraightConversion(channels)) {
+    return raw;
+  }
+  const uint8_t alpha_index = channels.logical[3];
+  const int64_t alpha = LoadStored(pixel, channels, alpha_index);
+  if (alpha <= 0) {
+    return 0;
+  }
+  const int64_t alpha_max = ChannelMax(channels, alpha_index);
+  const int64_t colour_max = ChannelMax(channels, storage_index);
+  // raw = round(straight * alpha / alpha_max), so this inverts it. Exact in
+  // the round trip: premultiplying the result back reproduces `raw`.
+  return std::min(colour_max, (raw * alpha_max + alpha / 2) / alpha);
+}
+
+// Writes a canonical (straight-alpha) value back through the store's own
+// premultiplication.
+void StoreCanonical(base::span<uint8_t> pixel,
+                    const Channels& channels,
+                    uint8_t logical_index,
+                    int64_t straight) {
+  const uint8_t storage_index = channels.logical[logical_index];
+  if (storage_index == Channels::kAbsent) {
+    return;
+  }
+  if (!HasStraightConversion(channels)) {
+    StoreStored(pixel, channels, storage_index, straight);
+    return;
+  }
+  const uint8_t alpha_index = channels.logical[3];
+  const int64_t alpha = LoadStored(pixel, channels, alpha_index);
+  const int64_t alpha_max = ChannelMax(channels, alpha_index);
+  const int64_t colour_max = ChannelMax(channels, storage_index);
+  if (alpha_max <= 0) {
+    return;
+  }
+  // A premultiplied colour can never exceed the pixel's own alpha, scaled
+  // into this channel's range.
+  const int64_t ceiling = std::min(colour_max, (alpha * colour_max) / alpha_max);
+  const int64_t premultiplied = (straight * alpha + alpha_max / 2) / alpha_max;
+  StoreStored(pixel, channels, storage_index,
+              std::clamp<int64_t>(premultiplied, 0, ceiling));
+}
+
+// One {-1, 0, +1} step on logical channel `logical_index`, taken on the value
+// a page reads. For a floating-point channel the step is one unit in the last
+// place, which is the same statement about the stored value and is invisible
+// to an eye.
+void StepChannel(base::span<uint8_t> pixel,
+                 const Channels& channels,
+                 uint8_t logical_index,
+                 int step) {
+  if (step == 0) {
+    return;
+  }
+  const uint8_t storage_index = channels.logical[logical_index];
+  if (storage_index == Channels::kAbsent) {
+    return;
+  }
+  switch (channels.storage) {
+    case Storage::kUint8:
+    case Storage::kUint16:
+    case Storage::kUint32:
+    case Storage::kBitFields: {
+      const int64_t max = ChannelMax(channels, storage_index);
+      if (max == 0) {
+        return;
+      }
+      const int64_t straight = CanonicalValue(pixel, channels, logical_index);
+      StoreCanonical(pixel, channels, logical_index,
+                     std::clamp<int64_t>(straight + step, 0, max));
+      return;
+    }
+    case Storage::kInt8: {
+      const int64_t value = LoadStored(pixel, channels, storage_index);
+      StoreStored(pixel, channels, storage_index,
+                  std::clamp<int64_t>(value + step, -0x80, 0x7F));
+      return;
+    }
+    case Storage::kInt16: {
+      const int64_t value = LoadStored(pixel, channels, storage_index);
+      StoreStored(pixel, channels, storage_index,
+                  std::clamp<int64_t>(value + step, -0x8000, 0x7FFF));
+      return;
+    }
+    case Storage::kInt32: {
+      const int64_t value = LoadStored(pixel, channels, storage_index);
+      StoreStored(pixel, channels, storage_index,
+                  std::clamp<int64_t>(value + step, INT32_MIN, INT32_MAX));
+      return;
+    }
+    case Storage::kFloat16: {
+      const uint16_t bits =
+          static_cast<uint16_t>(LoadStored(pixel, channels, storage_index));
+      const uint16_t magnitude = bits & 0x7FFFu;
+      // An infinity or a NaN has no next value, and a zero has no previous one
+      // that is not a sign flip. Both stay exactly as the renderer wrote them.
+      if (magnitude >= 0x7C00u || (step < 0 && magnitude == 0u) ||
+          (step > 0 && magnitude == 0x7BFFu)) {
+        return;
+      }
+      StoreStored(pixel, channels, storage_index,
+                  static_cast<uint16_t>(bits + step));
+      return;
+    }
+    case Storage::kFloat32: {
+      const uint32_t bits =
+          static_cast<uint32_t>(LoadStored(pixel, channels, storage_index));
+      const uint32_t magnitude = bits & 0x7FFFFFFFu;
+      if (magnitude >= 0x7F800000u || (step < 0 && magnitude == 0u) ||
+          (step > 0 && magnitude == 0x7F7FFFFFu)) {
+        return;
+      }
+      StoreStored(pixel, channels, storage_index,
+                  static_cast<uint32_t>(bits + step));
+      return;
+    }
+  }
+}
+
+// FNV-1a over one pixel's canonical channel values, each folded as eight
+// bytes so that a store's width and order cannot reach the key. This is the
+// pixel's identity: the colour a page reads, and nothing about how it is held.
+uint64_t CanonicalPixelKey(base::span<const uint8_t> pixel,
+                           const Channels& channels) {
+  uint64_t hash = kFnvOffset;
+  for (uint8_t logical_index = 0; logical_index < 4; ++logical_index) {
+    const uint64_t value = static_cast<uint64_t>(
+        CanonicalValue(pixel, channels, logical_index));
+    for (int byte = 0; byte < 8; ++byte) {
+      hash ^= (value >> (byte * 8)) & 0xFFu;
+      hash *= kFnvPrime;
+    }
+  }
+  return hash;
+}
+
+// True when every pixel of the rectangle carries the same bytes. A solid fill
+// is the one case a page can check without knowing anything about the machine,
+// so it comes back exactly as it went in. The 3x3 rule below would reach the
+// same answer; this is the cheap path and the explicit guarantee.
+bool WholeSurfaceIsOneValue(const Surface& surface) {
+  const size_t row_bytes = surface.pixel_stride *
+                           static_cast<size_t>(surface.width);
+  base::span<const uint8_t> first_row = surface.bytes.first(row_bytes);
+  base::span<const uint8_t> first_pixel =
+      first_row.first(surface.pixel_stride);
+  for (int32_t x = 1; x < surface.width; ++x) {
+    if (first_row.subspan(static_cast<size_t>(x) * surface.pixel_stride,
+                          surface.pixel_stride) != first_pixel) {
+      return false;
+    }
+  }
+  for (int32_t y = 1; y < surface.height; ++y) {
+    if (surface.bytes.subspan(static_cast<size_t>(y) * surface.row_stride,
+                              row_bytes) != first_row) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::span<uint8_t> PixelAt(const Surface& surface, int32_t x, int32_t y) {
+  return surface.bytes.subspan(
+      static_cast<size_t>(y) * surface.row_stride +
+          static_cast<size_t>(x) * surface.pixel_stride,
+      surface.pixel_stride);
+}
+
+void DigestRow(const Surface& surface, int32_t y, base::span<uint64_t> out) {
+  for (int32_t x = 0; x < surface.width; ++x) {
+    out[static_cast<size_t>(x)] =
+        CanonicalPixelKey(PixelAt(surface, x, y), surface.channels);
+  }
+}
+
+std::optional<Channels> ChannelsForColorType(SkColorType color_type,
+                                             SkAlphaType alpha_type) {
+  constexpr uint8_t kNone = Channels::kAbsent;
+  const bool premultiplied = alpha_type == kPremul_SkAlphaType;
+  Channels channels;
+  switch (color_type) {
+    case kRGBA_8888_SkColorType:
+      channels.storage = Storage::kUint8;
+      channels.premultiplied = premultiplied;
+      return channels;
+    case kBGRA_8888_SkColorType:
+      channels.storage = Storage::kUint8;
+      channels.logical = {{2, 1, 0, 3}};
+      channels.premultiplied = premultiplied;
+      return channels;
+    case kRGB_888x_SkColorType:
+      // The fourth byte is padding, not alpha, and stays as it is.
+      channels.storage = Storage::kUint8;
+      channels.logical = {{0, 1, 2, kNone}};
+      return channels;
+    case kRGBA_F16_SkColorType:
+    case kRGBA_F16Norm_SkColorType:
+      channels.storage = Storage::kFloat16;
+      channels.premultiplied = premultiplied;
+      return channels;
+    case kRGBA_F32_SkColorType:
+      channels.storage = Storage::kFloat32;
+      channels.premultiplied = premultiplied;
+      return channels;
+    case kRGBA_1010102_SkColorType:
+      channels.storage = Storage::kBitFields;
+      channels.field_bits = {{10, 10, 10, 2}};
+      channels.packed_bytes = 4;
+      channels.premultiplied = premultiplied;
+      return channels;
+    case kBGRA_1010102_SkColorType:
+      channels.storage = Storage::kBitFields;
+      channels.field_bits = {{10, 10, 10, 2}};
+      channels.packed_bytes = 4;
+      channels.logical = {{2, 1, 0, 3}};
+      channels.premultiplied = premultiplied;
+      return channels;
+    case kRGB_101010x_SkColorType:
+      channels.storage = Storage::kBitFields;
+      channels.field_bits = {{10, 10, 10, 2}};
+      channels.packed_bytes = 4;
+      channels.logical = {{0, 1, 2, kNone}};
+      return channels;
+    case kBGR_101010x_SkColorType:
+      channels.storage = Storage::kBitFields;
+      channels.field_bits = {{10, 10, 10, 2}};
+      channels.packed_bytes = 4;
+      channels.logical = {{2, 1, 0, kNone}};
+      return channels;
+    case kGray_8_SkColorType:
+    case kR8_unorm_SkColorType:
+      channels.storage = Storage::kUint8;
+      channels.count = 1;
+      channels.logical = {{0, kNone, kNone, kNone}};
+      return channels;
+    case kR8G8_unorm_SkColorType:
+      channels.storage = Storage::kUint8;
+      channels.count = 2;
+      channels.logical = {{0, 1, kNone, kNone}};
+      return channels;
+    case kR16G16B16A16_unorm_SkColorType:
+      channels.storage = Storage::kUint16;
+      channels.premultiplied = premultiplied;
+      return channels;
+    default:
+      // Alpha-only, depth, and the colour types no canvas output uses. Left
+      // byte-exact rather than guessed at.
+      return std::nullopt;
+  }
+}
+
+}  // namespace
+
+bool Enabled() {
+  return GetPolicy().enabled;
+}
+
+uint64_t Seed() {
+  return GetPolicy().seed;
+}
+
+void Apply(const Surface& surface) {
+  if (!Enabled() || surface.width <= 0 || surface.height <= 0 ||
+      surface.pixel_stride == 0 ||
+      surface.row_stride <
+          surface.pixel_stride * static_cast<size_t>(surface.width)) {
+    return;
+  }
+  const size_t extent =
+      surface.row_stride * static_cast<size_t>(surface.height - 1) +
+      surface.pixel_stride * static_cast<size_t>(surface.width);
+  if (surface.bytes.size() < extent) {
+    return;
+  }
+  const Channels& channels = surface.channels;
+  if (channels.logical[0] == Channels::kAbsent &&
+      channels.logical[1] == Channels::kAbsent &&
+      channels.logical[2] == Channels::kAbsent) {
+    // Nothing but alpha, which is never moved.
+    return;
+  }
+  if (WholeSurfaceIsOneValue(surface)) {
+    return;
+  }
+
+  // Row keys for the three rows the policy reads, rolled forward. Each row is
+  // keyed before it is written, so the key is always the clean image even
+  // though the perturbation happens in place.
+  const wtf_size_t width = base::checked_cast<wtf_size_t>(surface.width);
+  std::array<Vector<uint64_t>, 3> rows;
+  for (Vector<uint64_t>& row : rows) {
+    row.resize(width);
+  }
+  DigestRow(surface, 0, base::span<uint64_t>(rows[0]));
+  if (surface.height > 1) {
+    DigestRow(surface, 1, base::span<uint64_t>(rows[1]));
+  }
+
+  const NoiseHash origin{NoiseToken(Seed())};
+  for (int32_t y = 0; y < surface.height; ++y) {
+    if (y >= 1 && y + 1 < surface.height) {
+      DigestRow(surface, y + 1,
+                base::span<uint64_t>(rows[static_cast<size_t>(y + 1) % 3u]));
+    }
+    const std::array<base::span<const uint64_t>, 3> neighbour_rows = {
+        base::span<const uint64_t>(
+            rows[static_cast<size_t>(y == 0 ? 0 : y - 1) % 3u]),
+        base::span<const uint64_t>(rows[static_cast<size_t>(y) % 3u]),
+        base::span<const uint64_t>(
+            rows[static_cast<size_t>(y + 1 < surface.height ? y + 1 : y) % 3u]),
+    };
+    for (int32_t x = 0; x < surface.width; ++x) {
+      const uint64_t centre = neighbour_rows[1][static_cast<size_t>(x)];
+      bool uniform = true;
+      for (int32_t dy = 0; dy < 3 && uniform; ++dy) {
+        for (int32_t dx = -1; dx <= 1; ++dx) {
+          const int32_t nx = std::clamp(x + dx, 0, surface.width - 1);
+          if (neighbour_rows[dy][static_cast<size_t>(nx)] != centre) {
+            uniform = false;
+            break;
+          }
+        }
+      }
+      // A pixel that sits in a patch of one colour is left alone. Flat regions
+      // are what a page can predict; edges are what a renderer's rasteriser
+      // signs its name on.
+      if (uniform) {
+        continue;
+      }
+
+      NoiseHash hash = origin;
+      hash.Update(centre);
+      for (int32_t dy = 0; dy < 3; ++dy) {
+        for (int32_t dx = -1; dx <= 1; ++dx) {
+          const int32_t nx = std::clamp(x + dx, 0, surface.width - 1);
+          hash.Update(neighbour_rows[dy][static_cast<size_t>(nx)]);
+        }
+      }
+      hash.Update((static_cast<uint64_t>(y) << 32) |
+                  static_cast<uint32_t>(x));
+
+      base::span<uint8_t> pixel = PixelAt(surface, x, y);
+      // Red, then green, then blue, by logical channel rather than by
+      // position in memory, so the same colour takes the same step whichever
+      // store it is read out of.
+      for (uint8_t logical_index = 0; logical_index < 3; ++logical_index) {
+        if (channels.logical[logical_index] == Channels::kAbsent) {
+          continue;
+        }
+        StepChannel(pixel, channels, logical_index,
+                    hash.GetValueBelow(3) - 1);
+      }
+    }
+  }
+}
+
+void ApplyToPixmap(const SkPixmap& pixmap) {
+  if (!Enabled() || !pixmap.writable_addr() || pixmap.width() <= 0 ||
+      pixmap.height() <= 0) {
+    return;
+  }
+  std::optional<Channels> channels =
+      ChannelsForColorType(pixmap.colorType(), pixmap.alphaType());
+  if (!channels) {
+    return;
+  }
+  Surface surface;
+  surface.bytes = gfx::SkPixmapToWritableSpan(pixmap);
+  surface.width = pixmap.width();
+  surface.height = pixmap.height();
+  surface.row_stride = pixmap.rowBytes();
+  surface.pixel_stride = static_cast<size_t>(pixmap.info().bytesPerPixel());
+  surface.channels = *channels;
+  Apply(surface);
+}
+
+scoped_refptr<StaticBitmapImage> ApplyToSnapshot(
+    scoped_refptr<StaticBitmapImage> snapshot) {
+  if (!Enabled() || !snapshot) {
+    return snapshot;
+  }
+  sk_sp<SkImage> source = snapshot->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source) {
+    return snapshot;
+  }
+  const SkImageInfo info = source->imageInfo();
+  if (info.isEmpty()) {
+    return snapshot;
+  }
+  SkBitmap perturbed;
+  if (!perturbed.tryAllocPixels(info) ||
+      !source->readPixels(nullptr, perturbed.pixmap(), 0, 0)) {
+    return snapshot;
+  }
+  ApplyToPixmap(perturbed.pixmap());
+  perturbed.setImmutable();
+  sk_sp<SkImage> image = perturbed.asImage();
+  if (!image) {
+    return snapshot;
+  }
+  scoped_refptr<StaticBitmapImage> result =
+      UnacceleratedStaticBitmapImage::Create(std::move(image),
+                                             snapshot->Orientation());
+  if (!result) {
+    return snapshot;
+  }
+  result->SetOriginClean(snapshot->OriginClean());
+  return result;
+}
+
+bool ReadPixelsForPage(const cc::PaintImage& image,
+                       const SkPixmap& dst,
+                       int src_x,
+                       int src_y) {
+  const auto plain = [&] {
+    return image.readPixels(dst.info(), dst.writable_addr(), dst.rowBytes(),
+                            src_x, src_y);
+  };
+  if (!Enabled() || !dst.writable_addr() || dst.width() <= 0 ||
+      dst.height() <= 0) {
+    return plain();
+  }
+  const SkImageInfo source_info = image.GetSkImageInfo();
+  if (dst.alphaType() != kUnpremul_SkAlphaType ||
+      source_info.alphaType() != kPremul_SkAlphaType) {
+    // Either the destination holds what the image holds, or the image has no
+    // alpha association to undo. Perturbing the result is already perturbing
+    // the pixels the canvas holds.
+    const bool ok = plain();
+    ApplyToPixmap(dst);
+    return ok;
+  }
+  // Read the image's own pixels, in its own form, and perturb those; then let
+  // Skia convert, which is the same conversion `plain()` would have done and
+  // the same one an encoder does to the same snapshot. Both routes therefore
+  // agree without the policy knowing anything about how Skia rounds.
+  SkBitmap held;
+  if (!held.tryAllocPixels(source_info.makeWH(dst.width(), dst.height()))) {
+    const bool ok = plain();
+    ApplyToPixmap(dst);
+    return ok;
+  }
+  if (!image.readPixels(held.info(), held.getPixels(), held.rowBytes(), src_x,
+                        src_y)) {
+    return false;
+  }
+  ApplyToPixmap(held.pixmap());
+  return held.pixmap().readPixels(dst);
+}
+
