+void WebGLBuffer::AddReadbackTag(const ReadbackTag& tag) {
+  if (tag.width <= 0 || tag.height <= 0 || tag.pixel_stride <= 0 ||
+      tag.row_stride < tag.pixel_stride * tag.width) {
+    return;
+  }
+  // A new readback overwrites whatever was there.
+  InvalidateReadbackRows(tag.pixel_base, tag.End() - tag.pixel_base);
+  if (readback_tags_.size() >= kMaxReadbackTags) {
+    readback_tags_.EraseAt(0);
+  }
+  readback_tags_.push_back(tag);
+}
+
+void WebGLBuffer::InvalidateReadbackRows(int64_t offset, int64_t size) {
+  if (readback_tags_.empty() || size <= 0) {
+    return;
+  }
+  const int64_t begin = offset;
+  const int64_t end = offset + size;
+  Vector<ReadbackTag> kept;
+  for (const ReadbackTag& tag : readback_tags_) {
+    if (end <= tag.pixel_base || begin >= tag.End()) {
+      kept.push_back(tag);
+      continue;
+    }
+    // The write is one contiguous range, so the rows it lands in are
+    // contiguous too. Whole rows above and below it keep their content and
+    // their key; a row the write touches at all is gone, because a rectangle
+    // half of whose bytes came from somewhere else is not a readback.
+    int32_t first = tag.height;
+    int32_t last = -1;
+    for (int32_t row = 0; row < tag.height; ++row) {
+      const int64_t row_begin = tag.pixel_base + row * tag.row_stride;
+      const int64_t row_end = row_begin + tag.pixel_stride * tag.width;
