+    if (last < 0) {
+      // Only padding between rows was written.
+      kept.push_back(tag);
+      continue;
+    }
+    if (first > 0) {
+      ReadbackTag above = tag;
+      above.height = first;
+      kept.push_back(above);
+    }
+    if (last + 1 < tag.height) {
+      ReadbackTag below = tag;
+      below.pixel_base = tag.pixel_base + (last + 1) * tag.row_stride;
+      below.height = tag.height - (last + 1);
+      kept.push_back(below);
+    }
+  }
+  readback_tags_ = std::move(kept);
+}
