+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_APOSTATE_READBACK_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_APOSTATE_READBACK_NOISE_H_
+
+#include <array>
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+class SkPixmap;
+
+namespace blink {
+
+class StaticBitmapImage;
+
+// The opt-in readback policy behind --fingerprint-noise. OFF unless the switch
+// is present and the profile carries an identity to seed from, in which case
+// every page-visible canvas and WebGL readback comes back one step away from
+// the bytes the renderer produced.
+//
+// The policy is content-keyed, not call-keyed: the perturbation of a pixel is a
+// function of the profile seed, the clean pixel, its clean 3x3 neighbourhood
+// and its position in the returned rectangle, and of nothing else. Two reads of
+// one surface therefore agree, a 1:1 canvas-to-canvas copy reads back
+// identically, and every output route returns the same answer for the same
+// pixels. A pixel whose 3x3 neighbourhood is one value is left alone, so a
+// solid fill is byte-exact at every route.
+//
+// Alpha is never moved, and neither is a backing store: each route perturbs the
+// copy the caller is about to see and nothing upstream of it.
+namespace apostate_readback_noise {
+
+// How the channels of one pixel are stored.
+enum class Storage : uint8_t {
+  kUint8,
+  kInt8,
+  kUint16,
+  kInt16,
+  kUint32,
+  kInt32,
+  kFloat16,
+  kFloat32,
+  // One unsigned integer of `pixel_stride` bytes split into `field_bits`
+  // bitfields, least significant first. GL's packed pixel types.
+  kBitFields,
+};
+
+struct Channels {
+  Storage storage = Storage::kUint8;
+  // Components per pixel, or the number of bitfields for kBitFields.
+  uint8_t count = 4;
+  // Bit 1<<i set: the policy may move channel i. Alpha is never set, and
+  // neither is a padding byte or a shared exponent.
+  uint8_t movable = 0b0111;
+  // kBitFields only: the width in bits of each field, least significant first.
+  std::array<uint8_t, 4> field_bits = {{0, 0, 0, 0}};
+  // With premultiplied pixels a colour channel above alpha is not
+  // representable, so the step is clamped to it rather than to the type.
+  bool premultiplied = false;
+  uint8_t alpha = 3;
+};
+
+// A rectangle of interleaved pixels a page is about to see. `bytes` begins at
+// pixel (0, 0); rows are `row_stride` bytes apart and pixels `pixel_stride`.
+// The rectangle is read in memory order, so a bottom-up GL readback keys its
+// rows from the bottom of the framebuffer. That is the order the caller sees.
+struct Surface {
+  base::span<uint8_t> bytes;
+  int32_t width = 0;
+  int32_t height = 0;
+  size_t row_stride = 0;
+  size_t pixel_stride = 0;
+  Channels channels;
+};
+
+// Whether the opt-in is in force for this renderer. Constant for the process:
+// the switch and the profile are both fixed before the first page loads.
+CORE_EXPORT bool Enabled();
+
+// The profile-derived seed. Exposed for --fingerprint-explain; zero when the
+// policy is off.
+CORE_EXPORT uint64_t Seed();
+
+// Perturbs `surface` in place. A no-op unless Enabled().
+CORE_EXPORT void Apply(const Surface& surface);
+
+// Perturbs a Skia pixmap in place, taking the channel layout from its
+// SkImageInfo. A no-op unless Enabled(), and a no-op for a colour type the
+// policy does not describe.
+CORE_EXPORT void ApplyToPixmap(const SkPixmap& pixmap);
+
+// Returns a perturbed CPU copy of a canvas snapshot that is about to be
+// encoded or copied out, or `snapshot` itself when the policy is off. The
+// snapshot is never written to, so the canvas keeps a clean backing store and
+// the result is perturbed exactly once.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> ApplyToSnapshot(
+    scoped_refptr<StaticBitmapImage> snapshot);
+
+}  // namespace apostate_readback_noise
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_APOSTATE_READBACK_NOISE_H_
