+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_READBACK_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_READBACK_NOISE_H_
+
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/blink/renderer/platform/graphics/gpu/webgl_image_conversion.h"
+#include "third_party/khronos/GLES2/gl2ext.h"
+
+namespace blink {
+
+// Apostate: the GL half of the --fingerprint-noise readback policy. GL is
+// where the channel layout of a readback lives -- the (format, type) pair, the
+// packed pixel types and the pack state -- so the translation belongs here and
+// the content-keyed kernel stays in
+// core/canvas_interventions/apostate_readback_noise.h.
+//
+// Every (format, type) pair readPixels accepts is covered, including the packed
+// ones, so no combination is a clean route out. GL never packs premultiplied
+// pixels, so no colour channel is clamped to alpha here; alpha itself, the
+// shared exponent of RGB9_E5 and a format that carries nothing but alpha are
+// never moved.
+
+// Where the pixels of a readback rectangle sit in the destination.
+struct ApostateReadbackGeometry {
+  size_t skip_bytes = 0;    // bytes before pixel (0, 0)
+  size_t pixel_stride = 0;  // bytes per pixel
+  size_t row_stride = 0;    // bytes between the starts of two rows
+};
+
+// Resolves the geometry GL's pack state gives a `width`-wide readback. False
+// when the pair is not one GL can pack, or when the policy does not describe
+// it, in which case the caller leaves every byte alone.
+MODULES_EXPORT bool ApostateReadbackGeometryFor(
+    GLenum format,
+    GLenum type,
+    GLsizei width,
+    const WebGLImageConversion::PixelStoreParams& pack,
+    ApostateReadbackGeometry* geometry);
+
+// Perturbs the `width` x `height` rectangle that GL just packed into
+// `destination` under `pack`. A no-op unless the policy is in force.
+MODULES_EXPORT void ApostateNoiseReadbackPixels(
+    base::span<uint8_t> destination,
+    GLsizei width,
+    GLsizei height,
+    GLenum format,
+    GLenum type,
+    const WebGLImageConversion::PixelStoreParams& pack);
+
+// Perturbs a rectangle whose geometry is already known: the pixel-pack buffer
+// route, which recorded it when readPixels wrote the buffer. `rectangle`
+// begins at pixel (0, 0).
+MODULES_EXPORT void ApostateNoiseReadbackRectangle(
+    base::span<uint8_t> rectangle,
+    GLsizei width,
+    GLsizei height,
+    size_t pixel_stride,
+    size_t row_stride,
+    GLenum format,
+    GLenum type);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_WEBGL_READBACK_NOISE_H_
diff --git a/third_party/blink/renderer/modules/webgl/webgl_readback_noise.cc b/third_party/blink/renderer/modules/webgl/webgl_readback_noise.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/webgl_readback_noise.cc
@@ -0,0 +1,230 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webgl/webgl_readback_noise.h"
+
+#include <optional>
+
+#include "third_party/blink/renderer/core/canvas_interventions/apostate_readback_noise.h"
+
+namespace blink {
+
+namespace {
+
+using apostate_readback_noise::Channels;
+using apostate_readback_noise::Storage;
+using apostate_readback_noise::Surface;
+
+constexpr uint8_t kNone = Channels::kAbsent;
+
+// The channel layout of one packed pixel. GL numbers the components of a
+// packed type from the most significant end unless the name says _REV, so
+// `field_bits` is the spec's layout read least significant first and
+// `logical` says where red, green, blue and alpha ended up in that order.
+bool PackedChannels(GLenum type, Channels* channels) {
+  switch (type) {
+    case GL_UNSIGNED_SHORT_5_6_5:  // stored B, G, R
+      channels->count = 3;
+      channels->field_bits = {{5, 6, 5, 0}};
+      channels->logical = {{2, 1, 0, kNone}};
+      break;
+    case GL_UNSIGNED_SHORT_4_4_4_4:  // stored A, B, G, R
+      channels->count = 4;
+      channels->field_bits = {{4, 4, 4, 4}};
+      channels->logical = {{3, 2, 1, 0}};
+      break;
+    case GL_UNSIGNED_SHORT_5_5_5_1:  // stored A, B, G, R
+      channels->count = 4;
+      channels->field_bits = {{1, 5, 5, 5}};
+      channels->logical = {{3, 2, 1, 0}};
+      break;
+    case GL_UNSIGNED_INT_2_10_10_10_REV:  // stored R, G, B, A
+      channels->count = 4;
+      channels->field_bits = {{10, 10, 10, 2}};
+      channels->logical = {{0, 1, 2, 3}};
+      break;
+    case GL_UNSIGNED_INT_10F_11F_11F_REV:  // stored R, G, B
+      // Three unsigned mini-floats. A step of one on the stored field is one
+      // unit in the last place, the same statement as for a real float.
+      channels->count = 3;
+      channels->field_bits = {{11, 11, 10, 0}};
+      channels->logical = {{0, 1, 2, kNone}};
+      break;
+    case GL_UNSIGNED_INT_5_9_9_9_REV:  // stored R, G, B mantissae, exponent
+      channels->count = 4;
+      channels->field_bits = {{9, 9, 9, 5}};
+      // The shared exponent scales all three mantissae at once, so moving it
+      // would move the whole pixel. It is not a logical channel at all, so
+      // the policy never reaches it.
+      channels->logical = {{0, 1, 2, kNone}};
+      break;
+    default:
+      return false;
+  }
+  channels->storage = Storage::kBitFields;
+  channels->packed_bytes =
+      (type == GL_UNSIGNED_SHORT_5_6_5 || type == GL_UNSIGNED_SHORT_4_4_4_4 ||
+       type == GL_UNSIGNED_SHORT_5_5_5_1)
+          ? 2
+          : 4;
+  return true;
+}
+
+std::optional<Channels> ChannelsFor(GLenum format, GLenum type) {
+  Channels channels;
+  if (PackedChannels(type, &channels)) {
+    // GL never packs premultiplied pixels, so no colour channel is clamped to
+    // alpha on this side.
+    return channels;
+  }
+
+  switch (format) {
+    case GL_RGBA:
+    case GL_RGBA_INTEGER:
+      channels.count = 4;
+      channels.logical = {{0, 1, 2, 3}};
+      break;
+    case GL_RGB:
+    case GL_RGB_INTEGER:
+      channels.count = 3;
+      channels.logical = {{0, 1, 2, kNone}};
+      break;
+    case GL_RG:
+    case GL_RG_INTEGER:
+      channels.count = 2;
+      channels.logical = {{0, 1, kNone, kNone}};
+      break;
+    case GL_RED:
+    case GL_RED_INTEGER:
+    case GL_LUMINANCE:
+      channels.count = 1;
+      channels.logical = {{0, kNone, kNone, kNone}};
+      break;
+    case GL_LUMINANCE_ALPHA:
+      channels.count = 2;
+      channels.logical = {{0, kNone, kNone, 1}};
+      break;
+    default:
+      // GL_ALPHA carries nothing but alpha, and depth and stencil are not
+      // colour. Both come back exactly as GL wrote them.
+      return std::nullopt;
+  }
+
+  switch (type) {
+    case GL_UNSIGNED_BYTE:
+      channels.storage = Storage::kUint8;
+      break;
+    case GL_BYTE:
+      channels.storage = Storage::kInt8;
+      break;
+    case GL_UNSIGNED_SHORT:
+      channels.storage = Storage::kUint16;
+      break;
+    case GL_SHORT:
+      channels.storage = Storage::kInt16;
+      break;
+    case GL_UNSIGNED_INT:
+      channels.storage = Storage::kUint32;
+      break;
+    case GL_INT:
+      channels.storage = Storage::kInt32;
+      break;
+    case GL_HALF_FLOAT:
+    case GL_HALF_FLOAT_OES:
+      channels.storage = Storage::kFloat16;
+      break;
+    case GL_FLOAT:
+      channels.storage = Storage::kFloat32;
+      break;
+    default:
+      return std::nullopt;
+  }
+  return channels;
+}
+
+}  // namespace
+
+bool ApostateReadbackGeometryFor(
+    GLenum format,
+    GLenum type,
+    GLsizei width,
+    const WebGLImageConversion::PixelStoreParams& pack,
+    ApostateReadbackGeometry* geometry) {
+  if (width <= 0 || !ChannelsFor(format, type)) {
+    return false;
+  }
+  unsigned components_per_pixel = 0;
+  unsigned bytes_per_component = 0;
+  if (!WebGLImageConversion::ComputeFormatAndTypeParameters(
+          format, type, &components_per_pixel, &bytes_per_component)) {
+    return false;
+  }
+  const size_t alignment = pack.alignment > 0
+                               ? static_cast<size_t>(pack.alignment)
+                               : size_t{1};
+  const size_t pixel_stride =
+      static_cast<size_t>(components_per_pixel) * bytes_per_component;
+  const size_t row_pixels = pack.row_length > 0
+                                ? static_cast<size_t>(pack.row_length)
+                                : static_cast<size_t>(width);
+  // GL pads every row but the last one out to PACK_ALIGNMENT. The rectangle is
+  // walked row by row, so the padded stride is what matters and the last row's
+  // missing padding is simply never read.
+  const size_t unpadded = row_pixels * pixel_stride;
+  const size_t row_stride =
+      ((unpadded + alignment - 1) / alignment) * alignment;
+  geometry->pixel_stride = pixel_stride;
+  geometry->row_stride = row_stride;
+  geometry->skip_bytes =
+      static_cast<size_t>(pack.skip_rows > 0 ? pack.skip_rows : 0) * row_stride +
+      static_cast<size_t>(pack.skip_pixels > 0 ? pack.skip_pixels : 0) *
+          pixel_stride;
+  return true;
+}
+
+void ApostateNoiseReadbackPixels(
+    base::span<uint8_t> destination,
+    GLsizei width,
+    GLsizei height,
+    GLenum format,
+    GLenum type,
+    const WebGLImageConversion::PixelStoreParams& pack) {
+  if (!apostate_readback_noise::Enabled() || width <= 0 || height <= 0) {
+    return;
+  }
+  ApostateReadbackGeometry geometry;
+  if (!ApostateReadbackGeometryFor(format, type, width, pack, &geometry) ||
+      destination.size() < geometry.skip_bytes) {
+    return;
+  }
+  ApostateNoiseReadbackRectangle(destination.subspan(geometry.skip_bytes),
+                                 width, height, geometry.pixel_stride,
+                                 geometry.row_stride, format, type);
+}
+
+void ApostateNoiseReadbackRectangle(base::span<uint8_t> rectangle,
+                                    GLsizei width,
+                                    GLsizei height,
+                                    size_t pixel_stride,
+                                    size_t row_stride,
+                                    GLenum format,
+                                    GLenum type) {
+  if (!apostate_readback_noise::Enabled() || width <= 0 || height <= 0) {
+    return;
+  }
+  std::optional<Channels> channels = ChannelsFor(format, type);
+  if (!channels) {
+    return;
+  }
+  Surface surface;
+  surface.bytes = rectangle;
+  surface.width = width;
+  surface.height = height;
+  surface.pixel_stride = pixel_stride;
+  surface.row_stride = row_stride;
+  surface.channels = *channels;
+  apostate_readback_noise::Apply(surface);
+}
+
+}  // namespace blink
