+    // the invalidation above has already said so.
+    return;
+  }
+  const int64_t read_end = read_offset + size;
+  for (const ReadbackTag& tag : source.ReadbackTags()) {
+    // Only a rectangle that moved whole keeps its meaning: a partial copy
+    // splits a row, and the destination's row geometry would no longer match.
+    if (tag.pixel_base < read_offset || tag.End() > read_end) {
+      continue;
+    }
+    if (readback_tags_.size() >= kMaxReadbackTags) {
+      readback_tags_.EraseAt(0);
+    }
+    ReadbackTag moved = tag;
+    moved.pixel_base = write_offset + (tag.pixel_base - read_offset);
+    readback_tags_.push_back(moved);
+  }
+}
