+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_APOSTATE_READBACK_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_APOSTATE_READBACK_NOISE_H_
+
+#include <array>
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+class SkPixmap;
+
+namespace cc {
+class PaintImage;
+}  // namespace cc
+
+namespace blink {
+
+class StaticBitmapImage;
+
+// The opt-in readback policy behind --fingerprint-noise. OFF unless the switch
+// is present and the profile carries an identity to seed from, in which case
+// every page-visible canvas and WebGL readback comes back one step away from
+// the bytes the renderer produced.
+//
+// The policy is content-keyed, not call-keyed: the perturbation of a pixel is
+// a function of the profile seed, the clean pixel, its clean 3x3 neighbourhood
+// and its position in the returned rectangle, and of nothing else. Two reads
+// of one surface therefore agree, a 1:1 canvas-to-canvas copy reads back
+// identically, and every output route returns the same answer for the same
+// pixels. A pixel whose 3x3 neighbourhood is one value is left alone, so a
+// solid fill is byte-exact at every route.
+//
+// "The same pixels" means the same COLOURS, not the same bytes, and that
+// distinction is load-bearing. One canvas is read back through several stores:
+// `getImageData` hands out straight-alpha RGBA8, while a snapshot bound for an
+// encoder is the resource provider's own form, which on macOS is
+// premultiplied BGRA8. Keying on raw memory would give those two different
+// answers for one image -- measured, 749 of 3072 pixels disagreeing -- and
+// stepping a premultiplied channel by one is not a step of one in what the
+// page sees: at alpha 2 it is a step of 127. So the key and the step are both
+// taken in a canonical form, straight alpha in logical R,G,B,A order, and the
+// result is written back through the store's own premultiplication.
+//
+// That is necessary but not sufficient, and the remaining half is a routing
+// rule rather than arithmetic: the policy is applied to the pixels a canvas
+// HOLDS, and any straight-alpha copy a page receives is then produced from
+// those by Skia's own conversion. Reproducing that conversion instead would
+// mean reproducing its rounding, which on this architecture is the NEON
+// round-to-nearest-even of a float divide and not something a fork should
+// pin. Getting it wrong by one is not a rounding error, it is a different
+// KEY: the two routes then disagree about whether a pixel moves at all.
+// `ReadPixelsForPage` is where that rule is kept.
+//
+// Alpha is never moved, and neither is a backing store: each route perturbs
+// the copy the caller is about to see and nothing upstream of it.
+namespace apostate_readback_noise {
+
+// How the channels of one pixel are stored.
+enum class Storage : uint8_t {
+  kUint8,
+  kInt8,
+  kUint16,
+  kInt16,
+  kUint32,
+  kInt32,
+  kFloat16,
+  kFloat32,
+  // One unsigned integer of `packed_bytes` bytes split into `field_bits`
+  // bitfields, least significant first. GL's packed pixel types and Skia's
+  // 1010102 family.
+  kBitFields,
+};
+
+struct Channels {
+  // A logical channel the surface does not carry.
+  static constexpr uint8_t kAbsent = 0xFF;
+
+  Storage storage = Storage::kUint8;
+  // Components per pixel, or the number of bitfields for kBitFields.
+  uint8_t count = 4;
+  // Where the logical red, green, blue and alpha channels live in storage.
+  // This is what makes the policy independent of the memory layout: a BGRA
+  // store and an RGBA store of one image are perturbed identically.
+  std::array<uint8_t, 4> logical = {{0, 1, 2, 3}};
+  // kBitFields only: the width in bits of each field, least significant
+  // first, and the size of the packed integer.
+  std::array<uint8_t, 4> field_bits = {{0, 0, 0, 0}};
+  uint8_t packed_bytes = 0;
+  // The store holds colour already multiplied by alpha. The step is taken on
+  // the straight value and written back multiplied, so it is a step of one in
+  // the value a page reads rather than in the value the store holds.
+  bool premultiplied = false;
+};
+
+// A rectangle of interleaved pixels a page is about to see. `bytes` begins at
+// pixel (0, 0); rows are `row_stride` bytes apart and pixels `pixel_stride`.
+// The rectangle is read in memory order, so a bottom-up GL readback keys its
+// rows from the bottom of the framebuffer. That is the order the caller sees.
+struct Surface {
+  base::span<uint8_t> bytes;
+  int32_t width = 0;
+  int32_t height = 0;
+  size_t row_stride = 0;
+  size_t pixel_stride = 0;
+  Channels channels;
+};
+
+// Whether the opt-in is in force for this renderer. Constant for the process:
+// the switch and the profile are both fixed before the first page loads.
+CORE_EXPORT bool Enabled();
+
+// The profile-derived seed. Zero when the policy is off.
+CORE_EXPORT uint64_t Seed();
+
+// Perturbs `surface` in place. A no-op unless Enabled().
+CORE_EXPORT void Apply(const Surface& surface);
+
+// Perturbs a Skia pixmap in place, taking the channel layout from its
+// SkImageInfo. A no-op unless Enabled(), and a no-op for a colour type the
+// policy does not describe.
+CORE_EXPORT void ApplyToPixmap(const SkPixmap& pixmap);
+
+// Returns a perturbed CPU copy of a canvas snapshot that is about to be
+// encoded or copied out, or `snapshot` itself when the policy is off. The
+// snapshot is never written to, so the canvas keeps a clean backing store and
+// the result is perturbed exactly once.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> ApplyToSnapshot(
+    scoped_refptr<StaticBitmapImage> snapshot);
+
+// `image.readPixels(dst)`, with the policy applied to the pixels the image
+// holds rather than to the converted result. Returns what readPixels returns.
+//
+// The difference matters only where the destination is straight alpha and the
+// image is premultiplied, which is exactly `getImageData`. Perturbing after
+// the conversion would mean the policy had to reproduce that conversion to
+// keep an encoded snapshot of the same canvas in step with it, and a
+// disagreement of one in the reproduced value changes the KEY rather than the
+// answer -- so one route steps a pixel the other leaves alone. Perturbing
+// before it leaves the conversion to Skia on both routes, which is exact by
+// construction and stays exact when Skia's rounding changes.
+CORE_EXPORT bool ReadPixelsForPage(const cc::PaintImage& image,
+                                   const SkPixmap& dst,
+                                   int src_x,
+                                   int src_y);
+
+}  // namespace apostate_readback_noise
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_APOSTATE_READBACK_NOISE_H_
