Subject: [PATCH] tests: compose tests follow the platform-selected GPU

The compositor unit tests assert that the claimed platform picks the GPU
cluster and that the host's graphics backend does not. A new test checks
across 24 seeds that the SwiftShader GPU is never drawn, and that
--fingerprint-anchor can still select it. The fixture gains Windows and
Linux GPUs so each platform has one to draw. A test that sets
screen.left is removed, because the profile schema rejects that key.

--- a/base/apostate/compose_unittest.cc
+++ b/base/apostate/compose_unittest.cc
@@ -171,11 +171,33 @@
      R"({"webgpu":{"info":{"architecture":"test-3","vendor":"test"}}})"},
     {"no-adapter", "Google Inc. (Test)", "ANGLE (Test, Renderer No Adapter)",
      ""},
+};
+// Three anchors, because the persona is what selects among them: one per
+// platform the personas use, plus a software one that must never be drawn.
+//
+// Within a platform the catalogue holds one backend, which is the property that
+// let patch 0102 drop the host-backend filter, so each persona's candidate set
+// here is exactly one anchor and every draw below is deterministic.
+constexpr AnchorMember kD3d11Members[] = {
+    {"d3d11-only", "Google Inc. (Test)", "ANGLE (Test, Renderer D3D11)", ""},
+};
+constexpr AnchorMember kSoftwareMembers[] = {
+    {"software-only", "Google Inc. (Google)",
+     "ANGLE (Google, SwiftShader Device)", ""},
 };
 constexpr Anchor kAnchors[] = {
     {"test-metal", "macos", "metal", "Test", "physical-ground-truth", "aa",
      "bb", "cc", 1, span<const AnchorMember>(kAnchorMembers),
      R"({"gl_limits":{"MAX_TEXTURE_SIZE":16384}})"},
+    {"test-d3d11", "windows", "d3d11", "Test", "physical-ground-truth", "dd",
+     "ee", "ff", 1, span<const AnchorMember>(kD3d11Members),
+     R"({"gl_limits":{"MAX_TEXTURE_SIZE":8192}})"},
+    // Weighted far above the others so that a draw which considers it at all
+    // would pick it. It must still never be chosen.
+    {"test-swiftshader", "windows", "swiftshader", "Google",
+     "compatibility-capture", "gg", "hh", "ii", 1000,
+     span<const AnchorMember>(kSoftwareMembers),
+     R"({"gl_limits":{"MAX_TEXTURE_SIZE":4096}})"},
 };
 
