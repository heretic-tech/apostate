+// What the identity file turned out to be.
+enum class StoredSeedState {
+  // The file holds one usable seed. `seed` is it.
+  kRead,
+  // There is no file. This directory has no identity yet.
+  kAbsent,
+  // There is a file and it is not an identity: empty, truncated mid-write,
+  // longer than any seed, or carrying bytes a seed cannot contain.
+  kCorrupt,
+  // There is a file and this process could not read it. Distinct from corrupt
+  // on purpose: a permission error or a failing disk must not be answered by
+  // deleting the identity it failed to read.
+  kUnreadable,
+};
+
+// Reads the identity file.
+//
+// The accepted form is exactly one seed followed by one newline, and the
+// accepted seed is exactly what --fingerprint accepts -- one rule for both, so
+// a seed the report prints can be pasted into the file and a seed in the file
+// can be pasted onto a command line. The terminator is what makes a truncated
+// file detectable at all: a short write loses the newline, and without it a
+// half-written seed would be read as a shorter but perfectly valid one, which
+// is a silent identity change rather than a reported one.
+StoredSeedState ReadStoredSeed(const FilePath& path, std::string* seed) {
+  File file(path, File::FLAG_OPEN | File::FLAG_READ);
+  if (!file.IsValid()) {
+    return file.error_details() == File::FILE_ERROR_NOT_FOUND
+               ? StoredSeedState::kAbsent
+               : StoredSeedState::kUnreadable;
+  }
+
+  // One byte past the longest file that can be valid, so a longer one is
+  // recognised as too long rather than silently truncated to a valid prefix.
+  std::array<uint8_t, kMaxIdentityFileBytes + 1> buffer = {};
