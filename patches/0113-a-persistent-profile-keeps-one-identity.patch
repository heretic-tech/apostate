+// The longest seed IsUsableSeed accepts, plus the terminator the file carries.
+constexpr size_t kMaxSeedBytes = 512;
+constexpr size_t kMaxIdentityFileBytes = kMaxSeedBytes + 1;
+
+// The file, inside the state directory, that binds an identity to a user data
+// directory.
+//
+// No extension, so no platform associates a handler with it; a plain lowercase
+// name, so it does not collide with a Chromium profile directory name; and it
