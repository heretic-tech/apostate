 #include "base/values.h"
@@ -1025,5 +1031,306 @@ TEST(ApostateComposeTest, TheComposedProfileKeepsTheCredentialsItReplaced) {
       Base64Encode(as_byte_span(std::string_view("{}"))), composed));
 }
 
+// ---------------------------------------------------------------------------
+// The seed layer: pinned by flag, bound to a profile, or ephemeral
+// ---------------------------------------------------------------------------
+
+CommandLine BareCommandLine() {
+  return CommandLine(CommandLine::NO_PROGRAM);
+}
+
+CommandLine FingerprintCommandLine(std::string_view value) {
+  CommandLine command_line(CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII(switches::kFingerprint, std::string(value));
+  return command_line;
+}
+
+FilePath IdentityFileIn(const FilePath& state_directory) {
+  return state_directory.AppendASCII(IdentityFileName());
+}
+
+// The defect this layer exists to fix: four launches against one directory
+// used to be four machines sharing one cookie jar.
+TEST(ApostateSeedTest, OneDirectoryKeepsOneIdentityAcrossLaunches) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+
+  const SeedResolution first = ResolveSeed(BareCommandLine(), state);
+  EXPECT_EQ(SeedOrigin::kProfileBound, first.origin);
+  EXPECT_TRUE(first.identity_minted);
+  EXPECT_FALSE(first.seed.empty());
+  EXPECT_EQ(IdentityFileIn(state), first.identity_file);
+
+  for (int launch = 0; launch < 3; ++launch) {
+    const SeedResolution again = ResolveSeed(BareCommandLine(), state);
+    EXPECT_EQ(SeedOrigin::kProfileBound, again.origin);
+    EXPECT_EQ(first.seed, again.seed);
+    EXPECT_FALSE(again.identity_minted);
+    EXPECT_TRUE(again.limitation.empty());
+  }
+}
+
+// Two directories are two machines. A stored identity is per directory, which
+// is the property a derived-from-the-path seed would not have for two
+// containers that both mount their profile at the same path.
+TEST(ApostateSeedTest, TwoDirectoriesAreTwoIdentities) {
+  ScopedTempDir first_root;
+  ScopedTempDir second_root;
+  ASSERT_TRUE(first_root.CreateUniqueTempDir());
+  ASSERT_TRUE(second_root.CreateUniqueTempDir());
+
+  const SeedResolution first = ResolveSeed(
+      BareCommandLine(), first_root.GetPath().AppendASCII("apostate"));
+  const SeedResolution second = ResolveSeed(
+      BareCommandLine(), second_root.GetPath().AppendASCII("apostate"));
+
+  EXPECT_EQ(SeedOrigin::kProfileBound, first.origin);
+  EXPECT_EQ(SeedOrigin::kProfileBound, second.origin);
+  EXPECT_NE(first.seed, second.seed);
+}
+
+// An identity that moves with the directory. This is what storing buys over
+// hashing the path, and it is the case an operator hits by renaming a profile.
+TEST(ApostateSeedTest, TheIdentityFollowsADirectoryThatMoves) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath original = root.GetPath().AppendASCII("before");
+  const FilePath moved = root.GetPath().AppendASCII("after");
+
+  const SeedResolution minted = ResolveSeed(BareCommandLine(), original);
+  ASSERT_EQ(SeedOrigin::kProfileBound, minted.origin);
+  ASSERT_TRUE(Move(original, moved));
+
+  const SeedResolution after = ResolveSeed(BareCommandLine(), moved);
+  EXPECT_EQ(SeedOrigin::kProfileBound, after.origin);
+  EXPECT_EQ(minted.seed, after.seed);
+}
+
+// No directory named, so nothing for an identity to outlive. Ephemeral
+// sessions have to keep rotating or the default stops being a fresh device.
+TEST(ApostateSeedTest, NoDirectoryStillDrawsAFreshIdentityEveryLaunch) {
+  const SeedResolution first = ResolveSeed(BareCommandLine(), FilePath());
+  const SeedResolution second = ResolveSeed(BareCommandLine(), FilePath());
+
+  EXPECT_EQ(SeedOrigin::kGenerated, first.origin);
+  EXPECT_EQ(SeedOrigin::kGenerated, second.origin);
+  EXPECT_NE(first.seed, second.seed);
+  EXPECT_TRUE(first.identity_file.empty());
+}
+
+// Precedence: the flag outranks the profile, and does not disturb it. A
+// launch that pins a seed must not renumber the directory it ran against,
+// because the next unpinned launch has to present what it presented before.
+TEST(ApostateSeedTest, AnExplicitSeedOutranksTheProfileAndLeavesItAlone) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+
+  const SeedResolution bound = ResolveSeed(BareCommandLine(), state);
+  ASSERT_EQ(SeedOrigin::kProfileBound, bound.origin);
+
+  const SeedResolution pinned =
+      ResolveSeed(FingerprintCommandLine("a-named-seed"), state);
+  EXPECT_EQ(SeedOrigin::kSwitch, pinned.origin);
+  EXPECT_EQ("a-named-seed", pinned.seed);
+  EXPECT_TRUE(pinned.identity_file.empty());
+
+  const SeedResolution after = ResolveSeed(BareCommandLine(), state);
+  EXPECT_EQ(SeedOrigin::kProfileBound, after.origin);
+  EXPECT_EQ(bound.seed, after.seed);
+}
+
+// Host pass-through still composes nothing, and still writes nothing: a
+// directory that has never been launched without --fingerprint=host must not
+// acquire an identity from a launch that asked for none.
+TEST(ApostateSeedTest, HostPassThroughComposesNothingAndStoresNothing) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+
+  const SeedResolution host = ResolveSeed(FingerprintCommandLine("host"), state);
+  EXPECT_EQ(SeedOrigin::kHostInheritance, host.origin);
+  EXPECT_FALSE(host.should_compose());
+  EXPECT_FALSE(PathExists(IdentityFileIn(state)));
+}
+
+// A rejected --fingerprint is still a refusal, not a silent fall-through to
+// the profile identity. Falling through would present a device the launch did
+// not ask for while reporting success.
+TEST(ApostateSeedTest, AnUnusableSeedIsRefusedRatherThanFallingToTheProfile) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+
+  const SeedResolution refused =
+      ResolveSeed(FingerprintCommandLine(std::string(513, 'a')), state);
+  EXPECT_TRUE(refused.rejected);
+  EXPECT_EQ(SeedOrigin::kHostInheritance, refused.origin);
+  EXPECT_FALSE(PathExists(IdentityFileIn(state)));
+}
+
+// The file is one seed and one newline, so `cat` gives an operator something
+// they can paste straight back as --fingerprint=<seed>.
+TEST(ApostateSeedTest, TheStoredFileRoundTripsThroughTheFlag) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+
+  const SeedResolution minted = ResolveSeed(BareCommandLine(), state);
+  ASSERT_EQ(SeedOrigin::kProfileBound, minted.origin);
+
+  std::string contents;
+  ASSERT_TRUE(ReadFileToString(IdentityFileIn(state), &contents));
+  EXPECT_EQ(minted.seed + "\n", contents);
+
+  const SeedResolution pinned =
+      ResolveSeed(FingerprintCommandLine(minted.seed), FilePath());
+  EXPECT_EQ(minted.seed, pinned.seed);
+}
+
+// A seed written by hand is honoured, because the file's rule is the flag's
+// rule. An operator pinning a profile by editing the file is using it
+// correctly, not corrupting it.
+TEST(ApostateSeedTest, AHandWrittenSeedIsHonoured) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+  ASSERT_TRUE(CreateDirectory(state));
+  ASSERT_TRUE(WriteFile(IdentityFileIn(state), "chosen-by-hand\n"));
+
+  const SeedResolution bound = ResolveSeed(BareCommandLine(), state);
+  EXPECT_EQ(SeedOrigin::kProfileBound, bound.origin);
+  EXPECT_EQ("chosen-by-hand", bound.seed);
+  EXPECT_FALSE(bound.identity_minted);
+}
+
+// Corrupt, truncated and non-printable all mean the same thing: this is not
+// an identity. Each is replaced once, reported once, and stable afterwards --
+// the alternative is a directory that silently draws a new machine forever,
+// which is the defect this layer exists to fix.
+TEST(ApostateSeedTest, AFileThatIsNotAnIdentityIsReplacedAndReported) {
+  const std::string_view corrupt[] = {
+      "",              // empty
+      "nonewline",     // truncated mid-write: the terminator is gone
+      "two\nlines\n",  // not one seed
+      "\x01\x02\n",    // not printable
+      "has a space\n",
+  };
+
+  for (const std::string_view content : corrupt) {
+    ScopedTempDir root;
+    ASSERT_TRUE(root.CreateUniqueTempDir());
+    const FilePath state = root.GetPath().AppendASCII("apostate");
+    ASSERT_TRUE(CreateDirectory(state));
+    ASSERT_TRUE(WriteFile(IdentityFileIn(state), content));
+
+    const SeedResolution replaced = ResolveSeed(BareCommandLine(), state);
+    EXPECT_EQ(SeedOrigin::kProfileBound, replaced.origin) << content;
+    EXPECT_TRUE(replaced.identity_minted) << content;
+    EXPECT_FALSE(replaced.limitation.empty()) << content;
+
+    // Reported once, then the directory is well again.
+    const SeedResolution next = ResolveSeed(BareCommandLine(), state);
+    EXPECT_EQ(replaced.seed, next.seed) << content;
+    EXPECT_TRUE(next.limitation.empty()) << content;
+  }
+}
+
+// A seed over the length limit is corrupt rather than silently truncated to a
+// valid prefix, which would be an identity change reported nowhere.
+TEST(ApostateSeedTest, AnOverlongStoredSeedIsNotTruncatedIntoAValidOne) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+  ASSERT_TRUE(CreateDirectory(state));
+  const std::string overlong = std::string(513, 'a') + "\n";
+  ASSERT_TRUE(WriteFile(IdentityFileIn(state), overlong));
+
+  const SeedResolution replaced = ResolveSeed(BareCommandLine(), state);
+  EXPECT_EQ(SeedOrigin::kProfileBound, replaced.origin);
+  EXPECT_NE(std::string(512, 'a'), replaced.seed);
+  EXPECT_FALSE(replaced.limitation.empty());
+}
+
+// A directory that cannot hold a file still launches, with a coherent device
+// and a limitation saying the identity is not kept. Refusing to start because
+// an identity could not be filed away would be worse than the behaviour this
+// patch replaces.
+TEST(ApostateSeedTest, AnUnwritableDirectoryFallsBackToEphemeralAndSaysSo) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  // A regular file where the state directory's parent has to be, so the
+  // directory cannot be created on any platform and for any user, including
+  // root -- which a chmod-based test does not achieve.
+  const FilePath blocked = root.GetPath().AppendASCII("not-a-directory");
+  ASSERT_TRUE(WriteFile(blocked, "x"));
+
+  const SeedResolution fell_back =
+      ResolveSeed(BareCommandLine(), blocked.AppendASCII("apostate"));
+  EXPECT_EQ(SeedOrigin::kGenerated, fell_back.origin);
+  EXPECT_TRUE(fell_back.should_compose());
+  EXPECT_FALSE(fell_back.seed.empty());
+  EXPECT_FALSE(fell_back.limitation.empty());
+  EXPECT_TRUE(fell_back.identity_file.empty());
+}
+
+// A file this process cannot read is left alone rather than deleted. A
+// permission error or a failing disk must cost one ephemeral launch, not the
+// identity it failed to read.
+TEST(ApostateSeedTest, AnUnreadableIdentityIsLeftOnDisk) {
+  ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const FilePath state = root.GetPath().AppendASCII("apostate");
+  // A directory in the identity's place: it opens and refuses to be read,
+  // which is the same shape as an unreadable file and works as any user.
+  ASSERT_TRUE(CreateDirectory(IdentityFileIn(state)));
+
+  const SeedResolution fell_back = ResolveSeed(BareCommandLine(), state);
+  EXPECT_EQ(SeedOrigin::kGenerated, fell_back.origin);
+  EXPECT_FALSE(fell_back.limitation.empty());
+  EXPECT_TRUE(DirectoryExists(IdentityFileIn(state)));
+}
+
+// The line an operator reads when debugging exactly this behaviour. It has to
+// separate the three lifetimes -- pinned by flag, bound to a profile,
+// ephemeral -- and name the file, or "why is my machine different" has no
+// answer in the report.
+TEST(ApostateSeedTest, TheExplainReportDistinguishesTheThreeLifetimes) {
+  const HostCapability host;
+  Composition composition;
+  composition.seed = "a-seed";
+
+  composition.seed_origin = SeedOrigin::kSwitch;
+  const std::string pinned = FormatExplainReport(composition, host);
+  EXPECT_NE(std::string::npos, pinned.find("seed source"));
+  EXPECT_NE(std::string::npos, pinned.find("pinned by flag"));
+  EXPECT_EQ(std::string::npos, pinned.find("identity file"));
+
+  composition.seed_origin = SeedOrigin::kGenerated;
+  const std::string ephemeral = FormatExplainReport(composition, host);
+  EXPECT_NE(std::string::npos, ephemeral.find("ephemeral"));
+  EXPECT_EQ(std::string::npos, ephemeral.find("identity file"));
+
+  composition.seed_origin = SeedOrigin::kProfileBound;
+  composition.identity_file = "/profiles/one/apostate/identity";
+  composition.identity_minted = true;
+  const std::string minted = FormatExplainReport(composition, host);
+  EXPECT_NE(std::string::npos, minted.find("stable for this --user-data-dir"));
+  EXPECT_NE(std::string::npos,
+            minted.find("/profiles/one/apostate/identity (created this "
+                        "launch)"));
+
+  composition.identity_minted = false;
+  const std::string read = FormatExplainReport(composition, host);
+  EXPECT_NE(std::string::npos,
+            read.find("/profiles/one/apostate/identity (read from disk)"));
+
+  // All three read differently, which is the property the report exists for.
+  EXPECT_NE(pinned, ephemeral);
+  EXPECT_NE(ephemeral, read);
+  EXPECT_NE(pinned, read);
+}
+
 }  // namespace
 }  // namespace base::apostate
