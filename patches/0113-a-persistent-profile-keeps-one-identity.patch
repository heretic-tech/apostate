 inline constexpr char kFingerprint[] = "fingerprint";
 
 // The canonical reserved --fingerprint value: inherit the host, compose
@@ -188,6 +189,12 @@ struct BASE_EXPORT SurfaceRecord {
 struct BASE_EXPORT Composition {
   std::string seed;
