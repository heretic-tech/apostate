--- a/base/apostate/compose_unittest.cc
+++ b/base/apostate/compose_unittest.cc
@@ -12,10 +12,16 @@
 #include <vector>
 
 #include "base/apostate/dispersion_table.h"
+#include "base/apostate/explain.h"
 #include "base/apostate/host_capability.h"
 #include "base/apostate/profile.h"
+#include "base/apostate/seed.h"
