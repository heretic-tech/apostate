+// found in the LICENSE file.
+
+#include "net/socket/socks5_datagram_server_socket.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/notreached.h"
+#include "base/numerics/safe_conversions.h"
+#include "net/base/address_family.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/log/net_log_with_source.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/socket/stream_socket.h"
+
+namespace net {
+
+namespace {
+
+// These are the same wire constants SOCKS5DatagramClientSocket uses. They live
+// in that file's unnamed namespace, so they cannot be shared without moving
+// them; the names are kept identical so a later move is mechanical.
+constexpr uint8_t kSOCKS5Version = 0x05;
+constexpr uint8_t kUdpAssociateCommand = 0x03;
+constexpr uint8_t kAuthMethodNone = 0x00;
+constexpr uint8_t kAuthMethodUserPass = 0x02;
+constexpr uint8_t kAuthSubnegotiationVersion = 0x01;
+constexpr uint8_t kAuthStatusSuccess = 0x00;
+constexpr uint8_t kReplySuccess = 0x00;
+constexpr uint8_t kAddressTypeIPv4 = 0x01;
+constexpr uint8_t kAddressTypeDomain = 0x03;
+constexpr uint8_t kAddressTypeIPv6 = 0x04;
+
+// VER + METHOD for the greeting reply, VER + STATUS for the RFC 1929 reply.
+constexpr size_t kTwoByteReplySize = 2;
+// VER, REP, RSV, ATYP and the first address byte: enough to size the rest.
+constexpr size_t kReplyPrefixSize = 5;
+
+// RSV(2) + FRAG(1) + ATYP(1) before the address, DST.PORT(2) after it.
+constexpr size_t kHeaderPrefixSize = 4;
+constexpr size_t kPortSize = 2;
+
+uint16_t ReadPort(base::span<const uint8_t> bytes) {
+  return static_cast<uint16_t>((static_cast<uint16_t>(bytes[0]) << 8) |
+                               bytes[1]);
+}
+
+// The RFC 1928 §7 prefix addressing `destination`, or an empty vector when the
+// destination has no address this socket can frame. Unlike the QUIC socket's
+// header this is rebuilt per datagram, because a peer connection reaches a
+// different destination on almost every send.
+std::vector<uint8_t> BuildDatagramHeader(const IPEndPoint& destination) {
+  const IPAddress& address = destination.address();
+  if (!address.IsIPv4() && !address.IsIPv6()) {
+    return std::vector<uint8_t>();
+  }
+  std::vector<uint8_t> header;
+  header.reserve(kHeaderPrefixSize + address.size() + kPortSize);
+  header.insert(header.end(),
+                {0x00, 0x00, 0x00,
+                 address.IsIPv4() ? kAddressTypeIPv4 : kAddressTypeIPv6});
+  header.insert(header.end(), address.bytes().begin(), address.bytes().end());
+  header.push_back(static_cast<uint8_t>(destination.port() >> 8));
+  header.push_back(static_cast<uint8_t>(destination.port() & 0xff));
+  return header;
+}
+
+}  // namespace
+
+SOCKS5DatagramServerSocket::SOCKS5DatagramServerSocket(
+    std::unique_ptr<DatagramServerSocket> datagram_socket,
+    ClientSocketFactory* client_socket_factory,
+    HostResolver* host_resolver,
+    const NetworkAnonymizationKey& network_anonymization_key,
+    const HostPortPair& proxy,
+    std::optional<SOCKS5Credentials> credentials,
+    const NetworkTrafficAnnotationTag& traffic_annotation)
+    : datagram_socket_(std::move(datagram_socket)),
+      client_socket_factory_(client_socket_factory),
+      host_resolver_(host_resolver),
+      network_anonymization_key_(network_anonymization_key),
+      proxy_(proxy),
+      credentials_(std::move(credentials)),
+      traffic_annotation_(traffic_annotation) {
+  CHECK(datagram_socket_);
+  CHECK(client_socket_factory_);
+  CHECK(host_resolver_);
+}
+
+SOCKS5DatagramServerSocket::~SOCKS5DatagramServerSocket() {
+  // Destroying `control_socket_` ends the association, which is the point of
+  // holding it for this object's whole lifetime.
+}
+
+// ---------------------------------------------------------------------------
+// Association setup
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramServerSocket::Listen(const IPEndPoint& address) {
+  CHECK(!listening_);
+  const IPAddress& requested = address.address();
+  if (!requested.IsIPv4() && !requested.IsIPv6()) {
+    return ERR_ADDRESS_INVALID;
+  }
+  // The wildcard address of the requested family on an ephemeral port,
+  // whatever address and port were asked for. A specific interface address may
+  // have no route to the proxy, and the port the page is told is the relay's,
+  // so binding a chosen local port would constrain nothing a page can see.
+  const IPEndPoint bind_address(requested.IsIPv4() ? IPAddress::IPv4AllZeros()
+                                                   : IPAddress::IPv6AllZeros(),
+                                0);
+  int rv = datagram_socket_->Listen(bind_address);
+  if (rv != OK) {
+    return rv;
+  }
+  listening_ = true;
+  listen_family_ = GetAddressFamily(requested);
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::ConnectRelay(CompletionOnceCallback callback) {
+  if (!listening_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  CHECK(!associated_);
+  CHECK(connect_callback_.is_null());
+  next_state_ = STATE_RESOLVE_PROXY;
+  int rv = DoLoop(OK);
+  if (rv == ERR_IO_PENDING) {
+    connect_callback_ = std::move(callback);
+  }
+  return rv;
+}
+
+void SOCKS5DatagramServerSocket::OnIOComplete(int result) {
+  CHECK_NE(STATE_NONE, next_state_);
+  int rv = DoLoop(result);
+  if (rv != ERR_IO_PENDING && !connect_callback_.is_null()) {
+    std::move(connect_callback_).Run(rv);
+  }
+}
+
+int SOCKS5DatagramServerSocket::DoLoop(int last_io_result) {
+  int rv = last_io_result;
+  do {
+    State state = next_state_;
+    next_state_ = STATE_NONE;
+    switch (state) {
+      case STATE_RESOLVE_PROXY:
+        rv = DoResolveProxy();
+        break;
+      case STATE_RESOLVE_PROXY_COMPLETE:
+        rv = DoResolveProxyComplete(rv);
+        break;
+      case STATE_CONTROL_CONNECT:
+        rv = DoControlConnect();
+        break;
+      case STATE_CONTROL_CONNECT_COMPLETE:
+        rv = DoControlConnectComplete(rv);
+        break;
+      case STATE_GREET_WRITE:
+        rv = DoGreetWrite();
+        break;
+      case STATE_GREET_WRITE_COMPLETE:
+        rv = DoGreetWriteComplete(rv);
+        break;
+      case STATE_GREET_READ:
+        rv = DoGreetRead();
+        break;
+      case STATE_GREET_READ_COMPLETE:
+        rv = DoGreetReadComplete(rv);
+        break;
+      case STATE_AUTH_WRITE:
+        rv = DoAuthWrite();
+        break;
+      case STATE_AUTH_WRITE_COMPLETE:
+        rv = DoAuthWriteComplete(rv);
+        break;
+      case STATE_AUTH_READ:
+        rv = DoAuthRead();
+        break;
+      case STATE_AUTH_READ_COMPLETE:
+        rv = DoAuthReadComplete(rv);
+        break;
+      case STATE_ASSOCIATE_WRITE:
+        rv = DoAssociateWrite();
+        break;
+      case STATE_ASSOCIATE_WRITE_COMPLETE:
+        rv = DoAssociateWriteComplete(rv);
+        break;
+      case STATE_ASSOCIATE_READ:
+        rv = DoAssociateRead();
+        break;
+      case STATE_ASSOCIATE_READ_COMPLETE:
+        rv = DoAssociateReadComplete(rv);
+        break;
+      case STATE_NONE:
+        NOTREACHED();
+    }
+  } while (rv != ERR_IO_PENDING && next_state_ != STATE_NONE);
+  return rv;
+}
+
+int SOCKS5DatagramServerSocket::DoResolveProxy() {
+  next_state_ = STATE_RESOLVE_PROXY_COMPLETE;
+  // The default query type, not one narrowed to `listen_family_`: the stream
+  // path through the same proxy asks for both families, and asking for one
+  // would make the media plane's lookup distinguishable at the resolver. An
+  // IP-literal proxy resolves without a query at all, and a named one is
+  // usually already in the host cache from the stream path.
+  resolve_request_ = host_resolver_->CreateRequest(
+      proxy_, network_anonymization_key_, handles::kInvalidNetworkHandle,
+      datagram_socket_->NetLog(), std::nullopt);
+  return resolve_request_->Start(base::BindOnce(
+      &SOCKS5DatagramServerSocket::OnIOComplete, weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5DatagramServerSocket::DoResolveProxyComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  for (const IPEndPoint& endpoint :
+       resolve_request_->GetAddressResults().endpoints()) {
+    if (GetAddressFamily(endpoint.address()) == listen_family_) {
+      proxy_endpoint_ = endpoint;
+      break;
+    }
+  }
+  resolve_request_.reset();
+  if (proxy_endpoint_.address().empty()) {
+    // The proxy has no address in this socket's family, so this family has no
+    // relayed egress. Reporting it unreachable is what stops a candidate of
+    // that family being emitted at all.
+    return ERR_ADDRESS_UNREACHABLE;
+  }
+  next_state_ = STATE_CONTROL_CONNECT;
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::DoControlConnect() {
+  next_state_ = STATE_CONTROL_CONNECT_COMPLETE;
+  const NetLogWithSource& net_log = datagram_socket_->NetLog();
+  control_socket_ = client_socket_factory_->CreateTransportClientSocket(
+      AddressList(proxy_endpoint_), handles::kInvalidNetworkHandle,
+      /*socket_performance_watcher=*/nullptr,
+      /*network_quality_estimator=*/nullptr, net_log.net_log(),
+      net_log.source());
+  return control_socket_->Connect(base::BindOnce(
+      &SOCKS5DatagramServerSocket::OnIOComplete, weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5DatagramServerSocket::DoControlConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  next_state_ = STATE_GREET_WRITE;
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::DoGreetWrite() {
+  // Byte-for-byte the greeting SOCKS5DatagramClientSocket sends, which without
+  // credentials is byte-for-byte Chromium's own, so the proxy sees one client.
+  std::vector<uint8_t> greeting;
+  if (credentials_) {
+    greeting = {kSOCKS5Version, 0x02, kAuthMethodNone, kAuthMethodUserPass};
+  } else {
+    greeting = {kSOCKS5Version, 0x01, kAuthMethodNone};
+  }
+  return StartControlWrite(std::move(greeting), STATE_GREET_WRITE_COMPLETE,
+                           STATE_GREET_READ);
+}
+
+int SOCKS5DatagramServerSocket::DoGreetWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  control_write_buf_->DidConsume(result);
+  return ContinueControlWrite(STATE_GREET_WRITE_COMPLETE, STATE_GREET_READ);
+}
+
+int SOCKS5DatagramServerSocket::DoGreetRead() {
+  return StartControlRead(kTwoByteReplySize, STATE_GREET_READ_COMPLETE);
+}
+
+int SOCKS5DatagramServerSocket::DoGreetReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buf_->DidConsume(result);
+  if (control_read_buf_->RemainingCapacity() > 0) {
+    return ContinueControlRead(STATE_GREET_READ_COMPLETE);
+  }
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  if (reply[0] != kSOCKS5Version) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (reply[1] == kAuthMethodNone) {
+    next_state_ = STATE_ASSOCIATE_WRITE;
+    return OK;
+  }
+  if (reply[1] == kAuthMethodUserPass && credentials_) {
+    next_state_ = STATE_AUTH_WRITE;
+    return OK;
+  }
+  // Includes 0xFF ("no acceptable methods"), which is what a proxy requiring
+  // credentials answers when none were configured.
+  return ERR_SOCKS_CONNECTION_FAILED;
+}
+
+int SOCKS5DatagramServerSocket::DoAuthWrite() {
+  CHECK(credentials_);
+  std::vector<uint8_t> request;
+  request.reserve(3u + credentials_->username.size() +
+                  credentials_->password.size());
+  request.push_back(kAuthSubnegotiationVersion);
+  request.push_back(static_cast<uint8_t>(credentials_->username.size()));
+  request.insert(request.end(), credentials_->username.begin(),
+                 credentials_->username.end());
+  request.push_back(static_cast<uint8_t>(credentials_->password.size()));
+  request.insert(request.end(), credentials_->password.begin(),
+                 credentials_->password.end());
+  return StartControlWrite(std::move(request), STATE_AUTH_WRITE_COMPLETE,
+                           STATE_AUTH_READ);
+}
+
+int SOCKS5DatagramServerSocket::DoAuthWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  control_write_buf_->DidConsume(result);
+  return ContinueControlWrite(STATE_AUTH_WRITE_COMPLETE, STATE_AUTH_READ);
+}
+
+int SOCKS5DatagramServerSocket::DoAuthRead() {
+  return StartControlRead(kTwoByteReplySize, STATE_AUTH_READ_COMPLETE);
+}
+
+int SOCKS5DatagramServerSocket::DoAuthReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buf_->DidConsume(result);
+  if (control_read_buf_->RemainingCapacity() > 0) {
+    return ContinueControlRead(STATE_AUTH_READ_COMPLETE);
+  }
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  // The sub-negotiation carries its own version, which is not the SOCKS
+  // version.
+  if (reply[0] != kAuthSubnegotiationVersion ||
+      reply[1] != kAuthStatusSuccess) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  next_state_ = STATE_ASSOCIATE_WRITE;
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::DoAssociateWrite() {
+  // DST.ADDR and DST.PORT of an ASSOCIATE request name the address the client
+  // will send datagrams from. This socket is bound to a wildcard address, so
+  // the address it will be seen at is the proxy's to observe and not this
+  // host's to state, and RFC 1928 §4 requires zeros in exactly that case. It
+  // is also the same ten bytes SOCKS5DatagramClientSocket sends.
+  std::vector<uint8_t> request = {kSOCKS5Version, kUdpAssociateCommand,
+                                  0x00,           kAddressTypeIPv4,
+                                  0x00,           0x00,
+                                  0x00,           0x00,
+                                  0x00,           0x00};
+  return StartControlWrite(std::move(request), STATE_ASSOCIATE_WRITE_COMPLETE,
+                           STATE_ASSOCIATE_READ);
+}
+
+int SOCKS5DatagramServerSocket::DoAssociateWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  control_write_buf_->DidConsume(result);
+  return ContinueControlWrite(STATE_ASSOCIATE_WRITE_COMPLETE,
+                              STATE_ASSOCIATE_READ);
+}
+
+int SOCKS5DatagramServerSocket::DoAssociateRead() {
+  return StartControlRead(kReplyPrefixSize, STATE_ASSOCIATE_READ_COMPLETE);
+}
+
+int SOCKS5DatagramServerSocket::DoAssociateReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  control_read_buf_->DidConsume(result);
+  if (control_read_buf_->RemainingCapacity() > 0) {
+    return ContinueControlRead(STATE_ASSOCIATE_READ_COMPLETE);
+  }
+  if (static_cast<size_t>(control_read_buf_->offset()) == kReplyPrefixSize) {
+    // The prefix is in: size the remainder from ATYP and keep reading.
+    std::optional<size_t> remainder = AssociateReplyRemainder();
+    if (!remainder.has_value()) {
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    if (*remainder > 0) {
+      control_read_buf_->SetCapacity(
+          base::checked_cast<int>(kReplyPrefixSize + *remainder));
+      return ContinueControlRead(STATE_ASSOCIATE_READ_COMPLETE);
+    }
+  }
+  int rv = ResolveRelayEndpoint();
+  if (rv != OK) {
+    return rv;
+  }
+  control_read_buf_.reset();
+  associated_ = true;
+  StartControlWatch();
+  return OK;
+}
+
+std::optional<size_t> SOCKS5DatagramServerSocket::AssociateReplyRemainder()
+    const {
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  if (reply[0] != kSOCKS5Version || reply[2] != 0x00) {
+    return std::nullopt;
+  }
+  // The prefix already holds one address byte, so that byte is not counted
+  // again. For a domain name it is the length octet.
+  switch (reply[3]) {
+    case kAddressTypeIPv4:
+      return 4u - 1u + kPortSize;
+    case kAddressTypeIPv6:
+      return 16u - 1u + kPortSize;
+    case kAddressTypeDomain:
+      return size_t{reply[4]} + kPortSize;
+    default:
+      return std::nullopt;
+  }
+}
+
+int SOCKS5DatagramServerSocket::ResolveRelayEndpoint() {
+  base::span<const uint8_t> reply = control_read_buf_->span_before_offset();
+  if (reply[1] != kReplySuccess) {
+    // Includes 0x07 (command not supported), which is what a proxy without UDP
+    // ASSOCIATE answers. That is the failure that makes this socket, and
+    // therefore the UDP candidate it would have produced, not exist.
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  IPAddress reported;
+  uint16_t port = 0;
+  bool usable = false;
+  switch (reply[3]) {
+    case kAddressTypeIPv4:
+      reported = IPAddress(reply.subspan(kHeaderPrefixSize, 4u));
+      port = ReadPort(reply.subspan(kHeaderPrefixSize + 4u, kPortSize));
+      usable = true;
+      break;
+    case kAddressTypeIPv6:
+      reported = IPAddress(reply.subspan(kHeaderPrefixSize, 16u));
+      port = ReadPort(reply.subspan(kHeaderPrefixSize + 16u, kPortSize));
+      usable = true;
+      break;
+    case kAddressTypeDomain: {
+      // Resolving the relay's name would be a DNS query the stream path
+      // through the same proxy never makes.
+      const size_t name_length = size_t{reply[4]};
+      port = ReadPort(
+          reply.subspan(kHeaderPrefixSize + 1u + name_length, kPortSize));
+      usable = false;
+      break;
+    }
+    default:
+      return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (port == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  // The substitution rules of SOCKS5DatagramClientSocket, unchanged. Only the
+  // address is ever replaced; the port always comes from BND.PORT.
+  const IPAddress& proxy_address = proxy_endpoint_.address();
+  if (usable) {
+    if (reported.IsZero()) {
+      usable = false;  // "This host", and the most common real reply.
+    } else if (reported.IsLoopback() && !proxy_address.IsLoopback()) {
+      usable = false;  // The proxy reported its inside-the-box address.
+    } else if (reported.size() != proxy_address.size()) {
+      usable = false;  // Unreachable from the socket this object bound.
+    }
+  }
+  relay_endpoint_ = IPEndPoint(usable ? reported : proxy_address, port);
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::StartControlWrite(std::vector<uint8_t> bytes,
+                                                  State write_complete_state,
+                                                  State done_state) {
+  const size_t size = bytes.size();
+  control_write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(
+      base::MakeRefCounted<VectorIOBuffer>(std::move(bytes)), size);
+  return ContinueControlWrite(write_complete_state, done_state);
+}
+
+int SOCKS5DatagramServerSocket::ContinueControlWrite(State write_complete_state,
+                                                     State done_state) {
+  while (control_write_buf_->BytesRemaining() > 0) {
+    next_state_ = write_complete_state;
+    int rv = control_socket_->Write(
+        control_write_buf_.get(), control_write_buf_->BytesRemaining(),
+        base::BindOnce(&SOCKS5DatagramServerSocket::OnIOComplete,
+                       weak_factory_.GetWeakPtr()),
+        traffic_annotation_);
+    if (rv == ERR_IO_PENDING) {
+      return ERR_IO_PENDING;
+    }
+    if (rv <= 0) {
+      return rv == 0 ? ERR_SOCKS_CONNECTION_FAILED : rv;
+    }
+    control_write_buf_->DidConsume(rv);
+  }
+  control_write_buf_.reset();
+  next_state_ = done_state;
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::StartControlRead(size_t capacity,
+                                                 State complete_state) {
+  if (!control_read_buf_) {
+    control_read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+  }
+  control_read_buf_->set_offset(0);
+  control_read_buf_->SetCapacity(base::checked_cast<int>(capacity));
+  return ContinueControlRead(complete_state);
+}
+
+int SOCKS5DatagramServerSocket::ContinueControlRead(State complete_state) {
+  next_state_ = complete_state;
+  return control_socket_->Read(
+      control_read_buf_.get(), control_read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5DatagramServerSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SOCKS5DatagramServerSocket::StartControlWatch() {
+  control_watch_buf_ = base::MakeRefCounted<IOBufferWithSize>(size_t{1});
+  int rv = control_socket_->Read(
+      control_watch_buf_.get(), 1,
+      base::BindOnce(&SOCKS5DatagramServerSocket::OnControlWatchComplete,
+                     weak_factory_.GetWeakPtr()));
+  if (rv != ERR_IO_PENDING) {
+    OnControlWatchComplete(rv);
+  }
+}
+
+void SOCKS5DatagramServerSocket::OnControlWatchComplete(int result) {
+  // RFC 1928 §7: the association ends with the control connection, so anything
+  // other than "still pending" is terminal. Latching it here is what makes the
+  // next SendTo() fail instead of handing a packet to a relay that has stopped
+  // listening, which would otherwise look to WebRTC like a silent path.
+  if (result > 0) {
+    // A conforming proxy sends nothing after the ASSOCIATE reply.
+    LatchError(ERR_SOCKS_CONNECTION_FAILED);
+  } else if (result == 0) {
+    LatchError(ERR_CONNECTION_CLOSED);
+  } else {
+    LatchError(result);
+  }
+}
+
+void SOCKS5DatagramServerSocket::LatchError(int error) {
+  CHECK_LT(error, 0);
+  CHECK_NE(error, ERR_IO_PENDING);
+  if (latched_error_ != OK) {
+    return;
+  }
+  latched_error_ = error;
+  if (!read_user_callback_.is_null()) {
+    CompletionOnceCallback callback = std::move(read_user_callback_);
+    ClearReadState();
+    std::move(callback).Run(error);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Receive
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramServerSocket::RecvFrom(IOBuffer* buf,
+                                         int buf_len,
+                                         IPEndPoint* address,
+                                         CompletionOnceCallback callback) {
+  if (latched_error_ != OK) {
+    return latched_error_;
+  }
+  if (!associated_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  CHECK_GT(buf_len, 0);
+  CHECK(address);
+  CHECK(read_user_callback_.is_null());
+  read_user_buffer_ = buf;
+  read_user_buffer_len_ = static_cast<size_t>(buf_len);
+  read_user_address_ = address;
+  read_user_callback_ = std::move(callback);
+
+  const size_t frame_len = read_user_buffer_len_ + kMaxSocks5InboundHeaderSize;
+  if (!read_frame_buffer_ ||
+      static_cast<size_t>(read_frame_buffer_->size()) < frame_len) {
+    read_frame_buffer_ = base::MakeRefCounted<IOBufferWithSize>(frame_len);
+  }
+
+  int rv = ReadLoop();
+  if (rv == ERR_IO_PENDING) {
+    return ERR_IO_PENDING;
+  }
+  read_user_callback_.Reset();
+  ClearReadState();
+  return rv;
+}
+
+int SOCKS5DatagramServerSocket::ReadLoop() {
+  while (true) {
+    int rv = datagram_socket_->RecvFrom(
+        read_frame_buffer_.get(),
+        base::checked_cast<int>(read_frame_buffer_->size()),
+        &read_frame_address_,
+        base::BindOnce(&SOCKS5DatagramServerSocket::OnDatagramReadComplete,
+                       weak_factory_.GetWeakPtr()));
+    if (rv == ERR_IO_PENDING) {
+      return ERR_IO_PENDING;
+    }
+    int result = OK;
+    if (Deframe(rv, &result)) {
+      return result;
+    }
+    // The datagram was dropped rather than delivered, which is
+    // indistinguishable from the packet loss WebRTC already handles. Read
+    // again rather than report an error.
+  }
+}
+
+void SOCKS5DatagramServerSocket::OnDatagramReadComplete(int result) {
+  if (read_user_callback_.is_null()) {
+    return;
+  }
+  int out_result = OK;
+  if (!Deframe(result, &out_result)) {
+    // Dropped. Issue the next read; only a final result falls through.
+    out_result = ReadLoop();
+    if (out_result == ERR_IO_PENDING) {
+      return;
+    }
+  }
+  CompletionOnceCallback callback = std::move(read_user_callback_);
+  ClearReadState();
+  std::move(callback).Run(out_result);
+}
+
+bool SOCKS5DatagramServerSocket::Deframe(int result, int* out_result) {
+  if (result < 0) {
+    *out_result = result;
+    return true;
+  }
+  // A datagram from anything other than the relay carries no RFC 1928 header,
+  // so there is nothing to deframe and nothing legitimate it could be: the
+  // only address any peer was told is the relay's.
+  if (read_frame_address_ != relay_endpoint_) {
+    return false;
+  }
+  base::span<const uint8_t> datagram =
+      read_frame_buffer_->span().first(static_cast<size_t>(result));
+  if (datagram.size() < kHeaderPrefixSize) {
+    return false;
+  }
+  if (datagram[0] != 0x00 || datagram[1] != 0x00) {
+    return false;
+  }
+  // A non-zero FRAG means the relay fragmented the datagram. Reassembly is
+  // optional in RFC 1928 §7 and reassembling one datagram out of several
+  // would need a timer no relay in practice exercises, so it is dropped.
+  if (datagram[2] != 0x00) {
+    return false;
+  }
+  size_t address_length = 0;
+  switch (datagram[3]) {
+    case kAddressTypeIPv4:
+      address_length = 4u;
+      break;
+    case kAddressTypeIPv6:
+      address_length = 16u;
+      break;
+    case kAddressTypeDomain:
+      // The sender has to become an IPEndPoint for WebRTC to match it against
+      // a candidate, and a name cannot.
+      return false;
+    default:
+      return false;
+  }
+  const size_t header_length = kHeaderPrefixSize + address_length + kPortSize;
+  if (datagram.size() < header_length) {
+    return false;
+  }
+  const size_t payload_length = datagram.size() - header_length;
+  // A header-only datagram carries nothing. Stock Chromium already discards a
+  // zero-length one: P2PSocketUdp::HandleReadResult only delivers a positive
+  // result, so dropping it here is the same observable behaviour with one
+  // fewer round trip.
+  if (payload_length == 0 || payload_length > read_user_buffer_len_) {
+    return false;
+  }
+  // The sender the relay reports, which is what WebRTC treats as the remote
+  // address of this packet.
+  *read_user_address_ = IPEndPoint(
+      IPAddress(datagram.subspan(kHeaderPrefixSize, address_length)),
+      ReadPort(datagram.subspan(kHeaderPrefixSize + address_length,
+                                kPortSize)));
+  read_user_buffer_->span().first(payload_length).copy_from(
+      datagram.subspan(header_length, payload_length));
+  *out_result = base::checked_cast<int>(payload_length);
+  return true;
+}
+
+void SOCKS5DatagramServerSocket::ClearReadState() {
+  read_user_buffer_ = nullptr;
+  read_user_buffer_len_ = 0;
+  read_user_address_ = nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// Send
+// ---------------------------------------------------------------------------
+
+int SOCKS5DatagramServerSocket::SendTo(IOBuffer* buf,
+                                       int buf_len,
+                                       const IPEndPoint& address,
+                                       CompletionOnceCallback callback) {
+  if (latched_error_ != OK) {
+    return latched_error_;
+  }
+  if (!associated_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  CHECK_GT(buf_len, 0);
+  CHECK(send_user_callback_.is_null());
+  const std::vector<uint8_t> header = BuildDatagramHeader(address);
+  if (header.empty()) {
+    return ERR_ADDRESS_INVALID;
+  }
+  const size_t payload_len = static_cast<size_t>(buf_len);
+  const size_t framed_len = header.size() + payload_len;
+  if (!send_frame_buffer_ ||
+      static_cast<size_t>(send_frame_buffer_->size()) < framed_len) {
+    send_frame_buffer_ = base::MakeRefCounted<IOBufferWithSize>(framed_len);
+  }
+  // The caller's buffer must not be modified, so the frame is assembled here.
+  base::span<uint8_t> frame = send_frame_buffer_->span();
+  frame.first(header.size()).copy_from(base::span<const uint8_t>(header));
+  frame.subspan(header.size(), payload_len)
+      .copy_from(buf->span().first(payload_len));
+
+  send_payload_len_ = payload_len;
+  send_framed_len_ = framed_len;
+  send_user_callback_ = std::move(callback);
+  int rv = datagram_socket_->SendTo(
+      send_frame_buffer_.get(), base::checked_cast<int>(framed_len),
+      relay_endpoint_,
+      base::BindOnce(&SOCKS5DatagramServerSocket::OnDatagramSendComplete,
+                     weak_factory_.GetWeakPtr()));
+  if (rv == ERR_IO_PENDING) {
+    return ERR_IO_PENDING;
+  }
+  send_user_callback_.Reset();
+  return TranslateSendResult(rv);
+}
+
+void SOCKS5DatagramServerSocket::OnDatagramSendComplete(int result) {
+  if (send_user_callback_.is_null()) {
+    return;
+  }
+  CompletionOnceCallback callback = std::move(send_user_callback_);
+  std::move(callback).Run(TranslateSendResult(result));
+}
+
+int SOCKS5DatagramServerSocket::TranslateSendResult(int result) const {
+  if (result < 0) {
+    return result;
+  }
+  // The count must be in the caller's frame of reference, or the sender sees a
+  // short write for a packet that was in fact sent whole.
+  if (static_cast<size_t>(result) != send_framed_len_) {
+    // A datagram goes whole or not at all, and the tail of a framed packet
+    // cannot be resent because it carries no header.
+    return ERR_MSG_TOO_BIG;
+  }
+  return base::checked_cast<int>(send_payload_len_);
+}
+
+// ---------------------------------------------------------------------------
+// Addresses and options
+// ---------------------------------------------------------------------------
+
+void SOCKS5DatagramServerSocket::Close() {
+  next_state_ = STATE_NONE;
+  associated_ = false;
+  listening_ = false;
+  connect_callback_.Reset();
+  // A read or send in flight is abandoned without running its callback, which
+  // is what Close() means for every other socket.
+  read_user_callback_.Reset();
+  send_user_callback_.Reset();
+  ClearReadState();
+  resolve_request_.reset();
+  control_write_buf_.reset();
+  control_read_buf_.reset();
+  control_watch_buf_.reset();
+  // Destroying the control connection is what ends the association.
+  if (control_socket_) {
+    control_socket_->Disconnect();
+    control_socket_.reset();
+  }
+  datagram_socket_->Close();
+}
+
+int SOCKS5DatagramServerSocket::GetPeerAddress(IPEndPoint* address) const {
+  // An association has no single peer: every datagram names its own.
+  return ERR_SOCKET_NOT_CONNECTED;
+}
+
+int SOCKS5DatagramServerSocket::GetLocalAddress(IPEndPoint* address) const {
+  if (!associated_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  // The relay endpoint, never the bound socket's own address. This is the
+  // address this socket's traffic reaches the network from, and the caller
+  // publishes it: returning the real local address here is precisely the leak
+  // this class exists to close.
+  *address = relay_endpoint_;
+  return OK;
+}
+
+void SOCKS5DatagramServerSocket::UseNonBlockingIO() {
+  datagram_socket_->UseNonBlockingIO();
+}
+
+int SOCKS5DatagramServerSocket::SetDoNotFragment() {
+  // Applies to the outer datagram on the client-to-relay hop, which is the hop
+  // whose MTU this host can discover.
+  return datagram_socket_->SetDoNotFragment();
+}
+
+int SOCKS5DatagramServerSocket::SetRecvTos() {
+  // Deliberately not enabled on the inner socket. The TOS byte of a relayed
+  // datagram belongs to the relay-to-client hop; reporting it as the sender's
+  // would be worse than reporting none, so GetLastTos() reports ECN_NOT_ECT.
+  return OK;
+}
+
+int SOCKS5DatagramServerSocket::SetTos(DiffServCodePoint dscp,
+                                       EcnCodePoint ecn) {
+  // The DSCP of the outer datagram is this host's to set. The ECN bits are
+  // not: a relay re-originates the inner packet and cannot carry them.
+  return datagram_socket_->SetTos(dscp, ECN_NO_CHANGE);
+}
+
+void SOCKS5DatagramServerSocket::SetMsgConfirm(bool confirm) {
+  datagram_socket_->SetMsgConfirm(confirm);
+}
+
+const NetLogWithSource& SOCKS5DatagramServerSocket::NetLog() const {
+  // No new NetLog source or event type is introduced for the relay, so a
+  // net-export capture gains no field and in particular none holding the relay
+  // address or a credential.
+  return datagram_socket_->NetLog();
+}
+
+DscpAndEcn SOCKS5DatagramServerSocket::GetLastTos() const {
+  return DscpAndEcn{DSCP_DEFAULT, ECN_NOT_ECT};
+}
