+// A DatagramServerSocket that relays every datagram through a SOCKS5 proxy
+// using RFC 1928 UDP ASSOCIATE.
+//
+// This is the many-destinations counterpart of SOCKS5DatagramClientSocket. That
+// class serves QUIC, which talks to exactly one destination, so it derives its
+// per-datagram header once at construction. A peer connection sends to a STUN
+// server, a TURN server and every remote candidate over one socket and receives
+// from all of them, so here the header is built per SendTo() from the caller's
+// destination and parsed per RecvFrom() to recover the sender. An association
+// is a send-to-anyone, receive-from-anyone datagram relay, which is exactly the
+// shape a P2P socket needs.
+//
+// It owns two sockets. The TCP control socket carries the greeting, the
+// optional RFC 1929 authentication and the UDP ASSOCIATE request; RFC 1928 §7
+// ties the association's lifetime to that connection, so it is held open for as
+// long as this socket exists and nothing is ever written on it after the
+// ASSOCIATE reply. The datagram socket, supplied by the caller and therefore a
+// stock UDPServerSocket, carries the data.
+//
+// Addresses:
+//  - Listen() binds the datagram socket to the wildcard address of the
+//    requested family on an ephemeral port, whatever address was asked for. A
+//    specific interface address may have no route to the proxy, and the port a
+//    page is told is the relay's, so pinning a local one buys nothing.
+//  - GetLocalAddress() returns the relay endpoint from the ASSOCIATE reply,
+//    because that is the address this socket's traffic reaches the network
+//    from. It is what becomes the host ICE candidate, and it is a proxy address
+//    rather than one of this host's.
+//  - GetPeerAddress() fails: an association has no single peer.
+//
+// Datagrams whose source is not the relay are dropped. They carry no RFC 1928
+// header, so they cannot be deframed, and nothing else has any business
+// arriving on a port only the relay was told about.
+//
+// Credentials are launch-only transport state. They are held by this socket and
+// nowhere else; no NetLog parameter sees them, and this class introduces no
+// NetLog event type of its own.
+class NET_EXPORT_PRIVATE SOCKS5DatagramServerSocket
+    : public DatagramServerSocket {
+ public:
+  // `datagram_socket` is the unbound socket that will carry the relayed
+  // datagrams. `client_socket_factory` creates the TCP control socket and
+  // `host_resolver` resolves `proxy`, which may be a name; both must outlive
+  // this socket. `network_anonymization_key` keys that resolution.
+  SOCKS5DatagramServerSocket(
+      std::unique_ptr<DatagramServerSocket> datagram_socket,
+      ClientSocketFactory* client_socket_factory,
+      HostResolver* host_resolver,
+      const NetworkAnonymizationKey& network_anonymization_key,
+      const HostPortPair& proxy,
+      std::optional<SOCKS5Credentials> credentials,
+      const NetworkTrafficAnnotationTag& traffic_annotation);
+
+  SOCKS5DatagramServerSocket(const SOCKS5DatagramServerSocket&) = delete;
+  SOCKS5DatagramServerSocket& operator=(const SOCKS5DatagramServerSocket&) =
+      delete;
+
+  ~SOCKS5DatagramServerSocket() override;
+
+  // DatagramSocket implementation.
+  void Close() override;
+  int GetPeerAddress(IPEndPoint* address) const override;
+  int GetLocalAddress(IPEndPoint* address) const override;
+  void UseNonBlockingIO() override;
+  int SetDoNotFragment() override;
+  int SetRecvTos() override;
+  int SetTos(DiffServCodePoint dscp, EcnCodePoint ecn) override;
+  void SetMsgConfirm(bool confirm) override;
+  const NetLogWithSource& NetLog() const override;
+  DscpAndEcn GetLastTos() const override;
+
+  // DatagramServerSocket implementation.
+  int Listen(const IPEndPoint& address) override;
+  int RecvFrom(IOBuffer* buf,
+               int buf_len,
+               IPEndPoint* address,
+               CompletionOnceCallback callback) override;
+  int SendTo(IOBuffer* buf,
+             int buf_len,
+             const IPEndPoint& address,
+             CompletionOnceCallback callback) override;
+  int SetReceiveBufferSize(int32_t size) override;
+  int SetSendBufferSize(int32_t size) override;
+  void AllowAddressReuse() override;
+  void AllowBroadcast() override;
+  void AllowAddressSharingForMulticast() override;
+  int JoinGroup(const IPAddress& group_address) const override;
+  int LeaveGroup(const IPAddress& group_address) const override;
+  int SetMulticastInterface(uint32_t interface_index) override;
+  int SetMulticastTimeToLive(int time_to_live) override;
+  int SetMulticastLoopbackMode(bool loopback) override;
+  int SetDiffServCodePoint(DiffServCodePoint dscp) override;
+  void DetachFromThread() override;
+  int ConnectRelay(CompletionOnceCallback callback) override;
+
+  // The relay endpoint learned from the ASSOCIATE reply. Test-only; nothing
+  // logs it.
+  const IPEndPoint& relay_endpoint_for_testing() const {
+    return relay_endpoint_;
+  }
+
+ private:
+  enum State {
+    STATE_NONE,
+    STATE_RESOLVE_PROXY,
+    STATE_RESOLVE_PROXY_COMPLETE,
+    STATE_CONTROL_CONNECT,
+    STATE_CONTROL_CONNECT_COMPLETE,
+    STATE_GREET_WRITE,
+    STATE_GREET_WRITE_COMPLETE,
+    STATE_GREET_READ,
+    STATE_GREET_READ_COMPLETE,
+    STATE_AUTH_WRITE,
+    STATE_AUTH_WRITE_COMPLETE,
+    STATE_AUTH_READ,
+    STATE_AUTH_READ_COMPLETE,
+    STATE_ASSOCIATE_WRITE,
+    STATE_ASSOCIATE_WRITE_COMPLETE,
+    STATE_ASSOCIATE_READ,
+    STATE_ASSOCIATE_READ_COMPLETE,
+  };
+
+  void OnIOComplete(int result);
+  int DoLoop(int last_io_result);
+  int DoResolveProxy();
+  int DoResolveProxyComplete(int result);
+  int DoControlConnect();
+  int DoControlConnectComplete(int result);
+  int DoGreetWrite();
+  int DoGreetWriteComplete(int result);
+  int DoGreetRead();
+  int DoGreetReadComplete(int result);
+  int DoAuthWrite();
+  int DoAuthWriteComplete(int result);
+  int DoAuthRead();
+  int DoAuthReadComplete(int result);
+  int DoAssociateWrite();
+  int DoAssociateWriteComplete(int result);
+  int DoAssociateRead();
+  int DoAssociateReadComplete(int result);
+
+  // Sends `bytes` on the control connection, looping until it is drained.
+  // `write_complete_state` handles a partial write; `done_state` runs once the
+  // whole buffer is out.
+  int StartControlWrite(std::vector<uint8_t> bytes,
+                        State write_complete_state,
+                        State done_state);
+  int ContinueControlWrite(State write_complete_state, State done_state);
+
+  // Reads up to `capacity` bytes of a reply, resuming into the same buffer on
+  // a partial read. Returns a net error or ERR_IO_PENDING.
+  int StartControlRead(size_t capacity, State complete_state);
+  int ContinueControlRead(State complete_state);
+
+  // Additional bytes the ASSOCIATE reply needs beyond its five-byte prefix, or
+  // std::nullopt when the prefix is malformed.
+  std::optional<size_t> AssociateReplyRemainder() const;
+
+  // Fills `relay_endpoint_` from a complete ASSOCIATE reply, applying the same
+  // substitution rules as SOCKS5DatagramClientSocket. Returns a net error.
+  int ResolveRelayEndpoint();
+
+  // Starts the single outstanding read that watches the control connection for
+  // closure. It never completes under normal operation.
+  void StartControlWatch();
+  void OnControlWatchComplete(int result);
+
+  // Records a terminal error and fails a pending read with it. A send into a
+  // dead association must fail rather than appear to succeed.
+  void LatchError(int error);
+
+  int ReadLoop();
+  void OnDatagramReadComplete(int result);
+  // Returns true when `*out_result` is final, false when the datagram was
+  // dropped and another read must be issued.
+  bool Deframe(int result, int* out_result);
+  void ClearReadState();
+
+  void OnDatagramSendComplete(int result);
+  int TranslateSendResult(int result) const;
+
+  // The socket that carries data. Supplied by the caller, never replaced.
+  const std::unique_ptr<DatagramServerSocket> datagram_socket_;
+  // Creates the TCP control socket. Not owned.
+  const raw_ptr<ClientSocketFactory> client_socket_factory_;
+  // Resolves `proxy_`. Not owned.
+  const raw_ptr<HostResolver> host_resolver_;
+  // Holds the association open. Destroying it ends the association.
+  std::unique_ptr<StreamSocket> control_socket_;
+
+  const NetworkAnonymizationKey network_anonymization_key_;
+  const HostPortPair proxy_;
+  const std::optional<SOCKS5Credentials> credentials_;
+  const NetworkTrafficAnnotationTag traffic_annotation_;
+
+  State next_state_ = STATE_NONE;
+  bool listening_ = false;
+  bool associated_ = false;
+  int latched_error_ = OK;
+
+  // The family Listen() bound, which the proxy must be reachable over.
+  AddressFamily listen_family_ = ADDRESS_FAMILY_UNSPECIFIED;
+
+  std::unique_ptr<HostResolver::ResolveHostRequest> resolve_request_;
+  IPEndPoint proxy_endpoint_;
+  IPEndPoint relay_endpoint_;
+
+  CompletionOnceCallback connect_callback_;
+
+  scoped_refptr<DrainableIOBuffer> control_write_buf_;
+  scoped_refptr<GrowableIOBuffer> control_read_buf_;
+  scoped_refptr<IOBufferWithSize> control_watch_buf_;
+
+  // Read state. `read_user_address_` is the caller's out-parameter and the
+  // caller keeps it alive until the callback runs.
+  raw_ptr<IOBuffer> read_user_buffer_ = nullptr;
+  size_t read_user_buffer_len_ = 0;
+  raw_ptr<IPEndPoint> read_user_address_ = nullptr;
+  CompletionOnceCallback read_user_callback_;
+  scoped_refptr<IOBufferWithSize> read_frame_buffer_;
+  IPEndPoint read_frame_address_;
+
+  // Send state.
+  scoped_refptr<IOBufferWithSize> send_frame_buffer_;
+  size_t send_payload_len_ = 0;
+  size_t send_framed_len_ = 0;
+  CompletionOnceCallback send_user_callback_;
+
+  base::WeakPtrFactory<SOCKS5DatagramServerSocket> weak_factory_{this};
+};
+
