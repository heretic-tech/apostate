   // Resets the thread to be used for thread-safety checks.
   virtual void DetachFromThread() = 0;
+
+  // Completes any out-of-band setup this socket needs after Listen() before
+  // GetLocalAddress() is meaningful and datagrams can flow. The RFC 1928 UDP
+  // association of a SOCKS5 relay is the case this exists for: the relay's
+  // address is not known until the proxy has answered, and that answer takes
+  // three round trips.
+  //
+  // Returns a network error code, or ERR_IO_PENDING and runs |callback|. The
+  // default reports OK, because a plain UDP socket is ready to send and
+  // report its address as soon as it is bound.
+  virtual int ConnectRelay(CompletionOnceCallback callback);
 };
 
