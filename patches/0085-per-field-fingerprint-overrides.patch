 };
 
+// The per-field overrides a launch asked for, already parsed and range
+// checked. An empty string or an absent optional means "the seed decides".
+//
+// These are not a second identity layer. Each one lands on a profile the seed
+// composed in full, which is why an override cannot leave a device
+// half-specified: everything it does not name is still drawn from the same
+// root.
+struct BASE_EXPORT FieldOverrides {
+  // Restrict the gpu_identity draw to a measured member of the resolved
+  // anchor. Either alone is enough; the vendor on its own narrows a
+  // multi-vendor anchor and leaves the choice among what is left to the seed.
+  std::string gpu_vendor;
+  std::string gpu_renderer;
+
+  std::optional<int> logical_cores;
+  std::optional<uint64_t> memory_bytes;
+  std::optional<int> screen_width;
+  std::optional<int> screen_height;
+
+  std::string timezone;
+  // The Accept-Language list, e.g. "en-US,en". Re-keys the voices table too,
+  // which is why it is applied before that axis resolves rather than merged
+  // over the finished profile.
+  std::string accept_languages;
+};
+
 struct BASE_EXPORT ComposeRequest {
   // Never empty: --fingerprint=host is handled before composition starts.
   std::string seed;
@@ -214,6 +265,8 @@
 
   // Used when `accept_languages` is empty.
   std::string_view default_accept_languages;
+
+  FieldOverrides overrides;
 };
 
 // Resolves every axis in the §5 dependency order and deep-merges the result.
@@ -222,13 +275,21 @@
 // parents' resolved values, so there is no rejection sampling and no re-draw:
 // every profile is coherent by construction rather than by validation.
 //
-// Returns nullopt only when the request itself is unusable (no seed, no
-// platform persona the tables know). A coherence violation after resolution is
-// a defect in the compiled option tables and is fatal, because the generator
-// rejects all of them at build time -- reaching one at runtime means the
-// binary shipped with a broken catalogue, and a half-composed fingerprint is
