+// tables and is fatal, because the generator rejects all of them at build time
+// -- reaching one at runtime means the binary shipped with a broken
+// catalogue, and a half-composed fingerprint is more detectable than none.
+BASE_EXPORT std::optional<Composition> Compose(const ComposeRequest& request,
+                                               std::string* rejection = nullptr);
 
 // Deep-merges `overlay` into `target`.
