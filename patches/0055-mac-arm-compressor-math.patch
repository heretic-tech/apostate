+
+// Scalar range reduction for the Mac ARM audio math policy. The hexadecimal
+// constants and explicit double FMA order preserve the target rounding.
+// These tables reduce arbitrary inputs; they contain no audio output data.
+inline bool FlushInputs() {
+#if defined(ARCH_CPU_ARM64)
+  uint64_t control;
+  asm volatile("mrs %0, fpcr" : "=r"(control));
+  return control & (uint64_t{1} << 24);
+#elif defined(ARCH_CPU_ARM_FAMILY)
+  uint32_t control;
+  asm volatile("vmrs %0, fpscr" : "=r"(control));
+  return control & (uint32_t{1} << 24);
+#elif defined(ARCH_CPU_X86_FAMILY)
+  return _mm_getcsr() & 0x40;
+#else
+  return false;
+#endif
+}
+
+ALWAYS_INLINE float Log10(float value) {
+  uint32_t word = std::bit_cast<uint32_t>(value);
+  if (word - 0x00800000u >= 0x7f000000u) {
+    const uint32_t magnitude = word & 0x7fffffffu;
+    if (magnitude > 0x7f800000u) {
+      if (!(word & 0x00400000u)) {
+        std::feraiseexcept(FE_INVALID);
+      }
+      return value;
+    }
+    if (magnitude == 0 || (magnitude < 0x00800000u && FlushInputs())) {
+      std::feraiseexcept(FE_DIVBYZERO);
+      return -std::numeric_limits<float>::infinity();
+    }
+    if (word & 0x80000000u) {
+      std::feraiseexcept(FE_INVALID);
+      return std::bit_cast<float>(0x7fc00000u);
+    }
+    if (magnitude == 0x7f800000u) {
+      return value;
+    }
+    // Normalize the integer mantissa without losing subnormal input bits.
+    const float normalized = std::bit_cast<float>(word | 0x3f800000u) - 1.f;
+    word = std::bit_cast<uint32_t>(normalized) - 0x3f000000u;
+  }
+  struct Entry {
+    double reciprocal;
+    double logarithm;
+  };
+  static constexpr std::array<Entry, 65> kTable = {{
