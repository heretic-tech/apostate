+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ARM_AUDIO_MATH_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ARM_AUDIO_MATH_H_
