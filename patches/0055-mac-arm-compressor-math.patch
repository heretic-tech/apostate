+      {0x1.135c81135efedp-1, -0x1.0362241e83be8p-5},
+      {0x1.1111111104099p-1, -0x1.cb38fccc387a4p-6},
+      {0x1.0ecf56be75b6ep-1, -0x1.902c31d763f47p-6},
+      {0x1.0c9714fbdd2a2p-1, -0x1.559bd2420786bp-6},
+      {0x1.0a6810a68f2a2p-1, -0x1.1b85d605c7d78p-6},
+      {0x1.084210841501dp-1, -0x1.c3d08374fd2e0p-7},
+      {0x1.0624dd2f253e0p-1, -0x1.51824c77c8587p-7},
+      {0x1.04104104183eep-1, -0x1.c03a80b1c8a49p-8},
+      {0x1.0204081017ac2p-1, -0x1.be76bd7050239p-9},
+      {0x1.0000000000000p-1, 0x0.0p+0},
+  }};
+  const int exponent = std::bit_cast<int32_t>(word + 0xc0c10000u) >> 23;
+  const uint32_t mantissa = word & 0x007fffffu;
+  const unsigned index = (mantissa + 0x00010000u) >> 17;
+  const double fraction = std::bit_cast<float>(mantissa | 0x3f800000u);
+  const double residual = std::fma(fraction, kTable[index].reciprocal, -1.0);
+  double polynomial = std::fma(residual, -0x1.bcbea4c258daap-4,
+                               0x1.287d3dcaf476dp-3);
+  polynomial = std::fma(residual, polynomial, -0x1.bcb7b14dcbd85p-3);
+  polynomial = std::fma(residual, polynomial, 0x1.bcb7b151bc6b3p-2);
+  const double base = std::fma(static_cast<double>(exponent),
+                               0x1.34413509f79ffp-2, kTable[index].logarithm);
+  return static_cast<float>(std::fma(residual, polynomial, base));
+}
+
+ALWAYS_INLINE float Exp10(float value) {
+  const uint32_t word = std::bit_cast<uint32_t>(value);
+  const uint32_t magnitude = word & 0x7fffffffu;
+  if (magnitude >= 0x42800000u) {
+    if ((word & 0x80000000u) && magnitude <= 0x7f800000u) {
+      if (magnitude != 0x7f800000u) {
+        std::feraiseexcept(FE_UNDERFLOW | FE_INEXACT);
+      }
+      return 0.f;
+    }
+    return value * std::numeric_limits<float>::max();
+  }
+  static constexpr std::array<double, 128> kTable = {{
+      0x1.0000000000000p+0,
+      0x1.0163da9fb3335p+0,
