+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/host_capability.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/system/sys_info.h"
+#include "build/build_config.h"
+
+namespace base::apostate {
+
+namespace {
+
+// Switch names spelled as literals because base/ cannot include ui/gl or
+// chrome/common. Both are stable, both are cited, and neither is readable by
+// web content.
+//
+// "use-angle": ui/gl/gl_switches.cc kUseANGLE, with the backend value names
+// from kANGLEImplementation*Name in the same file.
+// "window-size": chrome/common/chrome_switches.cc kWindowSize, "w,h" in DIP.
+constexpr char kUseANGLESwitch[] = "use-angle";
+constexpr char kWindowSizeSwitch[] = "window-size";
+
+// The backend ANGLE selects when nothing overrides it.
+//
+// Grounded in this project's own T0 captures rather than asserted: the corpus
+// anchors record ANGLE/Metal on macOS, ANGLE/D3D11 on Windows and
+// ANGLE/Vulkan on Linux at the pinned Chromium version. It is an inference
+// about *this* launch, though, which is why HostCapability marks it as one.
+std::string PlatformDefaultBackend() {
+#if BUILDFLAG(IS_MAC)
+  return "metal";
+#elif BUILDFLAG(IS_WIN)
+  return "d3d11";
+#elif BUILDFLAG(IS_LINUX)
+  return "vulkan";
+#else
+  return std::string();
+#endif
+}
+
+std::string HostPlatformToken() {
+#if BUILDFLAG(IS_MAC)
+  return "macos";
+#elif BUILDFLAG(IS_WIN)
+  return "windows";
+#elif BUILDFLAG(IS_LINUX)
+  return "linux";
+#else
+  return std::string();
+#endif
+}
+
+// Maps a --use-angle value onto an Anchor::backend token.
+//
+// Only the values that name a backend an anchor could have been captured
+// through are mapped. "default" and the null/warp test backends deliberately
+// fall through to the platform default: pretending a null backend can serve a
+// measured capability cluster would make an unservable anchor selectable,
+// which is the §4 failure this whole model exists to avoid.
+std::string_view BackendFromANGLEValue(std::string_view value) {
+  if (value == "metal") {
+    return "metal";
+  }
+  if (value == "d3d11" || value == "d3d11on12") {
+    return "d3d11";
+  }
+  if (value == "d3d9") {
+    return "d3d9";
+  }
+  if (value == "vulkan") {
+    return "vulkan";
+  }
+  if (value == "gl" || value == "gl-egl" || value == "gles" ||
+      value == "gles-egl") {
+    return "gl";
+  }
+  if (value == "swiftshader" || value == "swiftshader-webgl") {
+    return "swiftshader";
+  }
+  return std::string_view();
+}
+
+}  // namespace
+
+HostCapability ProbeHostCapability(const CommandLine& command_line) {
+  HostCapability host;
+
+  host.logical_cores = SysInfo::NumberOfProcessorsImpl();
+  host.total_memory_bytes = SysInfo::AmountOfTotalPhysicalMemory().InBytes();
+  host.platform = HostPlatformToken();
+
+  host.graphics_backend = PlatformDefaultBackend();
+  if (command_line.HasSwitch(kUseANGLESwitch)) {
+    const std::string requested =
+        command_line.GetSwitchValueASCII(kUseANGLESwitch);
+    const std::string_view mapped = BackendFromANGLEValue(requested);
+    if (!mapped.empty()) {
+      host.graphics_backend = std::string(mapped);
+      host.graphics_backend_is_inferred = false;
+    }
+  }
+
+  if (command_line.HasSwitch(kWindowSizeSwitch)) {
+    const std::string value = command_line.GetSwitchValueASCII(kWindowSizeSwitch);
+    const std::vector<std::string_view> parts =
+        SplitStringPiece(value, ",", TRIM_WHITESPACE, SPLIT_WANT_NONEMPTY);
+    int width = 0;
+    int height = 0;
+    if (parts.size() == 2 && StringToInt(parts[0], &width) &&
+        StringToInt(parts[1], &height) && width > 0 && height > 0) {
+      host.window_width = width;
+      host.window_height = height;
+    }
+  }
+
+  return host;
+}
+
+int ClampLogicalCores(int claimed, int host) {
+  if (host <= 0) {
+    return claimed;
+  }
+  return claimed > host ? host : claimed;
+}
+
+uint64_t ClampMemoryBytes(uint64_t claimed, uint64_t host) {
+  if (host == 0) {
+    return claimed;
+  }
+  return claimed > host ? host : claimed;
+}
+
+}  // namespace base::apostate

