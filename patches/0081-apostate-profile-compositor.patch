@@ -0,0 +1,76 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_SEED_H_
+#define BASE_APOSTATE_SEED_H_
+
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base {
+
+class CommandLine;
+
+namespace apostate {
+
+// Where the seed for this launch came from.
+enum class SeedOrigin {
+  // --fingerprint=<seed>. Reproducible on any machine, with nothing on disk.
+  kSwitch,
+  // Drawn from OS entropy for this launch and kept nowhere. The default.
+  kGenerated,
+  // --fingerprint=host, and its off/false/0/disable/disabled spellings. No
+  // composition at all; every layer below it is off.
+  kHostInheritance,
+};
+
+struct BASE_EXPORT SeedResolution {
+  // Empty when `origin` is kHostInheritance.
+  std::string seed;
+  SeedOrigin origin = SeedOrigin::kHostInheritance;
+  // Non-empty when the launch asked for something it did not get. Reported by
+  // --fingerprint-explain, never silently swallowed.
+  std::string limitation;
+  // The launch named an identity that cannot be honoured. The caller must
+  // refuse the launch and say why, rather than falling back: a --fingerprint
+  // typo that quietly presents the operator's real machine is the worst
+  // outcome this code can produce, and it is indistinguishable from success
+  // until a site has already clustered the real device.
+  bool rejected = false;
+
+  bool should_compose() const { return origin != SeedOrigin::kHostInheritance; }
+};
+
+// Resolves the seed for this launch.
+//
+// Precedence, strongest first: an explicit --fingerprint, then 32 bytes of OS
+// entropy drawn for this launch alone. A reserved off value short-circuits
+// both and composes nothing.
+//
+// The seed's lifetime is the launch, not the user-data directory. A bare
+// launch is a different coherent device every time, which is what someone who
+// runs the binary with no arguments expects and what the launch contract
+// promises. An identity that has to stay the same across launches is asked for
+// by name, with --fingerprint=<seed>, and that is strictly better than a file:
+// it reproduces on another machine, in another container, and in a colleague's
+// shell, none of which a file does.
+//
+// There is deliberately no persisted seed. A seed file would make the default
+// identity depend on whether a directory happened to exist -- the same launch
+// random in a temporary directory and sticky in a named one -- and it would
+// write the entire identity to disk, where a copied profile, a backup or a
+// synced directory carries it, and where it survives the clear-everything a
+// user believes clears their identity.
+//
+// Pure: no filesystem, no globals, no ordering requirement beyond a populated
+// command line. That is what lets patch 0084 resolve the seed from a startup
+// hook in a process that may still turn out to be a second instance and exit
+// immediately: deciding an identity leaves no trace to undo.
+BASE_EXPORT SeedResolution ResolveSeed(const CommandLine& command_line);
+
+}  // namespace apostate
+}  // namespace base
+
+#endif  // BASE_APOSTATE_SEED_H_
