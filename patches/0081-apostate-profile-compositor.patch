+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_EXPLAIN_H_
+#define BASE_APOSTATE_EXPLAIN_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/base_export.h"
+
+namespace base::apostate {
+
+struct Composition;
+struct HostCapability;
+struct SeedResolution;
+
+// The --fingerprint-explain report: per surface, the resolved value, the layer
+// that owns it, the evidence class, and any limitation.
+//
+// It is the honest answer to "what does this profile actually claim, and what
+// can this host actually serve" -- and on a cross-platform launch it is where
+// the GPU-cluster mismatch is reported rather than hidden.
+//
+// Writes to stdout and never to a page-visible API. A page cannot read stdout,
+// and nothing here is exposed through any web surface: the report exists so an
+// operator can audit a launch, which is the opposite of a new observable.
+BASE_EXPORT std::string FormatExplainReport(const Composition& composition,
+                                            const HostCapability& host);
+
+// Formats and writes the report to stdout.
+BASE_EXPORT void WriteExplainReport(const Composition& composition,
+                                    const HostCapability& host);
+
+// The report for a launch that composes nothing, so that
+// `--fingerprint=host --fingerprint-explain` still answers the question rather
+// than printing nothing.
+BASE_EXPORT std::string FormatHostInheritanceReport(
+    const SeedResolution& seed);
+BASE_EXPORT void WriteHostInheritanceReport(const SeedResolution& seed);
+
+// Writes one refusal to stderr and exits non-zero.
+//
+// Straight to the stream rather than through LOG(ERROR), because a launch
+// refusal has to be readable before logging is configured and whatever
+// --enable-logging says: the operator asked for an identity this binary will
+// not present, and the only useful outcome is that they read why. Stderr is
+// not a web surface; a page cannot observe that anything was written.
+//
+// It exits rather than returning because every caller would otherwise have to
+// remember to, and the one that forgot would present a different device than
+// the one the launch asked for while reporting nothing.
+[[noreturn]] BASE_EXPORT void RefuseLaunch(std::string_view reason);
+
+}  // namespace base::apostate
+
+#endif  // BASE_APOSTATE_EXPLAIN_H_
