+
+# Apostate: compile the dispersion tables and the GPU anchors into the binary.
+#
+# FINGERPRINTS.md §10 rejects reading them from disk at runtime: a data
+# directory beside the executable is one more thing to lose, to mismatch
+# against the binary, and to diverge per install. The SHA-256 of the generator's
+# inputs is compiled in beside them, so --fingerprint-explain can answer whether
+# a binary and a profile came from the same catalogue.
+#
+# The table files live in the Apostate repository that drives this checkout, so
+# the input list is discovered when the action runs rather than at `gn gen`
+# time and ninja learns it from the depfile. Editing a table therefore
+# regenerates the tables without reconfiguring.
+action("apostate_dispersion_tables") {
+  script = "apostate/generate_dispersion_tables.py"
+  outputs = [
+    "$target_gen_dir/apostate/dispersion_tables.cc",
+    "$target_gen_dir/apostate/dispersion_tables.h",
+  ]
+  depfile = "$target_gen_dir/apostate/dispersion_tables.d"
+  args = [
+    "--out-cc",
+    rebase_path(outputs[0], root_build_dir),
+    "--out-h",
+    rebase_path(outputs[1], root_build_dir),
+    "--depfile",
+    rebase_path(depfile, root_build_dir),
+  ]
+}
