+// found in the LICENSE file.
+
+#include "base/apostate/dispersion_table.h"
+
+#include <string_view>
+
+#include "base/containers/span.h"
+
+namespace base::apostate {
+
+const DispersionOptionSet* DispersionAxis::FindOptionSet(
+    span<const ConditionKey> resolved) const {
+  for (const DispersionOptionSet& candidate : option_sets) {
+    if (candidate.key.size() != resolved.size()) {
+      continue;
+    }
+    // Exact and total: every name in the key must appear in `resolved` with the
+    // same value, and the sizes already agree, so this is set equality. Order
+    // is not compared because the caller builds `resolved` from its own
+    // resolution order, which need not be the table's.
+    bool matched = true;
+    for (const ConditionKey& required : candidate.key) {
+      bool found = false;
+      for (const ConditionKey& actual : resolved) {
+        if (actual.name == required.name) {
+          found = actual.value == required.value;
+          break;
+        }
+      }
+      if (!found) {
+        matched = false;
+        break;
+      }
+    }
+    if (matched) {
+      return &candidate;
+    }
+  }
+  return nullptr;
+}
+
+const AnchorMember* Anchor::FindMemberIdentity(
+    std::string_view unmasked_vendor,
+    std::string_view unmasked_renderer) const {
+  for (const AnchorMember& member : members) {
+    if (member.unmasked_vendor == unmasked_vendor &&
+        member.unmasked_renderer == unmasked_renderer) {
+      return &member;
+    }
+  }
+  return nullptr;
+}
+
+const DispersionAxis* FindAxis(span<const DispersionAxis> axes,
+                               std::string_view axis) {
+  for (const DispersionAxis& candidate : axes) {
+    if (candidate.axis == axis) {
+      return &candidate;
+    }
+  }
+  return nullptr;
+}
+
+const Anchor* FindAnchor(span<const Anchor> anchors, std::string_view id) {
+  for (const Anchor& candidate : anchors) {
+    if (candidate.id == id) {
+      return &candidate;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace base::apostate
diff --git a/base/apostate/dispersion_table.h b/base/apostate/dispersion_table.h
new file mode 100644
index 0000000..c49a16c
--- /dev/null
+++ b/base/apostate/dispersion_table.h
@@ -0,0 +1,190 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_DISPERSION_TABLE_H_
+#define BASE_APOSTATE_DISPERSION_TABLE_H_
+
+#include <cstdint>
+#include <string_view>
+
+#include "base/base_export.h"
+#include "base/containers/span.h"
+
+namespace base::apostate {
+
+// The in-memory shape of one dispersion option table, as compiled in by
+// scripts/generate-dispersion-tables.py. The file shape these mirror is
+// documented in the dispersion-table-shape contract; this header is the C++
+// side of it and nothing else parses those files.
+//
+// Everything here is a view into static, read-only data with no owner and no
+// lifetime: the tables are `constexpr` arrays in the generated translation
+// unit. There is deliberately no loader and no mutable state, because
+// FINGERPRINTS.md §10 rejects reading the tables from disk at runtime.
+
+// How many options one draw on this axis yields.
+enum class Selection {
+  // Weighted pick of exactly one option, using substream index 0.
+  kSingle,
+  // Every `core` option, plus an independent inclusion decision per `optional`
+  // option using substream indices 1..n. Index 0 is reserved so a `single` and
+  // a `core-plus-subset` axis never collide on the same draw.
+  kCorePlusSubset,
+};
+
+// Which host clamp is applied to the option list *before* drawing. Filtering
+// first rather than correcting afterwards is what keeps §3's "capacity is only
+// ever reduced" a property of the option set, so the drawn index stays
+// meaningful and no re-draw is ever needed.
+enum class Servability {
+  kNone,
+  kClampDown,
+  kWindowBounds,
+  kAnchorMember,
+  kFilesPresent,
+};
+
+enum class PackKind {
+  kNotAPack,
+  kCore,
+  kOptional,
+};
+
+// Preconditions an option states about the host. Zero and empty mean "unset":
+// the generator rejects an unrecognised key outright, so an unset field here
+// always means the table said nothing, never that something was dropped.
+struct Requirement {
+  int min_logical_cores = 0;
+  uint64_t min_total_bytes = 0;
+  int min_width = 0;
+  int min_height = 0;
+  std::string_view anchor;
+  span<const std::string_view> families;
+};
+
+struct DispersionOption {
+  std::string_view id;
+  // Relative real-world prevalence for kSingle; percent in 1..100 for an
+  // optional pack under kCorePlusSubset.
+  uint32_t weight = 0;
+  std::string_view evidence;
+  std::string_view source;
+  PackKind pack_kind = PackKind::kNotAPack;
+  const Requirement* requirement = nullptr;
+  // A partial device profile that validates against config/profile.schema.json
+  // on its own, as canonical JSON. Composition is a deep merge of these in
+  // resolution order, which is why the compositor needs no axis-specific
+  // knowledge of what any value means.
+  std::string_view value_json;
+};
+
+struct ConditionKey {
+  std::string_view name;
+  std::string_view value;
+};
+
+struct DispersionOptionSet {
+  // One entry per name in the axis's `conditioned_on`, in that order. Empty for
+  // a root axis.
+  span<const ConditionKey> key;
+  // File order is significant: the weighted pick resolves an index against
+  // cumulative weights in this order, so reordering reassigns every seed.
+  span<const DispersionOption> options;
+};
+
+struct DispersionAxis {
+  std::string_view axis;
+  // The draw(label, i) substream label. Adding an axis, or changing one axis's
+  // option list, cannot shift another axis's choice precisely because each
+  // keys its own substream.
+  std::string_view label;
+  span<const std::string_view> conditioned_on;
+  Selection selection = Selection::kSingle;
+  Servability servability = Servability::kNone;
+  span<const DispersionOptionSet> option_sets;
+
+  // The single option set whose key equals `resolved`, or null.
+  //
+  // Matching is exact and total: a child's option set is a *function* of its
+  // parents, so zero matches is a defect in the compiled tables rather than a
+  // runtime condition. Callers must not fall back and must not re-draw.
+  const DispersionOptionSet* FindOptionSet(
+      span<const ConditionKey> resolved) const;
+};
+
+struct AnchorMember {
+  std::string_view label;
+  std::string_view unmasked_vendor;
+  std::string_view unmasked_renderer;
+  // This member's measured WebGPU adapter as a profile fragment, empty when it
+  // measured none.
+  //
+  // WebGPU is the one part of a capability cluster that is not anchor-wide:
+  // `capability_cluster.webgpu.uniform` is false for the Linux/Vulkan anchor,
+  // where the two Ada cards report nvidia/lovelace and the RTX 3090 and RTX PRO
+  // 4000 Blackwell returned no adapter at all. Presenting lovelace on a 3090
+  // would be an unmeasured assertion, so an empty fragment leaves WebGPU
+  // host-inherited instead of borrowing a sibling's.
+  std::string_view webgpu_json;
+};
+
+// A measured GPU capability cluster. Atomic by construction: selecting it takes
+// the whole `value_json`, because any mixture of two anchors is a device that
+// does not exist.
+struct Anchor {
+  std::string_view id;
+  std::string_view platform;
+  // Normalised graphics backend: "metal", "d3d11", "d3d9", "vulkan", "gl" or
+  // "swiftshader". Across backends nothing transfers, so this is what host
+  // servability is decided on -- not the platform persona.
+  std::string_view backend;
+  std::string_view vendor;
+  std::string_view evidence;
+  std::string_view webgl1_caps_sha256;
+  std::string_view webgl2_caps_sha256;
+  std::string_view pixels_sha256;
+  uint32_t weight = 1;
+  span<const AnchorMember> members;
+  std::string_view value_json;
+
+  // The member that measured this identity pair, or null.
+  //
+  // Within an anchor the identity strings are rotatable because the members
+  // measurably agree on the GL cluster; across anchors they are not. The
+  // member matters beyond that agreement only for WebGPU, which is why this
+  // returns the member rather than a bool.
+  const AnchorMember* FindMemberIdentity(
+      std::string_view unmasked_vendor,
+      std::string_view unmasked_renderer) const;
+};
+
+// A catalogue policy: locale or theme.
+//
+// Not a dispersion axis. `locale` is launch precedence plus GeoIP and `theme`
+// is not one of the nine axes, so neither has an option table -- but both are
+// drawn by seed from the same root, with all candidates weighted equally, so
+// the compositor needs them in the same compiled form.
+struct PolicyOption {
+  std::string_view id;
+  // "all", or one of "windows", "macos", "linux".
+  std::string_view platform;
+  std::string_view evidence;
+  std::string_view value_json;
+
+  bool AppliesTo(std::string_view persona) const {
+    return platform == "all" || platform == persona;
+  }
+};
+
+// The axis named `axis`, or null when the compiled catalogue has no such table.
+BASE_EXPORT const DispersionAxis* FindAxis(span<const DispersionAxis> axes,
+                                           std::string_view axis);
+
+// The anchor with id `id`, or null.
+BASE_EXPORT const Anchor* FindAnchor(span<const Anchor> anchors,
+                                     std::string_view id);
+
+}  // namespace base::apostate
+
+#endif  // BASE_APOSTATE_DISPERSION_TABLE_H_
