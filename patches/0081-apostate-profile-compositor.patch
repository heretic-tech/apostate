+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_HOST_CAPABILITY_H_
+#define BASE_APOSTATE_HOST_CAPABILITY_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base {
+
+class CommandLine;
+
+namespace apostate {
+
+// What this host can actually serve.
+//
+// This exists because of FINGERPRINTS.md §3: a profile may claim fewer cores
+// than the host has, never more, and the same for memory, display area and the
+// GPU cluster. The reason is falsifiability -- a page can measure parallel
+// throughput, allocate until it fails, or compile a shader at the advertised
+// limit. A claim below host capability survives every one of those probes; a
+// claim above it fails the first.
+struct BASE_EXPORT HostCapability {
+  // The host's real logical processor count, from
+  // SysInfo::NumberOfProcessorsImpl(). Deliberately not NumberOfProcessors(),
+  // which consults the profile and would make the clamp consult its own
+  // output.
+  int logical_cores = 0;
+
+  // Real installed physical memory in bytes.
+  uint64_t total_memory_bytes = 0;
+
+  // Normalised graphics backend, matching Anchor::backend: "metal", "d3d11",
+  // "vulkan", "gl" or "swiftshader".
+  std::string graphics_backend;
+
+  // True when `graphics_backend` is the platform's default rather than an
+  // observed fact. It always is, unless --use-angle named one explicitly.
+  //
+  // A real backend probe requires the GPU process, and the GPU process is a
+  // child: A3 requires the profile to be fully materialised before the first
+  // renderer starts, so no child exists yet when this runs. The platform
+  // default is therefore the best available fact at composition time, and the
+  // explain report says so rather than implying a measurement happened.
+  bool graphics_backend_is_inferred = true;
+
+  // The host OS, as a fingerprint platform token: "windows", "macos" or
+  // "linux". Empty on a platform the model has no persona for.
+  std::string platform;
+
+  // Launch window bounds in DIP, from --window-size. Zero means unconstrained,
+  // in which case the window-bounds servability filter drops nothing.
+  int window_width = 0;
+  int window_height = 0;
+};
+
+// Probes the host. Cheap, no blocking I/O, safe to call before FeatureList
+// exists.
+BASE_EXPORT HostCapability ProbeHostCapability(const CommandLine& command_line);
+
+// Reduces a claim to what the host can serve, and never raises it.
+//
+// Callers use these as the servability *predicate*, not as the value: a result
+// different from the input means the claim is above host capability, and the
+// compositor then leaves that surface host-inherited. Substituting the reduced
+// figure is what the first version of the compositor did, and it published the
+// host's own core count and memory size as the most likely value the binary
+// ever emits, which is the opposite of the intent. The reduction is kept here,
+// in one place, because it is also the rule a per-field override is checked
+// against: a host count of zero or less means "unknown", and an unknown host
+// capability cannot justify refusing anything, so the claim passes through.
+BASE_EXPORT int ClampLogicalCores(int claimed, int host);
+BASE_EXPORT uint64_t ClampMemoryBytes(uint64_t claimed, uint64_t host);
+
+}  // namespace apostate
+}  // namespace base
+
+#endif  // BASE_APOSTATE_HOST_CAPABILITY_H_
