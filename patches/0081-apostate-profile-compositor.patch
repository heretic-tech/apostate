+
+// The fingerprint compositor: the deterministic function
+// (seed, tables, host capability, requested platform) -> profile.
+//
+// It lives here, in the browser process, in C++, and is the only
+// implementation. The bare binary must produce a fingerprint with no
+// arguments, which puts the compositor inside the binary by necessity;
+// reimplementing it in the Python and Node packages would create three sources
+// of truth for one deterministic function and the drift between them would be
+// silent. It already did: three resolvers disagreed on what "no seed" means.
+//
+// Nothing here reaches a value at read time. The profile is fully materialised
+// before the first renderer starts, and nothing inside the session varies.
+
+namespace switches {
+
+// FINGERPRINTS.md §10. Declared here rather than in base_switches.h because
+// they belong to the compositor's launch contract, and because command-line
+// switches are not readable by web content -- carrying them discloses nothing
+// to a page.
+
+// Deterministic seed. An integer or an arbitrary printable string. Absent
+// means a fresh seed for this launch alone, which is the default and the
+// reason the binary spoofs with no arguments at all.
+inline constexpr char kFingerprint[] = "fingerprint";
+
+// The canonical reserved --fingerprint value: inherit the host, compose
+// nothing. `off`, `false`, `0`, `disable` and `disabled` are accepted as
+// synonyms, case-insensitively, because those are the spellings already in
+// people's launch scripts and because reading --fingerprint=off as a literal
+// seed would silently compose an identity when pass-through was asked for.
+inline constexpr char kFingerprintHostValue[] = "host";
+
+// Platform persona: windows | macos | linux. Defaults to the host's.
+//
+// This does not move the GPU cluster. Across graphics backends nothing
+// transfers -- the same NVIDIA silicon produces a different capability digest
+// through D3D11 than through Vulkan -- so the anchor is always selected from
+// what the host can actually serve, and a persona/cluster mismatch is reported
+// as a limitation instead of hidden.
+inline constexpr char kFingerprintPlatform[] = "fingerprint-platform";
+
+// Pin the GPU anchor by id instead of drawing one.
+inline constexpr char kFingerprintAnchor[] = "fingerprint-anchor";
+
+// Write the composition report to stdout and exit.
+inline constexpr char kFingerprintExplain[] = "fingerprint-explain";
+
+}  // namespace switches
+
+// ---------------------------------------------------------------------------
+// The deterministic core
+// ---------------------------------------------------------------------------
+//
+// These are the whole of FINGERPRINTS.md §5 and they are free functions over
+// plain data on purpose: they must be unit-testable without a browser, a
+// filesystem or a command line.
+
+using Digest = std::array<uint8_t, 32>;
+
+// The tuple that keys the composition. Every field is part of the identity, so
+// changing any one of them is a different profile for the same seed -- which
+// is what makes a binary and a profile unable to silently disagree about what
+// the catalogue said.
+struct BASE_EXPORT RootInputs {
+  std::string_view profile_schema_version;
+  std::string_view catalogue_version;
+  std::string_view chromium_version;
+  std::string_view fingerprint_platform;
+  std::string_view seed;
+};
+
+// root = SHA-256( "apostate/fp/v1" 0x00
+//                 profile_schema_version 0x00
+//                 catalogue_version      0x00
+//                 chromium_version       0x00
+//                 fingerprint_platform   0x00
+//                 seed )
+BASE_EXPORT Digest ComputeRoot(const RootInputs& inputs);
+
+// draw(label, i) = SHA-256( root 0x00 label 0x00 uint32_be(i) )
+//
+// Every axis draws from a substream keyed by its own label. That is the
+// property that lets the catalogue grow: adding an axis, or changing the
+// option list of one axis, cannot shift any other axis's choice, so an old
+// seed keeps producing the same profile for everything that did not change.
+BASE_EXPORT Digest Draw(const Digest& root,
+                        std::string_view label,
+                        uint32_t index);
+
+// The leading 8 bytes of a digest as a big-endian u64.
+BASE_EXPORT uint64_t High64(const Digest& digest);
+
+// (value * range) >> 64, the high half of the 128-bit product. No modulo, no
+// rejection loop, no floating point, so the mapping is uniform to within one
+// part in 2^64 and needs no re-draw.
+BASE_EXPORT uint64_t ScaleToRange(uint64_t value, uint32_t range);
+
+// The index whose cumulative weight first exceeds ScaleToRange(value, total).
+// `weights` must be non-empty and sum to a non-zero value that fits in
+// uint32_t; the sum is the option list's total prevalence.
+BASE_EXPORT size_t WeightedPick(uint64_t value, span<const uint32_t> weights);
+
+// Whether an optional pack at `percent` prevalence is included.
+BASE_EXPORT bool SubsetIncluded(uint64_t value, uint32_t percent);
+
+// ---------------------------------------------------------------------------
+// Composition
+// ---------------------------------------------------------------------------
+
+// One line of the --fingerprint-explain report: what a surface resolved to,
+// who owns it, and what backs it.
+struct BASE_EXPORT SurfaceRecord {
+  std::string surface;
+  std::string value;
+  // "invariant", "anchor", "dispersion" or "host-inherited".
+  std::string layer;
+  std::string evidence;
+  // Empty when the resolved value is exactly what was asked for.
+  std::string limitation;
+};
+
+struct BASE_EXPORT Composition {
+  std::string seed;
+  SeedOrigin seed_origin = SeedOrigin::kGenerated;
+
+  // The requested persona and the host it is running on. When they differ the
+  // GPU cluster stays with the host and that is recorded in `limitations`.
+  std::string platform;
+  std::string host_platform;
+
+  std::string profile_schema_version;
+  std::string catalogue_version;
+  // SHA-256 over the generator's inputs. Not a root component -- §5 fixes the
+  // tuple -- but the value that makes "did this binary and this profile come
+  // from the same tables" answerable from the explain report.
+  std::string catalogue_digest;
+  std::string chromium_version;
+  Digest root = {};
+
+  std::vector<SurfaceRecord> surfaces;
+  std::vector<std::string> limitations;
+
+  // The composed profile, deep-merged in resolution order. Validates against
+  // config/profile.schema.json because every option's value does.
+  DictValue profile;
+};
+
+struct BASE_EXPORT ComposeRequest {
+  // Never empty: --fingerprint=host is handled before composition starts.
+  std::string seed;
+  // Requested persona. Empty means the host's platform.
+  std::string platform;
+  // --fingerprint-anchor. Empty means draw one.
+  std::string pinned_anchor;
+  // The launch's language list, e.g. "en-US,en". Empty means the catalogue's
+  // default. The voices table is keyed on the resolved list, projected onto
+  // the keys the table actually has.
+  std::string accept_languages;
+  // <user-data-dir>/apostate: where font provisioning is looked for. Empty
+  // when the launch named no user data directory and none was resolved for
+  // it. Nothing is written there; the compositor's only use of the
+  // filesystem is to ask whether a provisioned font family exists.
+  FilePath state_directory;
+
+  HostCapability host;
+
+  // The catalogue. Passed in rather than read from the generated tables inside
+  // Compose() so that composition is a pure function of its request: that is
+  // what "the deterministic function (seed, tables, host capability, requested
+  // platform) -> profile" means, and it is what lets the resolution order be
+  // tested against a table written in the test instead of against whatever the
+  // shipped catalogue happens to say today.
+  span<const DispersionAxis> axes;
+  span<const Anchor> anchors;
+  span<const PolicyOption> locale_policies;
+  span<const PolicyOption> theme_policies;
+  span<const std::string_view> union_array_paths;
+
+  // The three declared identity components of the §5 root.
+  std::string_view profile_schema_version;
+  std::string_view catalogue_version;
+  std::string_view chromium_version;
+  // Reported, not hashed. See Composition::catalogue_digest.
+  std::string_view catalogue_digest;
+
+  // Used when `accept_languages` is empty.
+  std::string_view default_accept_languages;
+};
+
+// Resolves every axis in the §5 dependency order and deep-merges the result.
+//
+// A dependent axis draws from an option set that is a *function* of its
+// parents' resolved values, so there is no rejection sampling and no re-draw:
+// every profile is coherent by construction rather than by validation.
+//
+// Returns nullopt only when the request itself is unusable (no seed, no
+// platform persona the tables know). A coherence violation after resolution is
+// a defect in the compiled option tables and is fatal, because the generator
+// rejects all of them at build time -- reaching one at runtime means the
+// binary shipped with a broken catalogue, and a half-composed fingerprint is
+// more detectable than none.
+BASE_EXPORT std::optional<Composition> Compose(const ComposeRequest& request);
+
+// Deep-merges `overlay` into `target`.
+//
+// Dictionaries recurse. Arrays replace, except at a dotted path in
+// `union_array_paths`, where the overlay's new items are appended in option
+// file order. That one exception is what makes a font pack additive without the
+// compositor knowing what a font is; everything else replacing is what lets a
+// later axis correct an earlier one. Exposed for tests.
+BASE_EXPORT void MergeFragment(DictValue& target,
+                               DictValue overlay,
+                               span<const std::string_view> union_array_paths,
+                               std::string_view path = {});
+
+// Whether every family in `families` has been provisioned into this profile,
+// i.e. exists under `fonts_directory`.
+//
+// base/ cannot enumerate the host's installed families at composition time --
+// that is Skia's job and Skia starts later -- so "present on the host" is not
+// answerable here, and a launch that provisions nothing has every pack offered
+// with the gap reported. Exposed for tests.
+BASE_EXPORT bool FamiliesProvisioned(const FilePath& fonts_directory,
+                                     span<const std::string_view> families);
+
+// Turns panel geometry plus furniture insets into the avail_* rectangle, and
+// removes the four inset keys either way.
+//
+// `panel_resolved` is false when the panel axis was left host-inherited; in
+// that case an inset has no panel to apply to, and a `screen` object left with
+// nothing in it is dropped rather than emitted empty, because an empty section
+// is not a claim. Insets that exceed the panel are a table defect and fail the
+// launch. Exposed for tests.
+BASE_EXPORT void DeriveWorkArea(DictValue& profile,
+                                bool panel_resolved,
+                                std::vector<std::string>* limitations);
+
+// ---------------------------------------------------------------------------
+// The entry point
+// ---------------------------------------------------------------------------
+
+// Composes the profile for this launch and returns it base64-encoded, ready to
+// hand to the profile loader's existing parser.
+//
+// `user_data_dir` is Chrome's resolved user data directory. base/ cannot
+// compute it -- the default is branding-dependent and lives in
+// chrome/common/chrome_paths_*.cc -- and the `user-data-dir` switch is present
+// only when the launch passed one, so it is handed in by the caller that knows
+// it. An empty path means font provisioning cannot be checked, which is
+// reported rather than assumed.
+//
+// Returns nullopt, meaning "inherit the host", when:
+//   * this is not the browser process (a child receives the composed profile
+//     on its command line and must never compose its own);
+//   * --apostate-profile was supplied, so an already-composed profile wins;
+//   * --fingerprint named an off value;
+//   * the compiled catalogue cannot serve the request.
+//
+// When --fingerprint-explain is present this writes the report to stdout and
+// exits the process instead of returning. When the launch named an identity
+// that cannot be honoured it writes the reason to stderr and exits non-zero,
+// because presenting a different identity than the one asked for is worse than
+// not launching.
+BASE_EXPORT std::optional<std::string> ComposeProfileForCurrentProcess(
+    const FilePath& user_data_dir);
+
+// Composes the profile for this launch and installs it on this process's
+// command line as --apostate-profile, which patch 0005 copies to every child.
+//
+// This is the one place a profile is composed and installed, and it is
+// idempotent: a launch that already carries --apostate-profile, whether the
+// operator passed it or an earlier call installed it, is left alone. Calling
+// it from a startup hook is what makes the ordering real rather than
+// documented -- the switch is on the browser's command line before any child
+// command line is built, so no process type can be forgotten and no lazy first
+// use can decide the identity at an arbitrary moment.
+BASE_EXPORT void InstallComposedProfile(const FilePath& user_data_dir);
+
+}  // namespace apostate
+}  // namespace base
+
+#endif  // BASE_APOSTATE_COMPOSE_H_
