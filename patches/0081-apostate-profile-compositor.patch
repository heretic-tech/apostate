@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""GN action shim: run the Apostate table generator from inside the checkout.
+
+A GN action's script has to live in the source tree, and the generator and its
+inputs live in the Apostate repository that drives this checkout. Copying the
+generator in here would create a second implementation to keep in sync -- which
+is the exact failure this whole change exists to remove -- so this file locates
+the repository and execs the one implementation instead.
+
+The layout is fixed by scripts/lib.sh: the Chromium checkout is
+`$REPO_ROOT/.workspace/src`, so from this file at
+`<src>/base/apostate/generate_dispersion_tables.py` the repository root is five
+parents up. `APOSTATE_DATA_ROOT` overrides that for a checkout placed
+elsewhere.
+
+Failing the build when the repository cannot be found is deliberate. The bare
+binary has to produce a fingerprint with no arguments, so a binary with no
+compiled tables is not a degraded build, it is a broken one.
+"""
+
+from __future__ import annotations
+
+import os
+import pathlib
+import runpy
+import sys
+
+GENERATOR = "scripts/generate-dispersion-tables.py"
+# Files that together identify the Apostate repository rather than some other
+# directory that happens to have a scripts/ in it.
+MARKERS = (GENERATOR, "resources/profiles/catalogue.json", "build/CHROMIUM_VERSION")
+
+
+def looks_like_repository(candidate: pathlib.Path) -> bool:
+    return all((candidate / marker).is_file() for marker in MARKERS)
+
+
+def find_repository() -> pathlib.Path:
+    override = os.environ.get("APOSTATE_DATA_ROOT")
+    if override:
+        candidate = pathlib.Path(override).resolve()
+        if not looks_like_repository(candidate):
+            raise SystemExit(
+                f"APOSTATE_DATA_ROOT={override} is not an Apostate repository: "
+                f"expected {', '.join(MARKERS)} under it"
+            )
+        return candidate
+
+    here = pathlib.Path(__file__).resolve()
+    # <repo>/.workspace/src/base/apostate/generate_dispersion_tables.py
+    for candidate in here.parents:
+        if looks_like_repository(candidate):
+            return candidate
+
+    raise SystemExit(
+        "could not find the Apostate repository above "
+        f"{here}. The dispersion tables and GPU anchors are compiled into the "
+        "binary, so a build without them is broken rather than degraded. Set "
+        "APOSTATE_DATA_ROOT to the repository root."
+    )
+
+
+def main() -> int:
+    repository = find_repository()
+    script = repository / GENERATOR
+    sys.argv = [str(script), "--data-root", str(repository), *sys.argv[1:]]
+    runpy.run_path(str(script), run_name="__main__")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
