@@ -0,0 +1,103 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/seed.h"
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/apostate/compose.h"
+#include "base/command_line.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace base::apostate {
+
+namespace {
+
+// 32 bytes of entropy, hex-encoded: 256 bits is past any birthday concern for
+// an identity space, and hex text means the seed the explain report prints can
+// be handed straight back as --fingerprint=<seed> to reproduce the identity
+// somewhere else. A binary value would not round-trip through a shell.
+constexpr size_t kSeedEntropyBytes = 32;
+
+// The reserved --fingerprint spellings that turn composition off. `host` is
+// the canonical one; the rest exist because they are the spellings a user
+// already has in their launch scripts, and a launch whose identity is the
+// SHA-256 of the word "off" is the worst possible reading of --fingerprint=off.
+constexpr std::string_view kOffValues[] = {
+    "host", "off", "false", "0", "disable", "disabled",
+};
+
+bool IsOffValue(std::string_view value) {
+  for (const std::string_view candidate : kOffValues) {
+    if (EqualsCaseInsensitiveASCII(value, candidate)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// A seed is used verbatim as a hash input, so any byte sequence is technically
+// usable. Restricting it to one short printable line is about diagnosis: a
+// seed nobody can read back and retype is a seed nobody can reproduce.
+bool IsUsableSeed(std::string_view seed) {
+  if (seed.empty() || seed.size() > 512) {
+    return false;
+  }
+  for (const char c : seed) {
+    const auto byte = static_cast<unsigned char>(c);
+    if (byte < 0x21 || byte > 0x7E) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::string GenerateSeed() {
+  std::array<uint8_t, kSeedEntropyBytes> entropy = {};
+  RandBytes(entropy);
+  return HexEncodeLower(entropy);
+}
+
+}  // namespace
+
+SeedResolution ResolveSeed(const CommandLine& command_line) {
+  SeedResolution resolution;
+
+  // --fingerprint wins outright, and an off value disables every layer below
+  // it.
+  if (command_line.HasSwitch(switches::kFingerprint)) {
+    const std::string value =
+        command_line.GetSwitchValueASCII(switches::kFingerprint);
+    if (IsOffValue(value)) {
+      resolution.origin = SeedOrigin::kHostInheritance;
+      return resolution;
+    }
+    if (IsUsableSeed(value)) {
+      resolution.seed = value;
+      resolution.origin = SeedOrigin::kSwitch;
+      return resolution;
+    }
+    resolution.origin = SeedOrigin::kHostInheritance;
+    resolution.rejected = true;
+    resolution.limitation =
+        "--fingerprint was given a value that is empty, longer than 512 bytes "
+        "or not printable ASCII, so the identity it names cannot be "
+        "reproduced; pass --fingerprint=host to present this machine "
+        "deliberately, or drop the switch for a fresh identity";
+    return resolution;
+  }
+
+  // The default, and the whole point of the binary: a fresh coherent device
+  // for this launch, recorded nowhere.
+  resolution.seed = GenerateSeed();
+  resolution.origin = SeedOrigin::kGenerated;
+  return resolution;
+}
+
+}  // namespace base::apostate
