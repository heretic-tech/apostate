+
+// The domain separator. Any change to it is a new identity space for every
+// existing seed, which is why it carries its own version.
+constexpr std::string_view kRootPrefix = "apostate/fp/v1";
+
+constexpr uint8_t kSeparator = 0x00;
+
+// chrome/common/chrome_switches.cc kLang. base/ cannot include chrome/.
+constexpr char kLangSwitch[] = "lang";
+
+// content/public/common/content_switches.cc kProcessType. A child process
+// always carries it; the browser process never does. Spelled as a literal for
+// the same reason base/metrics/histogram_shared_memory.cc does.
+constexpr char kProcessTypeSwitch[] = "type";
+
+// chrome/common/chrome_switches.cc kUserDataDir. Only a fallback: Chrome's
+// resolved directory is handed to ComposeProfileForCurrentProcess(), and this
+// switch is present only when the launch passed one explicitly.
+constexpr char kUserDataDirSwitch[] = "user-data-dir";
+
+// This project's subdirectory of the user data directory, and the directory
+// under it where a provisioned font family lives.
+constexpr char kStateDirectoryName[] = "apostate";
+constexpr char kProvisionedFontsDirectory[] = "fonts";
+
+constexpr std::string_view kLayerAnchor = "anchor";
+constexpr std::string_view kLayerDispersion = "dispersion";
+constexpr std::string_view kLayerHostInherited = "host-inherited";
+
+void Absorb(SHA256_CTX* context, std::string_view data) {
+  SHA256_Update(context, data.data(), data.size());
+}
+
+void AbsorbSeparator(SHA256_CTX* context) {
+  SHA256_Update(context, &kSeparator, 1);
+}
+
+bool IsKnownPlatform(std::string_view platform) {
+  return platform == "windows" || platform == "macos" || platform == "linux";
+}
+
+// Parses one option's profile fragment.
+//
+// A fragment that does not parse is a defect in the compiled catalogue, not a
+// runtime condition: the generator canonicalises every fragment through a JSON
+// round-trip, so reaching this means the binary was built with a broken
+// generator. Failing loudly is correct -- a half-composed fingerprint is more
+// detectable than none, and this is not reachable from user input.
+DictValue ParseFragment(std::string_view axis, std::string_view json) {
+  std::optional<DictValue> parsed = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!parsed) {
+    LOG(FATAL) << "apostate: the compiled table for '" << axis
+               << "' carries a value that is not a JSON object; the binary was "
+                  "built with a broken catalogue";
+  }
+  return std::move(*parsed);
+}
+
+// The identity strings the composed profile claims, if it claims any.
+struct ClaimedIdentity {
+  bool declared = false;
+  std::string vendor;
+  std::string renderer;
+};
+
+ClaimedIdentity IdentityFromProfile(const DictValue& profile) {
+  ClaimedIdentity identity;
+  const DictValue* gpu = profile.FindDict("gpu");
+  if (!gpu) {
+    return identity;
+  }
+  const std::string* vendor = gpu->FindString("unmasked_vendor");
+  const std::string* renderer = gpu->FindString("unmasked_renderer");
+  if (vendor && renderer) {
+    identity.declared = true;
+    identity.vendor = *vendor;
+    identity.renderer = *renderer;
+  }
+  return identity;
+}
+
+// The projection of a resolved accept-languages list onto the voices table's
+// own keys.
+//
+// This is computed *before* the draw, so it is a key projection and never a
+// fallback after a failed match: option-set matching stays exact and total, and
+// there is never a miss to recover from. The empty-string set carries no
+// `speech` section, which leaves the host's real providers in effect -- the
+// only honest answer for a language set nobody measured.
+std::string ProjectLanguages(const DispersionAxis& axis,
+                             std::string_view accept_languages) {
+  for (const DispersionOptionSet& option_set : axis.option_sets) {
+    for (const ConditionKey& entry : option_set.key) {
+      if (entry.name == "languages" && entry.value == accept_languages) {
+        return std::string(accept_languages);
+      }
+    }
+  }
+  return std::string();
+}
+
+struct FilterOutcome {
+  std::vector<const DispersionOption*> options;
+  // Per-option notes that must be reported rather than dropped silently.
+  std::vector<std::string> limitations;
+};
+
+// Applies the axis's servability clamp to an option set *before* drawing.
+//
+// Filtering first rather than correcting afterwards is what keeps §3's
+// "capacity is only ever reduced" a property of the option set: the drawn index
+// always lands on a servable option, so nothing is ever re-drawn and the
+// realised distribution is the table's distribution over what the host can
+// serve. A dropped option changes that distribution, and that is intended -- a
+// 14-core host offering only <= 14 core buckets is correct behaviour.
+FilterOutcome FilterServable(const DispersionAxis& axis,
+                             const DispersionOptionSet& option_set,
+                             const HostCapability& host,
+                             const Anchor* anchor,
+                             const FilePath& fonts_directory) {
+  FilterOutcome outcome;
+
+  for (const DispersionOption& option : option_set.options) {
+    const Requirement* requirement = option.requirement;
+    bool servable = true;
+
+    switch (axis.servability) {
+      case Servability::kNone:
+        break;
+
+      case Servability::kClampDown:
+        if (requirement) {
+          if (host.logical_cores > 0 && requirement->min_logical_cores > 0 &&
+              requirement->min_logical_cores > host.logical_cores) {
+            servable = false;
+          }
+          if (host.total_memory_bytes > 0 && requirement->min_total_bytes > 0 &&
+              requirement->min_total_bytes > host.total_memory_bytes) {
+            servable = false;
+          }
+        }
+        break;
+
+      case Servability::kWindowBounds:
+        // The panel must be at least as large as the window the launch asked
+        // for. An option that states no dimensions states a zero-sized panel,
+        // which can only serve a launch that constrained nothing.
+        if (host.window_width > 0 &&
+            (requirement ? requirement->min_width : 0) < host.window_width) {
+          servable = false;
+        }
+        if (host.window_height > 0 &&
+            (requirement ? requirement->min_height : 0) < host.window_height) {
+          servable = false;
+        }
+        break;
+
+      case Servability::kAnchorMember:
+        // Within an anchor the identity strings are rotatable, because the
+        // anchor's members measurably agree on everything else. Across anchors
+        // they are not: presenting a Windows/D3D11 renderer string on top of an
+        // Apple Metal capability cluster is exactly the failure this model was
+        // built to stop. That the drawn identity really was measured on this
+        // anchor is checked after the draw, where the member is also what
+        // WebGPU comes from.
+        servable = anchor && requirement && requirement->anchor == anchor->id;
+        break;
+
+      case Servability::kFilesPresent:
+        // Core packs are never dropped: the mandatory set for an OS release is
+        // what makes the claim coherent at all, and a machine claiming macOS
+        // without its core faces is not a Mac. What is reported here is the
+        // inability to check, not a missing face. FamiliesProvisioned only
+        // asks whether a family was copied into this profile's fonts
+        // directory, nothing in the tree ever writes that directory, and the
+        // host's own installed families cannot be enumerated before Skia
+        // starts -- so on a host presenting its own platform the faces are
+        // all there and the check still cannot say so.
+        if (option.pack_kind == PackKind::kCore) {
+          if (requirement && !fonts_directory.empty() &&
+              !FamiliesProvisioned(fonts_directory, requirement->families)) {
+            outcome.limitations.push_back(
+                "core font pack '" + std::string(option.id) +
+                "' could not be checked: nothing is provisioned into this "
+                "profile and the host's installed families cannot be "
+                "enumerated before the graphics stack starts, so the pack was "
+                "offered unchecked. This is a gap in what was established, not "
+                "a missing face -- a host presenting its own platform has the "
+                "core faces already");
+          }
+          break;
+        }
+        // An optional pack is only offered when its families are provisioned.
+        // When nothing is provisioned the host's own families are the only
+        // ones in play and presence is not answerable from here, so the packs
+        // stay offered and the gap is reported on the axis.
+        if (!fonts_directory.empty()) {
+          servable = requirement &&
+                     FamiliesProvisioned(fonts_directory, requirement->families);
+        }
+        break;
+    }
+
+    if (servable) {
+      outcome.options.push_back(&option);
+    }
+  }
+
+  return outcome;
+}
+
+}  // namespace
+
+void MergeFragment(DictValue& target,
+                   DictValue overlay,
+                   span<const std::string_view> union_array_paths,
+                   std::string_view path) {
+  for (auto [key, value] : overlay) {
+    const std::string here =
+        path.empty() ? std::string(key) : std::string(path) + "." + key;
+
+    Value* existing = target.Find(key);
+
+    if (value.is_dict() && existing && existing->is_dict()) {
+      MergeFragment(existing->GetDict(), std::move(value).TakeDict(),
+                    union_array_paths, here);
+      continue;
+    }
+
+    if (value.is_list() && existing && existing->is_list()) {
+      bool unioned = false;
+      for (const std::string_view candidate : union_array_paths) {
+        if (candidate == here) {
+          unioned = true;
+          break;
+        }
+      }
+      if (unioned) {
+        ListValue& into = existing->GetList();
+        for (const Value& item : value.GetList()) {
+          // ListValue::contains has no Value overload, and a de-duplicating
+          // union is the whole point of this path, so the comparison is
+          // explicit.
+          bool present = false;
+          for (const Value& existing_item : into) {
+            if (existing_item == item) {
+              present = true;
+              break;
+            }
+          }
+          if (!present) {
+            into.Append(item.Clone());
+          }
+        }
+        continue;
+      }
+    }
+
+    target.Set(key, std::move(value));
+  }
+}
+
+// ---------------------------------------------------------------------------
+// The deterministic core
+// ---------------------------------------------------------------------------
+
+Digest ComputeRoot(const RootInputs& inputs) {
+  SHA256_CTX context;
+  SHA256_Init(&context);
+  Absorb(&context, kRootPrefix);
+  AbsorbSeparator(&context);
+  Absorb(&context, inputs.profile_schema_version);
+  AbsorbSeparator(&context);
+  Absorb(&context, inputs.catalogue_version);
+  AbsorbSeparator(&context);
+  Absorb(&context, inputs.chromium_version);
+  AbsorbSeparator(&context);
+  Absorb(&context, inputs.fingerprint_platform);
+  AbsorbSeparator(&context);
+  // The seed closes the input with no trailing separator, exactly as
+  // FINGERPRINTS.md §5 writes it.
+  Absorb(&context, inputs.seed);
+
+  Digest root = {};
+  SHA256_Final(root.data(), &context);
+  return root;
+}
+
+Digest Draw(const Digest& root, std::string_view label, uint32_t index) {
+  const std::array<uint8_t, 4> index_be = {
+      static_cast<uint8_t>((index >> 24) & 0xFF),
+      static_cast<uint8_t>((index >> 16) & 0xFF),
+      static_cast<uint8_t>((index >> 8) & 0xFF),
+      static_cast<uint8_t>(index & 0xFF),
+  };
+
+  SHA256_CTX context;
+  SHA256_Init(&context);
+  SHA256_Update(&context, root.data(), root.size());
+  AbsorbSeparator(&context);
+  Absorb(&context, label);
+  AbsorbSeparator(&context);
+  SHA256_Update(&context, index_be.data(), index_be.size());
+
+  Digest digest = {};
+  SHA256_Final(digest.data(), &context);
+  return digest;
+}
+
+uint64_t High64(const Digest& digest) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < 8; ++i) {
+    value = (value << 8) | digest[i];
+  }
+  return value;
+}
+
+uint64_t ScaleToRange(uint64_t value, uint32_t range) {
+  // The high 64 bits of the 128-bit product value*range, computed from 32-bit
+  // halves because C++ has no portable 128-bit multiply and MSVC's intrinsic is
+  // not available on every toolchain this builds with.
+  //
+  //   value*range = hi*range*2^32 + lo*range
+  //   (value*range) >> 64 = ((hi*range) + ((lo*range) >> 32)) >> 32
+  //
+  // The nested floor is exact: the fraction discarded by the inner shift is
+  // strictly less than one, and adding it to a value already reduced mod 2^32
+  // cannot carry into the outer shift. Neither intermediate overflows, since
+  // hi*range <= (2^32-1)^2 and the addend is at most range-1 < 2^32.
+  const uint64_t hi = value >> 32;
+  const uint64_t lo = value & 0xFFFFFFFFu;
+  const uint64_t span_size = range;
+  const uint64_t carry = (lo * span_size) >> 32;
+  return ((hi * span_size) + carry) >> 32;
+}
+
+size_t WeightedPick(uint64_t value, span<const uint32_t> weights) {
+  CHECK(!weights.empty());
+
+  uint64_t total = 0;
+  for (const uint32_t weight : weights) {
+    total += weight;
+  }
+  CHECK_GT(total, 0u);
+  // ScaleToRange takes a 32-bit range, and the generator enforces the same
+  // bound on every option set's weight sum, so this cannot fire on a
+  // well-generated catalogue.
+  CHECK_LE(total, uint64_t{std::numeric_limits<uint32_t>::max()});
+
+  const uint64_t position = ScaleToRange(value, static_cast<uint32_t>(total));
+
+  uint64_t cumulative = 0;
+  size_t index = 0;
+  for (const uint32_t weight : weights) {
+    cumulative += weight;
+    if (position < cumulative) {
+      return index;
+    }
+    ++index;
+  }
+  // position < total by construction, so the loop always returns.
+  NOTREACHED();
+}
+
+bool SubsetIncluded(uint64_t value, uint32_t percent) {
+  return ScaleToRange(value, 100) < percent;
+}
+
+bool FamiliesProvisioned(const FilePath& fonts_directory,
+                         span<const std::string_view> families) {
+  if (families.empty() || fonts_directory.empty()) {
+    return false;
+  }
+  for (const std::string_view family : families) {
+    if (!PathExists(fonts_directory.AppendASCII(family))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Composition
+// ---------------------------------------------------------------------------
+
+std::optional<Composition> Compose(const ComposeRequest& request) {
+  if (request.seed.empty()) {
+    return std::nullopt;
+  }
+
+  Composition composition;
+  composition.seed = request.seed;
+  composition.host_platform = request.host.platform;
+  composition.profile_schema_version =
+      std::string(request.profile_schema_version);
+  composition.catalogue_version = std::string(request.catalogue_version);
+  composition.catalogue_digest = std::string(request.catalogue_digest);
+  composition.chromium_version = std::string(request.chromium_version);
+
+  composition.platform = request.platform.empty() ? request.host.platform
+                                                  : request.platform;
+  if (!IsKnownPlatform(composition.platform)) {
+    LOG(ERROR) << "apostate: no platform persona for '" << composition.platform
+               << "'; this launch inherits the host";
+    return std::nullopt;
+  }
+
+  const RootInputs root_inputs = {
+      .profile_schema_version = request.profile_schema_version,
+      .catalogue_version = request.catalogue_version,
+      .chromium_version = request.chromium_version,
+      .fingerprint_platform = composition.platform,
+      .seed = composition.seed,
+  };
+  composition.root = ComputeRoot(root_inputs);
+
+  // Resolved parent values, keyed by condition name. std::map is used for its
+  // node stability: the ConditionKey views handed to FindOptionSet point into
+  // these nodes.
+  std::map<std::string, std::string> resolved;
+  resolved["platform"] = composition.platform;
+
+  const FilePath fonts_directory =
+      request.state_directory.empty()
+          ? FilePath()
+          : request.state_directory.AppendASCII(kProvisionedFontsDirectory);
+
+  // ---- the anchor, before any axis that can be conditioned on it ----
+  //
+  // The GPU cluster is selected from anchors the host can actually serve, and
+  // --fingerprint-platform does not move it. Across backends nothing
+  // transfers, so the host's backend is the filter and the persona is not.
+  const Anchor* anchor = nullptr;
+  if (!request.pinned_anchor.empty()) {
+    anchor = FindAnchor(request.anchors, request.pinned_anchor);
+    if (!anchor) {
+      LOG(ERROR) << "apostate: --fingerprint-anchor named '"
+                 << request.pinned_anchor
+                 << "', which is not in the compiled catalogue";
+      return std::nullopt;
+    }
+  } else {
+    std::vector<const Anchor*> servable;
+    for (const Anchor& candidate : request.anchors) {
+      if (request.host.graphics_backend.empty() ||
+          candidate.backend == request.host.graphics_backend) {
+        servable.push_back(&candidate);
+      }
+    }
+    // Prefer an anchor captured on this host's own platform, but do not insist
+    // on it: a backend match is the coherence requirement, and the platform is
+    // only a tie-break within it.
+    if (!request.host.platform.empty()) {
+      std::vector<const Anchor*> same_platform;
+      for (const Anchor* candidate : servable) {
+        if (candidate->platform == request.host.platform) {
+          same_platform.push_back(candidate);
+        }
+      }
+      if (!same_platform.empty()) {
+        servable = std::move(same_platform);
+      }
+    }
+
+    if (servable.empty()) {
+      // Presenting another backend's cluster is the retired catalogue's
+      // failure, so there is nothing to fall back to.
+      LOG(ERROR) << "apostate: no compiled anchor was captured through this "
+                    "host's graphics backend ("
+                 << request.host.graphics_backend
+                 << "); a coherent capability cluster cannot be composed";
+      return std::nullopt;
+    }
+
+    std::vector<uint32_t> weights;
+    weights.reserve(servable.size());
+    for (const Anchor* candidate : servable) {
+      weights.push_back(candidate->weight);
+    }
+    anchor = servable[WeightedPick(High64(Draw(composition.root, "anchor", 0)),
+                                   weights)];
+  }
+
+  resolved["anchor"] = std::string(anchor->id);
+
+  std::string anchor_limitation;
+  if (anchor->platform != composition.platform) {
+    // The §4 case, stated rather than hidden: on a macOS host a Windows
+    // persona keeps an Apple GPU cluster. A coherent Windows fingerprint wants
+    // a Windows or Linux host with the corresponding silicon, which is a
+    // property of graphics drivers and not of this codebase.
+    anchor_limitation = "anchor " + std::string(anchor->id) + " is a " +
+                        std::string(anchor->platform) + "/" +
+                        std::string(anchor->backend) +
+                        " cluster while the persona is " +
+                        composition.platform +
+                        ": --fingerprint-platform does not move the GPU "
+                        "cluster, and this mismatch is reported rather than "
+                        "hidden";
+    composition.limitations.push_back(anchor_limitation);
+  }
+  if (anchor->members.size() == 1) {
+    composition.limitations.push_back(
+        "anchor " + std::string(anchor->id) +
+        " has one measured member, so no identity rotation is offered on its "
+        "capability cluster");
+  }
+  if (request.host.graphics_backend_is_inferred) {
+    composition.limitations.push_back(
+        "the host graphics backend was taken to be the platform default (" +
+        request.host.graphics_backend +
+        ") because the GPU process does not exist yet at composition time; "
+        "pass --use-angle to state it");
+  }
+
+  MergeFragment(composition.profile,
+                ParseFragment("anchor", anchor->value_json),
+                request.union_array_paths);
+  composition.surfaces.push_back({
+      .surface = "anchor",
+      .value = std::string(anchor->id),
+      .layer = std::string(kLayerAnchor),
+      .evidence = std::string(anchor->evidence),
+      .limitation = anchor_limitation,
+  });
+
+  // ---- the catalogue policies ----
+  auto resolve_policy = [&](std::string_view kind,
+                            span<const PolicyOption> policies) {
+    std::vector<const PolicyOption*> candidates;
+    for (const PolicyOption& policy : policies) {
+      if (policy.AppliesTo(composition.platform)) {
+        candidates.push_back(&policy);
+      }
+    }
+    if (candidates.empty()) {
+      LOG(FATAL) << "apostate: no " << kind << " policy supports the persona '"
+                 << composition.platform
+                 << "'; the compiled catalogue is incomplete";
+    }
+    // Every policy weighs the same: the catalogue states no prevalence for
+    // them, and inventing one would be synthesis dressed as data.
+    const std::vector<uint32_t> weights(candidates.size(), 1u);
+    const std::string label = "policy." + std::string(kind);
+    const PolicyOption* chosen =
+        candidates[WeightedPick(High64(Draw(composition.root, label, 0)),
+                                weights)];
+
+    MergeFragment(composition.profile,
+                  ParseFragment(kind, chosen->value_json),
+                  request.union_array_paths);
+    composition.surfaces.push_back({
+        .surface = std::string(kind),
+        .value = std::string(chosen->id),
+        .layer = std::string(kLayerDispersion),
+        .evidence = std::string(chosen->evidence),
+        .limitation = std::string(),
+    });
+    resolved[std::string(kind)] = std::string(chosen->id);
+  };
+
+  // ---- the dispersion axes, in the §5 resolution order ----
+  bool locale_resolved = false;
+  bool panel_resolved = false;
+
+  for (const DispersionAxis& axis : request.axes) {
+    // The voices table is keyed on the resolved accept-languages list, so the
+    // locale policy has to be picked before it. It is picked as late as
+    // possible otherwise, because the §5 order puts locale last.
+    if (axis.axis == "voices" && !locale_resolved) {
+      resolve_policy("locale", request.locale_policies);
+      locale_resolved = true;
+    }
+    if (axis.axis == "voices") {
+      std::string accept_languages(request.default_accept_languages);
+      if (const DictValue* locale = composition.profile.FindDict("locale")) {
+        if (const std::string* declared =
+                locale->FindString("accept_languages")) {
+          accept_languages = *declared;
+        }
+      }
+      resolved["languages"] = ProjectLanguages(axis, accept_languages);
+    }
+
+    std::vector<ConditionKey> key;
+    key.reserve(axis.conditioned_on.size());
+    for (const std::string_view name : axis.conditioned_on) {
+      const auto it = resolved.find(std::string(name));
+      if (it == resolved.end()) {
+        LOG(FATAL) << "apostate: axis '" << axis.axis
+                   << "' is conditioned on '" << name
+                   << "', which nothing resolved before it; the compiled "
+                      "catalogue's resolution order is wrong";
+      }
+      key.push_back({it->first, it->second});
+    }
+
+    const DispersionOptionSet* option_set = axis.FindOptionSet(key);
+    if (!option_set) {
+      // Matching is exact and total: a child's option set is a function of its
+      // parents, so a miss is a hole in the compiled table. The generator
+      // rejects duplicate and mismatched keys, so this is unreachable from a
+      // well-generated binary -- and falling back or re-drawing here would
+      // silently produce an incoherent machine.
+      LOG(FATAL) << "apostate: axis '" << axis.axis
+                 << "' has no option set for its resolved parents; the "
+                    "compiled catalogue is incomplete";
+    }
+
+    FilterOutcome outcome = FilterServable(axis, *option_set, request.host,
+                                           anchor, fonts_directory);
+    for (std::string& limitation : outcome.limitations) {
+      composition.limitations.push_back(std::string(axis.axis) + ": " +
+                                        limitation);
+    }
+
+    if (outcome.options.empty()) {
+      if (axis.servability == Servability::kAnchorMember) {
+        // Every anchor has at least one measured member, so an empty set here
+        // is a defect in the compiled tables and not a host condition.
+        LOG(FATAL) << "apostate: axis '" << axis.axis
+                   << "' offers no member of anchor '" << anchor->id
+                   << "'; the compiled catalogue is inconsistent with the "
+                      "corpus";
+      }
+      // Nothing this host can serve. The axis contributes nothing and the
+      // surface stays host-inherited, which is servable by definition because
+      // it is the host's own value. Keeping the table's lowest option instead
+      // would ship a claim *above* host capability whenever the host sits
+      // below every bucket -- a 4-core host given an 8-core floor -- which is
+      // exactly what servability exists to prevent.
+      const std::string limitation =
+          "no option is servable on this host, so the surface is left "
+          "inherited rather than raising a claim the host cannot serve";
+      composition.surfaces.push_back({
+          .surface = std::string(axis.axis),
+          .value = "(inherited)",
+          .layer = std::string(kLayerHostInherited),
+          .evidence = "host-inherited",
+          .limitation = limitation,
+      });
+      composition.limitations.push_back(std::string(axis.axis) + ": " +
+                                        limitation);
+      continue;
+    }
+
+    if (axis.selection == Selection::kSingle) {
+      std::vector<uint32_t> weights;
+      weights.reserve(outcome.options.size());
+      for (const DispersionOption* option : outcome.options) {
+        weights.push_back(option->weight);
+      }
+      const DispersionOption* chosen = outcome.options[WeightedPick(
+          High64(Draw(composition.root, axis.label, 0)), weights)];
+
+      resolved[std::string(axis.axis)] = std::string(chosen->id);
+      MergeFragment(composition.profile,
+                    ParseFragment(axis.axis, chosen->value_json),
+                    request.union_array_paths);
+      composition.surfaces.push_back({
+          .surface = std::string(axis.axis),
+          .value = std::string(chosen->id),
+          .layer = std::string(kLayerDispersion),
+          .evidence = std::string(chosen->evidence),
+          .limitation = std::string(),
+      });
+      if (axis.axis == "panel") {
+        panel_resolved = true;
+      }
+      if (axis.axis == "gpu_identity") {
+        // WebGPU belongs to the resolved member, not to the anchor: it is the
+        // one part of a capability cluster that is not anchor-wide. Two of the
+        // Linux/Vulkan anchor's four members measured no adapter at all, and
+        // claiming a sibling's would be an unmeasured assertion, so an empty
+        // fragment leaves WebGPU host-inherited.
+        const ClaimedIdentity identity =
+            IdentityFromProfile(composition.profile);
+        const AnchorMember* member =
+            identity.declared
+                ? anchor->FindMemberIdentity(identity.vendor, identity.renderer)
+                : nullptr;
+        if (identity.declared && !member) {
+          LOG(FATAL) << "apostate: gpu_identity option '" << chosen->id
+                     << "' claims a renderer that is not a measured member of "
+                        "anchor '"
+                     << anchor->id
+                     << "'; the compiled catalogue is inconsistent with the "
+                        "corpus";
+        }
+        if (member && !member->webgpu_json.empty()) {
+          MergeFragment(composition.profile,
+                        ParseFragment("webgpu", member->webgpu_json),
+                        request.union_array_paths);
+          composition.surfaces.push_back({
+              .surface = "webgpu",
+              .value = std::string(member->label),
+              .layer = std::string(kLayerAnchor),
+              .evidence = std::string(anchor->evidence),
+              .limitation = std::string(),
+          });
+        } else if (member) {
+          const std::string limitation =
+              "the resolved member measured no WebGPU adapter, so WebGPU is "
+              "the host's own rather than a sibling member's";
+          composition.surfaces.push_back({
+              .surface = "webgpu",
+              .value = "(inherited)",
+              .layer = std::string(kLayerHostInherited),
+              .evidence = "host-inherited",
+              .limitation = limitation,
+          });
+          composition.limitations.push_back("webgpu: " + limitation);
+        }
+      }
+      continue;
+    }
+
+    // core-plus-subset: every core option, plus an independent inclusion
+    // decision per optional option. Substream index 0 is reserved so a single
+    // and a core-plus-subset axis never collide on the same draw, and the
+    // optional index counts the *offered* optional options in file order --
+    // the servability filter runs before the draw precisely so that the drawn
+    // index is an index into the offered set.
+    std::string included;
+    uint32_t optional_index = 0;
+    for (const DispersionOption* option : outcome.options) {
+      bool take = true;
+      if (option->pack_kind != PackKind::kCore) {
+        take = SubsetIncluded(
+            High64(Draw(composition.root, axis.label, optional_index + 1)),
+            option->weight);
+        ++optional_index;
+      }
+      if (!take) {
+        continue;
+      }
+      MergeFragment(composition.profile,
+                    ParseFragment(axis.axis, option->value_json),
+                    request.union_array_paths);
+      if (!included.empty()) {
+        included += "+";
+      }
+      included += std::string(option->id);
+      composition.surfaces.push_back({
+          .surface = std::string(axis.axis) + "/" + std::string(option->id),
+          .value = option->pack_kind == PackKind::kCore ? "core" : "included",
+          .layer = std::string(kLayerDispersion),
+          .evidence = std::string(option->evidence),
+          .limitation = std::string(),
+      });
+    }
+    resolved[std::string(axis.axis)] = included;
+
+    if (axis.servability == Servability::kFilesPresent &&
+        fonts_directory.empty()) {
+      composition.limitations.push_back(
+          std::string(axis.axis) +
+          ": font presence could not be checked, because the host's installed "
+          "families cannot be enumerated before the graphics stack starts and "
+          "nothing is provisioned into this profile; every pack the table "
+          "offers was therefore offered");
+    }
+  }
+
+  if (!locale_resolved) {
+    resolve_policy("locale", request.locale_policies);
+  }
+  resolve_policy("theme", request.theme_policies);
+
+  DeriveWorkArea(composition.profile, panel_resolved,
+                 &composition.limitations);
+
+  // A diagnostic handle, not a claim: patch 0004 reads `id` into source_id_
+  // and nothing page-visible consumes it. Naming it after the root makes a
+  // profile traceable back to the tuple that produced it.
+  composition.profile.Set("id",
+                          "fp-" + HexEncodeLower(composition.root).substr(0, 24));
+
+  // The last line behind the pre-draw option filters. It exists for the case
+  // the filters cannot see: an option that states no requirement for the field
+  // it sets passes FilterServable untouched, so a table that grows a bucket
+  // without a `requires` block could otherwise ship a claim above host
+  // capability, and a page can falsify that by measuring parallel throughput
+  // or by allocating until it fails.
+  //
+  // The reduction helpers are used as the predicate here, never as the value.
+  // Pinning the claim to the host's own number is what the first version did,
+  // and it is a leak rather than a repair: on a fourteen-core machine every
+  // profile that drew sixteen reported exactly fourteen, which makes the
+  // host's true core count the single most likely value this binary ever
+  // emits, recoverable by launching twice. Dropping the surface leaves the
+  // host's own value in place instead, which is exactly what an unspoofed
+  // Chrome reports and is therefore not a signal at all.
+  auto inherit_surface = [&composition](std::string_view axis,
+                                        const std::string& reason) {
+    for (SurfaceRecord& record : composition.surfaces) {
+      if (record.surface == axis) {
+        record.value = "(inherited)";
+        record.layer = std::string(kLayerHostInherited);
+        record.evidence = "host-inherited";
+        record.limitation = reason;
+      }
+    }
+    composition.limitations.push_back(std::string(axis) + ": " + reason);
+  };
+
+  if (DictValue* cpu = composition.profile.FindDict("cpu")) {
+    const std::optional<int> claimed = cpu->FindInt("logical_cores");
+    if (claimed &&
+        ClampLogicalCores(*claimed, request.host.logical_cores) != *claimed) {
+      cpu->Remove("logical_cores");
+      if (cpu->empty()) {
+        composition.profile.Remove("cpu");
+      }
+      inherit_surface(
+          "cpu", "the resolved core count " + NumberToString(*claimed) +
+                     " is above this host's " +
+                     NumberToString(request.host.logical_cores) +
+                     ", and no catalogue bucket fits, so the surface was left "
+                     "inherited rather than pinned to the host's own count");
+    }
+  }
+  if (DictValue* memory = composition.profile.FindDict("memory")) {
+    const std::optional<double> claimed = memory->FindDouble("total_bytes");
+    const uint64_t claimed_bytes =
+        claimed ? static_cast<uint64_t>(*claimed) : 0;
+    if (claimed && ClampMemoryBytes(claimed_bytes,
+                                    request.host.total_memory_bytes) !=
+                       claimed_bytes) {
+      memory->Remove("total_bytes");
+      if (memory->empty()) {
+        composition.profile.Remove("memory");
+      }
+      inherit_surface(
+          "memory",
+          "the resolved installed memory " + NumberToString(claimed_bytes) +
+              " bytes is above this host's " +
+              NumberToString(request.host.total_memory_bytes) +
+              ", and no catalogue bucket fits, so the surface was left "
+              "inherited rather than pinned to the host's own figure");
+    }
+  }
+
+  return composition;
+}
+
+void DeriveWorkArea(DictValue& profile,
+                    bool panel_resolved,
+                    std::vector<std::string>* limitations) {
+  DictValue* screen = profile.FindDict("screen");
+  if (!screen) {
+    return;
+  }
+
+  const std::optional<int> inset_left = screen->FindInt("avail_inset_left");
+  const std::optional<int> inset_top = screen->FindInt("avail_inset_top");
+  const std::optional<int> inset_right = screen->FindInt("avail_inset_right");
+  const std::optional<int> inset_bottom = screen->FindInt("avail_inset_bottom");
+
+  screen->Remove("avail_inset_left");
+  screen->Remove("avail_inset_top");
+  screen->Remove("avail_inset_right");
+  screen->Remove("avail_inset_bottom");
+
+  const std::optional<int> width = screen->FindInt("width");
+  const std::optional<int> height = screen->FindInt("height");
+
+  if (!width || !height || !inset_left || !inset_top || !inset_right ||
+      !inset_bottom) {
+    // The panel axis was left inherited while furniture still contributed
+    // insets. The insets are already stripped: an inset without a panel is not
+    // a work area, and an empty section is not a claim, so the whole object
+    // goes rather than shipping "screen": {}.
+    if (!panel_resolved && screen->empty()) {
+      profile.Remove("screen");
+      if (limitations) {
+        limitations->push_back(
+            "screen: the panel axis was left inherited, so the furniture "
+            "insets have no panel to apply to and the screen section was "
+            "dropped rather than emitted empty");
+      }
+    }
+    return;
+  }
+
+  if (*inset_left + *inset_right >= *width ||
+      *inset_top + *inset_bottom >= *height) {
+    LOG(FATAL) << "apostate: furniture insets exceed the panel (" << *inset_left
+               << "+" << *inset_right << " of " << *width << ", " << *inset_top
+               << "+" << *inset_bottom << " of " << *height
+               << "); that work area cannot exist and the compiled tables are "
+                  "inconsistent";
+  }
+
+  // availLeft/availTop are panel-relative: the Windows reference capture ran
+  // on a second monitor at x=1920 and reported availLeft 1920 with a zero
+  // inset. So the inset is added to the panel origin, which is zero unless the
+  // panel states one.
+  const int origin_left = screen->FindInt("left").value_or(0);
+  const int origin_top = screen->FindInt("top").value_or(0);
+
+  screen->Set("avail_left", origin_left + *inset_left);
+  screen->Set("avail_top", origin_top + *inset_top);
+  screen->Set("avail_width", *width - *inset_left - *inset_right);
+  screen->Set("avail_height", *height - *inset_top - *inset_bottom);
+}
+
+// ---------------------------------------------------------------------------
+// The entry point
+// ---------------------------------------------------------------------------
+
+std::optional<std::string> ComposeProfileForCurrentProcess(
+    const FilePath& user_data_dir) {
+  if (!CommandLine::InitializedForCurrentProcess()) {
+    return std::nullopt;
+  }
+  const CommandLine& command_line = *CommandLine::ForCurrentProcess();
+
+  // Browser process only. A child receives the composed profile on its command
+  // line, and composing again in a child would draw its own seed and present a
+  // second device inside one browser.
+  if (command_line.HasSwitch(kProcessTypeSwitch)) {
+    return std::nullopt;
+  }
+
+  // An already-composed profile is the strongest layer in the §10 precedence,
+  // so it is not recomposed. `::switches` is base_switches.h, not this
+  // namespace's own switches.
+  if (command_line.HasSwitch(::switches::kApostateProfile)) {
+    return std::nullopt;
+  }
+
+  const SeedResolution seed = ResolveSeed(command_line);
+  const bool explain = command_line.HasSwitch(switches::kFingerprintExplain);
+
+  if (seed.rejected) {
+    RefuseLaunch(seed.limitation);
+  }
+
+  if (!seed.should_compose()) {
+    if (explain) {
+      WriteHostInheritanceReport(seed);
+      Process::TerminateCurrentProcessImmediately(0);
+    }
+    return std::nullopt;
+  }
+
+  ComposeRequest request;
+  request.seed = seed.seed;
+  request.host = ProbeHostCapability(command_line);
+  request.axes = DispersionAxes();
+  request.anchors = Anchors();
+  request.locale_policies = LocalePolicies();
+  request.theme_policies = ThemePolicies();
+  request.union_array_paths = UnionArrayPaths();
+  request.profile_schema_version = kProfileSchemaVersion;
+  request.catalogue_version = kCatalogueVersion;
+  request.chromium_version = kChromiumVersion;
+  request.catalogue_digest = kCatalogueDigest;
+  request.default_accept_languages = kDefaultAcceptLanguages;
+  // Chrome's resolved directory when the caller knows it, the explicit switch
+  // otherwise. Only font provisioning reads it; nothing is written.
+  const FilePath state_root =
+      user_data_dir.empty()
+          ? command_line.GetSwitchValuePath(kUserDataDirSwitch)
+          : user_data_dir;
+  request.state_directory = state_root.empty()
+                                ? FilePath()
+                                : state_root.AppendASCII(kStateDirectoryName);
+  request.pinned_anchor =
+      command_line.GetSwitchValueASCII(switches::kFingerprintAnchor);
+  request.accept_languages = command_line.GetSwitchValueASCII(kLangSwitch);
+
+  std::string persona_limitation;
+  if (command_line.HasSwitch(switches::kFingerprintPlatform)) {
+    const std::string requested =
+        command_line.GetSwitchValueASCII(switches::kFingerprintPlatform);
+    if (IsKnownPlatform(requested)) {
+      request.platform = requested;
+    } else {
+      persona_limitation =
+          "--fingerprint-platform named '" + requested +
+          "', which is not one of windows, macos or linux; the host's platform "
+          "was used";
+      LOG(ERROR) << "apostate: " << persona_limitation;
+    }
+  }
+
+  std::optional<Composition> composition = Compose(request);
+  if (!composition) {
+    LOG(ERROR) << "apostate: the compiled catalogue cannot serve this launch; "
+                  "inheriting the host";
+    return std::nullopt;
+  }
+
+  composition->seed_origin = seed.origin;
+  if (!seed.limitation.empty()) {
+    composition->limitations.push_back("seed: " + seed.limitation);
+  }
+  if (!persona_limitation.empty()) {
+    composition->limitations.push_back(persona_limitation);
+  }
+
+  if (explain) {
+    WriteExplainReport(*composition, request.host);
+    Process::TerminateCurrentProcessImmediately(0);
+  }
+
+  // OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION is not cosmetic here.
+  //
+  // base::Value has no 64-bit integer type, so every profile field above
+  // INT32_MAX is held as a double: memory.total_bytes,
+  // gl_limits.MAX_ELEMENT_INDEX, webgpu.limits.maxBufferSize and
+  // maxStorageBufferBindingSize, and both theme highlight ARGBs. The default
+  // writer appends ".0" to an integral double to keep it a JSON real, which
+  // would emit `8589934592.0` for a field config/profile.schema.json declares
+  // as "type": "integer" -- so the binary's own output would fail the schema
+  // the packages validate against, and would differ byte-for-byte from the
+  // reference resolver for six real fields. This flag writes an integral
+  // double in int64 range as an integer and leaves a genuinely fractional
+  // value alone, so screen.device_pixel_ratio stays 1.25.
+  const std::optional<std::string> json = WriteJsonWithOptions(
+      composition->profile, JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION);
+  if (!json) {
+    LOG(ERROR) << "apostate: the composed profile could not be serialised; "
+                  "inheriting the host";
+    return std::nullopt;
+  }
+
+  // Base64EncodeEarlyStartup rather than Base64Encode: this runs before
+  // FeatureList exists and the ordinary entry point consults a base::Feature.
+  return Base64EncodeEarlyStartup(as_byte_span(*json));
+}
+
+void InstallComposedProfile(const FilePath& user_data_dir) {
+  if (!CommandLine::InitializedForCurrentProcess()) {
+    return;
+  }
+  CommandLine* command_line = CommandLine::ForCurrentProcess();
+
+  // Already carried, either by the operator or by an earlier call. Recomposing
+  // would draw a second identity for one launch, so there is nothing to do.
+  if (command_line->HasSwitch(::switches::kApostateProfile)) {
+    return;
+  }
+
+  const std::optional<std::string> composed =
+      ComposeProfileForCurrentProcess(user_data_dir);
+  if (!composed) {
+    return;
+  }
+
+  // Onto this process's own command line, because patch 0005 builds every
+  // child's command line by copying switches from the browser's. A composed
+  // profile that does not reach the renderer is worse than none: the browser
+  // would size its pools from the claim while the renderer reported the host's
+  // cores, and navigator.hardwareConcurrency would contradict the Device-Memory
+  // header from the same session.
+  command_line->AppendSwitchASCII(::switches::kApostateProfile, *composed);
+}
