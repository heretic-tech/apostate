@@ -0,0 +1,182 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/explain.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/apostate/compose.h"
+#include "base/apostate/host_capability.h"
+#include "base/apostate/seed.h"
+#include "base/containers/span.h"
+#include "base/process/process.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace base::apostate {
+
+namespace {
+
+std::string_view SeedOriginName(SeedOrigin origin) {
+  switch (origin) {
+    case SeedOrigin::kSwitch:
+      return "--fingerprint (stable across launches)";
+    case SeedOrigin::kGenerated:
+      return "drawn from OS entropy for this launch only";
+    case SeedOrigin::kHostInheritance:
+      return "none: the host is inherited";
+  }
+  return "unknown";
+}
+
+void AppendField(std::string& out, std::string_view name, std::string_view value) {
+  out += "  ";
+  out += name;
+  // Two columns, so the report stays greppable by field name.
+  for (size_t i = name.size(); i < 20; ++i) {
+    out += ' ';
+  }
+  out += value;
+  out += '\n';
+}
+
+void AppendPadded(std::string& out, std::string_view text, size_t width) {
+  out += text;
+  for (size_t i = text.size(); i < width; ++i) {
+    out += ' ';
+  }
+}
+
+void AppendLimitations(std::string& out,
+                       span<const std::string> limitations) {
+  out += '\n';
+  if (limitations.empty()) {
+    out += "limitations\n  none\n";
+    return;
+  }
+  out += "limitations\n";
+  for (const std::string& limitation : limitations) {
+    out += "  - ";
+    out += limitation;
+    out += '\n';
+  }
+}
+
+void WriteTo(std::FILE* stream, const std::string& text) {
+  // fprintf with a literal format, not fwrite, not fputs, and not
+  // WriteFileDescriptor. Chromium builds with -Wunsafe-buffer-usage, which
+  // rejects the pointer+size libc form outright and makes fputs require an
+  // UNSAFE_TODO; and base/files/file_util.h declares WriteFileDescriptor only
+  // on POSIX and Fuchsia, while base/BUILD.gn compiles this file on Windows
+  // too. The flush is because this runs during early startup, where the
+  // process can exit before a buffered stream drains.
+  std::fprintf(stream, "%s", text.c_str());
+  std::fflush(stream);
+}
+
+}  // namespace
+
+std::string FormatExplainReport(const Composition& composition,
+                                const HostCapability& host) {
+  std::string out = "apostate fingerprint composition\n\n";
+
+  AppendField(out, "chromium", composition.chromium_version);
+  AppendField(out, "profile schema", composition.profile_schema_version);
+  AppendField(out, "catalogue",
+              "v" + composition.catalogue_version + " (tables " +
+                  composition.catalogue_digest + ")");
+  AppendField(out, "platform persona", composition.platform);
+  AppendField(out, "host platform",
+              composition.host_platform.empty() ? "(unknown)"
+                                                : composition.host_platform);
+  AppendField(out, "host cores", NumberToString(host.logical_cores));
+  AppendField(out, "host memory",
+              NumberToString(host.total_memory_bytes) + " bytes");
+  AppendField(out, "host backend",
+              host.graphics_backend +
+                  (host.graphics_backend_is_inferred
+                       ? " (platform default, not probed)"
+                       : " (from --use-angle)"));
+  if (host.window_width > 0 && host.window_height > 0) {
+    AppendField(out, "window bounds",
+                NumberToString(host.window_width) + "x" +
+                    NumberToString(host.window_height));
+  }
+  AppendField(out, "seed", composition.seed);
+  AppendField(out, "seed source", SeedOriginName(composition.seed_origin));
+  // The one thing an operator wants from a random launch: the exact argument
+  // that reproduces it. There is no seed file to read it out of any more, so
+  // the report is where it comes from.
+  AppendField(out, "reproduce with", "--fingerprint=" + composition.seed);
+  AppendField(out, "root", HexEncodeLower(composition.root));
+
+  // Column widths from the data, so nothing is ever truncated: a truncated
+  // renderer string is exactly the kind of detail this report exists to show.
+  size_t surface_width = std::string_view("surface").size();
+  size_t layer_width = std::string_view("layer").size();
+  size_t evidence_width = std::string_view("evidence").size();
+  for (const SurfaceRecord& record : composition.surfaces) {
+    surface_width = std::max(surface_width, record.surface.size());
+    layer_width = std::max(layer_width, record.layer.size());
+    evidence_width = std::max(evidence_width, record.evidence.size());
+  }
+
+  out += '\n';
+  AppendPadded(out, "surface", surface_width + 2);
+  AppendPadded(out, "layer", layer_width + 2);
+  AppendPadded(out, "evidence", evidence_width + 2);
+  out += "value\n";
+
+  for (const SurfaceRecord& record : composition.surfaces) {
+    AppendPadded(out, record.surface, surface_width + 2);
+    AppendPadded(out, record.layer, layer_width + 2);
+    AppendPadded(out, record.evidence, evidence_width + 2);
+    out += record.value;
+    out += '\n';
+    if (!record.limitation.empty()) {
+      out += "  ! ";
+      out += record.limitation;
+      out += '\n';
+    }
+  }
+
+  AppendLimitations(out, composition.limitations);
+  return out;
+}
+
+void WriteExplainReport(const Composition& composition,
+                        const HostCapability& host) {
+  WriteTo(stdout, FormatExplainReport(composition, host));
+}
+
+std::string FormatHostInheritanceReport(const SeedResolution& seed) {
+  std::string out = "apostate fingerprint composition\n\n";
+  AppendField(out, "composition", "disabled");
+  AppendField(out, "seed source", SeedOriginName(seed.origin));
+  out +=
+      "\nEvery surface is the host's own value, which is what --fingerprint=host\n"
+      "asks for. No layer below it is active, so there is nothing to report per\n"
+      "surface: the profile is the host.\n";
+
+  std::vector<std::string> limitations;
+  if (!seed.limitation.empty()) {
+    limitations.push_back(seed.limitation);
+  }
+  AppendLimitations(out, limitations);
+  return out;
+}
+
+void WriteHostInheritanceReport(const SeedResolution& seed) {
+  WriteTo(stdout, FormatHostInheritanceReport(seed));
+}
+
+void RefuseLaunch(std::string_view reason) {
+  WriteTo(stderr, "apostate: " + std::string(reason) + "\n");
+  Process::TerminateCurrentProcessImmediately(1);
+}
+
+}  // namespace base::apostate
