+std::vector<SyntheticMediaDevice> SyntheticAudioOutputDevices(
+    size_t host_device_count) {
+  const Profile* profile = Profile::Get();
+  if (!profile) {
+    return {};
+  }
+  return Build(*profile, profile->media_audiooutput_count(), "audiooutput",
+               kAudioOutputPrefix, host_device_count);
