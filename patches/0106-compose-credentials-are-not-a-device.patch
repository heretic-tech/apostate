+// Reports the switches a supplied device profile made inert.
+//
+// A profile supplied through --apostate-profile outranks a seed, a persona and
+// a per-field override by the documented precedence, so this is not the
+// contradiction host mode refuses -- there is a profile, it is the one asked
+// for, and the switches below it have nothing left to shape. It is still the
+// one branch where --fingerprint could be passed and do nothing without a word
+// said, and a silently ignored --fingerprint is the failure this file exists to
+// avoid: the operator believes they are wearing a composed device.
+//
+// So it is named, in the two places a diagnostic belongs. Nothing a page can
+// read changes: the log goes to stderr and the report to stdout, and neither is
+// reachable from any web surface.
+void ReportAuthoredProfileBypass(const CommandLine& command_line,
+                                 bool explain) {
+  std::vector<std::string> inert;
+  if (command_line.HasSwitch(switches::kFingerprint)) {
+    inert.emplace_back(switches::kFingerprint);
+  }
+  for (const std::string_view name : kShapingSwitches) {
+    if (command_line.HasSwitch(name)) {
+      inert.emplace_back(name);
+    }
+  }
+
+  if (!inert.empty()) {
+    std::string named;
+    for (const std::string& name : inert) {
+      named += named.empty() ? "--" : ", --";
+      named += name;
+    }
+    LOG(ERROR) << "apostate: --apostate-profile supplied a device profile, "
+                  "which outranks composition, so "
+               << named
+               << " had no effect on this launch; --fingerprint-explain "
+                  "reports the same thing in full";
+  }
+
+  if (explain) {
+    WriteAuthoredProfileReport(inert);
+    Process::TerminateCurrentProcessImmediately(0);
+  }
+}
