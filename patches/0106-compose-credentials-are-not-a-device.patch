+std::string FormatAuthoredProfileReport(span<const std::string> inert) {
+  std::string out = "apostate fingerprint composition\n\n";
+  AppendField(out, "composition", "bypassed");
+  AppendField(out, "profile source", "--apostate-profile");
+  out +=
+      "\nThe profile was supplied whole through --apostate-profile, the strongest\n"
+      "layer in the launch precedence, so nothing was composed and there is no\n"
+      "derivation to report per surface: the profile is the one you passed. Every\n"
+      "surface it does not name stays the host's, because a profile that does not\n"
+      "describe a surface leaves it inherited rather than have a value invented\n"
+      "for it here.\n";
+
+  std::vector<std::string> limitations;
+  for (const std::string& name : inert) {
+    limitations.push_back("--" + name +
+                          " had no effect: the supplied profile bypasses "
+                          "composition, so there is nothing for it to shape");
+  }
+  AppendLimitations(out, limitations);
+  return out;
+}
+
+void WriteAuthoredProfileReport(span<const std::string> inert) {
+  WriteTo(stdout, FormatAuthoredProfileReport(inert));
+}
