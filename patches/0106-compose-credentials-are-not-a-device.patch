 // static
+bool Profile::PayloadDescribesDevice(const std::string& encoded) {
+  std::string json;
+  if (!Base64Decode(encoded, &json)) {
+    return true;
+  }
+  std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!dict) {
+    return true;
+  }
+
+  // The envelope form. An empty `device_profile` is what the launcher sends
+  // for a launch that authenticates to a proxy and authors nothing, and an
+  // empty section is not a claim anywhere else in this codebase either.
+  // wiring-exempt: device_profile - the switch envelope, not a profile field.
+  if (const DictValue* envelope = dict->FindDict("device_profile")) {
+    return !envelope->empty();
+  }
+
+  // The bare form. Every key in it is a profile field except the one that is
+  // not, so the payload claims a device exactly when it holds something other
+  // than credentials. Counted rather than iterated because the question is
+  // whether anything else is there, not what it is.
+  // wiring-exempt: proxy_credentials - kept out of the device-profile schema.
+  return dict->size() > (dict->contains("proxy_credentials") ? 1u : 0u);
+}
+
+// static
+std::optional<std::string> Profile::PayloadWithSuppliedCredentials(
+    const std::string& supplied,
+    const std::string& composed) {
+  std::string supplied_json;
+  std::string composed_json;
+  if (!Base64Decode(supplied, &supplied_json) ||
+      !Base64Decode(composed, &composed_json)) {
+    return std::nullopt;
+  }
+  std::optional<DictValue> dict =
+      JSONReader::ReadDict(supplied_json, JSON_PARSE_RFC);
+  std::optional<DictValue> device =
+      JSONReader::ReadDict(composed_json, JSON_PARSE_RFC);
+  if (!dict || !device) {
+    return std::nullopt;
+  }
+  // wiring-exempt: proxy_credentials - kept out of the device-profile schema.
+  DictValue* credentials = dict->FindDict("proxy_credentials");
+  if (!credentials) {
+    return std::nullopt;
+  }
+
+  DictValue envelope;
+  envelope.Set("device_profile", std::move(*device));
+  envelope.Set("proxy_credentials", std::move(*credentials));
+
+  // The same writer options the compositor serialises the bare form with.
+  // base::Value has no 64-bit integer type, so six real profile fields are
+  // held as doubles and the default writer would append ".0" to each, emitting
+  // a profile that fails the schema the packages validate against. Wrapping a
+  // profile must not change its bytes.
+  const std::optional<std::string> json = WriteJsonWithOptions(
+      envelope, JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION);
+  if (!json) {
+    return std::nullopt;
+  }
+  // Base64EncodeEarlyStartup rather than Base64Encode: this runs before
+  // FeatureList exists and the ordinary entry point consults a base::Feature.
+  return Base64EncodeEarlyStartup(as_byte_span(*json));
+}
