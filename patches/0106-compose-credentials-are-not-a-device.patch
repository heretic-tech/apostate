+// ---------------------------------------------------------------------------
+// What an --apostate-profile payload claims
+// ---------------------------------------------------------------------------
+
+// The predicate the launch precedence turns on. A payload that claims a device
+// replaces the composed one; a payload that claims none must not, or an
+// authenticated proxy -- whose credentials have no switch of their own and so
+// have nowhere to travel but this payload -- costs the launch every axis it
+// never mentioned.
+TEST(ApostateComposeTest, OnlyAPayloadWithDeviceContentClaimsADevice) {
+  struct Case {
+    std::string_view json;
+    bool claims;
+    std::string_view why;
+  };
+  static constexpr auto kCases = std::to_array<Case>({
+      // A bare profile, whole or partial. Partial is the case that must not
+      // change: absent fields staying absent is what makes a single-surface
+      // payload usable for testing, so one surface is still a device claim and
+      // this is a predicate rather than a merge.
+      {R"({"cpu":{"logical_cores":8},"screen":{"width":1710}})", true,
+       "a bare profile"},
+      {R"({"screen":{"width":1710}})", true, "a bare single-surface profile"},
+      {R"({"locale":{"accept_languages":"en-US,en"}})", true,
+       "a bare locale-only profile"},
+      // The envelope form with a device profile in it.
+      {R"({"device_profile":{"screen":{"width":1710}},)"
+       R"("proxy_credentials":{"username":"u","password":"p"}})",
+       true, "an envelope around a single-surface profile"},
+      // The envelope form with nothing in the device half, which is what a
+      // launch that authenticates to a proxy and authors no profile sends.
+      {R"({"device_profile":{},)"
+       R"("proxy_credentials":{"username":"u","password":"p"}})",
+       false, "credentials beside an empty device profile"},
+      // The same intent written by hand, with the empty key left out.
+      {R"({"proxy_credentials":{"username":"u","password":"p"}})", false,
+       "credentials with no device_profile key at all"},
+      {"{}", false, "an empty payload"},
+      // Undecidable rather than empty. The loader refuses this; answering "no
+      // device" would replace an operator's malformed profile with a composed
+      // one and launch without a word, which is the outcome that refusal
+      // exists to prevent.
+      {R"(["not","an","object"])", true, "JSON that is not an object"},
+  });
+
+  for (const Case& test : kCases) {
+    EXPECT_EQ(test.claims, Profile::PayloadDescribesDevice(
+                               Base64Encode(as_byte_span(test.json))))
+        << test.why;
+  }
+
+  // Not base64, so there is nothing to inspect: the shape of the mistake 0083
+  // refuses, a path where the encoded bytes were wanted.
+  EXPECT_TRUE(Profile::PayloadDescribesDevice("/tmp/profile.json"));
+}
+
+// The other half. A payload claiming no device is composed over, so the
+// credentials it carried have to survive that -- otherwise the fix trades a
+// host-inherited fingerprint for a proxy connection that cannot authenticate.
+TEST(ApostateComposeTest, TheComposedProfileKeepsTheCredentialsItReplaced) {
+  // memory.total_bytes is above INT32_MAX, so base::Value holds it as a double
+  // and the default writer would emit 8589934592.0 for a key
+  // config/profile.schema.json declares as an integer. Re-enveloping a profile
+  // must not change its bytes.
+  const std::string composed = Base64Encode(as_byte_span(std::string_view(
+      R"({"memory":{"total_bytes":8589934592},"screen":{"width":1710}})")));
+  const std::string supplied = Base64Encode(as_byte_span(std::string_view(
+      R"({"device_profile":{},)"
+      R"("proxy_credentials":{"password":"p","username":"u"}})")));
+
+  const std::optional<std::string> merged =
+      Profile::PayloadWithSuppliedCredentials(supplied, composed);
+  ASSERT_TRUE(merged);
+
+  std::string json;
+  ASSERT_TRUE(Base64Decode(*merged, &json));
+  EXPECT_EQ(
+      R"({"device_profile":{"memory":{"total_bytes":8589934592},)"
+      R"("screen":{"width":1710}},)"
+      R"("proxy_credentials":{"password":"p","username":"u"}})",
+      json);
+
+  // The result claims a device, so it suppresses composition exactly as an
+  // authored payload does. That is what stops the next caller, and every child
+  // process, from drawing a second identity inside one launch.
+  EXPECT_TRUE(Profile::PayloadDescribesDevice(*merged));
+
+  // Nothing to carry, so the composed profile is installed as it stands and
+  // the bare form is still reachable.
+  EXPECT_FALSE(Profile::PayloadWithSuppliedCredentials(
+      Base64Encode(as_byte_span(std::string_view("{}"))), composed));
+}
