+void WebGPUDecoderImpl::DeviceGetFeaturesImpl(
+    WGPUDevice device,
+    WGPUSupportedFeatures* features_out) {
+  const DawnProcTable& procs = dawn::native::GetProcs();
+  procs.deviceGetFeatures(device, features_out);
+  if (!claimed_device_request_ || claimed_device_request_->features.empty()) {
+    return;
+  }
+  // The device's own features plus the claimed ones the page required, the
+  // web-visible ones first in Dawn's order as the backend would list them.
+  std::vector<wgpu::FeatureName> granted;
+  for (size_t i = 0; i < features_out->featureCount; ++i) {
+    granted.push_back(
+        static_cast<wgpu::FeatureName>(UNSAFE_TODO(features_out->features[i])));
+  }
+  procs.supportedFeaturesFreeMembers(*features_out);
+  std::vector<wgpu::FeatureName> reported;
+  for (wgpu::FeatureName feature : kClaimableFeatures) {
+    if (std::ranges::contains(granted, feature) ||
+        std::ranges::contains(claimed_device_request_->features, feature)) {
+      reported.push_back(feature);
+    }
+  }
+  for (wgpu::FeatureName feature : granted) {
+    if (!std::ranges::contains(kClaimableFeatures, feature)) {
+      reported.push_back(feature);
+    }
+  }
+  WGPUFeatureName* features = new WGPUFeatureName[reported.size()];
+  uint32_t index = 0;
+  for (wgpu::FeatureName feature : reported) {
+    UNSAFE_TODO(features[index++]) = static_cast<WGPUFeatureName>(feature);
+  }
+  features_out->featureCount = reported.size();
+  features_out->features = features;
+}
