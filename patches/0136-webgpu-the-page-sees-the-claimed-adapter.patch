+// Every WebGPU limit a page can read or require, spelled the way the IDL and
+// the profile spell them, in the order Dawn validates a device request.
+// X(side, maximum, name): `side` says whether the limit is in wgpu::Limits or
+// in the chained compatibility struct, and `maximum` is false for the two
+// alignments, where the smaller value is the better one.
+#define APOSTATE_WEBGPU_LIMITS(X)                          \
+  X(Core, true, maxComputeWorkgroupStorageSize)            \
+  X(Core, true, maxComputeInvocationsPerWorkgroup)         \
+  X(Core, true, maxComputeWorkgroupSizeX)                  \
+  X(Core, true, maxComputeWorkgroupSizeY)                  \
+  X(Core, true, maxComputeWorkgroupSizeZ)                  \
