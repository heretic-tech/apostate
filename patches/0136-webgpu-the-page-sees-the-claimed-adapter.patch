+const std::set<std::string>* WebGPUDecoderImpl::ClaimedFeatures() const {
+  const auto* profile = base::apostate::Profile::Get();
+  if (!profile_software_webgpu_ || !profile ||
+      profile->webgpu_features().empty()) {
+    return nullptr;
+  }
