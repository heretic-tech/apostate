+
+bool IsClaimedFeature(const std::set<std::string>& claimed,
+                      wgpu::FeatureName feature) {
+  const dawn::native::FeatureInfo* info = dawn::native::GetFeatureInfo(feature);
+  return info != nullptr && claimed.contains(info->name);
+}
+
+bool IsLimitUndefined(uint32_t value) {
+  return value == wgpu::kLimitU32Undefined;
+}
+bool IsLimitUndefined(uint64_t value) {
+  return value == wgpu::kLimitU64Undefined;
+}
+
+wgpu::CompatibilityModeLimits* FindCompatibilityLimits(
+    const wgpu::Limits& limits) {
+  for (wgpu::ChainedStructOut* chain = limits.nextInChain; chain != nullptr;
+       chain = chain->nextInChain) {
+    if (chain->sType == wgpu::SType::CompatibilityModeLimits) {
+      return static_cast<wgpu::CompatibilityModeLimits*>(chain);
+    }
+  }
+  return nullptr;
+}
+
+// Calls visit(maximum, name, a_value, b_value) for every limit both sides
+// carry, in the order of APOSTATE_WEBGPU_LIMITS.
+template <typename A, typename B, typename Visit>
+void ForEachLimit(A& a, B& b, Visit visit) {
+  wgpu::CompatibilityModeLimits* a_compat = FindCompatibilityLimits(a);
+  wgpu::CompatibilityModeLimits* b_compat = FindCompatibilityLimits(b);
+#define APOSTATE_VISIT_Core(maximum, name) \
+  visit(maximum, #name, a.name, b.name);
+#define APOSTATE_VISIT_Compat(maximum, name)               \
+  if (a_compat != nullptr && b_compat != nullptr) {        \
+    visit(maximum, #name, a_compat->name, b_compat->name); \
+  }
+#define X(side, maximum, name) APOSTATE_VISIT_##side(maximum, name)
+  APOSTATE_WEBGPU_LIMITS(X)
+#undef X
+#undef APOSTATE_VISIT_Compat
+#undef APOSTATE_VISIT_Core
+}
+
+// True when the defined `value` is a better limit than `bound`.
+template <typename T>
+bool IsBetterLimit(bool maximum, T value, T bound) {
+  return !IsLimitUndefined(value) && (maximum ? value > bound : value < bound);
+}
+
+template <typename T>
+void ServeClaimedLimit(const std::map<std::string, uint64_t>& claimed,
+                       const char* name,
+                       T& value) {
+  const auto it = claimed.find(name);
+  if (it != claimed.end() && it->second < std::numeric_limits<T>::max()) {
+    value = static_cast<T>(it->second);
+  }
+}
+
+// Replaces every limit the profile names with the claimed value.
+void ServeClaimedLimits(const std::map<std::string, uint64_t>& claimed,
+                        wgpu::Limits& limits) {
+  ForEachLimit(limits, limits,
+               [&](bool, const char* name, auto&, auto& value) {
+                 ServeClaimedLimit(claimed, name, value);
+               });
+}
+
+// The error a device with `supported` limits gives a request for more, in
+// Dawn's words, or nothing when the request is within them.
+std::optional<std::string> LimitBeyond(const wgpu::Limits& supported,
+                                       const wgpu::Limits& required) {
+  std::optional<std::string> error;
+  ForEachLimit(supported, required,
+               [&](bool maximum, const char* name, const auto& bound,
+                   const auto& value) {
+                 if (error || !IsBetterLimit(maximum, value, bound)) {
+                   return;
+                 }
+                 error = base::StrCat(
+                     {"Required limit (", base::NumberToString(value), ") is ",
+                      maximum ? "greater" : "lower",
+                      " than the supported limit (", base::NumberToString(bound),
+                      ").\n - While validating ", name,
+                      "\n - While validating required limits\n"});
+               });
+  return error;
+}
+
+// Moves each limit the page requires down to what the backend supports, so
+// the real device is created within what the backend can run.
+void FitLimits(const wgpu::Limits& supported, wgpu::Limits& required) {
+  ForEachLimit(supported, required,
+               [](bool maximum, const char*, const auto& bound, auto& value) {
+                 if (IsBetterLimit(maximum, value, bound)) {
+                   value = bound;
+                 }
+               });
+}
+
+// Reports each limit the page required as granted where the device was
+// created with less.
+void ReportRequestedLimits(const wgpu::Limits& requested,
+                           wgpu::Limits& reported) {
+  ForEachLimit(requested, reported,
+               [](bool maximum, const char*, const auto& value, auto& granted) {
+                 if (IsBetterLimit(maximum, value, granted)) {
+                   granted = value;
+                 }
+               });
+}
