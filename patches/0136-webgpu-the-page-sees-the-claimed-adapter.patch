+  X(Core, true, maxDynamicStorageBuffersPerPipelineLayout) \
+  X(Core, true, maxSampledTexturesPerShaderStage)          \
+  X(Core, true, maxSamplersPerShaderStage)                 \
+  X(Core, true, maxStorageTexturesPerShaderStage)          \
+  X(Compat, true, maxStorageTexturesInFragmentStage)       \
+  X(Compat, true, maxStorageTexturesInVertexStage)         \
+  X(Core, true, maxUniformBuffersPerShaderStage)           \
+  X(Core, true, maxStorageBuffersPerShaderStage)           \
+  X(Compat, true, maxStorageBuffersInFragmentStage)        \
+  X(Compat, true, maxStorageBuffersInVertexStage)          \
+  X(Core, true, maxColorAttachmentBytesPerSample)          \
+  X(Core, true, maxInterStageShaderVariables)              \
+  X(Core, true, maxTextureDimension1D)                     \
+  X(Core, true, maxTextureDimension2D)                     \
+  X(Core, true, maxTextureDimension3D)                     \
+  X(Core, true, maxTextureArrayLayers)                     \
+  X(Core, true, maxImmediateSize)                          \
+  X(Core, true, maxBindGroups)                             \
+  X(Core, true, maxBindGroupsPlusVertexBuffers)            \
+  X(Core, true, maxBindingsPerBindGroup)                   \
+  X(Core, true, maxUniformBufferBindingSize)               \
+  X(Core, false, minUniformBufferOffsetAlignment)          \
+  X(Core, false, minStorageBufferOffsetAlignment)          \
+  X(Core, true, maxVertexBuffers)                          \
+  X(Core, true, maxVertexAttributes)                       \
+  X(Core, true, maxVertexBufferArrayStride)                \
+  X(Core, true, maxColorAttachments)
+
+// The features a page can be told about, in Dawn's own order so a list built
+// from them reads the way the backend's would.
