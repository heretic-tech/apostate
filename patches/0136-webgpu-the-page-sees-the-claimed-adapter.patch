+WGPUStatus WebGPUDecoderImpl::AdapterGetInfoImpl(WGPUAdapter adapter,
+                                                 WGPUAdapterInfo* info) {
+  const WGPUStatus status =
+      dawn::native::GetProcs().adapterGetInfo(adapter, info);
+  const auto* profile = base::apostate::Profile::Get();
+  if (status != WGPUStatus_Success || !profile_software_webgpu_ || !profile ||
+      info->adapterType != WGPUAdapterType_CPU) {
+    return status;
+  }
+  // SwiftShader reports itself as a CPU adapter, which a page reads as
+  // isFallbackAdapter. The device it stands in for is a GPU.
+  const std::string& vendor = profile->webgpu_vendor();
+  info->adapterType = vendor == "nvidia" || vendor == "amd"
+                          ? WGPUAdapterType_DiscreteGPU
+                          : WGPUAdapterType_IntegratedGPU;
+  if (profile->webgpu_subgroup_min() > 0) {
+    info->subgroupMinSize = profile->webgpu_subgroup_min();
+  }
