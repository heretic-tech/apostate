+
+# The same source set on the remaining targets whose config enables the
+# decoder. Held apart from the linux/x64 stanza above because that one is a
+# single target and this list is arch-independent; the conditions are disjoint,
+# so no target receives a name twice.
+if ((ffmpeg_branding == "Chrome" && current_cpu == "x64" &&
+     os_config == "win") ||
+    ((current_cpu == "arm64" || current_cpu == "arm64e") &&
+     ffmpeg_branding == "Chrome" && os_config == "linux")) {
+  ffmpeg_c_sources += [
+    "libavcodec/bswapdsp.c",
+    "libavcodec/hevc/autorename_libavcodec_hevc_cabac.c",
+    "libavcodec/hevc/autorename_libavcodec_hevc_parse.c",
+    "libavcodec/hevc/autorename_libavcodec_hevc_parser.c",
+    "libavcodec/hevc/data.c",
+    "libavcodec/hevc/dsp.c",
+    "libavcodec/hevc/filter.c",
+    "libavcodec/hevc/hevcdec.c",
+    "libavcodec/hevc/mvs.c",
+    "libavcodec/hevc/pred.c",
+    "libavcodec/hevc/ps.c",
+    "libavcodec/hevc/refs.c",
+    "libavcodec/hevc/sei.c",
+  ]
+  ffmpeg_c_deps += [
+    "libavcodec/hevc/cabac.c",
+    "libavcodec/hevc/parse.c",
+    "libavcodec/hevc/parser.c",
+  ]
+}
+
+# The x86 half, shared with the linux/x64 stanza above. os_config "win-msvc" is
+# absent because our Windows target is clang, and "linux-noasm" because MSAN
+# builds without assembly and BUILD.gn strips these sources.
+if (ffmpeg_branding == "Chrome" && current_cpu == "x64" && os_config == "win") {
+  ffmpeg_c_sources += [
+    "libavcodec/x86/bswapdsp_init.c",
+    "libavcodec/x86/h26x/h2656dsp.c",
+    "libavcodec/x86/hevc/dsp_init.c",
   ]
+  ffmpeg_asm_sources += [
+    "libavcodec/x86/autorename_libavcodec_x86_bswapdsp.asm",
+    "libavcodec/x86/h26x/h2656_inter.asm",
+    "libavcodec/x86/hevc/add_res.asm",
+    "libavcodec/x86/hevc/deblock.asm",
+    "libavcodec/x86/hevc/dequant.asm",
+    "libavcodec/x86/hevc/idct.asm",
+    "libavcodec/x86/hevc/mc.asm",
+    "libavcodec/x86/hevc/sao.asm",
+    "libavcodec/x86/hevc/sao_10bit.asm",
+  ]
+  ffmpeg_asm_deps += [ "libavcodec/x86/bswapdsp.asm" ]
   ffmpeg_asm_include_dirs += [
     "//third_party/ffmpeg/libavcodec/x86",
     "//third_party/ffmpeg/libavcodec/x86/h26x",
     "//third_party/ffmpeg/libavcodec/x86/hevc",
   ]
 }
+
+# The arm64 half. hevc/dsp.c:262 and hevc/pred.c:82 call
+# ff_hevc_dsp_init_aarch64 and ff_hevc_pred_init_aarch64 unconditionally under
+# ARCH_AARCH64, so these are required rather than optional, and the set is the
+# nine objects libavcodec/aarch64/Makefile lists for CONFIG_HEVC_DECODER --
+# three of which live in aarch64/h26x. There is no arm64 counterpart to the
+# x86 bswapdsp asm: bswapdsp.c dispatches only on ARCH_RISCV and ARCH_X86, so
+# aarch64 runs its C implementation.
+if ((current_cpu == "arm64" || current_cpu == "arm64e") &&
+    ffmpeg_branding == "Chrome" && os_config == "linux") {
+  ffmpeg_c_sources += [
+    "libavcodec/aarch64/hevcdsp_init_aarch64.c",
+    "libavcodec/aarch64/hevcpred_init_aarch64.c",
+  ]
+  ffmpeg_gas_sources += [
+    "libavcodec/aarch64/h26x/epel_neon.S",
+    "libavcodec/aarch64/h26x/qpel_neon.S",
+    "libavcodec/aarch64/h26x/sao_neon.S",
+    "libavcodec/aarch64/hevcdsp_deblock_neon.S",
+    "libavcodec/aarch64/hevcdsp_dequant_neon.S",
+    "libavcodec/aarch64/hevcdsp_idct_neon.S",
+    "libavcodec/aarch64/hevcpred_neon.S",
+  ]
+}
