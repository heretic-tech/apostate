Subject: [PATCH] tests: standalone check for the software WebGPU provider

Adds a Linux test program that loads only a hash-checked SwiftShader
library, requests real WebGPU Core devices, and checks their limits,
validation and small compute and texture transfers. It uses no unsafe
WebGPU switches. It is test-only and changes nothing a page sees.

diff --git a/gpu/BUILD.gn b/gpu/BUILD.gn
--- a/gpu/BUILD.gn
+++ b/gpu/BUILD.gn
@@ -983,3 +983,24 @@
     deps += [ "//ui/ozone" ]
   }
 }
+
+# Standalone diagnostic only. No browser, installer or runtime target depends on it.
+# Non-component linkage is required for the test's strict dlopen/dlerror boundary.
+if (is_linux && use_dawn && !is_component_build) {
+  executable("apostate_dawn_software_check") {
+    testonly = true
+    sources = [ "apostate_dawn_software_check.cc" ]
+    deps = [
+      "//base",
+      "//crypto",
+      "//third_party/dawn/include/dawn:cpp_headers",
+      "//third_party/dawn/src/dawn:proc",
+      "//third_party/dawn/src/dawn/native:native",
+    ]
+    libs = [ "dl" ]
+    ldflags = [
+      "-Wl,--wrap=dlopen",
+      "-Wl,--wrap=dlerror",
+    ]
+  }
+}
diff --git a/gpu/apostate_dawn_software_check.cc b/gpu/apostate_dawn_software_check.cc
new file mode 100644
--- /dev/null
+++ b/gpu/apostate_dawn_software_check.cc
@@ -0,0 +1,552 @@
+// Test-only executable. Never add this target to browser packaging.
+#include <dlfcn.h>
+#include <unistd.h>
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <iterator>
+#include <utility>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "crypto/sha2.h"
+#include "dawn/dawn_proc.h"
+#include "dawn/native/DawnNative.h"
+#include "dawn/webgpu_cpp.h"
+#include "dawn/webgpu_cpp_print.h"
+
+namespace {
+// The executable is non-component so Dawn's dlopen calls pass through this
+// link-time wrapper. No default Vulkan loader or other ICD may be opened.
+std::atomic<bool> provider_ready{false};
+std::atomic<unsigned> denied_loads{0};
+std::atomic<unsigned> provider_loads{0};
+thread_local bool denied_error_pending = false;
+constexpr char kProvider[] = "/provider/libvk_swiftshader.so";
+constexpr char kICD[] = "/provider/vk_swiftshader_icd.json";
+constexpr uint64_t kWaitNanoseconds = 5'000'000'000;
+
+std::string Text(wgpu::StringView view) {
+  if (!view.data) return {};
+  return view.length == WGPU_STRLEN ? std::string(view.data)
+                                   : std::string(view.data, view.length);
+}
+
+struct Request {
+  bool done = false;
+  wgpu::RequestDeviceStatus status = wgpu::RequestDeviceStatus::Error;
+  wgpu::Device device;
+  std::string message;
+};
+struct Mapped {
+  bool done = false;
+  wgpu::MapAsyncStatus status = wgpu::MapAsyncStatus::Error;
+};
+struct Scope {
+  bool done = false;
+  wgpu::PopErrorScopeStatus status = wgpu::PopErrorScopeStatus::Error;
+  wgpu::ErrorType type = wgpu::ErrorType::Unknown;
+};
+struct State {
+  base::DictValue report;
+  std::mutex mutex;
+  std::vector<std::string> errors;
+  std::vector<std::string> diagnostics;
+  // Callback storage outlives every device and the native instance, including
+  // cancellation after a bounded wait fails.
+  std::deque<Request> requests;
+  std::deque<Mapped> maps;
+  std::deque<Scope> scopes;
+  unsigned adapter_requests = 0;
+  void Error(std::string message) {
+    std::lock_guard<std::mutex> lock(mutex);
+    errors.push_back(std::move(message));
+  }
+};
+#define REQUIRE(state, condition, message) \
+  do { if (!(condition)) { (state).Error(message); return false; } } while (false)
+
+bool VerifyHash(const base::FilePath& path, std::string expected, State& state) {
+  std::string data;
+  REQUIRE(state, expected.size() == 64, "SHA256 pin is missing");
+  REQUIRE(state, !base::IsLink(path), "Pinned input must not be a symlink");
+  REQUIRE(state, base::ReadFileToString(path, &data), "Cannot read pinned input");
+  std::string hash = crypto::SHA256HashString(data);
+  const std::string actual = base::ToLowerASCII(base::HexEncode(std::string_view(hash)));
+  REQUIRE(state, actual == expected, "Pinned input SHA256 mismatch");
+  return true;
+}
+
+bool Preflight(const base::CommandLine& command, State& state) {
+  for (const char* path : {"/dev/dri", "/dev/kfd", "/dev/dxg", "/dev/nvidiactl", "/dev/nvidia0", "/dev/vfio"}) {
+    REQUIRE(state, !base::PathExists(base::FilePath(path)), "Physical GPU device nodes are visible");
+  }
+  REQUIRE(state, !getenv("DISPLAY") && !getenv("WAYLAND_DISPLAY") && !getenv("LD_PRELOAD") &&
+          !getenv("LD_AUDIT") && !getenv("LD_LIBRARY_PATH") && !getenv("VK_ADD_DRIVER_FILES"),
+          "Display or preload environment is present");
+  for (const char* name : {"VK_DRIVER_FILES", "VK_ICD_FILENAMES"}) {
+    const char* value = getenv(name);
+    REQUIRE(state, value && std::string_view(value) == kICD, "Software ICD environment is not pinned");
+  }
+  REQUIRE(state, VerifyHash(base::FilePath(kProvider), command.GetSwitchValueASCII("provider-sha256"), state),
+          "Provider verification failed");
+  REQUIRE(state, VerifyHash(base::FilePath(kICD), command.GetSwitchValueASCII("icd-sha256"), state),
+          "ICD verification failed");
+  std::string json;
+  REQUIRE(state, base::ReadFileToString(base::FilePath(kICD), &json), "Cannot read ICD JSON");
+  auto icd = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  REQUIRE(state, icd.has_value(), "Malformed ICD JSON");
+  const std::string* library = icd->FindStringByDottedPath("ICD.library_path");
+  REQUIRE(state, library && (*library == "libvk_swiftshader.so" || *library == kProvider ||
+                            *library == "./libvk_swiftshader.so"), "ICD points outside provider");
+  provider_ready.store(true);
+  state.report.Set("provider_verified", true);
+  state.report.Set("provider_sha256", command.GetSwitchValueASCII("provider-sha256"));
+  state.report.Set("icd_sha256", command.GetSwitchValueASCII("icd-sha256"));
+  return true;
+}
+
+base::DictValue LimitsJSON(const wgpu::Limits& value) {
+  base::DictValue result;
+  result.Set("maxTextureDimension1D", static_cast<double>(value.maxTextureDimension1D));
+  result.Set("maxTextureDimension2D", static_cast<double>(value.maxTextureDimension2D));
+  result.Set("maxTextureDimension3D", static_cast<double>(value.maxTextureDimension3D));
+  result.Set("maxTextureArrayLayers", static_cast<double>(value.maxTextureArrayLayers));
+  result.Set("maxBindGroups", static_cast<double>(value.maxBindGroups));
+  result.Set("maxBindGroupsPlusVertexBuffers", static_cast<double>(value.maxBindGroupsPlusVertexBuffers));
+  result.Set("maxBindingsPerBindGroup", static_cast<double>(value.maxBindingsPerBindGroup));
+  result.Set("maxDynamicUniformBuffersPerPipelineLayout", static_cast<double>(value.maxDynamicUniformBuffersPerPipelineLayout));
+  result.Set("maxDynamicStorageBuffersPerPipelineLayout", static_cast<double>(value.maxDynamicStorageBuffersPerPipelineLayout));
+  result.Set("maxSampledTexturesPerShaderStage", static_cast<double>(value.maxSampledTexturesPerShaderStage));
+  result.Set("maxSamplersPerShaderStage", static_cast<double>(value.maxSamplersPerShaderStage));
+  result.Set("maxStorageBuffersPerShaderStage", static_cast<double>(value.maxStorageBuffersPerShaderStage));
+  result.Set("maxStorageTexturesPerShaderStage", static_cast<double>(value.maxStorageTexturesPerShaderStage));
+  result.Set("maxUniformBuffersPerShaderStage", static_cast<double>(value.maxUniformBuffersPerShaderStage));
+  result.Set("maxUniformBufferBindingSize", static_cast<double>(value.maxUniformBufferBindingSize));
+  result.Set("maxStorageBufferBindingSize", static_cast<double>(value.maxStorageBufferBindingSize));
+  result.Set("minUniformBufferOffsetAlignment", static_cast<double>(value.minUniformBufferOffsetAlignment));
+  result.Set("minStorageBufferOffsetAlignment", static_cast<double>(value.minStorageBufferOffsetAlignment));
+  result.Set("maxVertexBuffers", static_cast<double>(value.maxVertexBuffers));
+  result.Set("maxBufferSize", static_cast<double>(value.maxBufferSize));
+  result.Set("maxVertexAttributes", static_cast<double>(value.maxVertexAttributes));
+  result.Set("maxVertexBufferArrayStride", static_cast<double>(value.maxVertexBufferArrayStride));
+  result.Set("maxInterStageShaderVariables", static_cast<double>(value.maxInterStageShaderVariables));
+  result.Set("maxColorAttachments", static_cast<double>(value.maxColorAttachments));
+  result.Set("maxColorAttachmentBytesPerSample", static_cast<double>(value.maxColorAttachmentBytesPerSample));
+  result.Set("maxComputeWorkgroupStorageSize", static_cast<double>(value.maxComputeWorkgroupStorageSize));
+  result.Set("maxComputeInvocationsPerWorkgroup", static_cast<double>(value.maxComputeInvocationsPerWorkgroup));
+  result.Set("maxComputeWorkgroupSizeX", static_cast<double>(value.maxComputeWorkgroupSizeX));
+  result.Set("maxComputeWorkgroupSizeY", static_cast<double>(value.maxComputeWorkgroupSizeY));
+  result.Set("maxComputeWorkgroupSizeZ", static_cast<double>(value.maxComputeWorkgroupSizeZ));
+  result.Set("maxComputeWorkgroupsPerDimension", static_cast<double>(value.maxComputeWorkgroupsPerDimension));
+  result.Set("maxImmediateSize", static_cast<double>(value.maxImmediateSize));
+  return result;
+}
+
+bool Wait(wgpu::Instance instance, wgpu::Future future, State& state) {
+  wgpu::FutureWaitInfo info{future};
+  REQUIRE(state, instance.WaitAny(1, &info, kWaitNanoseconds) == wgpu::WaitStatus::Success && info.completed,
+          "Dawn callback did not complete within the bounded wait");
+  return true;
+}
+
+bool CheckToggles(const std::vector<const char*>& toggles, State& state, const char* key) {
+  base::ListValue used;
+  for (const char* toggle : toggles) {
+    used.Append(toggle);
+    for (std::string_view forbidden : {"allow_unsafe_apis", "skip_validation", "disable_robustness",
+                                      "disable_lazy_clear_for_mapped_at_creation_buffer"}) {
+      REQUIRE(state, toggle != forbidden, "Unsafe or validation-disabling toggle is active");
+    }
+  }
+  state.report.Set(key, std::move(used));
+  return true;
+}
+
+// Each successful requestDevice consumes its adapter in safe mode. Enumerate
+// a fresh Core adapter for each independent test; never relax that contract.
+bool FreshSoftwareAdapter(dawn::native::Instance& native, State& state,
+                          dawn::native::Adapter* selected) {
+  wgpu::RequestAdapterOptions options;
+  options.backendType = wgpu::BackendType::Vulkan;
+  options.featureLevel = wgpu::FeatureLevel::Core;
+  options.forceFallbackAdapter = true;
+  auto adapters = native.EnumerateAdapters(&options);
+  REQUIRE(state, adapters.size() == 1, "Expected exactly one real software Core adapter");
+  *selected = adapters.front();
+  wgpu::Adapter adapter(selected->Get());
+  wgpu::AdapterInfo info;
+  adapter.GetInfo(&info);
+  REQUIRE(state, info.backendType == wgpu::BackendType::Vulkan &&
+          info.adapterType == wgpu::AdapterType::CPU && info.vendorID == 0x1ae0 && info.deviceID == 0xc0de,
+          "Fresh adapter identity does not match verified SwiftShader");
+  REQUIRE(state, adapter.HasFeature(wgpu::FeatureName::CoreFeaturesAndLimits), "Fresh adapter is not Core");
+  REQUIRE(state, CheckToggles(dawn::native::GetTogglesUsed(adapter), state, "adapter_toggles"),
+          "Fresh adapter has unsafe toggles");
+  selected->SetUseTieredLimits(true);
+  state.report.Set("software_adapter_requests", static_cast<int>(++state.adapter_requests));
+  return true;
+}
+
+bool RequestDevice(wgpu::Instance instance, wgpu::Adapter adapter, const wgpu::Limits* limits,
+                   bool expect_success, State& state, wgpu::Device* output) {
+  state.requests.emplace_back();
+  Request* result = &state.requests.back();
+  wgpu::DeviceDescriptor descriptor;
+  descriptor.requiredLimits = limits;
+  descriptor.SetUncapturedErrorCallback(
+      [](const wgpu::Device&, wgpu::ErrorType, wgpu::StringView message, State* state) {
+        state->Error("Uncaptured Dawn error: " + Text(message));
+      }, &state);
+  descriptor.SetDeviceLostCallback(wgpu::CallbackMode::AllowSpontaneous,
+      [](const wgpu::Device&, wgpu::DeviceLostReason reason, wgpu::StringView message, State* state) {
+        if (reason == wgpu::DeviceLostReason::Unknown) state->Error("Device lost: " + Text(message));
+      }, &state);
+  auto future = adapter.RequestDevice(&descriptor, wgpu::CallbackMode::WaitAnyOnly,
+      [result](wgpu::RequestDeviceStatus status, wgpu::Device device, wgpu::StringView message) {
+        result->status = status;
+        result->device = std::move(device);
+        result->message = Text(message);
+        result->done = true;
+      });
+  REQUIRE(state, Wait(instance, future, state) && result->done, "Device callback missing");
+  if (!expect_success) {
+    REQUIRE(state, result->status == wgpu::RequestDeviceStatus::Error && !result->device,
+            "Above-adapter required limit was not rejected");
+    REQUIRE(state, result->message.find("maxTextureDimension2D") != std::string::npos,
+            "Device rejection did not identify the tested excessive limit");
+    state.report.Set("above_adapter_limit_error", result->message);
+    return true;
+  }
+  REQUIRE(state, result->status == wgpu::RequestDeviceStatus::Success && result->device,
+          "Real Core device creation failed");
+  REQUIRE(state, CheckToggles(dawn::native::GetTogglesUsed(result->device.Get()), state, "device_toggles"),
+          "Unsafe device toggles");
+  *output = std::move(result->device);
+  return true;
+}
+
+bool ReadBuffer(wgpu::Instance instance, wgpu::Buffer buffer, size_t size,
+                std::vector<uint8_t>* bytes, State& state) {
+  state.maps.emplace_back();
+  Mapped* result = &state.maps.back();
+  auto future = buffer.MapAsync(wgpu::MapMode::Read, 0, size, wgpu::CallbackMode::WaitAnyOnly,
+      [result](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        result->status = status;
+        result->done = true;
+      });
+  REQUIRE(state, Wait(instance, future, state) && result->done &&
+          result->status == wgpu::MapAsyncStatus::Success, "Buffer mapping failed");
+  const auto* data = static_cast<const uint8_t*>(buffer.GetConstMappedRange(0, size));
+  REQUIRE(state, data, "Mapped range missing");
+  // SAFETY: successful MapAsync mapped exactly [0, size), and the non-null
+  // GetConstMappedRange(0, size) result is valid for that full range until
+  // Unmap below. This is the sole raw-pointer/length FFI boundary; subsequent
+  // access uses the bounded span and copies into owned vector storage.
+  const auto mapped = UNSAFE_BUFFERS(base::span(data, size));
+  bytes->assign(mapped.begin(), mapped.end());
+  buffer.Unmap();
+  return true;
+}
+
+bool Workloads(wgpu::Instance instance, wgpu::Device device, State& state) {
+  wgpu::BufferDescriptor storage_desc;
+  storage_desc.size = 64;
+  storage_desc.usage = wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopySrc;
+  auto storage = device.CreateBuffer(&storage_desc);
+  wgpu::BufferDescriptor read_desc;
+  read_desc.size = 64;
+  read_desc.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+  auto readback = device.CreateBuffer(&read_desc);
+  auto encoder = device.CreateCommandEncoder();
+  encoder.CopyBufferToBuffer(storage, 0, readback, 0, 64);
+  auto command = encoder.Finish();
+  auto queue = device.GetQueue();
+  queue.Submit(1, &command);
+  std::vector<uint8_t> bytes;
+  REQUIRE(state, ReadBuffer(instance, readback, 64, &bytes, state), "Initialization readback failed");
+  for (uint8_t value : bytes) REQUIRE(state, value == 0, "Uninitialized storage was not zeroed");
+  state.report.Set("zero_initialization_passed", true);
+
+  wgpu::ShaderSourceWGSL wgsl;
+  wgsl.code = R"(@group(0) @binding(0) var<storage, read_write> values: array<u32>;
+@compute @workgroup_size(4) fn main(@builtin(global_invocation_id) id: vec3u) {
+  if (id.x < 16u) { values[id.x] = id.x * 3u + 7u; }
+})";
+  wgpu::ShaderModuleDescriptor shader_desc;
+  shader_desc.nextInChain = &wgsl;
+  auto shader = device.CreateShaderModule(&shader_desc);
+  wgpu::ComputePipelineDescriptor pipeline_desc;
+  pipeline_desc.compute.module = shader;
+  pipeline_desc.compute.entryPoint = "main";
+  auto pipeline = device.CreateComputePipeline(&pipeline_desc);
+  wgpu::BindGroupEntry entry;
+  entry.binding = 0;
+  entry.buffer = storage;
+  entry.size = 64;
+  wgpu::BindGroupDescriptor bind_desc;
+  bind_desc.layout = pipeline.GetBindGroupLayout(0);
+  bind_desc.entryCount = 1;
+  bind_desc.entries = &entry;
+  auto bind = device.CreateBindGroup(&bind_desc);
+  encoder = device.CreateCommandEncoder();
+  auto pass = encoder.BeginComputePass();
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, bind);
+  pass.DispatchWorkgroups(4);
+  pass.End();
+  encoder.CopyBufferToBuffer(storage, 0, readback, 0, 64);
+  command = encoder.Finish();
+  queue.Submit(1, &command);
+  REQUIRE(state, ReadBuffer(instance, readback, 64, &bytes, state), "Compute readback failed");
+  for (unsigned i = 0; i < 16; ++i) {
+    const uint32_t value = base::U32FromLittleEndian(
+        base::span(bytes).subspan(i * sizeof(uint32_t)).first<sizeof(uint32_t)>());
+    REQUIRE(state, value == i * 3 + 7, "Compute result mismatch");
+  }
+  state.report.Set("compute_passed", true);
+
+  wgpu::TextureDescriptor texture_desc;
+  texture_desc.size = {2, 2, 1};
+  texture_desc.format = wgpu::TextureFormat::RGBA8Unorm;
+  texture_desc.usage = wgpu::TextureUsage::CopyDst | wgpu::TextureUsage::CopySrc;
+  auto texture = device.CreateTexture(&texture_desc);
+  const std::array<uint8_t, 16> pixels{255, 0, 0, 255, 0, 255, 0, 128,
+                                        0, 0, 255, 64, 11, 22, 33, 44};
+  wgpu::TexelCopyTextureInfo texture_info;
+  texture_info.texture = texture;
+  wgpu::TexelCopyBufferLayout layout;
+  layout.bytesPerRow = 8;
+  layout.rowsPerImage = 2;
+  const wgpu::Extent3D extent{2, 2, 1};
+  queue.WriteTexture(&texture_info, pixels.data(), pixels.size(), &layout, &extent);
+  read_desc.size = 512;
+  auto texture_readback = device.CreateBuffer(&read_desc);
+  wgpu::TexelCopyBufferInfo destination;
+  destination.buffer = texture_readback;
+  destination.layout.bytesPerRow = 256;
+  destination.layout.rowsPerImage = 2;
+  encoder = device.CreateCommandEncoder();
+  encoder.CopyTextureToBuffer(&texture_info, &destination, &extent);
+  command = encoder.Finish();
+  queue.Submit(1, &command);
+  REQUIRE(state, ReadBuffer(instance, texture_readback, 512, &bytes, state), "Texture readback failed");
+  for (unsigned row = 0; row < 2; ++row)
+    for (unsigned byte = 0; byte < 8; ++byte)
+      REQUIRE(state, bytes[row * 256 + byte] == pixels[row * 8 + byte], "Texture bytes differ");
+  state.report.Set("texture_upload_readback_passed", true);
+
+  device.PushErrorScope(wgpu::ErrorFilter::Validation);
+  wgsl.code = "@compute fn invalid_wgsl( {";
+  auto invalid = device.CreateShaderModule(&shader_desc);
+  (void)invalid;
+  state.scopes.emplace_back();
+  Scope* scope = &state.scopes.back();
+  auto future = device.PopErrorScope(wgpu::CallbackMode::WaitAnyOnly,
+      [scope](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView) {
+        scope->status = status; scope->type = type; scope->done = true;
+      });
+  REQUIRE(state, Wait(instance, future, state) && scope->done &&
+          scope->status == wgpu::PopErrorScopeStatus::Success &&
+          scope->type == wgpu::ErrorType::Validation, "Invalid WGSL escaped validation");
+  state.report.Set("invalid_wgsl_rejected", true);
+  return true;
+}
+
+bool Run(State& state) {
+  const auto& command = *base::CommandLine::ForCurrentProcess();
+  REQUIRE(state, Preflight(command, state), "Preflight failed");
+  dawnProcSetProcs(&dawn::native::GetProcs());
+  const char* disabled[] = {"allow_unsafe_apis", "skip_validation", "disable_robustness"};
+  wgpu::DawnTogglesDescriptor toggles;
+  toggles.disabledToggleCount = std::size(disabled);
+  toggles.disabledToggles = disabled;
+  const char* paths[] = {"/provider/"};
+  dawn::native::DawnInstanceDescriptor native_desc;
+  native_desc.nextInChain = &toggles;
+  native_desc.additionalRuntimeSearchPathsCount = 1;
+  native_desc.additionalRuntimeSearchPaths = paths;
+  native_desc.backendValidationLevel = dawn::native::BackendValidationLevel::Full;
+  native_desc.SetLoggingCallback([](wgpu::LoggingType, wgpu::StringView message, State* state) {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->diagnostics.push_back(Text(message));
+  }, &state);
+  // Direct-ICD operation can lack Khronos layers. Do not equate this request
+  // with proven layer activation; API/shader/robustness checks remain required.
+  state.report.Set("vulkan_backend_validation_requested", "full");
+  state.report.Set("vulkan_validation_layer_activation_proven", false);
+  wgpu::InstanceFeatureName features[] = {wgpu::InstanceFeatureName::TimedWaitAny};
+  wgpu::InstanceDescriptor descriptor;
+  descriptor.nextInChain = &native_desc;
+  descriptor.requiredFeatureCount = std::size(features);
+  descriptor.requiredFeatures = features;
+  dawn::native::Instance native(&descriptor);
+  wgpu::Instance instance(native.Get());
+  dawn::native::Adapter selected;
+  REQUIRE(state, FreshSoftwareAdapter(native, state, &selected), "Default adapter request failed");
+  wgpu::Adapter adapter(selected.Get());
+  wgpu::AdapterInfo info;
+  adapter.GetInfo(&info);
+  REQUIRE(state, info.backendType == wgpu::BackendType::Vulkan &&
+          info.adapterType == wgpu::AdapterType::CPU && info.vendorID == 0x1ae0 && info.deviceID == 0xc0de,
+          "Adapter identity does not match verified SwiftShader");
+  state.report.Set("adapter_description", Text(info.description));
+  state.report.Set("adapter_device", Text(info.device));
+  state.report.Set("actual_vendor_id", static_cast<int>(info.vendorID));
+  state.report.Set("actual_device_id", static_cast<int>(info.deviceID));
+  REQUIRE(state, CheckToggles(dawn::native::GetTogglesUsed(adapter), state, "adapter_toggles"),
+          "Unsafe adapter toggles");
+  REQUIRE(state, adapter.HasFeature(wgpu::FeatureName::CoreFeaturesAndLimits), "Adapter is not Core");
+  wgpu::SupportedFeatures supported;
+  adapter.GetFeatures(&supported);
+  base::ListValue feature_names;
+  // SAFETY: Dawn's GetFeatures owns featureCount contiguous FeatureName
+  // entries through this SupportedFeatures record. The record remains alive
+  // until after this bounded-span iteration; no pointer arithmetic escapes it.
+  const auto feature_span = UNSAFE_BUFFERS(
+      base::span(supported.features, supported.featureCount));
+  for (wgpu::FeatureName feature : feature_span) {
+    std::ostringstream name;
+    name << feature;
+    feature_names.Append(name.str());
+  }
+  state.report.Set("actual_features", std::move(feature_names));
+  wgpu::Limits raw;
+  selected.SetUseTieredLimits(false);
+  REQUIRE(state, adapter.GetLimits(&raw) == wgpu::Status::Success, "Native limits unavailable");
+  state.report.Set("adapter_native_limits", LimitsJSON(raw));
+  selected.SetUseTieredLimits(true);
+  wgpu::Limits tiered;
+  REQUIRE(state, adapter.GetLimits(&tiered) == wgpu::Status::Success, "Tiered limits unavailable");
+  state.report.Set("adapter_tiered_limits", LimitsJSON(tiered));
+  wgpu::Device device;
+  REQUIRE(state, RequestDevice(instance, adapter, nullptr, true, state, &device), "Default Core device failed");
+  wgpu::Limits actual;
+  REQUIRE(state, device.GetLimits(&actual) == wgpu::Status::Success, "Default device limits unavailable");
+  state.report.Set("device_default_limits", LimitsJSON(actual));
+  REQUIRE(state, device.HasFeature(wgpu::FeatureName::CoreFeaturesAndLimits), "Default device is not Core");
+  REQUIRE(state, Workloads(instance, device, state), "Real workloads failed");
+  device.Destroy();
+  dawn::native::Adapter required_selected;
+  REQUIRE(state, FreshSoftwareAdapter(native, state, &required_selected), "Required-limit adapter request failed");
+  wgpu::Adapter required_adapter(required_selected.Get());
+  REQUIRE(state, required_adapter.Get() != adapter.Get(), "Required-limit test reused a consumed adapter");
+  wgpu::Limits required_adapter_limits;
+  REQUIRE(state, required_adapter.GetLimits(&required_adapter_limits) == wgpu::Status::Success,
+          "Required-limit adapter caps unavailable");
+  state.report.Set("required_test_adapter_limits", LimitsJSON(required_adapter_limits));
+  wgpu::Limits required;
+  required.maxTextureDimension2D = required_adapter_limits.maxTextureDimension2D;
+  wgpu::Device requested;
+  REQUIRE(state, RequestDevice(instance, required_adapter, &required, true, state, &requested), "Valid required limit failed");
+  REQUIRE(state, requested.GetLimits(&actual) == wgpu::Status::Success &&
+          actual.maxTextureDimension2D == required.maxTextureDimension2D, "Required device cap differs");
+  state.report.Set("device_required_limits", LimitsJSON(actual));
+  state.report.Set("requested_maxTextureDimension2D", static_cast<double>(required.maxTextureDimension2D));
+  requested.Destroy();
+  dawn::native::Adapter excessive_selected;
+  REQUIRE(state, FreshSoftwareAdapter(native, state, &excessive_selected), "Above-limit adapter request failed");
+  wgpu::Adapter excessive_adapter(excessive_selected.Get());
+  REQUIRE(state, excessive_adapter.Get() != adapter.Get() &&
+          excessive_adapter.Get() != required_adapter.Get(), "Above-limit test reused a consumed adapter");
+  excessive_selected.SetUseTieredLimits(false);
+  wgpu::Limits excessive_adapter_limits;
+  REQUIRE(state, excessive_adapter.GetLimits(&excessive_adapter_limits) == wgpu::Status::Success,
+          "Above-limit adapter native caps unavailable");
+  state.report.Set("above_limit_test_adapter_native_limits", LimitsJSON(excessive_adapter_limits));
+  excessive_selected.SetUseTieredLimits(true);
+  REQUIRE(state, excessive_adapter_limits.maxTextureDimension2D < std::numeric_limits<uint32_t>::max(),
+          "Cannot form above-limit case");
+  wgpu::Limits excessive;
+  excessive.maxTextureDimension2D = excessive_adapter_limits.maxTextureDimension2D + 1;
+  wgpu::Device rejected;
+  REQUIRE(state, RequestDevice(instance, excessive_adapter, &excessive, false, state, &rejected),
+          "Above-limit validation failed");
+  state.report.Set("above_adapter_limit_rejected", true);
+  state.report.Set("adapter_instances_distinct", true);
+  return true;
+}
+}  // namespace
+
+extern "C" void* __real_dlopen(const char*, int);
+extern "C" char* __real_dlerror();
+extern "C" char* __wrap_dlerror() {
+  if (denied_error_pending) {
+    denied_error_pending = false;
+    static char message[] = "Test loader denied a non-pinned provider";
+    return message;
+  }
+  return __real_dlerror();
+}
+extern "C" void* __wrap_dlopen(const char* path, int flags) {
+  denied_error_pending = false;
+  if (!path) return __real_dlopen(nullptr, flags);
+  if (provider_ready.load()) {
+    std::string_view value(path);
+    const size_t slash = value.find_last_of('/');
+    const std::string_view basename = slash == std::string_view::npos ? value : value.substr(slash + 1);
+    if (basename == "libvk_swiftshader.so") {
+      provider_loads.fetch_add(1);
+      return __real_dlopen(kProvider, flags);
+    }
+  }
+  denied_loads.fetch_add(1);
+  denied_error_pending = true;
+  return nullptr;
+}
+
+int main(int argc, char** argv) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(argc, argv);
+  State state;
+  state.report.Set("diagnostic_only", true);
+  state.report.Set("corpus_admission", false);
+  state.report.Set("chromium_revision", "79460ebecaa5625e57a5fb679a735659e73dc687");
+  state.report.Set("dawn_revision", "ab8827bc57b176eeaa89f71324130c02d4d41145");
+  state.report.Set("swiftshader_revision", "5b0479bd2d15058aaa9eb490e364f920ff824a8c");
+  bool passed = Run(state);
+  provider_ready.store(false);
+  state.report.Set("provider_dlopen_calls", static_cast<int>(provider_loads.load()));
+  state.report.Set("denied_dlopen_calls", static_cast<int>(denied_loads.load()));
+  if (provider_loads.load() == 0) state.Error("Software provider was never loaded");
+  base::ListValue requests;
+  for (const auto& request : state.requests) {
+    base::DictValue entry;
+    entry.Set("done", request.done);
+    entry.Set("status", static_cast<int>(request.status));
+    entry.Set("message", request.message);
+    requests.Append(std::move(entry));
+  }
+  state.report.Set("device_requests", std::move(requests));
+  base::ListValue diagnostics;
+  for (const auto& message : state.diagnostics) diagnostics.Append(message);
+  state.report.Set("dawn_diagnostics", std::move(diagnostics));
+  base::ListValue errors;
+  for (const auto& error : state.errors) errors.Append(error);
+  passed = passed && errors.empty();
+  state.report.Set("errors", std::move(errors));
+  state.report.Set("passed", passed);
+  std::string json;
+  if (!base::JSONWriter::WriteWithOptions(state.report, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json)) return 2;
+  const auto output = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath("out");
+  if (output.empty() || !base::WriteFile(output, json)) return 2;
+  return passed ? 0 : 1;
+}
