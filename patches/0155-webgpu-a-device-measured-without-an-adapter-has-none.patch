   EXPECT_EQ(16384, absent->profile.FindDict("gl_limits")
@@ -892,8 +895,8 @@ TEST(ApostateComposeTest, WebGpuComesFromTheResolvedMemberNotTheAnchor) {
 
   const SurfaceRecord* record = Record(*absent, "webgpu");
