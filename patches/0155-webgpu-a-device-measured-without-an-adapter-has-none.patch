   // off the macOS/Metal anchor and patch 0102 made the persona select the
@@ -884,7 +884,10 @@ TEST(ApostateComposeTest, WebGpuComesFromTheResolvedMemberNotTheAnchor) {
   const std::optional<Composition> absent =
       Compose(RequestOnTestMetal("webgpu-seed", kNoAdapter));
   ASSERT_TRUE(absent.has_value());
-  EXPECT_FALSE(absent->profile.contains("webgpu"));
+  const DictValue* none = absent->profile.FindDict("webgpu");
