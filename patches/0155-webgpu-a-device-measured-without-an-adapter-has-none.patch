diff --git a/gpu/command_buffer/service/webgpu_decoder_impl.cc b/gpu/command_buffer/service/webgpu_decoder_impl.cc
index 0ebb417..27c4d9f 100644
--- a/gpu/command_buffer/service/webgpu_decoder_impl.cc
+++ b/gpu/command_buffer/service/webgpu_decoder_impl.cc
@@ -1607,6 +1607,16 @@ WGPUFuture WebGPUDecoderImpl::RequestAdapterImpl(
     return {};
   }
 
+  // The claimed device had no WebGPU adapter when it was measured, so
+  // requestAdapter() finds none on it, whatever GPU this host has.
+  if (const auto* profile = base::apostate::Profile::Get();
