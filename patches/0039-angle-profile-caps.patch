Subject: [PATCH] angle: apply profile limits to ANGLE's own caps

ANGLE lowers its internal caps to the profile's gl_limits before it sets
up context state and the shader compiler. This covers MAX_VIEWPORT_DIMS,
MAX_UNIFORM_BLOCK_SIZE and the vertex uniform limits, which the Chromium
query hooks either miss or report without changing what ANGLE enforces.
A page gets the same limit from a query as from viewport and shader
validation. Chromium passes the values in through a platform callback,
limits never rise above the native ones, and the effective limits are
part of the program cache key.

diff --git a/ui/gl/angle_platform_impl.cc b/ui/gl/angle_platform_impl.cc
--- a/ui/gl/angle_platform_impl.cc
+++ b/ui/gl/angle_platform_impl.cc
@@ -7,6 +7,7 @@
 #include <atomic>
 #include <string>
 
+#include "base/apostate/profile.h"
 #include "base/base64.h"
 #include "base/compiler_specific.h"
 #include "base/functional/bind.h"
@@ -27,6 +28,24 @@
 namespace {
 
 std::atomic<bool> g_post_task_failed_for_testing{false};
+
+bool ANGLEPlatformImpl_getProfileIntegerCapV1(PlatformMethods* platform,
+                                             const char* name,
+                                             int64_t* value) {
+  if (!name || !value) {
+    return false;
+  }
+  const auto* profile = base::apostate::Profile::Get();
+  if (!profile) {
+    return false;
+  }
+  const auto it = profile->gl_limits().find(name);
+  if (it == profile->gl_limits().end()) {
+    return false;
+  }
+  *value = it->second;
+  return true;
+}
 
 double ANGLEPlatformImpl_currentTime(PlatformMethods* platform) {
   return base::Time::Now().InSecondsFSinceUnixEpoch();
@@ -195,6 +214,8 @@
                           g_PlatformMethodNames, g_NumPlatformMethods, nullptr,
                           &platformMethods))
     return false;
+  platformMethods->getProfileIntegerCapV1 =
+      ANGLEPlatformImpl_getProfileIntegerCapV1;
   platformMethods->currentTime = ANGLEPlatformImpl_currentTime;
   platformMethods->addTraceEvent = ANGLEPlatformImpl_addTraceEvent;
   platformMethods->getTraceCategoryEnabledFlag =
