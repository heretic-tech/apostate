+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_TEXT_PHASE_H_
+#define BASE_APOSTATE_TEXT_PHASE_H_
+
+#include <string_view>
+
+#include "base/base_export.h"
+
+namespace base::apostate {
+
+// The sub-pixel offset, in device-independent pixels on x, that this launch's
+// identity draws canvas text at. Zero when no profile is active, when the
+// profile carries no source id, and under --fingerprint=host: there is nothing
+// profile-bound to key on, and an offset derived from the host would put a
+// host fact in the pixels.
+//
+// The value is in [-0.25, 0.25] in steps of 1/64. The bound is a quarter pixel
+// because that is Skia's sub-pixel bin on every platform this fork claims, so
+// a shift inside it moves some glyphs of a run to the neighbouring bin and
+// leaves the others -- the coverage difference two machines produce when their
+// hinting disagrees, rather than a value that platform cannot draw.
+//
+// Resolved once per process. Two calls in one launch agree, two launches of
+// one profile agree, and two profiles differ.
+BASE_EXPORT float CanvasTextPhase();
+
+// The same computation against an explicit identity, for tests and for callers
+// that have an id in hand rather than a resolved profile. An empty id is zero.
+BASE_EXPORT float CanvasTextPhaseForIdentityForTesting(std::string_view id);
+
+}  // namespace base::apostate
+
+#endif  // BASE_APOSTATE_TEXT_PHASE_H_
diff --git a/base/apostate/text_phase.cc b/base/apostate/text_phase.cc
new file mode 100644
--- /dev/null
+++ b/base/apostate/text_phase.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/text_phase.h"
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/apostate/profile.h"
+#include "base/hash/hash.h"
+#include "base/strings/strcat.h"
+
+namespace base::apostate {
+
+namespace {
+
+// 33 positions across the half-pixel span, so the quantum is 1/64 px and zero
+// is one of the values a profile can draw: an identity whose phase is the
+// host's own is a real outcome, not a bug, and pretending otherwise would mean
+// no profile ever renders the way an unmodified build does.
+constexpr int32_t kSteps = 32;
+constexpr float kQuantum = 1.0f / 64.0f;
+
+float PhaseFor(std::string_view id) {
+  if (id.empty()) {
+    return 0.0f;
+  }
+  // The NUL keeps the domain from running into the identity. PersistentHash is
+  // stable across builds and processes, which is what makes one profile draw
+  // at one phase on every launch and on every host; the two halves are the
+  // SyntheticDeviceSeed construction in base/apostate/media_devices.cc.
+  static constexpr std::string_view kDomain("apostate/canvas-text-phase/v1\0",
+                                            30);
+  const std::string material = base::StrCat({kDomain, id});
+  const uint64_t seed =
+      (static_cast<uint64_t>(base::PersistentHash(material)) << 32) |
+      base::PersistentHash(base::StrCat({material, "/2"}));
+  // Centred on zero: [-kSteps/2, +kSteps/2] steps of kQuantum, which is
+  // [-0.25, 0.25] px.
+  const int32_t step =
+      static_cast<int32_t>(seed % (kSteps + 1)) - (kSteps / 2);
+  return static_cast<float>(step) * kQuantum;
+}
+
+float ResolvePhase() {
+  const Profile* profile = Profile::Get();
+  if (!profile) {
+    return 0.0f;
+  }
+  return PhaseFor(profile->source_id());
+}
+
+}  // namespace
+
+float CanvasTextPhase() {
+  static const float phase = ResolvePhase();
+  return phase;
+}
+
+float CanvasTextPhaseForIdentityForTesting(std::string_view id) {
+  return PhaseFor(id);
+}
+
+}  // namespace base::apostate
diff --git a/base/apostate/text_phase_unittest.cc b/base/apostate/text_phase_unittest.cc
new file mode 100644
--- /dev/null
+++ b/base/apostate/text_phase_unittest.cc
@@ -0,0 +1,69 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/text_phase.h"
+
+#include <cmath>
+#include <set>
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace base::apostate {
+namespace {
+
+using Phase = float;
+
+// An identity with nothing to key on keeps the host's phase. This is the
+// --fingerprint=host and authored-profile-without-an-id case, and it is the
+// one result that must not be a fabricated offset.
+TEST(CanvasTextPhaseTest, EmptyIdentityIsHostPhase) {
+  EXPECT_EQ(0.0f, CanvasTextPhaseForIdentityForTesting(""));
+}
+
+// Two reads of one identity in one launch agree, which is the determinism rule
+// the whole fork rests on.
+TEST(CanvasTextPhaseTest, OneIdentityResolvesToOneValue) {
+  const Phase first = CanvasTextPhaseForIdentityForTesting("apostate-abc123");
+  const Phase second = CanvasTextPhaseForIdentityForTesting("apostate-abc123");
+  EXPECT_EQ(first, second);
+}
+
+// A quarter pixel is the bound the header claims, and a value outside it is a
+// glyph position the claimed platform's bins do not produce.
+TEST(CanvasTextPhaseTest, StaysInsideAQuarterPixel) {
+  for (int i = 0; i < 512; ++i) {
+    const Phase phase =
+        CanvasTextPhaseForIdentityForTesting("apostate-" + base::NumberToString(i));
+    EXPECT_GE(phase, -0.25f);
+    EXPECT_LE(phase, 0.25f);
+  }
+}
+
+// Every value is a whole number of 1/64 px steps. A phase off the lattice
+// would be a position Skia rounds differently on different runs.
+TEST(CanvasTextPhaseTest, EveryValueIsOnTheQuantum) {
+  for (int i = 0; i < 512; ++i) {
+    const Phase phase =
+        CanvasTextPhaseForIdentityForTesting("apostate-" + base::NumberToString(i));
+    const float steps = phase * 64.0f;
+    EXPECT_FLOAT_EQ(steps, std::round(steps));
+  }
+}
+
+// Different identities draw at different phases often enough for the offset to
+// be worth applying: with 33 positions, 512 identities must cover most of them.
+TEST(CanvasTextPhaseTest, IdentitiesSpreadAcrossThePositions) {
+  std::set<Phase> seen;
+  for (int i = 0; i < 512; ++i) {
+    seen.insert(
+        CanvasTextPhaseForIdentityForTesting("apostate-" + base::NumberToString(i)));
+  }
+  EXPECT_GE(seen.size(), 30u);
+}
+
+}  // namespace
+}  // namespace base::apostate
