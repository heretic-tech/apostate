 #include "third_party/perfetto/include/perfetto/tracing/track.h"
+#include "ui/gl/gl_features.h"
 #include "ui/gl/gl_implementation.h"
 #include "ui/gl/gl_utils.h"
 #include "ui/gl/gl_version_info.h"
@@ -1198,11 +1199,22 @@
     ui::GpuSwitchingManager::GetInstance()->AddObserver(this);
   }
 
-  // Deprecation warning for SwiftShader WebGL fallback
+  // Deprecation warning for SwiftShader WebGL fallback.
+  //
+  // Gated on whether the fallback was allowed at all rather than on the switch
+  // alone. This message goes to the page's console, so with the fallback
+  // re-enabled by feature default it would announce software WebGL on every
+  // GPU-less launch -- a page-visible observable, and the loudest possible one,
+  // since it names the deprecation by hand. It is a nag aimed at a user relying
+  // on the implicit fallback unknowingly; this fork allows it deliberately, so
+  // the condition now asks the same question the allow decision asks.
+  //
+  // It still fires if SwiftShader is somehow reached with the fallback
+  // disallowed, which would be a defect worth seeing.
   if (feature_info_->IsWebGLContext() &&
       gl::GetANGLEImplementation() == gl::ANGLEImplementation::kSwiftShader &&
-      !base::CommandLine::ForCurrentProcess()->HasSwitch(
-          switches::kEnableUnsafeSwiftShader)) {
+      !features::IsSwiftShaderAllowed(
+          base::CommandLine::ForCurrentProcess())) {
     constexpr const char* kSwiftShaderFallbackDeprcationMessage =
         "Automatic fallback to software WebGL has been deprecated. Please use "
         "the --enable-unsafe-swiftshader "
