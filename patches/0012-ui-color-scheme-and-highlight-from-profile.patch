Subject: [PATCH] css: color scheme and Highlight color from the profile

The profile sets the preferred color scheme and the system Highlight
color. Dark or light mode changes prefers-color-scheme and about thirty
CSS system colors at once, so it has to match the claimed machine.
Highlight differs between macOS and Linux, and a Linux host claiming
macOS would show the Linux value in getComputedStyle. An explicit
--force-dark-mode still wins over the profile.

diff --git a/base/apostate/profile.cc b/base/apostate/profile.cc
index d2727ce..af28053 100644
--- a/base/apostate/profile.cc
+++ b/base/apostate/profile.cc
@@ -170,6 +170,18 @@ Profile* Profile::ParseOrNull(const std::string& encoded) {
     }
   }
 
+  if (const DictValue* theme = dict->FindDict("theme")) {
+    if (std::optional<bool> v = theme->FindBool("prefers_dark")) {
+      profile->prefers_dark_ = *v;
+    }
+    if (std::optional<double> v = theme->FindDouble("highlight_argb")) {
+      profile->css_highlight_argb_ = static_cast<uint32_t>(*v);
+    }
+    if (std::optional<double> v = theme->FindDouble("highlight_text_argb")) {
+      profile->css_highlight_text_argb_ = static_cast<uint32_t>(*v);
+    }
+  }
+
   if (const DictValue* browser = dict->FindDict("browser")) {
     if (const std::string* v = browser->FindString("user_agent")) {
       profile->user_agent_ = *v;
diff --git a/base/apostate/profile.h b/base/apostate/profile.h
index 5f924bc..4c856b5 100644
--- a/base/apostate/profile.h
+++ b/base/apostate/profile.h
@@ -145,6 +145,27 @@ class BASE_EXPORT Profile {
   // free to get right, and impossible to get wrong per-host.
   const std::optional<std::string>& timezone() const { return timezone_; }
 
+  // Preferred colour scheme: true for dark.
+  //
+  // A user preference rather than a device property, but it belongs in the
+  // profile because it moves roughly thirty observable values at once — every
+  // CSS system colour follows it. A capture taken in dark mode replayed in
+  // light mode differs on all of them.
+  std::optional<bool> prefers_dark() const { return prefers_dark_; }
+
+  // The platform's selection highlight, as CSS reports it, in 0xAARRGGBB so a
+  // partly transparent value round-trips.
+  //
+  // macOS overrides exactly these two colours, and on platforms with no native
+  // mapping the function that would set them is an empty body — so a Linux host
+  // claiming macOS emits the wrong Highlight in a single getComputedStyle read.
+  std::optional<uint32_t> css_highlight_argb() const {
+    return css_highlight_argb_;
+  }
+  std::optional<uint32_t> css_highlight_text_argb() const {
+    return css_highlight_text_argb_;
+  }
+
   // Identifier of the capture this profile was derived from, for diagnostics.
   const std::string& source_id() const { return source_id_; }
 
@@ -170,6 +191,9 @@ class BASE_EXPORT Profile {
   std::optional<float> device_scale_factor_;
   std::optional<int> screen_color_depth_;
   std::optional<std::string> timezone_;
+  std::optional<bool> prefers_dark_;
+  std::optional<uint32_t> css_highlight_argb_;
+  std::optional<uint32_t> css_highlight_text_argb_;
   std::string source_id_;
 };
 
diff --git a/ui/color/css_system_color_mixer.cc b/ui/color/css_system_color_mixer.cc
index 2e51a25..3ddbe85 100644
--- a/ui/color/css_system_color_mixer.cc
+++ b/ui/color/css_system_color_mixer.cc
@@ -4,6 +4,8 @@
 
 #include "ui/color/css_system_color_mixer.h"
 
+#include "base/apostate/profile.h"
+
 #include "build/build_config.h"
 #include "ui/color/color_id.h"
 #include "ui/color/color_mixer.h"
@@ -16,6 +18,21 @@ namespace ui {
 
 #if !BUILDFLAG(IS_WIN) && !BUILDFLAG(IS_MAC)
 void MapNativeColorsToCssSystemColors(ColorMixer& mixer, ColorProviderKey key) {
+  // Apostate: upstream leaves this empty on platforms with no native mapping,
+  // which is why a Linux build claiming macOS reports the wrong selection
+  // highlight — macOS overrides exactly these two colours and nothing supplies
+  // them here. Taking them from the profile keeps this one function correct for
+  // any claimed platform rather than adding another per-platform table.
+  if (const base::apostate::Profile* profile = base::apostate::Profile::Get()) {
+    if (profile->css_highlight_argb().has_value()) {
+      mixer[kColorCssSystemHighlight] = {
+          static_cast<SkColor>(*profile->css_highlight_argb())};
+    }
+    if (profile->css_highlight_text_argb().has_value()) {
+      mixer[kColorCssSystemHighlightText] = {
+          static_cast<SkColor>(*profile->css_highlight_text_argb())};
+    }
+  }
 }
 #endif
 
diff --git a/ui/native_theme/native_theme.cc b/ui/native_theme/native_theme.cc
index 478080b..8b06781 100644
--- a/ui/native_theme/native_theme.cc
+++ b/ui/native_theme/native_theme.cc
@@ -4,6 +4,8 @@
 
 #include "ui/native_theme/native_theme.h"
 
+#include "base/apostate/profile.h"
+
 #include <stddef.h>
 
 #include <algorithm>
@@ -588,6 +590,18 @@ ColorProviderKey::ForcedColors NativeTheme::CalculateForcedColors() const {
 
 NativeTheme::PreferredColorScheme NativeTheme::CalculatePreferredColorScheme()
     const {
+  // Apostate: the profile wins over the host's setting but not over an
+  // explicit --force-dark-mode, which is a deliberate instruction from whoever
+  // launched the browser rather than a property of the claimed device.
+  if (!IsForcedDarkMode()) {
+    if (const base::apostate::Profile* profile =
+            base::apostate::Profile::Get()) {
+      if (profile->prefers_dark().has_value()) {
+        return *profile->prefers_dark() ? PreferredColorScheme::kDark
+                                        : PreferredColorScheme::kLight;
+      }
+    }
+  }
   return IsForcedDarkMode() ? PreferredColorScheme::kDark
                             : OsSettingsProvider::Get().PreferredColorScheme();
 }
