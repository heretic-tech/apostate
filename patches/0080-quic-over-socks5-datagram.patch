     const quic::QuicSocketAddress& peer_address) const {
-  return quic::kMaxOutgoingPacketSize;
+  // A socket that encapsulates each datagram -- a SOCKS5 UDP relay prepends an
+  // RFC 1928 section 7 header -- can carry that much less. Without the
+  // subtraction an MTU probe at 1452 becomes a 1462-byte payload, 1510 bytes on
+  // the wire over IPv6, which the first 1500-MTU hop drops and QUIC reads as a
+  // path-MTU black hole. The overhead is fixed for the socket's lifetime, so
+  // this cannot go stale.
+  const quic::QuicByteCount overhead =
+      socket_ ? socket_->GetEncapsulation().overhead : 0;
+  CHECK_LT(overhead, quic::kMaxOutgoingPacketSize);
+  return quic::kMaxOutgoingPacketSize - overhead;
 }
 
