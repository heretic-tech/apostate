+std::unique_ptr<DatagramClientSocket> QuicSessionPool::CreateSocket(
+    const QuicSessionKey& session_key,
+    handles::NetworkHandle target_network,
+    NetLog* net_log,
+    const NetLogSource& source) {
+  auto socket = client_socket_factory_->CreateDatagramClientSocket(
+      DatagramSocket::DEFAULT_BIND, target_network, net_log, source);
+  if (params_.enable_socket_recv_optimization) {
+    socket->EnableRecvOptimization();
+  }
+  if (!IsQuicOverSocks5Chain(session_key.proxy_chain())) {
+    return socket;
+  }
+  // The socket that carries data is still the one the factory produced, so it
+  // is configured exactly as a direct QUIC socket is; the wrapper only frames
+  // and deframes.
+  //
+  // Credentials are read here, at the point of use, and held only by the
+  // socket. They are deliberately absent from QuicSessionKey, the crypto
+  // config key and every NetLog parameter, so two launches with different
+  // credentials against one proxy still share session keying and a capture
+  // holds no secret.
+  std::optional<SOCKS5Credentials> credentials;
+  if (const base::apostate::Profile* profile =
+          base::apostate::Profile::Get()) {
+    if (const std::optional<base::apostate::ProxyCredentials>& configured =
+            profile->proxy_credentials()) {
+      credentials.emplace(configured->username, configured->password);
+    }
+  }
+  return std::make_unique<SOCKS5DatagramClientSocket>(
+      std::move(socket), client_socket_factory_,
+      HostPortPair(session_key.server_id().host(),
+                   session_key.server_id().port()),
+      std::move(credentials), kSocks5AssociateTrafficAnnotation);
+}
 
