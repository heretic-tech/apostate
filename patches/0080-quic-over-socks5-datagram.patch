+quic::QuicByteCount QuicChromiumPacketWriter::GetMaxPacketSize(
+    const quic::QuicSocketAddress& peer_address) const {
+  // A socket that encapsulates each datagram -- a SOCKS5 UDP relay prepends an
+  // RFC 1928 section 7 header -- can carry that much less. Without the
