+// Serve a two-element range in place. Both endpoints come from the profile or
+// neither does: half a served interval is a pair no device reported.
+template <typename T>
+bool ApostateServeRange(const base::apostate::Profile* profile,
+                        const ApostateGlRange& range,
+                        bool enforces,
+                        T* params) {
+  const std::optional<double> low = ApostateClaimedLimit(profile, range.low);
+  const std::optional<double> high = ApostateClaimedLimit(profile, range.high);
+  if (!low.has_value() || !high.has_value()) {
+    return false;
+  }
+  // Read and written through std::array and std::copy_n rather than
+  // params[0]/params[1]. The GL entry point contract guarantees two elements
+  // and GLApiBase has just filled both, but raw indexing past [0] trips
+  // -Wunsafe-buffer-usage, and nothing in ui/gl uses the UNSAFE_BUFFERS
+  // escape hatch -- patch 0029 set this pattern for the shader precision
+  // range and there is no reason to be the first to break it.
+  std::array<T, 2> real = {};
+  std::copy_n(params, real.size(), real.begin());
+
+  // Intersecting an interval takes the higher floor and the lower ceiling.
+  // A pair of independent ceilings takes the lower of each.
+  const std::array<T, 2> served = {
+      ApostateServedLimit(static_cast<T>(*low), real[0], enforces,
+                          /*is_minimum=*/range.is_interval),
+      ApostateServedLimit(static_cast<T>(*high), real[1], enforces,
+                          /*is_minimum=*/false)};
+  std::copy_n(served.begin(), served.size(), params);
+  return true;
