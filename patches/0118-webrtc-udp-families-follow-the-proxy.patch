--- a/net/socket/socks5_datagram_server_socket.cc
+++ b/net/socket/socks5_datagram_server_socket.cc
@@ -224,24 +224,75 @@
   if (result != OK) {
     return result;
   }
-  for (const IPEndPoint& endpoint :
-       resolve_request_->GetAddressResults().endpoints()) {
+  // Prefer an endpoint in the family Listen() bound, so that a proxy reachable
+  // in both families keeps one association per family and each family's host
+  // candidate stays in its own family. Fall back to whatever the proxy does
+  // resolve in: a relayed socket has no family of its own. Its local bind
+  // family, the family it sends in, and the family of the candidate it
+  // produces are all the family of the relay endpoint, because that endpoint
+  // is the only address it ever sends to and the ICE candidate is BND.ADDR
+  // verbatim. The destination of a relayed datagram lives in the RFC 1928
+  // per-datagram header and is independent of all of that, so nothing is lost
+  // by binding a family the caller did not ask for -- whereas refusing the
+  // socket loses the whole peer connection: a port whose socket never binds
+  // never reports an address and never finishes gathering.
+  const AddressList& answer = resolve_request_->GetAddressResults();
+  for (const IPEndPoint& endpoint : answer.endpoints()) {
     if (GetAddressFamily(endpoint.address()) == listen_family_) {
       proxy_endpoint_ = endpoint;
       break;
     }
   }
+  if (proxy_endpoint_.address().empty() && !answer.endpoints().empty()) {
+    proxy_endpoint_ = answer.endpoints().front();
+  }
   resolve_request_.reset();
   if (proxy_endpoint_.address().empty()) {
-    // The proxy has no address in this socket's family, so this family has no
-    // relayed egress. Reporting it unreachable is what stops a candidate of
-    // that family being emitted at all.
-    return ERR_ADDRESS_UNREACHABLE;
+    // The proxy has no address at all, so there is no association to make.
+    return ERR_NAME_NOT_RESOLVED;
+  }
+  int rv = RebindForProxyFamily();
+  if (rv != OK) {
+    return rv;
   }
   next_state_ = STATE_CONTROL_CONNECT;
   return OK;
 }
 
+int SOCKS5DatagramServerSocket::RebindForProxyFamily() {
+  const AddressFamily proxy_family =
+      GetAddressFamily(proxy_endpoint_.address());
+  if (proxy_family == listen_family_) {
+    return OK;
+  }
+  // Closing and reopening is the only way to change a bound socket's family,
+  // and it is safe here: nothing has been sent or received yet, the port is
+  // ephemeral and discarded anyway, and GetLocalAddress() reports the relay's
+  // address rather than this socket's, so no address the caller has seen
+  // changes.
+  datagram_socket_->Close();
+  const IPEndPoint bind_address(proxy_family == ADDRESS_FAMILY_IPV4
+                                    ? IPAddress::IPv4AllZeros()
+                                    : IPAddress::IPv6AllZeros(),
+                                0);
+  int rv = datagram_socket_->Listen(bind_address);
+  if (rv != OK) {
+    listening_ = false;
+    return rv;
+  }
+  listen_family_ = proxy_family;
+  // Re-apply what the caller set on the socket it thought it had. A failure
+  // here costs the OS default buffer size and nothing else, which is what the
+  // caller's own failed call would have cost.
+  if (receive_buffer_size_.has_value()) {
+    datagram_socket_->SetReceiveBufferSize(*receive_buffer_size_);
+  }
+  if (send_buffer_size_.has_value()) {
+    datagram_socket_->SetSendBufferSize(*send_buffer_size_);
+  }
+  return OK;
+}
+
 int SOCKS5DatagramServerSocket::DoControlConnect() {
   next_state_ = STATE_CONTROL_CONNECT_COMPLETE;
   const NetLogWithSource& net_log = datagram_socket_->NetLog();
@@ -887,10 +938,13 @@
 }
 
 int SOCKS5DatagramServerSocket::SetReceiveBufferSize(int32_t size) {
+  // Remembered so that a rebind onto the proxy's family can replay it.
+  receive_buffer_size_ = size;
   return datagram_socket_->SetReceiveBufferSize(size);
 }
 
 int SOCKS5DatagramServerSocket::SetSendBufferSize(int32_t size) {
+  send_buffer_size_ = size;
   return datagram_socket_->SetSendBufferSize(size);
 }
 
