+P2PSocketManager::UdpEgress P2PSocketManager::GetUdpEgress(
+    net::HostPortPair* proxy) {
+  if (!udp_egress_.has_value()) {
+    udp_egress_ = ResolveUdpEgress(url_request_context_, &udp_egress_proxy_);
+  }
+  *proxy = udp_egress_proxy_;
+  return *udp_egress_;
+}
+
+void P2PSocketManager::EnsureUdpEgressFamilies(base::OnceClosure done) {
+  if (udp_egress_families_.has_value()) {
+    std::move(done).Run();
+    return;
+  }
+  udp_egress_family_callbacks_.push_back(std::move(done));
+  if (udp_egress_family_request_) {
+    return;
+  }
+
+  net::HostPortPair proxy;
+  switch (GetUdpEgress(&proxy)) {
+    case UdpEgress::kDirect:
+      // The host's own interfaces, so whatever families they have.
+      FinishUdpEgressFamilies({/*ipv4=*/true, /*ipv6=*/true});
+      return;
+    case UdpEgress::kBlocked:
+      FinishUdpEgressFamilies({/*ipv4=*/false, /*ipv6=*/false});
+      return;
+    case UdpEgress::kRelayThroughSocks5:
+      break;
+  }
+
+  // The families the proxy resolves in, which are the families it can serve an
+  // association in and therefore the only families a relayed candidate can be
+  // in. This is the lookup each SOCKS5DatagramServerSocket performs for itself
+  // before connecting its control stream, done once here so that the answer is
+  // known before a port exists rather than after one has been created and
+  // cannot be taken back. The default query type, not one narrowed to a
+  // family, for the reason SOCKS5DatagramServerSocket gives: the stream path
+  // through the same proxy asks for both, and a narrowed query would make the
+  // media plane's lookup distinguishable at the resolver.
+  udp_egress_family_request_ =
+      url_request_context_->host_resolver()->CreateRequest(
+          proxy, network_anonymization_key_,
+          net::handles::kInvalidNetworkHandle, net::NetLogWithSource(),
+          std::nullopt);
+  int rv = udp_egress_family_request_->Start(
+      base::BindOnce(&P2PSocketManager::OnUdpEgressFamiliesResolved,
+                     base::Unretained(this)));
+  if (rv != net::ERR_IO_PENDING) {
+    OnUdpEgressFamiliesResolved(rv);
+  }
+}
+
+void P2PSocketManager::OnUdpEgressFamiliesResolved(int result) {
+  UdpEgressFamilies families;
+  if (result == net::OK) {
+    for (const net::IPEndPoint& endpoint :
+         udp_egress_family_request_->GetAddressResults().endpoints()) {
+      if (endpoint.address().IsIPv4()) {
+        families.ipv4 = true;
+      } else if (endpoint.address().IsIPv6()) {
+        families.ipv6 = true;
+      }
+    }
+  }
+  // A name that does not resolve leaves both false, which is the truth: no
+  // association can be made, so no UDP candidate of any family can be.
+  udp_egress_family_request_.reset();
+  FinishUdpEgressFamilies(families);
+}
+
+void P2PSocketManager::FinishUdpEgressFamilies(UdpEgressFamilies families) {
+  udp_egress_families_ = families;
+  std::vector<base::OnceClosure> callbacks =
+      std::move(udp_egress_family_callbacks_);
+  udp_egress_family_callbacks_.clear();
+  for (base::OnceClosure& callback : callbacks) {
+    std::move(callback).Run();
+  }
 }
 
