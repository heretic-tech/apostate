 void P2PSocketManager::DoGetDefaultLocalAddresses(
     net::NetworkInterfaceList list) {
+  // The network list carries the address families this manager's datagram
+  // egress covers, and settling that needs the proxy's name resolved. Re-read
+  // it on this edge unless a read is already in flight: a network change is
+  // also when a real machine's candidate set changes, so it is the right
+  // moment to notice that the proxy configuration moved, and taking the
+  // network list and the families from one snapshot is what keeps the socket a
+  // request gets from contradicting what the renderer was told.
+  if (!udp_egress_family_request_) {
+    udp_egress_.reset();
+    udp_egress_families_.reset();
+  }
+  EnsureUdpEgressFamilies(
+      base::BindOnce(&P2PSocketManager::ContinueGetDefaultLocalAddresses,
+                     weak_factory_.GetWeakPtr(), std::move(list)));
+}
