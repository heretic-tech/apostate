+int SOCKS5DatagramServerSocket::RebindForProxyFamily() {
+  const AddressFamily proxy_family =
+      GetAddressFamily(proxy_endpoint_.address());
+  if (proxy_family == listen_family_) {
+    return OK;
+  }
+  // Closing and reopening is the only way to change a bound socket's family,
+  // and it is safe here: nothing has been sent or received yet, the port is
+  // ephemeral and discarded anyway, and GetLocalAddress() reports the relay's
+  // address rather than this socket's, so no address the caller has seen
+  // changes.
+  datagram_socket_->Close();
+  const IPEndPoint bind_address(proxy_family == ADDRESS_FAMILY_IPV4
+                                    ? IPAddress::IPv4AllZeros()
+                                    : IPAddress::IPv6AllZeros(),
+                                0);
+  int rv = datagram_socket_->Listen(bind_address);
+  if (rv != OK) {
+    listening_ = false;
+    return rv;
+  }
+  listen_family_ = proxy_family;
+  // Re-apply what the caller set on the socket it thought it had. A failure
+  // here costs the OS default buffer size and nothing else, which is what the
+  // caller's own failed call would have cost.
+  if (receive_buffer_size_.has_value()) {
+    datagram_socket_->SetReceiveBufferSize(*receive_buffer_size_);
+  }
+  if (send_buffer_size_.has_value()) {
+    datagram_socket_->SetSendBufferSize(*send_buffer_size_);
+  }
+  return OK;
+}
