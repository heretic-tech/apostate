+void UDPPort::OnSocketClosed(AsyncPacketSocket* socket, int error) {
+  RTC_DCHECK(socket == socket_);
+  if (ready_) {
+    // The port already reported its address, so its candidates stand and the
+    // session tears it down with the transport. A close here is the ordinary
+    // shutdown path.
+    return;
+  }
+  // The socket died before it was ever bound, so this port has no address to
+  // report and never will. Report the error now: leaving it pending stalls
+  // the whole session's candidate gathering, because
+  // BasicPortAllocatorSession only signals candidates-allocation-done once
+  // every port it created has completed or failed.
+  RTC_LOG(LS_WARNING) << ToString() << ": UDP socket closed before it was "
+                                       "bound, error=" << error;
+  error_ = error;
+  ready_ = true;
+  NotifyPortError(this);
+}
