   int latched_error_ = OK;
 
-  // The family Listen() bound, which the proxy must be reachable over.
+  // The family Listen() bound. The proxy's family decides it in the end, and
+  // the two differ when the caller asked for a family the proxy has no address
+  // in -- which is not an error, because a relayed socket's traffic never
+  // leaves in the family the caller named.
   AddressFamily listen_family_ = ADDRESS_FAMILY_UNSPECIFIED;
 
+  // Buffer sizes the caller asked for, replayed after a rebind. A rebind
+  // closes and reopens the underlying socket, which drops them.
+  std::optional<int32_t> receive_buffer_size_;
