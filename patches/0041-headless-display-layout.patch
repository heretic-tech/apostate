   if (const DictValue* screen = dict->FindDict("screen")) {
+    if (const Value* raw_displays = screen->Find("displays")) {
+      const ListValue* displays = raw_displays->GetIfList();
+      if (!displays || displays->empty() || displays->size() > 16) {
+        LOG(ERROR) << "apostate: screen.displays must contain 1..16 displays";
+        return nullptr;
+      }
+      int primary_count = 0;
+      for (const Value& value : *displays) {
+        Profile::ScreenDisplay display;
+        const DictValue* entry = value.GetIfDict();
+        if (!entry || !ParseScreenDisplay(*entry, &display)) {
+          LOG(ERROR) << "apostate: invalid screen.displays geometry or metadata";
+          return nullptr;
+        }
+        primary_count += display.is_primary;
+        profile->screen_displays_.push_back(std::move(display));
+      }
+      if (primary_count != 1 ||
+          (profile->screen_is_extended_ &&
+           *profile->screen_is_extended_ != (displays->size() > 1))) {
+        LOG(ERROR) << "apostate: screen.displays primary/count contradiction";
+        return nullptr;
+      }
+      // DisplayList requires its first inserted display to be primary.
+      std::stable_partition(profile->screen_displays_.begin(),
+                            profile->screen_displays_.end(),
+                            [](const auto& display) { return display.is_primary; });
+    }
     if (std::optional<int> v = screen->FindInt("width")) {
       profile->screen_width_ = *v;
     }
