+  if (const auto* profile = base::apostate::Profile::Get();
+      profile && !profile->screen_displays().empty()) {
+    for (const auto& source : profile->screen_displays()) {
+      HeadlessScreenInfo info;
+      // SetDisplayGeometry divides size/insets by DPR but preserves origin.
+      // Floor before its inverse ceil so integral DIP geometry round-trips,
+      // including fractional desktop DPR, without multiplying origins twice.
+      const float ratio = source.device_pixel_ratio;
+      info.bounds = gfx::Rect(
+          gfx::Point(source.left, source.top),
+          gfx::ScaleToFlooredSize(gfx::Size(source.width, source.height), ratio));
+      const int left = source.avail_left.value_or(source.left) - source.left;
+      const int top = source.avail_top.value_or(source.top) - source.top;
+      const auto insets = gfx::Insets::TLBR(
+          top, left, source.height - top - source.avail_height,
+          source.width - left - source.avail_width);
+      info.work_area_insets = gfx::ScaleToFlooredInsets(insets, ratio);
+      info.device_pixel_ratio = ratio;
+      info.color_depth = source.color_depth;
+      info.is_internal = source.is_internal;
+      info.label = source.label;
+      screen_info.push_back(std::move(info));
+    }
+    return screen_info;
+  }
