+bool ParseScreenDisplay(const DictValue& value, Profile::ScreenDisplay* out) {
+  auto bounded_int = [&](const char* key) -> std::optional<int> {
+    auto result = value.FindInt(key);
+    if (!result || *result < -1000000 || *result > 1000000)
+      return std::nullopt;
+    return result;
+  };
+  const auto left = bounded_int("left");
+  const auto top = bounded_int("top");
+  const auto width = bounded_int("width");
+  const auto height = bounded_int("height");
+  const auto avail_width = bounded_int("avail_width");
+  const auto avail_height = bounded_int("avail_height");
+  const auto ratio = value.FindDouble("device_pixel_ratio");
+  const auto depth = value.FindInt("color_depth");
+  const auto primary = value.FindBool("is_primary");
+  const auto internal = value.FindBool("is_internal");
+  const auto* label = value.FindString("label");
+  if (!left || !top || !width || !height || !avail_width || !avail_height ||
+      *width <= 0 || *height <= 0 || *avail_width <= 0 || *avail_height <= 0 ||
+      *avail_width > *width || *avail_height > *height || !ratio ||
+      !std::isfinite(*ratio) || *ratio < 1 || *ratio > 8 ||
+      !depth || (*depth != 24 && *depth != 30) || !primary || !internal ||
+      !label || label->size() > 1024) {
+    return false;
+  }
+  out->avail_left = bounded_int("avail_left");
+  out->avail_top = bounded_int("avail_top");
+  if ((value.Find("avail_left") && !out->avail_left) ||
+      (value.Find("avail_top") && !out->avail_top)) {
+    return false;
+  }
+  if ((out->avail_left && (*out->avail_left < *left ||
+                          *out->avail_left > *left + *width - *avail_width)) ||
+      (out->avail_top && (*out->avail_top < *top ||
+                         *out->avail_top > *top + *height - *avail_height))) {
+    return false;
+  }
+  out->left = *left;
+  out->top = *top;
+  out->width = *width;
+  out->height = *height;
+  out->avail_width = *avail_width;
+  out->avail_height = *avail_height;
+  out->device_pixel_ratio = static_cast<float>(*ratio);
+  out->color_depth = *depth;
+  out->is_primary = *primary;
+  out->is_internal = *internal;
+  out->label = *label;
+  return true;
+}
+
+
 }  // namespace
 
 Profile::Profile() = default;
