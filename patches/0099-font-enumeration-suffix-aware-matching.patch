 const char kMonoEmojiLocale[] = "und-Zsym";
 
+namespace {
+
+// The family-name suffixes Chromium strips before it re-matches the base
+// family, lowercase, mirroring TypefacesHasWeightSuffix and
+// TypefacesHasStretchSuffix in win/font_cache_skia_win.cc and
+// WindowsStretchSuffix in skia/font_cache_skia.cc. Those live in the platform
+// font caches as file-local statics; duplicating the strings here rather than
+// exporting them keeps the platform matchers untouched, and a suffix added
+// upstream that is missing here can only make this filter hide a family it
+// should have shown, never show one it should have hidden.
+constexpr std::string_view kWeightSuffixes[] = {
+    " thin",      " extralight", " ultralight", " light",
+    " regular",   " medium",     " demibold",   " semibold",
+    " extrabold", " ultrabold",  " black",      " heavy"};
+constexpr std::string_view kStretchSuffixes[] = {
+    " ultracondensed", " extracondensed", " condensed",
+    " narrow",         " semicondensed",  " semiexpanded",
+    " expanded",       " extraexpanded",  " ultraexpanded"};
+
+// Removes one recognised suffix from an already-lowercased name.
+bool StripOneSuffix(std::string_view& name,
+                    base::span<const std::string_view> suffixes) {
+  for (std::string_view suffix : suffixes) {
+    if (name.size() > suffix.size() && name.ends_with(suffix)) {
+      name.remove_suffix(suffix.size());
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+// static
+bool FontCache::ProfileHidesFamily(const AtomicString& family) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->filters_font_enumeration()) {
+    return false;
+  }
+
+  const std::string lowered = base::ToLowerASCII(family.Utf8());
+  std::string_view name(lowered);
+  if (profile->FontFamilyEnumerable(name)) {
+    return false;
+  }
+
+  // Some family names are resolved by stripping a recognised suffix and
+  // matching the base family instead, so the allowlist has to be consulted
+  // for the name the platform will actually look up. On Windows a host with
+  // Arial reports "Arial Narrow" as present whether or not a narrow face is
+  // installed, and the same holds for twenty other suffixes; an allowlist
+  // naming the base family and not the variants would describe a machine that
+  // cannot exist.
+  //
+  // Weight is tried first and precludes stretch, one level only, because that
+  // is the order and the depth of the else-if chain being mirrored.
+#if BUILDFLAG(IS_WIN)
+  const bool strip_weight = true;
+  const bool strip_stretch = true;
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  // The Linux path emulates only the stretch table, and only for a Windows
+  // persona. There is no weight emulation to mirror.
+  const bool strip_weight = false;
+  const bool strip_stretch =
+      profile->ua_platform() && *profile->ua_platform() == "Windows";
+#else
+  // CoreText does no suffix stripping. A Mac enumerates "Avenir Next" and
+  // "Avenir Next Condensed" as separate families, so hiding one while showing
+  // the other is a claim a Mac can make, and stripping here would decline to
+  // hide a family the profile legitimately excluded.
+  const bool strip_weight = false;
+  const bool strip_stretch = false;
+#endif
+
+  if (strip_weight && StripOneSuffix(name, kWeightSuffixes)) {
+    return !profile->FontFamilyEnumerable(name);
+  }
+  if (strip_stretch && StripOneSuffix(name, kStretchSuffixes)) {
+    return !profile->FontFamilyEnumerable(name);
+  }
+  return true;
+}
+
 #if BUILDFLAG(IS_ANDROID)
 extern const char kNotoColorEmojiCompat[] = "Noto Color Emoji Compat";
 #endif
