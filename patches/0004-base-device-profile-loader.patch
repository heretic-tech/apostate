@@ -0,0 +1,86 @@
+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_APOSTATE_PROFILE_H_
+#define BASE_APOSTATE_PROFILE_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base::apostate {
+
+// The device profile this process is presenting.
+//
+// Lives in base/ because the values it carries are consumed by base/ itself —
+// SysInfo is the first consumer — and base cannot depend on content or chrome.
+// That also makes it reachable from every process type without a layering
+// violation.
+//
+// Availability is the whole design constraint. A value read before the profile
+// is parsed is the host's real value, and a process that never receives the
+// profile reports the host's real value; both are observable from a page and
+// neither is visible in the surface the profile was meant to fix. So the
+// profile arrives on the command line, which is the only channel present before
+// anything else runs. Mojo is initialised after field trials and is therefore
+// too late — see docs/subsystems/profile-loader.md.
+//
+// Every getter returns nullopt when no profile is configured or when the
+// profile does not carry that field. Callers must fall through to the real
+// value rather than substituting a default: a made-up value is worse than the
+// host's, because it is wrong in a way nothing can predict.
+class BASE_EXPORT Profile {
+ public:
+  // Null when this process has no profile. Never owns; valid for process
+  // lifetime.
+  //
+  // Parses on first call. The command line is fully populated before anything
+  // in base runs, so there is no startup hook to place correctly and no process
+  // type that can be forgotten by omitting one.
+  static const Profile* Get();
+
+  // Overrides the profile for tests. Passing nullptr clears it.
+  static void SetForTesting(const Profile* profile);
+
+  Profile();
+  ~Profile();
+
+  Profile(const Profile&) = delete;
+  Profile& operator=(const Profile&) = delete;
+
+  // Number of logical processors the profile claims.
+  //
+  // A claim above the host's real count is permitted but weakly detectable: a
+  // worker scaling curve plateaus at the host's real capacity whatever this
+  // says. Claims at or below it are free. The loader clamps rather than
+  // refusing, because a browser that will not launch is a worse trade than a
+  // rarely probed weak signal.
+  std::optional<int> cpu_logical_cores() const { return cpu_logical_cores_; }
+
+  // Total physical memory in bytes.
+  //
+  // Note this is the *real* installed figure, not the value navigator.deviceMemory
+  // reports. Blink rounds to a power of two and clamps to [2, 32] GiB on
+  // desktop, so storing the bucketed value directly would let an out-of-bucket
+  // number ship. Reproducing Chromium's own rounding from a real figure cannot.
+  std::optional<uint64_t> memory_total_bytes() const {
+    return memory_total_bytes_;
+  }
+
+  // Identifier of the capture this profile was derived from, for diagnostics.
+  const std::string& source_id() const { return source_id_; }
+
+ private:
+  static Profile* ParseOrNull(const std::string& encoded);
+
+  std::optional<int> cpu_logical_cores_;
+  std::optional<uint64_t> memory_total_bytes_;
+  std::string source_id_;
+};
+
+}  // namespace base::apostate
+
+#endif  // BASE_APOSTATE_PROFILE_H_
