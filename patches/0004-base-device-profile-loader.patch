+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/profile.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+
+namespace base::apostate {
+
+namespace {
+
+const Profile* g_profile_for_testing = nullptr;
+
+}  // namespace
+
+Profile::Profile() = default;
+Profile::~Profile() = default;
+
+// static
+const Profile* Profile::Get() {
+  if (g_profile_for_testing) {
+    return g_profile_for_testing;
+  }
+
+  // Initialised on first use rather than from an explicit startup hook.
+  //
+  // The command line is fully populated before anything in base runs, so there
+  // is no window in which this could parse too early. Doing it here instead of
+  // from content's startup sequence removes the ordering hazard entirely —
+  // there is no call site to place correctly, and no process type that can be
+  // forgotten. Function-local static initialisation is thread-safe.
+  static const Profile* const profile = [] {
+    if (!CommandLine::InitializedForCurrentProcess()) {
+      return static_cast<const Profile*>(nullptr);
+    }
+    const CommandLine* command_line = CommandLine::ForCurrentProcess();
+    if (!command_line->HasSwitch(switches::kApostateProfile)) {
+      return static_cast<const Profile*>(nullptr);
+    }
+    return static_cast<const Profile*>(ParseOrNull(
+        command_line->GetSwitchValueASCII(switches::kApostateProfile)));
+  }();
+  return profile;
+}
+
+// static
+void Profile::SetForTesting(const Profile* profile) {
+  g_profile_for_testing = profile;
+}
+
+// static
+Profile* Profile::ParseOrNull(const std::string& encoded) {
+  std::string json;
+  if (!Base64Decode(encoded, &json)) {
+    LOG(ERROR) << "apostate: profile switch is not valid base64; ignoring";
+    return nullptr;
+  }
+
+  // Strict RFC parsing: a profile is machine-generated, so comments and
+  // trailing commas would only mask a generator bug.
+  std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!dict) {
+    LOG(ERROR) << "apostate: profile is not a JSON object; ignoring";
+    return nullptr;
+  }
+
+  auto profile = std::make_unique<Profile>();
+
+  if (const std::string* id = dict->FindString("id")) {
+    profile->source_id_ = *id;
+  }
+
+  // Absent fields stay absent. A profile that does not describe a surface must
+  // leave it inherited rather than have a default invented here, because an
+  // invented value is wrong in a way no consumer can detect.
+  if (const DictValue* cpu = dict->FindDict("cpu")) {
+    if (std::optional<int> cores = cpu->FindInt("logical_cores")) {
+      if (*cores > 0) {
+        profile->cpu_logical_cores_ = *cores;
+      } else {
+        LOG(ERROR) << "apostate: cpu.logical_cores must be positive; ignoring";
+      }
+    }
+  }
+
+  if (const DictValue* memory = dict->FindDict("memory")) {
+    // JSON numbers are doubles, and installed memory exceeds 2^53 in no
+    // realistic case, but a double still cannot represent an arbitrary uint64.
+    // Reading it as a double and converting is honest about the precision the
+    // wire format actually has.
+    if (std::optional<double> total = memory->FindDouble("total_bytes")) {
+      if (*total > 0) {
+        profile->memory_total_bytes_ = static_cast<uint64_t>(*total);
+      } else {
+        LOG(ERROR) << "apostate: memory.total_bytes must be positive; ignoring";
+      }
+    }
+  }
+
+  return profile.release();
+}
+
+}  // namespace base::apostate
