 namespace base {
 
 // static
 int SysInfo::NumberOfProcessors() {
+  // Apostate: the Windows half of the same clamp. Without it a Windows build
+  // ignores cpu.logical_cores entirely and reports the host's count, so one
+  // profile would describe a different machine depending on which OS built
+  // the binary — and sys_info.h would declare NumberOfProcessorsImpl with no
+  // definition on this platform.
+  //
+  // Same rule as the POSIX emitter: the claim is only ever reduced. A count
+  // above the host's is contradicted by any parallel-throughput measurement
+  // whatever this function returns, so an over-claim is served as the host's
+  // real count rather than refused.
+  if (const apostate::Profile* profile = apostate::Profile::Get()) {
+    if (std::optional<int> claimed = profile->cpu_logical_cores()) {
+      static int clamped = [claimed] {
+        const int real = NumberOfProcessorsImpl();
+        if (*claimed > real) {
+          LOG(WARNING) << "apostate: profile claims " << *claimed
+                       << " logical cores but the host has " << real
+                       << "; clamping, since measured parallelism cannot "
+                          "exceed the host";
+          return real;
+        }
+        return *claimed;
+      }();
+      return clamped;
+    }
+  }
+
+  return NumberOfProcessorsImpl();
+}
+
+// Apostate: the host's real logical processor count, split out so the clamp
+// above can consult it without re-entering the override. Mirrors the split in
+// sys_info_posix.cc.
