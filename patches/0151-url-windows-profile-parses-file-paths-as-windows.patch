diff --git a/url/url_parse_file.cc b/url/url_parse_file.cc
--- a/url/url_parse_file.cc
+++ b/url/url_parse_file.cc
@@ -115,22 +115,21 @@ Parsed DoParseFileUrl(std::basic_string_view<CharT> url) {
   size_t after_scheme;
