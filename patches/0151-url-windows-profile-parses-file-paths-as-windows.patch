--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -103,6 +103,7 @@
 #include "ui/base/resource/resource_bundle.h"
 #include "ui/base/resource/scoped_startup_resource_bundle.h"
 #include "ui/base/ui_base_switches.h"
+#include "url/url_file_semantics.h"
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || \
     BUILDFLAG(IS_MAC)
@@ -1444,6 +1445,16 @@
     base::apostate::InstallComposedProfile(user_data_dir);
   }
 
+  // Apostate: a Windows profile parses file paths the way Chrome on Windows
+  // does (patch 0151). Every process type decides it here, once its profile is
+  // on its command line and before it parses any page's URL. A Linux zygote
+  // decides it before it forks, so every renderer inherits the answer.
+  {
+    const base::apostate::Profile* profile = base::apostate::Profile::Get();
+    url::SetUsesWindowsFileSemantics(profile &&
+                                     profile->ua_platform() == "Windows");
+  }
+
   // Register component_updater PathProvider after DIR_USER_DATA overridden by
   // command line flags. Maybe move the chrome PathProvider down here also?
   component_updater::RegisterPathProvider(chrome::DIR_COMPONENTS,
