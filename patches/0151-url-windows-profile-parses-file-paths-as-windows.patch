--- /dev/null
+++ b/url/url_file_semantics.h
@@ -0,0 +1,27 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef URL_URL_FILE_SEMANTICS_H_
+#define URL_URL_FILE_SEMANTICS_H_
+
+#include "base/component_export.h"
+
+namespace url {
+
+// Apostate: whether this process parses URLs the way Chrome on Windows does,
+// turning "c:\foo" and "\\server\share" into file: URLs. A page reads the
+// difference through `new URL("c:/x").protocol`, so a Windows persona that
+// parsed like Linux would contradict its own user agent.
+//
+// Always true on Windows. Elsewhere it is false until the embedder calls the
+// setter, once per process, after that process's device profile is installed
+// (chrome_main_delegate.cc, PreSandboxStartup). So unit tests, host mode and
+// anything that runs before the profile is known keep the host's rules, and
+// this component never asks the profile loader anything itself.
+COMPONENT_EXPORT(URL) bool UsesWindowsFileSemantics();
+COMPONENT_EXPORT(URL) void SetUsesWindowsFileSemantics(bool enabled);
+
+}  // namespace url
+
+#endif  // URL_URL_FILE_SEMANTICS_H_
