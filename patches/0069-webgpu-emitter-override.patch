 namespace dawn::native {
 namespace {
 static constexpr DeviceDescriptor kDefaultDeviceDesc = {};
+
+// Backend capabilities a claimed desktop device may lack. Listed explicitly:
+// a capability outside this list is never stripped, so a future backend
+// feature stays visible until someone reasons about it, while a claimed
+// device that genuinely has one of these (Apple silicon has all five) keeps
+// it through the profile-membership test below.
+struct ProfileFeatureEntry {
+    Feature feature;
+    const char* name;
+};
+constexpr ProfileFeatureEntry kProfileStrippableFeatures[] = {
+    {Feature::Subgroups, "subgroups"},
+    {Feature::SubgroupSizeControl, "subgroup-size-control"},
+    {Feature::TextureCompressionASTC, "texture-compression-astc"},
+    {Feature::TextureCompressionASTCSliced3D, "texture-compression-astc-sliced-3d"},
+    {Feature::TextureCompressionETC2, "texture-compression-etc2"},
+};
+
+// Numeric limits reasoned about one by one in ApplyProfileAdapterCaps below.
+// A limit outside that list is never served from the profile.
 }  // anonymous namespace
 
 AdapterBase::AdapterBase(InstanceBase* instance,
@@ -71,6 +93,96 @@ AdapterBase::AdapterBase(InstanceBase* instance,
     UpdateLimits();
 }
 
+void AdapterBase::ApplyProfileAdapterCaps(const Adapter::ProfileAdapterCaps& caps) {
+    if (caps.features.empty()) {
+        return;
+    }
+    FeaturesSet filtered;
+    bool changed = false;
+    for (size_t i = 0; i < kEnumCount<Feature>; ++i) {
+        Feature feature = static_cast<Feature>(i);
+        if (!mSupportedFeatures.IsEnabled(feature)) {
+            continue;
+        }
+        bool keep = true;
+        for (const ProfileFeatureEntry& entry : kProfileStrippableFeatures) {
+            if (entry.feature == feature &&
+                caps.features.count(std::string(entry.name)) == 0) {
+                keep = false;
+                break;
+            }
+        }
+        if (keep) {
+            filtered.EnableFeature(feature);
+        } else {
+            changed = true;
+        }
+    }
+    if (changed) {
+        mSupportedFeatures = filtered;
+    }
+    if (!caps.vendor.empty()) {
+        mProfileVendor = caps.vendor;
+    }
+    if (!caps.architecture.empty()) {
+        mProfileArchitecture = caps.architecture;
+    }
+    if (caps.subgroup_min_size > 0) {
+        mProfileSubgroupMin = caps.subgroup_min_size;
+    }
+    if (caps.subgroup_max_size > 0) {
+        mProfileSubgroupMax = caps.subgroup_max_size;
+    }
+    // One call per reasoned-about limit: the smaller of the claim and the
+    // backend wins, so over-claiming is structurally impossible. Saturation
+    // keeps a profile value past uint32 from wrapping on the way down.
+    auto clampU32 = [&](uint32_t& member, const char* name) {
+        auto it = caps.limits.find(std::string(name));
+        if (it != caps.limits.end()) {
+            member = std::min(member, static_cast<uint32_t>(
+                                          std::min<uint64_t>(it->second, UINT32_MAX)));
+        }
+    };
+    auto clampU64 = [&](uint64_t& member, const char* name) {
+        auto it = caps.limits.find(std::string(name));
+        if (it != caps.limits.end()) {
+            member = std::min(member, it->second);
+        }
+    };
+    auto clampCompatU32 = [&](uint32_t& member, const char* name) {
+        auto it = caps.limits.find(std::string(name));
+        if (it != caps.limits.end()) {
+            member = std::min(member, static_cast<uint32_t>(
+                                          std::min<uint64_t>(it->second, UINT32_MAX)));
+        }
+    };
+    clampU64(mLimits.v1.maxBufferSize, "maxBufferSize");
+    clampU32(mLimits.v1.maxComputeInvocationsPerWorkgroup,
+             "maxComputeInvocationsPerWorkgroup");
+    clampU32(mLimits.v1.maxComputeWorkgroupSizeX, "maxComputeWorkgroupSizeX");
+    clampU32(mLimits.v1.maxComputeWorkgroupSizeY, "maxComputeWorkgroupSizeY");
+    clampU32(mLimits.v1.maxDynamicStorageBuffersPerPipelineLayout,
+             "maxDynamicStorageBuffersPerPipelineLayout");
+    clampU32(mLimits.v1.maxDynamicUniformBuffersPerPipelineLayout,
+             "maxDynamicUniformBuffersPerPipelineLayout");
+    clampU32(mLimits.v1.maxSampledTexturesPerShaderStage,
+             "maxSampledTexturesPerShaderStage");
+    clampU64(mLimits.v1.maxStorageBufferBindingSize, "maxStorageBufferBindingSize");
+    clampCompatU32(mLimits.compat.maxStorageBuffersInFragmentStage,
+                   "maxStorageBuffersInFragmentStage");
+    clampCompatU32(mLimits.compat.maxStorageBuffersInVertexStage,
+                   "maxStorageBuffersInVertexStage");
+    clampU32(mLimits.v1.maxStorageBuffersPerShaderStage,
+             "maxStorageBuffersPerShaderStage");
+    clampCompatU32(mLimits.compat.maxStorageTexturesInFragmentStage,
+                   "maxStorageTexturesInFragmentStage");
+    clampCompatU32(mLimits.compat.maxStorageTexturesInVertexStage,
+                   "maxStorageTexturesInVertexStage");
+    clampU32(mLimits.v1.maxStorageTexturesPerShaderStage,
+             "maxStorageTexturesPerShaderStage");
+    clampU32(mLimits.v1.maxVertexAttributes, "maxVertexAttributes");
+}
+
 AdapterBase::~AdapterBase() = default;
 
