Subject: [PATCH] webgpu: serve the claimed adapter from Dawn

A page's GPUAdapter info, features and limits come from the profile,
applied inside Dawn with plain values handed over by the WebGPU decoder.
Features are the intersection of the profile's list and what the backend
supports, so a feature the claimed device lacks disappears and none is
ever added. Each of fifteen listed limits takes the smaller of the claim
and the driver value. Vendor and architecture strings come from the
profile verbatim, and subgroup sizes take the minimum with a
power-of-two check so a bad profile value cannot trip Dawn's validation.

diff --git a/gpu/command_buffer/service/webgpu_decoder_impl.cc b/gpu/command_buffer/service/webgpu_decoder_impl.cc
index 255dab2d59..03ca36524f 100644
--- a/gpu/command_buffer/service/webgpu_decoder_impl.cc
+++ b/gpu/command_buffer/service/webgpu_decoder_impl.cc
@@ -5,8 +5,10 @@
 #include "gpu/command_buffer/service/webgpu_decoder_impl.h"
 
 #include <algorithm>
+#include <map>
 #include <memory>
 #include <optional>
+#include <set>
 #include <string_view>
 #include <vector>
 
@@ -1642,6 +1644,24 @@ bool WebGPUDecoderImpl::use_blocklist() const {
       safety_level_ == webgpu::SafetyLevel::kUnsafe ||
       std::ranges::contains(require_disabled_toggles_, "adapter_blocklist"));
 }
+// Intersect the enumerated adapter with the claimed device before the page
+// can read it. An empty feature set means the profile carries no webgpu
+// section and the adapter is left exactly as the backend built it.
+void ApplyProfileWebGPUAdapterCaps(dawn::native::Adapter& adapter) {
+  const auto* profile = base::apostate::Profile::Get();
+  if (!profile || profile->webgpu_features().empty()) {
+    return;
+  }
+  dawn::native::Adapter::ProfileAdapterCaps caps;
+  caps.features = profile->webgpu_features();
+  caps.vendor = profile->webgpu_vendor();
+  caps.architecture = profile->webgpu_architecture();
+  caps.subgroup_min_size = profile->webgpu_subgroup_min();
+  caps.subgroup_max_size = profile->webgpu_subgroup_max();
+  caps.limits = profile->webgpu_limits();
+  adapter.ApplyProfileAdapterCaps(caps);
+}
+
 
 wgpu::Adapter WebGPUDecoderImpl::CreatePreferredAdapter(
     wgpu::PowerPreference power_preference,
@@ -1873,6 +1893,8 @@ wgpu::Adapter WebGPUDecoderImpl::CreatePreferredAdapter(
         continue;
       }
 
+
+      ApplyProfileWebGPUAdapterCaps(native_adapter);
       return wgpu::Adapter(native_adapter.Get());
     }
   }
@@ -1892,6 +1914,8 @@ wgpu::Adapter WebGPUDecoderImpl::CreatePreferredAdapter(
       continue;
     }
 
+
+    ApplyProfileWebGPUAdapterCaps(native_adapter);
     return wgpu::Adapter(native_adapter.Get());
   }
 
