@@ -43,7 +44,17 @@ namespace blink {
 // path map certain common bitmap fonts to their truetype equivalent up front.
 inline const AtomicString& AdjustFamilyNameToAvoidUnsupportedFonts(
     const AtomicString& family_name) {
-#if BUILDFLAG(IS_WIN)
+#if !BUILDFLAG(IS_WIN)
+  // Apostate: a Windows persona answers these names the way Windows does, on
+  // any host. A page that asks for Courier gets Courier New, as on Windows,
+  // and never a face of the host's that happens to be called Courier.
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->ua_platform() ||
+      *profile->ua_platform() != "Windows") {
+    return family_name;
+  }
+#endif
+
   // On Windows, 'Courier New' (truetype font) is always present and
   // 'Courier' is a bitmap font. On Mac on the other hand 'Courier' is
   // a truetype font. Thus pages asking for Courier are better of
@@ -65,7 +76,6 @@ inline const AtomicString& AdjustFamilyNameToAvoidUnsupportedFonts(
       EqualIgnoringAsciiCase(family_name, font_family_names::kTimes)) {
     return font_family_names::kTimesNewRoman;
   }
-#endif
 
