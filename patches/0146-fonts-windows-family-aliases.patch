+bool ClaimsWindows(const base::apostate::Profile& profile) {
+  return profile.ua_platform() && *profile.ua_platform() == "Windows";
+}
+
 // Apostate: the family `system-ui` resolves to on the platform the profile
 // claims, or empty to keep this build's own answer. Windows Chrome takes it
 // from the shell's menu font, Segoe UI, and Linux Chrome from the desktop
@@ -153,12 +163,47 @@ bool FontCache::ProfileHidesFamily(const AtomicString& family) {
     return false;
   }
 
+  // A Windows persona never looks up Courier, MS Sans Serif, MS Serif or Times
+  // as written: AdjustFamilyNameToAvoidUnsupportedFonts turns them into
+  // Courier New, Microsoft Sans Serif and Times New Roman first, on Windows
+  // and on any other host. Such a name shows exactly when that family does.
+  if (ClaimsWindows(*profile)) {
+    const AtomicString& adjusted =
+        AdjustFamilyNameToAvoidUnsupportedFonts(family);
+    if (adjusted != family) {
+      return !profile->FontFamilyEnumerable(adjusted.Utf8());
+    }
+  }
+
   const std::string lowered = base::ToLowerASCII(family.Utf8());
   std::string_view name(lowered);
   if (profile->FontFamilyEnumerable(name)) {
     return false;
   }
 
+  // For a Windows persona the Linux lookup answers two more kinds of name the
+  // way Windows does (CreateWindowsPersonaTypeface in skia/font_cache_skia.cc):
+  // a name no face answers to falls back to its alternate family (Helvetica
+  // is Arial), and a name Windows files a listed family under finds that
+  // family (Franklin Gothic is Franklin Gothic Medium). Other builds keep
+  // these names hidden, because their lookup would reach the host's own
+  // Helvetica.
+#if BUILDFLAG(IS_LINUX)
+  const bool windows_names = ClaimsWindows(*profile);
+#else
+  const bool windows_names = false;
+#endif
+  if (windows_names) {
+    const AtomicString& alternate = AlternateFamilyName(family);
+    if (!alternate.empty() &&
+        profile->FontFamilyEnumerable(alternate.Utf8())) {
+      return false;
+    }
+    if (!ProfileWeightNamedFamily(family, kNormalWeightValue).IsNull()) {
+      return false;
+    }
+  }
+
   // Some family names are resolved by stripping a recognised suffix and
   // matching the base family instead, so the allowlist has to be consulted
   // for the name the platform will actually look up. On Windows a host with
@@ -196,6 +241,51 @@ bool FontCache::ProfileHidesFamily(const AtomicString& family) {
   return true;
 }
 
+// static
+bool FontCache::ProfileListsFamily(const AtomicString& family) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  return !profile || profile->FontFamilyEnumerable(family.Utf8());
+}
+
+// static
+AtomicString FontCache::ProfileWeightNamedFamily(const AtomicString& family,
+                                                 FontSelectionValue weight) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->filters_font_enumeration() ||
+      !ClaimsWindows(*profile)) {
+    return AtomicString();
+  }
+  const std::string written = family.Utf8();
+  const std::string lowered = base::ToLowerASCII(written);
+  if (profile->FontFamilyEnumerable(lowered)) {
+    return AtomicString();
+  }
+
+  // The suffixes run from light to heavy. A tie goes to the heavier family
+  // from normal weight up and to the lighter one below it, as CSS font
+  // matching does.
+  const bool ties_go_heavier = weight >= kNormalWeightValue;
+  const base::span<const std::string_view> suffixes(kWeightSuffixes);
+  const base::span<const float> weights(kWeightSuffixWeights);
+  std::string_view nearest;
+  float nearest_distance = 0;
+  for (size_t i = 0; i < suffixes.size(); ++i) {
+    if (!profile->FontFamilyEnumerable(base::StrCat({lowered, suffixes[i]}))) {
+      continue;
+    }
+    const float distance = std::abs(weights[i] - static_cast<float>(weight));
+    if (nearest.empty() || distance < nearest_distance ||
+        (ties_go_heavier && distance == nearest_distance)) {
+      nearest = suffixes[i];
+      nearest_distance = distance;
+    }
+  }
+  if (nearest.empty()) {
+    return AtomicString();
+  }
+  return AtomicString::FromUtf8(base::StrCat({written, nearest}));
+}
