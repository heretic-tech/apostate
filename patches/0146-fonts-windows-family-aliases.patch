+// Whether a lookup answers family names the way Windows does: a family name,
+// not a unique face name, for a Windows persona, and not the last-resort
+// search, which has to find some face.
+bool UsesWindowsFamilyNames(const FontFaceCreationParams& creation_params,
+                            AlternateFontName alternate_name) {
+  const auto* profile = base::apostate::Profile::Get();
+  return profile && profile->ua_platform() &&
+         *profile->ua_platform() == "Windows" &&
+         creation_params.CreationType() == kCreateFontByFamily &&
+         alternate_name != AlternateFontName::kLocalUniqueFace &&
+         alternate_name != AlternateFontName::kLastResort;
+}
 #endif  // BUILDFLAG(IS_LINUX)
 
 const FontPlatformData* CreateFontPlatformDataForTypeface(
@@ -349,6 +362,81 @@ sk_sp<SkTypeface> FontCache::CreateTypeface(
   return typeface;
 }
 
+#if BUILDFLAG(IS_LINUX)
+// Windows answers a family name through DirectWrite, which also files a face
+// under its family name without the weight word, and then retries a name with
+// a width word as the base family at that width (win/font_cache_skia_win.cc).
+// fontconfig knows only the names written in each file. A name the persona
+// lists, or does not show at all, is looked up as written, with the width
+// retry. A name the persona shows only because Windows answers it with a
+// listed family is answered with that family and never looked up as written,
+// so no host face of that name comes back.
+sk_sp<SkTypeface> FontCache::CreateWindowsPersonaTypeface(
+    const FontDescription& font_description,
+    const AtomicString& family,
+    std::string& name) {
+  AtomicString base_family;
+  FontSelectionValue stretch;
+  const bool has_stretch_suffix =
+      WindowsStretchSuffix(family, base_family, stretch);
+
+  if (ProfileListsFamily(family) || ProfileHidesFamily(family)) {
+    sk_sp<SkTypeface> typeface =
+        CreateTypeface(font_description, FontFaceCreationParams(family), name);
+    if (!has_stretch_suffix ||
+        (typeface && MatchesWindowsFamily(typeface.get(), family))) {
+      return typeface;
+    }
+    FontDescription stretched = font_description;
+    stretched.SetStretch(stretch);
+    typeface =
+        CreateTypeface(stretched, FontFaceCreationParams(base_family), name);
+    if (!typeface || !MatchesWindowsFamily(typeface.get(), base_family)) {
+      return nullptr;
+    }
+    return typeface;
+  }
+
+  // Franklin Gothic is the listed Franklin Gothic Medium.
+  const AtomicString weight_family =
+      ProfileWeightNamedFamily(family, font_description.Weight());
+  if (!weight_family.IsNull()) {
+    sk_sp<SkTypeface> typeface = CreateTypeface(
+        font_description, FontFaceCreationParams(weight_family), name);
+    if (!typeface || !MatchesWindowsFamily(typeface.get(), weight_family)) {
+      return nullptr;
+    }
+    return typeface;
+  }
+
+  // Arial Narrow, when only Arial is listed, is Arial at the narrow width. A
+  // face that answers to Arial Narrow itself is the host's, since the persona
+  // lists none, so it is Arial at its normal width, as on a Windows machine
+  // without a narrow face.
+  if (has_stretch_suffix) {
+    FontDescription stretched = font_description;
+    stretched.SetStretch(stretch);
+    sk_sp<SkTypeface> typeface =
+        CreateTypeface(stretched, FontFaceCreationParams(base_family), name);
+    if (typeface && MatchesWindowsFamily(typeface.get(), family)) {
+      stretched.SetStretch(kNormalWidthValue);
+      typeface =
+          CreateTypeface(stretched, FontFaceCreationParams(base_family), name);
+    }
+    if (!typeface || !MatchesWindowsFamily(typeface.get(), base_family) ||
+        MatchesWindowsFamily(typeface.get(), family)) {
+      return nullptr;
+    }
+    return typeface;
+  }
+
+  // Helvetica, or Courier asked for without going through
+  // AdjustFamilyNameToAvoidUnsupportedFonts. No Windows face answers to the
+  // name; the caller tries its alternate family.
+  return nullptr;
+}
+#endif  // BUILDFLAG(IS_LINUX)
+
