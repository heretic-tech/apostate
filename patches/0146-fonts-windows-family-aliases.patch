+#endif
   } else {
     typeface = CreateTypeface(font_description, creation_params, name);
   }
@@ -381,29 +474,6 @@ const FontPlatformData* FontCache::CreateFontPlatformData(
   typeface = CreateTypeface(font_description, creation_params, name);
 #endif
 
