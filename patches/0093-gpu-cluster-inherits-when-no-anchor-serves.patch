+    // An axis that hangs off the anchor has nothing to hang off when the GPU
+    // cluster is the host's own. Its surface is inherited too, for the reason
+    // the empty-option-set branch below already gives: the host's own value is
+    // servable by definition.
+    //
+    // Checked here rather than left to the lookup below, because that lookup
+    // treats a missing parent as a catalogue defect and aborts. It is a defect
+    // when the resolution order is wrong. It is not one when the parent was
+    // legitimately never resolved.
+    //
+    // gpu_identity is the only axis this catches, and it is caught by either
+    // test on its own: it is the only anchor-member axis and the only axis
+    // conditioned on "anchor". Every other axis keys on platform, os_release
+    // or languages, none of which comes from the anchor, so the surviving set
+    // and the skipped set are disjoint and together are all of them. Both
+    // tests are kept so that a future anchor-conditioned axis is caught
+    // whichever way the catalogue spells its dependency.
+    if (!anchor) {
+      bool needs_anchor = axis.servability == Servability::kAnchorMember;
+      for (const std::string_view name : axis.conditioned_on) {
+        needs_anchor = needs_anchor || name == "anchor";
+      }
+      if (needs_anchor) {
+        const std::string limitation =
+            "the GPU capability cluster is the host's own on this host, so "
+            "this axis has no anchor to be conditioned on and its surface is "
+            "inherited as well";
+        composition.surfaces.push_back({
+            .surface = std::string(axis.axis),
+            .value = "(inherited)",
+            .layer = std::string(kLayerHostInherited),
+            .evidence = "host-inherited",
+            .limitation = limitation,
+        });
+        composition.limitations.push_back(std::string(axis.axis) + ": " +
+                                          limitation);
+        continue;
+      }
+    }
+
