-    weights.reserve(servable.size());
-    for (const Anchor* candidate : servable) {
-      weights.push_back(candidate->weight);
+      // No measured cluster fits this host. On a software rasteriser that is
+      // the normal case and always will be: a capability cluster is a property
+      // of a real driver, so nothing in the corpus was captured through
+      // SwiftShader and nothing ever can be. Patch 0091 made that condition
+      // detectable instead of guessed, which is what brings launches here.
+      //
+      // The GPU surfaces are therefore left inherited, which is what every
+      // other axis with no servable option already does a few dozen lines
+      // below. Returning nullopt here instead discarded the entire profile --
+      // timezone, locale, accept-languages, fonts, screen geometry, core
+      // count, memory, media device topology, voices -- because one surface
+      // out of a dozen could not be served. A page reads all of them and only
+      // some of them are GPU, so that trade was the wrong way round, and a
+      // GPU-less Linux container is precisely the host this is built for.
+      //
+      // Inheriting is coherent and not merely safe. Real Chrome reports
+      // SwiftShader whenever it runs in a VM, a container or an RDP session
+      // over a perfectly real Windows or macOS install, so a persona above a
+      // software rasteriser is a configuration that exists in the world by
+      // the million. The alternative -- a discrete-GPU renderer string above
+      // SwiftShader's own limits and extension list -- is a combination that
+      // exists nowhere, and it is the one a WebGL hash catches first.
+      composition.limitations.push_back(
+          "anchor: no compiled anchor was captured through this host's "
+          "graphics backend (" +
+          request.host.graphics_backend +
+          "), so the GPU capability cluster is the host's own and every other "
+          "surface is composed as usual");
+      composition.surfaces.push_back({
+          .surface = "anchor",
+          .value = "(inherited)",
+          .layer = std::string(kLayerHostInherited),
+          .evidence = "host-inherited",
+          .limitation = "no compiled anchor was captured through this host's "
+                        "graphics backend",
+      });
+    } else {
+      std::vector<uint32_t> weights;
+      weights.reserve(servable.size());
+      for (const Anchor* candidate : servable) {
+        weights.push_back(candidate->weight);
+      }
+      anchor = servable[WeightedPick(
+          High64(Draw(composition.root, "anchor", 0)), weights)];
     }
-    anchor = servable[WeightedPick(High64(Draw(composition.root, "anchor", 0)),
-                                   weights)];
   }
 
-  resolved["anchor"] = std::string(anchor->id);
+  if (anchor) {
+    resolved["anchor"] = std::string(anchor->id);
+  }
 
