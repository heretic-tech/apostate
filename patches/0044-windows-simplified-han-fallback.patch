Subject: [PATCH] fonts: Windows Simplified Han fallback for Windows profiles

Under a Windows profile, a missing Simplified Chinese glyph falls back
through the same ordered family list Windows uses, starting with
Microsoft YaHei. Fontconfig on Linux picks Malgun Gothic for an English
locale instead, which gives a page different glyph shapes and widths.
Each candidate must be installed and cover the glyph. Other scripts,
other profiles and runs without a profile keep the Linux path.

diff --git a/third_party/blink/renderer/platform/fonts/linux/font_cache_linux.cc b/third_party/blink/renderer/platform/fonts/linux/font_cache_linux.cc
--- a/third_party/blink/renderer/platform/fonts/linux/font_cache_linux.cc
+++ b/third_party/blink/renderer/platform/fonts/linux/font_cache_linux.cc
@@ -24,15 +24,64 @@
 
 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
 
+#include <unicode/uscript.h>
+
+#include "base/apostate/profile.h"
+#include "base/strings/string_util.h"
 #include "build/build_config.h"
 #include "third_party/blink/public/platform/linux/web_sandbox_support.h"
 #include "third_party/blink/public/platform/platform.h"
 #include "third_party/blink/renderer/platform/fonts/font_fallback_priority.h"
 #include "third_party/blink/renderer/platform/fonts/font_platform_data.h"
 #include "third_party/blink/renderer/platform/fonts/simple_font_data.h"
+#include "third_party/blink/renderer/platform/text/layout_locale.h"
+#include "third_party/skia/include/core/SkTypeface.h"
 #include "ui/gfx/font_fallback_linux.h"
 
 namespace blink {
+
+namespace {
+
+bool UseWindowsSimplifiedHanFallback(const FontDescription& description,
+                                     UChar32 character) {
+  const auto* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->ua_platform() ||
+      *profile->ua_platform() != "Windows") {
+    return false;
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  if (uscript_getScript(character, &error) != USCRIPT_HAN || U_FAILURE(error)) {
+    return false;
+  }
+  const LayoutLocale* locale = LayoutLocale::LocaleForHan(description.Locale());
+  if (!locale) {
+    locale = &LayoutLocale::GetSystem();
+  }
+  return locale->GetScriptForHan() == USCRIPT_SIMPLIFIED_HAN;
+}
+
+bool TypefaceHasFamily(SkTypeface* face, const char* family) {
+  // Fontconfig can substitute a different family for an absent candidate.
+  // Check actual localized names before treating it as an available face.
+  auto* names = face->createFamilyNameIterator();
+  SkTypeface::LocalizedString name;
+  bool matches = false;
+  while (names->next(&name)) {
+    if (base::EqualsCaseInsensitiveASCII(name.fString.c_str(), family)) {
+      matches = true;
+      break;
+    }
+  }
+  names->unref();
+  if (!matches) {
+    SkString primary;
+    face->getFamilyName(&primary);
+    matches = base::EqualsCaseInsensitiveASCII(primary.c_str(), family);
+  }
+  return matches;
+}
+
+}  // namespace
 
 static AtomicString& MutableSystemFontFamily() {
   DEFINE_THREAD_SAFE_STATIC_LOCAL(AtomicString, system_font_family, ());
@@ -86,6 +135,27 @@
       return font_data;
   }
 
+  if (UseWindowsSimplifiedHanFallback(font_description, c)) {
+    // Reuse the Windows Simplified Han candidate order from
+    // win/font_fallback_win.cc. This runs only after the requested face and
+    // standard-style fallback have failed to cover the character.
+    static constexpr const char* kFamilies[] = {
+        "Noto Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", "simsun"};
+    for (const char* family : kFamilies) {
+      const FontPlatformData* data = GetFontPlatformData(
+          font_description, FontFaceCreationParams(AtomicString(family)));
+      if (!data || !TypefaceHasFamily(data->Typeface(), family)) {
+        continue;
+      }
+      if (data->FontContainsCharacter(c)) {
+        return FontDataFromFontPlatformData(data);
+      }
+      // Windows first chooses an available family, then checks its glyph
+      // coverage. Preserve the existing fallback when that check fails.
+      break;
+    }
+  }
+
   gfx::FallbackFontData fallback_font;
   if (!FontCache::GetFontForCharacter(
           c,
