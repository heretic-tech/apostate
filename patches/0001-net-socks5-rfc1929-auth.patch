+scoped_refptr<DrainableIOBuffer> SOCKS5ClientSocket::BuildGreetWriteBuffer()
+    const {
+  std::vector<uint8_t> greeting;
+  greeting.push_back(kSOCKS5Version);
+  if (credentials_.has_value()) {
+    // Offer both, so a proxy that does not require authentication still
+    // completes and one that does can select it.
+    greeting.push_back(2);
+    greeting.push_back(kAuthMethodNone);
+    greeting.push_back(kAuthMethodUserPass);
+  } else {
+    greeting.push_back(1);
+    greeting.push_back(kAuthMethodNone);
+  }
+
+  auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(greeting));
+  size_t size = buffer->size();
+  return base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer), size);
+}
+
+scoped_refptr<DrainableIOBuffer> SOCKS5ClientSocket::BuildAuthWriteBuffer()
+    const {
+  DCHECK(credentials_.has_value());
+  DCHECK(credentials_->IsValid());
+
+  // RFC 1929: VER | ULEN | UNAME | PLEN | PASSWD
+  std::vector<uint8_t> request;
+  request.push_back(kAuthSubnegotiationVersion);
+  request.push_back(static_cast<uint8_t>(credentials_->username.size()));
+  request.insert(request.end(), credentials_->username.begin(),
+                 credentials_->username.end());
+  request.push_back(static_cast<uint8_t>(credentials_->password.size()));
+  request.insert(request.end(), credentials_->password.begin(),
+                 credentials_->password.end());
+
+  auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(request));
+  size_t size = buffer->size();
+  return base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer), size);
+}
 
