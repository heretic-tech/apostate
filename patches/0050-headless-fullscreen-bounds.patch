diff --git a/ui/ozone/platform/headless/headless_window_unittest.cc b/ui/ozone/platform/headless/headless_window_unittest.cc
--- a/ui/ozone/platform/headless/headless_window_unittest.cc
+++ b/ui/ozone/platform/headless/headless_window_unittest.cc
@@ -8,6 +8,7 @@
 
 #include "testing/gtest/include/gtest/gtest.h"
 #include "ui/display/test/test_screen.h"
+#include "ui/display/types/display_constants.h"
 #include "ui/gfx/geometry/rect.h"
 #include "ui/ozone/platform/headless/headless_window_manager.h"
 #include "ui/platform_window/platform_window_delegate.h"
@@ -139,5 +140,91 @@
   headless_window->Restore();
 }
 
+// Exercise the real screen matcher with device-pixel platform bounds.
+class ScaledGeometryDelegate : public DestroyingDelegate {
+ public:
+  explicit ScaledGeometryDelegate(float scale)
+      : DestroyingDelegate(DestroyOn::kNone), scale_(scale) {}
+
+  gfx::Rect ConvertRectToPixels(const gfx::Rect& bounds) const override {
+    return gfx::ScaleToEnclosingRect(bounds, scale_);
+  }
+  gfx::Rect ConvertRectToDIP(const gfx::Rect& bounds) const override {
+    return gfx::ScaleToEnclosingRect(bounds, 1.f / scale_);
+  }
+
+ private:
+  const float scale_;
+};
+
+class HeadlessWindowGeometryTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    display::Display primary(1, gfx::Rect(0, 0, 800, 600));
+    primary.set_work_area(gfx::Rect(0, 20, 800, 560));
+    test_screen_.display_list().AddDisplay(primary,
+                                         display::DisplayList::Type::PRIMARY);
+    display::Display secondary(2, gfx::Rect(800, -100, 600, 500));
+    secondary.set_work_area(gfx::Rect(800, -60, 600, 440));
+    test_screen_.display_list().AddDisplay(
+        secondary, display::DisplayList::Type::NOT_PRIMARY);
+  }
+
+  display::test::TestScreen test_screen_{/*create_display=*/false,
+                                         /*register_screen=*/true};
+  HeadlessWindowManager manager_;
+};
+
+TEST_F(HeadlessWindowGeometryTest, FullscreenUsesDisplayBoundsAndRestores) {
+  // On the primary display, unconverted pixel bounds would match the
+  // secondary display at scale 2. Integral coordinates avoid rounding ambiguity.
+  for (float scale : {1.f, 1.25f, 2.f}) {
+    SCOPED_TRACE(scale);
+    for (const gfx::Rect initial_dip :
+         {gfx::Rect(600, 100, 100, 100), gfx::Rect(900, 0, 100, 100)}) {
+      SCOPED_TRACE(initial_dip.ToString());
+      ScaledGeometryDelegate delegate(scale);
+      const gfx::Rect initial_pixels = delegate.ConvertRectToPixels(initial_dip);
+      HeadlessWindow window(&delegate, &manager_, initial_pixels);
+      const auto target_display = test_screen_.GetDisplayMatching(initial_dip);
+
+      window.SetFullscreen(true, display::kInvalidDisplayId);
+      EXPECT_EQ(window.GetBoundsInPixels(),
+                delegate.ConvertRectToPixels(target_display.bounds()));
+      EXPECT_EQ(window.GetPlatformWindowState(),
+                PlatformWindowState::kFullScreen);
+      window.SetFullscreen(false, display::kInvalidDisplayId);
+      EXPECT_EQ(window.GetBoundsInPixels(), initial_pixels);
+      EXPECT_EQ(window.GetPlatformWindowState(), PlatformWindowState::kNormal);
+    }
+  }
+}
+
+TEST_F(HeadlessWindowGeometryTest, MaximizeUsesWorkAreaBeforeFullscreen) {
+  for (float scale : {1.f, 1.25f, 2.f}) {
+    SCOPED_TRACE(scale);
+    for (const gfx::Rect initial_dip :
+         {gfx::Rect(600, 100, 100, 100), gfx::Rect(900, 0, 100, 100)}) {
+      SCOPED_TRACE(initial_dip.ToString());
+      ScaledGeometryDelegate delegate(scale);
+      const gfx::Rect initial_pixels = delegate.ConvertRectToPixels(initial_dip);
+      HeadlessWindow window(&delegate, &manager_, initial_pixels);
+      const auto target_display = test_screen_.GetDisplayMatching(initial_dip);
+
+      window.Maximize();
+      EXPECT_EQ(window.GetBoundsInPixels(),
+                delegate.ConvertRectToPixels(target_display.work_area()));
+      EXPECT_EQ(window.GetPlatformWindowState(), PlatformWindowState::kMaximized);
+      window.SetFullscreen(true, display::kInvalidDisplayId);
+      EXPECT_EQ(window.GetBoundsInPixels(),
+                delegate.ConvertRectToPixels(target_display.bounds()));
+      // Preserve the existing restore-to-normal contract after maximization.
+      window.SetFullscreen(false, display::kInvalidDisplayId);
+      EXPECT_EQ(window.GetBoundsInPixels(), initial_pixels);
+      EXPECT_EQ(window.GetPlatformWindowState(), PlatformWindowState::kNormal);
+    }
+  }
+}
+
 }  // namespace
 }  // namespace ui
