Subject: [PATCH] headless: fullscreen windows use the full display bounds

A headless window in fullscreen fills the whole display, and a maximized
window fills the work area. Otherwise fullscreen stops at the work area,
and a page in fullscreen sees a window smaller than the screen, which a
real browser never shows. This applies to every headless window, with or
without a profile, and adds tests at several scale factors on two
displays.

diff --git a/ui/ozone/platform/headless/headless_window.cc b/ui/ozone/platform/headless/headless_window.cc
--- a/ui/ozone/platform/headless/headless_window.cc
+++ b/ui/ozone/platform/headless/headless_window.cc
@@ -88,7 +88,7 @@
         window_state_ != PlatformWindowState::kFullScreen) {
       restored_bounds_ = bounds_;
     }
-    ZoomWindowBounds();
+    ZoomWindowBounds(/*fullscreen=*/true);
     if (!weak_ptr) {
       return;
     }
@@ -117,7 +117,7 @@
     auto weak_ptr = GetWeakPtr();
 
     restored_bounds_ = bounds_;
-    ZoomWindowBounds();
+    ZoomWindowBounds(/*fullscreen=*/false);
     if (!weak_ptr) {
       return;
     }
@@ -209,11 +209,13 @@
 
 void HeadlessWindow::SizeConstraintsChanged() {}
 
-void HeadlessWindow::ZoomWindowBounds() {
-  gfx::Rect zoomed_bounds =
-      display::Screen::Get()->GetDisplayMatching(bounds_).work_area();
-  // Convert the work area bounds from DIP to device pixels before setting
-  // the platform window's geometry.
+void HeadlessWindow::ZoomWindowBounds(bool fullscreen) {
+  // Screen matching takes DIP bounds; the platform window stores pixels.
+  const display::Display target_display =
+      display::Screen::Get()->GetDisplayMatching(GetBoundsInDIP());
+  const gfx::Rect zoomed_bounds =
+      fullscreen ? target_display.bounds() : target_display.work_area();
+  // Convert the selected bounds back to pixels for the platform window.
   UpdateBounds(delegate_->ConvertRectToPixels(zoomed_bounds));
 }
 
diff --git a/ui/ozone/platform/headless/headless_window.h b/ui/ozone/platform/headless/headless_window.h
--- a/ui/ozone/platform/headless/headless_window.h
+++ b/ui/ozone/platform/headless/headless_window.h
@@ -64,7 +64,7 @@
                       const gfx::ImageSkia& app_icon) override;
   void SizeConstraintsChanged() override;
 
-  void ZoomWindowBounds();
+  void ZoomWindowBounds(bool fullscreen);
   void RestoreWindowBounds();
   void UpdateBounds(const gfx::Rect& bounds);
