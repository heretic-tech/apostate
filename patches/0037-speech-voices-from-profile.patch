+namespace {
+
+// Voices the profile supplies, or nullptr when it supplies none.
+//
+// When present they replace the host's entirely rather than adding to them.
+// speech-dispatcher on the build host offers espeak voices with names no
+// Windows or macOS machine produces, so merging would report a device running
+// two synthesisers at once.
+const std::vector<base::apostate::Profile::SpeechVoice>* ApostateVoices() {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || profile->speech_voices().empty()) {
+    return nullptr;
+  }
+  return &profile->speech_voices();
+}
+
+// Characters per second of synthesised speech at rate 1.0. Measured against
+// the SAPI voices on the reference machine, which is also roughly where every
+// other synthesiser sits — the exact figure matters only because a page can
+// time an utterance, and an instant one is as wrong as a silent one.
+constexpr double kApostateCharsPerSecond = 15.0;
+
+}  // namespace
+
 bool TtsPlatformImplLinux::PlatformImplSupported() {
+  // A profile carrying voices makes this platform "supported" whether or not
+  // speech-dispatcher is installed. Without this the controller never asks for
+  // voices at all — TtsPlatformReady() gates the call — and the list stays
+  // empty no matter what GetVoices() would have returned.
+  if (ApostateVoices()) {
+    return true;
+  }
   return is_supported_;
 }
 
 bool TtsPlatformImplLinux::PlatformImplInitialized() {
+  if (ApostateVoices()) {
+    return true;
+  }
   return is_initialized_;
 }
 
@@ -437,6 +475,37 @@ void TtsPlatformImplLinux::Speak(
     return;
   }
 
+  // Speaking, when the voices came from the profile and the host has no
+  // synthesiser behind them.
+  //
+  // Serving a voice list that cannot speak would be worse than serving none.
+  // A page sets utterance.volume = 0, calls speak(), and listens for onend
+  // against onerror: silent, instant, and it catches a list of voices that are
+  // only a list. So the utterance runs — start, then end after the time real
+  // speech would have taken — and the only thing missing is audio, which
+  // nothing can observe.
+  //
+  // Deferred to the real synthesiser whenever there is one, so a host with
+  // speech-dispatcher installed still speaks for real.
+  if (ApostateVoices() && !is_initialized_) {
+    is_speaking_ = true;
+    utterance_id_ = utterance_id;
+    const int text_length = static_cast<int>(utterance.size());
+    TtsController::GetInstance()->OnTtsEvent(utterance_id, TTS_EVENT_START, 0,
+                                             text_length, std::string());
+    const double rate = params.rate > 0.0 ? params.rate : 1.0;
+    base::TimeDelta duration = base::Milliseconds(static_cast<int64_t>(
+        text_length * 1000.0 / (kApostateCharsPerSecond * rate)));
+    duration = std::clamp(duration, base::Milliseconds(120), base::Seconds(300));
+    GetUIThreadTaskRunner({})->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&TtsPlatformImplLinux::FinishApostateUtterance,
+                       base::Unretained(this), utterance_id, text_length),
+        duration);
+    std::move(on_speak_finished).Run(true);
+    return;
+  }
+
   // Flag that a utterance is getting emitted. The |is_speaking_| flag will be
   // set back to false when the utterance will be fully spoken, stopped or if
   // the voice synthetizer was not able to emit it.
@@ -453,10 +522,32 @@ void TtsPlatformImplLinux::Speak(
                                     std::move(on_speak_finished))));
 }
 
+void TtsPlatformImplLinux::FinishApostateUtterance(int utterance_id,
+                                                   int text_length) {
+  DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  // A stop or a newer utterance already moved on; the timer is stale.
+  if (utterance_id != utterance_id_) {
+    return;
+  }
+  is_speaking_ = false;
+  utterance_id_ = kInvalidUtteranceId;
+  TtsController::GetInstance()->OnTtsEvent(utterance_id, TTS_EVENT_END,
+                                           text_length, 0, std::string());
+}
+
 bool TtsPlatformImplLinux::StopSpeaking() {
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   DCHECK(PlatformImplInitialized());
 
+  // Nothing to stop in the worker when there is no synthesiser behind it, and
+  // calling into an uninitialised speech-dispatcher connection is not safe.
+  if (ApostateVoices() && !is_initialized_) {
+    paused_ = false;
+    is_speaking_ = false;
+    utterance_id_ = kInvalidUtteranceId;
+    return true;
+  }
+
   worker_.AsyncCall(&TtsPlatformImplBackgroundWorker::StopSpeaking);
   paused_ = false;
 
@@ -496,6 +587,25 @@ void TtsPlatformImplLinux::GetVoices(std::vector<VoiceData>* out_voices) {
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   DCHECK(PlatformImplInitialized());
 
+  if (const auto* claimed = ApostateVoices()) {
+    for (const auto& v : *claimed) {
+      out_voices->push_back(VoiceData());
+      VoiceData& voice = out_voices->back();
+      voice.native = true;
+      voice.name = v.name;
+      voice.lang = v.lang;
