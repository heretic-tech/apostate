Subject: [PATCH] battery: Battery Status API from the profile

navigator.getBattery() resolves with the profile's battery section, and
the browser never reads the host's battery. With present false, it
reports the default values desktop Chrome gives for a machine with no
battery. With present true, level and charging come from the profile,
and chargingTime and dischargingTime follow from them. The status
arrives once, on a posted task like a real IPC reply, and no change
events fire. A profile without a battery section leaves the host's
battery in place.

--- a/base/apostate/profile.h
+++ b/base/apostate/profile.h
@@ -428,6 +428,38 @@
   // sets it true is claiming something desktop Chrome cannot produce.
   std::optional<bool> network_save_data() const { return network_save_data_; }
 
+  // The battery the claimed device has, as the Battery Status API reports it.
+  //
+  // battery_present() is the gate, and false is not the same thing as hiding
+  // the API. Desktop Chrome still resolves getBattery(); it answers charging
+  // true, level 1.0, chargingTime 0 and dischargingTime Infinity, which is
+  // BatteryStatus's own default and what every platform's manager produces for
+  // a machine with no battery. So false means emit that tuple, and it is only
+  // coherent for a chassis that has no battery. A profile claiming a laptop
+  // and omitting this section inherits the host instead, which is how a laptop
+  // profile ends up reporting the tuple a server reports.
+  //
+  // level is a fraction in [0, 1]. Blink rounds it to two decimals in
+  // BatteryStatus::EnsureTwoSignificantDigits on every platform, so detail
+  // finer than a whole percent is discarded rather than served.
+  //
+  // The two times are seconds, and an absent one means Infinity, which is what
+  // the spec requires for the direction the charge is not moving in. macOS can
+  // only report whole minutes, since battery_status_manager_mac.cc multiplies
+  // the IOPM minute count by 60; Windows and UPower report seconds, where a
+  // whole minute is one of the values they can produce. The emitter rounds to
+  // the nearest minute so a figure no platform could have produced cannot
+  // reach a page.
+  std::optional<bool> battery_present() const { return battery_present_; }
+  std::optional<bool> battery_charging() const { return battery_charging_; }
+  std::optional<double> battery_level() const { return battery_level_; }
+  std::optional<int> battery_charging_time_seconds() const {
+    return battery_charging_time_seconds_;
+  }
+  std::optional<int> battery_discharging_time_seconds() const {
+    return battery_discharging_time_seconds_;
+  }
+
   // Pointing device capability: "fine", "coarse" or "none".
   //
   // Headless has no input device at all, so it reports none — and a desktop
@@ -513,6 +545,11 @@
   std::optional<int> network_http_rtt_ms_;
   std::optional<double> network_downlink_mbps_;
   std::optional<bool> network_save_data_;
+  std::optional<bool> battery_present_;
+  std::optional<bool> battery_charging_;
+  std::optional<double> battery_level_;
+  std::optional<int> battery_charging_time_seconds_;
+  std::optional<int> battery_discharging_time_seconds_;
   std::optional<std::string> pointer_type_;
   std::optional<bool> has_hover_;
   std::optional<uint32_t> css_highlight_argb_;
--- a/base/apostate/profile.cc
+++ b/base/apostate/profile.cc
@@ -647,6 +647,42 @@
     }
   }
 
+  if (const DictValue* battery = dict->FindDict("battery")) {
+    if (std::optional<bool> v = battery->FindBool("present")) {
+      profile->battery_present_ = *v;
+    }
+    if (std::optional<bool> v = battery->FindBool("charging")) {
+      profile->battery_charging_ = *v;
+    }
+    if (std::optional<double> v = battery->FindDouble("level")) {
+      if (std::isfinite(*v) && *v >= 0 && *v <= 1) {
+        profile->battery_level_ = *v;
+      } else {
+        LOG(ERROR) << "apostate: battery.level must be 0-1; ignoring";
+      }
+    }
+    // A week is past what any charger or discharge curve reaches, and both
+    // fields are seconds, so anything larger is a unit mistake rather than a
+    // claim.
+    constexpr int kMaxBatterySeconds = 7 * 24 * 60 * 60;
+    if (std::optional<int> v = battery->FindInt("charging_time_seconds")) {
+      if (*v >= 0 && *v <= kMaxBatterySeconds) {
+        profile->battery_charging_time_seconds_ = *v;
+      } else {
+        LOG(ERROR) << "apostate: battery.charging_time_seconds must be "
+                      "0-604800; ignoring";
+      }
+    }
+    if (std::optional<int> v = battery->FindInt("discharging_time_seconds")) {
+      if (*v >= 0 && *v <= kMaxBatterySeconds) {
+        profile->battery_discharging_time_seconds_ = *v;
+      } else {
+        LOG(ERROR) << "apostate: battery.discharging_time_seconds must be "
+                      "0-604800; ignoring";
+      }
+    }
+  }
+
   return profile.release();
 }
 
