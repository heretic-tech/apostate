+// static
+std::optional<BatteryStatus> BatteryDispatcher::ProfileBatteryStatus() {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile) {
+    return std::nullopt;
+  }
+  const std::optional<bool> present = profile->battery_present();
+  if (!present) {
+    return std::nullopt;
+  }
+
+  // Infinity, as the API spells it. BatteryStatus stores these as TimeDeltas
+  // and InSecondsF turns the maximum into the double infinity a page sees.
+  constexpr base::TimeDelta kForever = base::TimeDelta::Max();
+
+  // A chassis with no battery. This is not an absent API: desktop Chrome
+  // resolves getBattery() with exactly this tuple, which is also what
+  // BatteryStatus's default constructor holds.
+  if (!*present) {
+    return BatteryStatus(/*charging=*/true, /*charging_time=*/base::TimeDelta(),
+                         /*discharging_time=*/kForever, /*level=*/1.0);
+  }
+
+  const bool charging = profile->battery_charging().value_or(false);
+  const double level =
+      std::clamp(profile->battery_level().value_or(1.0), 0.0, 1.0);
+
+  // Whole minutes. macOS can only produce a multiple of 60, so a finer figure
+  // could not have come from the platform a macOS profile claims; Windows and
+  // UPower report seconds, where a whole minute is a value they can produce.
+  auto whole_minutes = [](std::optional<int> seconds) {
+    return seconds ? base::Minutes((*seconds + 30) / 60)
+                   : base::TimeDelta::Max();
+  };
+
+  // The API pins each time to Infinity in the direction the charge is not
+  // moving, and a battery already full on the charger needs no time to fill.
+  // Deriving both from the charging flag means a profile cannot state a pair
+  // the API itself forbids.
+  if (charging) {
+    return BatteryStatus(
+        true,
+        level >= 1.0 ? base::TimeDelta()
+                     : whole_minutes(profile->battery_charging_time_seconds()),
+        kForever, level);
+  }
+  return BatteryStatus(
+      false, kForever,
+      whole_minutes(profile->battery_discharging_time_seconds()), level);
+}
+
+void BatteryDispatcher::DeliverProfileBatteryStatus() {
+  if (std::optional<BatteryStatus> from_profile = ProfileBatteryStatus()) {
+    UpdateBatteryStatus(*from_profile);
+  }
+}
+
 void BatteryDispatcher::StartListening(LocalDOMWindow* window) {
   DCHECK(!monitor_.is_bound());
+
+  if (ProfileBatteryStatus()) {
+    // The monitor is never bound, so the host's charger and charge level are
+    // not read at all. One status is delivered and nothing re-queries, so two
+    // reads in one launch agree and no levelchange event ever fires.
+    //
+    // Posted rather than delivered inline. getBattery() resolves after an IPC
+    // round trip on a stock build, and PlatformEventDispatcher sets
+    // is_listening_ only once StartListening has returned, so notifying from
+    // inside it would resolve the promise a turn early and reenter the
+    // dispatcher's own bookkeeping.
+    window->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostTask(FROM_HERE,
+                   BindOnce(&BatteryDispatcher::DeliverProfileBatteryStatus,
+                            WrapPersistent(this)));
+    return;
+  }
+
   // See https://bit.ly/2S0zRAS for task types.
   window->GetBrowserInterfaceBroker().GetInterface(
       monitor_.BindNewPipeAndPassReceiver(
