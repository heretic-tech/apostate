+
+  for (const Expectation& expected : kExpected) {
+    std::string first_json;
+    for (int seed = 0; seed < 8; ++seed) {
+      ComposeRequest request =
+          RequestFor("render-" + NumberToString(seed), kAxes, CapableHost());
+      request.platform = expected.persona;
+      const std::optional<Composition> composed = Compose(request);
+      ASSERT_TRUE(composed.has_value()) << expected.persona;
+
+      const DictValue* params =
+          composed->profile.FindDictByDottedPath("fonts.render_params");
+      ASSERT_NE(nullptr, params) << expected.persona;
+      EXPECT_EQ(expected.hinting, *params->FindString("hinting"));
+      EXPECT_EQ(expected.subpixel_positioning,
+                params->FindBool("subpixel_positioning"));
+      EXPECT_EQ(expected.use_bitmaps, params->FindBool("use_bitmaps"));
+      EXPECT_EQ(expected.text_contrast, params->FindDouble("text_contrast"));
+      EXPECT_EQ(expected.text_gamma, params->FindDouble("text_gamma"));
+      // Complete, because a partial tuple leaves the rest to the host and the
+      // loader refuses it outright.
+      EXPECT_EQ(8u, params->size()) << expected.persona;
+
+      // And identical across seeds: the projection has nothing to draw from.
+      const std::string json =
+          WriteJsonWithOptions(*params,
+                               JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION)
+              .value_or("<unserialisable>");
+      if (seed == 0) {
+        first_json = json;
+      }
+      EXPECT_EQ(first_json, json) << expected.persona << " moved with the seed";
+
+      const SurfaceRecord* record = Record(*composed, "fonts.render_params");
+      ASSERT_NE(nullptr, record);
+      EXPECT_EQ("platform-projection", record->layer);
+      EXPECT_EQ("native-derived", record->evidence);
+      EXPECT_TRUE(record->limitation.empty());
+    }
+  }
+
+  // The three tuples are actually different, so the loop above is not three
+  // copies of one answer.
+  std::vector<std::string> tuples;
+  for (const Expectation& expected : kExpected) {
+    ComposeRequest request = RequestFor("render-seed", kAxes, CapableHost());
+    request.platform = expected.persona;
+    const std::optional<Composition> composed = Compose(request);
+    ASSERT_TRUE(composed.has_value());
+    tuples.push_back(
+        WriteJsonWithOptions(
+            *composed->profile.FindDictByDottedPath("fonts.render_params"),
+            JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION)
+            .value_or("<unserialisable>"));
+  }
+  EXPECT_NE(tuples[0], tuples[1]);
+  EXPECT_NE(tuples[1], tuples[2]);
+  EXPECT_NE(tuples[0], tuples[2]);
 }
 
