+namespace {
+
+// The profile's vocabulary is gfx::FontRenderParams::Hinting lowercased, and
+// base/apostate/profile.cc refuses any other spelling before the value is
+// stored, so these two are total over what can actually arrive.
+FontRenderParams::Hinting HintingFromProfile(std::string_view name) {
+  if (name == "none") {
+    return FontRenderParams::HINTING_NONE;
+  }
+  if (name == "slight") {
+    return FontRenderParams::HINTING_SLIGHT;
+  }
+  if (name == "medium") {
+    return FontRenderParams::HINTING_MEDIUM;
+  }
+  if (name == "full") {
+    return FontRenderParams::HINTING_FULL;
+  }
+  NOTREACHED();
+}
+
+FontRenderParams::SubpixelRendering SubpixelRenderingFromProfile(
+    std::string_view name) {
+  if (name == "none") {
+    return FontRenderParams::SUBPIXEL_RENDERING_NONE;
+  }
+  if (name == "rgb") {
+    return FontRenderParams::SUBPIXEL_RENDERING_RGB;
+  }
+  if (name == "bgr") {
+    return FontRenderParams::SUBPIXEL_RENDERING_BGR;
+  }
+  if (name == "vrgb") {
+    return FontRenderParams::SUBPIXEL_RENDERING_VRGB;
+  }
+  if (name == "vbgr") {
+    return FontRenderParams::SUBPIXEL_RENDERING_VBGR;
+  }
+  NOTREACHED();
+}
+
+}  // namespace
+
+std::optional<FontRenderParams> ComposedFontRenderParams() {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->font_render_params()) {
+    return std::nullopt;
+  }
+
+  // Whole tuple or nothing, which is the loader's rule and not a convenience
+  // here: a field left to the platform below would be the host's answer
+  // wearing the persona's, and on Linux that is the host's fontconfig.
+  const base::apostate::Profile::FontRenderParams& composed =
+      *profile->font_render_params();
+  FontRenderParams params;
+  params.antialiasing = composed.antialiasing;
+  params.subpixel_positioning = composed.subpixel_positioning;
+  params.autohinter = composed.autohinter;
+  params.use_bitmaps = composed.use_bitmaps;
+  params.hinting = HintingFromProfile(composed.hinting);
+  params.subpixel_rendering =
+      SubpixelRenderingFromProfile(composed.subpixel_rendering);
+  params.text_contrast = static_cast<float>(composed.text_contrast);
+  params.text_gamma = static_cast<float>(composed.text_gamma);
+  return params;
+}
+
 FontRenderParamsQuery::FontRenderParamsQuery()
     : pixel_size(0),
       point_size(0),
