-  // persona, and --fingerprint-locale is *inert* on this path
-  // (ReportAuthoredProfileBypass says so), so the payload's own list is the
-  // only thing that can name the locale. Its absence means the composed
-  // default, exactly as it does for a composed launch.
+  // persona, so its locale is pinned exactly as a composed one is.
   if (carried && Profile::PayloadDescribesDevice(supplied)) {
-    InstallComposedLocaleEnvironment(
-        ComposedLocaleTag(Profile::AcceptLanguagesInPayload(supplied)));
+    InstallComposedLocaleEnvironment(ComposedApplicationLocale());
     return;
   }
 
@@ -2050,19 +2120,12 @@ void InstallComposedProfile(const FilePath& user_data_dir) {
   // header from the same session.
   command_line->AppendSwitchASCII(::switches::kApostateProfile, payload);
 
-  // And the locale environment, from the same source the report named: the
-  // switch, because patch 0111 left --fingerprint-locale as the only thing
-  // that writes locale.accept_languages into a composed profile, so reading
-  // the switch and reading the composed profile are the same answer. Reading
-  // the switch is the one of the two that cannot be raced -- Profile::Get()
-  // caches on first call and that call can precede this hook, which is the
-  // bug patch 0110 was bitten by.
-  //
-  // Placed after the append because nothing requires either order and this one
-  // reads as the sequence it is: the profile is installed, then the launch's
-  // locale is pinned to what that profile resolved.
-  InstallComposedLocaleEnvironment(ComposedLocaleTag(
-      command_line->GetSwitchValueASCII(switches::kFingerprintLocale)));
+  // And the locale environment, from the accessor rather than from a second
+  // reading of the same inputs: ComposedApplicationLocale() is what
+  // l10n_util::GetApplicationLocale also resolves against, and one function
