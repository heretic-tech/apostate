+#if !BUILDFLAG(IS_APPLE) && !BUILDFLAG(IS_ANDROID)
+// Apostate: the composed application locale outranks every platform candidate.
+//
+// Excluded on Apple and Android for the reason the test above is: the locale
+// data those platforms look for cannot be faked through ui::DIR_LOCALES -- on
+// Apple GetLocaleFilePath resolves against the framework bundle's
+// <locale>.lproj, and this binary is not a bundle. The precedence itself is
+// structural there rather than untested: GetApplicationLocaleInternal returns
+// the composed locale before GetApplicationLocaleInternalMac is called at all,
+// so nothing in the Cocoa branch can be reached to override it, and the
+// decision that feeds it is covered by
+// ApostateComposeTest.TheApplicationLocaleFollowsTheLaunchPrecedence.
+//
+// What this covers is the half that is a behaviour change: on Windows
+// pref_locale -- the --lang switch and the kApplicationLocale pref -- was the
+// FIRST candidate, ahead of the preferred-UI-language list, so a stored UI
+// language in an existing Local State could outrank a composed persona's
+// locale. It cannot now, and this is the test that says so.
+TEST_F(L10nUtilTest, ApostateComposedLocaleOutranksThePlatformCandidates) {
+  base::ScopedPathOverride locale_dir_override(ui::DIR_LOCALES);
+  base::FilePath locale_dir;
+  ASSERT_TRUE(base::PathService::Get(ui::DIR_LOCALES, &locale_dir));
+  for (const char* tag : {"en-US", "de-DE", "fr"}) {
+    base::WriteFile(locale_dir.AppendASCII(std::string(tag) + ".pak"), "");
+  }
+
+  const std::string original_locale = base::i18n::GetConfiguredLocale();
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  const std::optional<std::string> original_language = env->GetVar("LANGUAGE");
+
+  const auto payload = [](std::string_view json) {
+    return base::Base64Encode(base::as_byte_span(json));
+  };
+
+  {
+    // No profile: every candidate is Chromium's own, which is what a launch
+    // that is not ours has to keep. `fr` arrives as pref_locale on Windows and
+    // through the environment on Linux, so one of the two answers on each.
+    base::test::ScopedCommandLine scoped;
+    scoped.GetProcessCommandLine()->RemoveSwitch(switches::kApostateProfile);
+    env->SetVar("LANGUAGE", "fr");
+    base::i18n::SetICUDefaultLocale("fr");
+    EXPECT_EQ("fr", l10n_util::GetApplicationLocale("fr"));
+  }
+
+  {
+    // A composed profile naming no locale. `fr` is still the platform's
+    // answer and is still servable -- the fake pak for it exists -- so this
+    // fails if the injection is absent or ordered after the candidates.
+    base::test::ScopedCommandLine scoped;
+    scoped.GetProcessCommandLine()->AppendSwitchASCII(
+        switches::kApostateProfile, payload(R"({"cpu":{"logical_cores":8}})"));
+    env->SetVar("LANGUAGE", "fr");
+    base::i18n::SetICUDefaultLocale("fr");
+    EXPECT_EQ("en-US", l10n_util::GetApplicationLocale("fr"));
+  }
+
+  {
+    // And an explicit --fingerprint-locale, which outranks the profile's own
+    // list as well as the platform's. The exact tag survives because the fake
+    // set above carries `de-DE`; a real build shipping only `de` narrows it to
+    // `de` through CheckAndResolveLocale, which is Chromium's behaviour and
+    // measured on both shipped targets.
+    base::test::ScopedCommandLine scoped;
+    base::CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->AppendSwitchASCII(
+        switches::kApostateProfile,
+        payload(R"({"locale":{"accept_languages":"fr,en"}})"));
+    command_line->AppendSwitchASCII(base::apostate::switches::kFingerprintLocale,
+                                    "de-DE,de");
+    env->SetVar("LANGUAGE", "fr");
+    base::i18n::SetICUDefaultLocale("fr");
+    EXPECT_EQ("de-DE", l10n_util::GetApplicationLocale("fr"));
+  }
+
+  {
+    // A composed locale with no data falls back to the composed default and
+    // NOT to the platform's answer. Falling through to `fr` here would serve
+    // the host's locale under a composed persona, which is the entire defect.
+    //
+    // `tlh` rather than a plausible language, because the fallback has to be
+    // unreachable for the right reason: CheckAndResolveLocale strips the region
+    // and retries, so a real tag like `sw-KE` resolves to `sw` on any build
+    // that ships Swahili -- measured, it does -- and would test nothing here.
+    base::test::ScopedCommandLine scoped;
+    base::CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->AppendSwitchASCII(switches::kApostateProfile,
+                                    payload(R"({"cpu":{"logical_cores":8}})"));
+    command_line->AppendSwitchASCII(base::apostate::switches::kFingerprintLocale,
+                                    "tlh-AA,tlh");
+    env->SetVar("LANGUAGE", "fr");
+    base::i18n::SetICUDefaultLocale("fr");
+    EXPECT_EQ("en-US", l10n_util::GetApplicationLocale("fr"));
+  }
+
+  if (original_language) {
+    env->SetVar("LANGUAGE", *original_language);
+  } else {
+    env->UnSetVar("LANGUAGE");
+  }
+  base::i18n::SetICUDefaultLocale(original_locale);
+}
+#endif  // !BUILDFLAG(IS_APPLE) && !BUILDFLAG(IS_ANDROID)
