--- a/ui/base/l10n/l10n_util.cc
+++ b/ui/base/l10n/l10n_util.cc
@@ -12,6 +12,7 @@
 #include <string>
 #include <string_view>
 
+#include "base/apostate/compose.h"
 #include "base/check_op.h"
 #include "base/command_line.h"
 #include "base/compiler_specific.h"
@@ -273,7 +274,70 @@ std::string GetApplicationLocaleInternalNonMac(std::string_view pref_locale) {
 }
 #endif  // !BUILDFLAG(IS_APPLE)
 
+// Apostate: the composed application locale, ahead of every platform
+// candidate.
+//
+// This is the one point all three desktop platforms share, and it has to be
+// this one because each of them leaks the host from a different place. On
+// Linux the candidates come from glib's LANGUAGE/LC_*/LANG reading, which the
+// browser's own environment already pins (patch 0114). On macOS
+// GetApplicationLocaleInternalMac consults GetLocaleOverride() first, filled
+// from NSBundle's preferredLocalizations, so the host's *system language*
+// decides -- and does so on the artifact as shipped, because the bundle has
+// always carried 55 .lproj directories. On Windows the candidates are
+// pref_locale, then GetLocaleOverrides(), which content fills from
+// GetThreadPreferredUILanguageList(); the ICU fallback below them is only
+// reached in a process where neither ran. Three levers, one resolution: so the
+// composed value is resolved here, above all of them, rather than pushed into
+// three platform slots that would each need their own ordering argument.
+//
+// Measured on the shipped macos-arm64 bundle, on a host whose system language
+// was varied per launch: a composed Windows persona reported Intl locale th
+// with calendar "buddhist" while navigator.languages said en-SG, and fr gave
+// French month names and 1 234 567,89 beside en-GB. Two producers, one
+// contradiction a page reads in a single call -- and --fingerprint-locale=de-DE
+// moved navigator.languages to de-DE and left Intl on the host's Thai, so the
+// launch contract's strongest locale layer was being honoured on one half of
+// the surface and ignored on the other.
+//
+// Nothing here reaches a launch that is not ours: ComposedApplicationLocale()
+// is empty unless this process carries an --apostate-profile that claims a
+// device, which --fingerprint=host, an unservable catalogue and every other
+// browser all fail.
+std::string ApostateApplicationLocale() {
+  const std::string composed = base::apostate::ComposedApplicationLocale();
+  if (composed.empty()) {
+    return std::string();
+  }
+  if (std::optional<std::string> resolved = CheckAndResolveLocale(composed)) {
+    return *resolved;
+  }
+
+  // The composed locale has no bundle in this build. Falling through to the
+  // platform candidates would serve the host's locale under a composed
+  // persona, which is the whole defect, so the composed *default* is tried
+  // instead -- it is the locale every shipped target is guaranteed to carry,
+  // and it is what a launch naming no locale would have presented anyway.
+  LOG(ERROR) << "apostate: no localization data for the composed locale '"
+             << composed << "'; presenting "
+             << base::apostate::kComposedDefaultLocale
+             << " rather than the host's";
+  if (std::optional<std::string> fallback =
+          CheckAndResolveLocale(base::apostate::kComposedDefaultLocale)) {
+    return *fallback;
+  }
+
+  // Not even en-US. This build ships no usable localization at all and the
+  // callers below CHECK on the empty string a moment later; returning empty
+  // here reaches that check with the platform candidates untried, which is
+  // wrong, so fall through and let Chromium's own fallback chain report it.
+  return std::string();
+}
+
 std::string GetApplicationLocaleInternal(std::string_view pref_locale) {
+  if (std::string composed = ApostateApplicationLocale(); !composed.empty()) {
+    return composed;
+  }
 #if BUILDFLAG(IS_APPLE)
   return GetApplicationLocaleInternalMac(pref_locale);
 #else
