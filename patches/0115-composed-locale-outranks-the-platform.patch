@@ -27,6 +29,7 @@
 #include "base/files/scoped_temp_dir.h"
 #include "base/json/json_writer.h"
 #include "base/strings/string_number_conversions.h"
+#include "base/test/scoped_command_line.h"
 #include "base/values.h"
 #include "build/build_config.h"
 #include "testing/gtest/include/gtest/gtest.h"
@@ -1497,5 +1500,115 @@ TEST(ApostateComposeTest, TheLocaleEnvironmentIsWrittenToAllFourVariables) {
 #endif
 }
 
+// The accessor l10n_util resolves against and InstallComposedProfile writes the
+// environment from. One function, so the resolution-side pin and the
+// environment-side pin cannot disagree -- which is the whole reason it exists
+// rather than each site reading the command line for itself.
+//
+// Driven through the process command line because that is its only input, and
+// deliberately not through Profile::Get(): Get() caches on first call and this
+// is called from locale resolution, which makes no ordering promises.
+TEST(ApostateComposeTest, TheApplicationLocaleFollowsTheLaunchPrecedence) {
+  const auto payload = [](std::string_view json) {
+    return Base64Encode(as_byte_span(json));
+  };
+
+  // No profile: inherit. This is --fingerprint=host, a catalogue that cannot
+  // serve the launch, and every process of a browser that is not ours -- all
+  // three install no profile, and an empty answer is what leaves l10n_util's
+  // platform candidates untouched.
+  {
+    test::ScopedCommandLine scoped;
+    CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->RemoveSwitch(::switches::kApostateProfile);
+    command_line->RemoveSwitch(switches::kFingerprintLocale);
+    EXPECT_EQ("", ComposedApplicationLocale());
+  }
+
+  // A payload that claims no device is not a composed launch either: an
+  // envelope carrying only proxy credentials has always meant "authored
+  // nothing", and pinning a locale off it would give an otherwise entirely
+  // host-inherited launch one composed surface.
+  {
+    test::ScopedCommandLine scoped;
+    CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->RemoveSwitch(switches::kFingerprintLocale);
+    command_line->AppendSwitchASCII(
+        ::switches::kApostateProfile,
+        payload(R"({"device_profile":{},"proxy_credentials":)"
+                R"({"username":"u","password":"p"}})"));
+    EXPECT_EQ("", ComposedApplicationLocale());
+  }
+
+  // A composed profile naming no locale: the composed default, never the
+  // host's.
+  {
+    test::ScopedCommandLine scoped;
+    CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->RemoveSwitch(switches::kFingerprintLocale);
+    command_line->AppendSwitchASCII(::switches::kApostateProfile,
+                                    payload(R"({"cpu":{"logical_cores":8}})"));
+    EXPECT_EQ(kComposedDefaultLocale, ComposedApplicationLocale());
+  }
+
+  // The profile's own list, which is what an authored --apostate-profile
+  // carries. Read from the payload rather than from the switch, because the
+  // switch is inert on that path and this is the only thing that can name it.
+  {
+    test::ScopedCommandLine scoped;
+    CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->RemoveSwitch(switches::kFingerprintLocale);
+    command_line->AppendSwitchASCII(
+        ::switches::kApostateProfile,
+        payload(R"({"locale":{"accept_languages":"ja-JP,ja"}})"));
+    EXPECT_EQ("ja-JP", ComposedApplicationLocale());
+  }
+
+  // --fingerprint-locale outranks the payload. Both are present here and they
+  // disagree, which is the only arrangement that tells them apart.
+  {
+    test::ScopedCommandLine scoped;
+    CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->AppendSwitchASCII(
+        ::switches::kApostateProfile,
+        payload(R"({"locale":{"accept_languages":"ja-JP,ja"}})"));
+    command_line->AppendSwitchASCII(switches::kFingerprintLocale,
+                                    "de-DE,de,en-US,en");
+    EXPECT_EQ("de-DE", ComposedApplicationLocale());
+  }
+}
+
+// --lang is inert under a composed profile on every platform, and the report
+// has to say so. It was inert on linux and macOS before this and said nothing;
+// on windows it was the first candidate l10n_util consulted, so this is a real
+// behaviour change there and the limitation is how an operator finds out.
+TEST(ApostateComposeTest, AnIneffectiveLangSwitchIsNamedInTheReport) {
+  constexpr DispersionAxis kAxes[] = {kOsReleaseAxis};
+
+  ComposeRequest disagrees = RequestFor("lang-seed", kAxes, CapableHost());
+  disagrees.accept_languages = "de-DE";
+  const std::optional<Composition> reported = Compose(disagrees);
+  ASSERT_TRUE(reported.has_value());
+  EXPECT_EQ("en-US", ChosenId(*reported, "locale.application"));
+  EXPECT_TRUE(std::ranges::any_of(
+      reported->limitations, [](const std::string& limitation) {
+        return limitation.find("--lang named 'de-DE' and had no effect") !=
+               std::string::npos;
+      }))
+      << "the report does not name the switch that did nothing";
+
+  // A --lang that agrees with the resolved locale is not a limitation: there
+  // is nothing for the operator to discover, and reporting it would train
+  // them to skip the section that matters.
+  ComposeRequest agrees = RequestFor("lang-seed", kAxes, CapableHost());
+  agrees.accept_languages = "en-US";
+  const std::optional<Composition> quiet = Compose(agrees);
+  ASSERT_TRUE(quiet.has_value());
+  EXPECT_FALSE(std::ranges::any_of(
+      quiet->limitations, [](const std::string& limitation) {
+        return limitation.find("--lang") != std::string::npos;
+      }));
+}
+
 }  // namespace
 }  // namespace base::apostate
