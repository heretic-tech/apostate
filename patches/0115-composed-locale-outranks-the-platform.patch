 void InstallComposedLocaleEnvironment(std::string_view tag) {
+  // Empty means inherit, and the guard lives here rather than at each caller
+  // so that "host mode is untouched" is one statement in one place instead of
+  // a condition every future caller has to remember.
+  if (tag.empty()) {
+    return;
+  }
   const std::string language(tag);
   const std::string posix = PosixLocaleForTag(tag);
 
@@ -1984,6 +2022,42 @@ void InstallComposedLocaleEnvironment(std::string_view tag) {
 #endif
 }
 
+std::string ComposedApplicationLocale() {
+  if (!CommandLine::InitializedForCurrentProcess()) {
+    return std::string();
+  }
+  const CommandLine& command_line = *CommandLine::ForCurrentProcess();
+
+  // A composed launch is one carrying a device profile, and that is the whole
+  // of the condition. --fingerprint=host installs none because the host is
+  // what it presents; a launch the catalogue cannot serve installs none
+  // because it inherits the host on every axis; and a process of some other
+  // browser has no such switch at all. All three inherit, which is what each
+  // of them asks for.
+  //
+  // Reading the switch rather than Profile::Get() is the point: Get() caches
+  // on first call and this is called from locale resolution, which is not a
+  // place that can make ordering promises.
+  const std::string payload =
+      command_line.GetSwitchValueASCII(::switches::kApostateProfile);
+  if (payload.empty() || !Profile::PayloadDescribesDevice(payload)) {
+    return std::string();
+  }
+
+  // --fingerprint-locale first, then the profile's own list. For a composed
+  // launch those are the same answer, because patch 0111 left the switch as
+  // the only thing that writes locale.accept_languages into a composed
+  // profile. For an authored --apostate-profile they are not: the switch is
+  // inert there (ReportAuthoredProfileBypass says so) and the payload's list
+  // is what the operator wrote, so the payload has to be read.
+  std::string named =
+      command_line.GetSwitchValueASCII(switches::kFingerprintLocale);
+  if (named.empty()) {
+    named = Profile::AcceptLanguagesInPayload(payload);
+  }
+  return ComposedLocaleTag(named);
+}
+
 void InstallComposedProfile(const FilePath& user_data_dir) {
   if (!CommandLine::InitializedForCurrentProcess()) {
     return;
@@ -2000,13 +2074,9 @@ void InstallComposedProfile(const FilePath& user_data_dir) {
   // launch, so there is nothing to do -- except the locale environment, which
