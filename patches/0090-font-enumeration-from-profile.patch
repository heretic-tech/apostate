   }
 
+  // Whether fonts.enumeration_allowlist was stated. False means the claimed
+  // machine's installed set was not described and page-visible font
+  // enumeration is the host's own.
+  bool filters_font_enumeration() const {
+    return !font_enumeration_allowlist_.empty();
+  }
+
+  // Whether a page may observe `family` as an installed family.
+  //
+  // The allowlist is subtractive and only subtractive. A family the host does
+  // not have cannot be made to measure correctly, so the answer for a family
+  // that is in the list but not on the host is still "absent" — the platform
+  // simply fails to match it, exactly as it does today. What this predicate
+  // changes is the other direction: a family the host has and the claimed
+  // machine does not.
+  //
+  // Matching is case-insensitive over ASCII and byte-exact elsewhere, which is
+  // how Blink already compares family names (EqualIgnoringASCIICase in
+  // FontFaceCache).
+  bool FontFamilyEnumerable(std::string_view family) const;
+
   struct SpeechVoice {
