 namespace blink {
 
+namespace {
+
+// Whether the profile hides a family the page named from the families a page
+// is allowed to see.
+//
+// The host is the only source of typefaces, so this can only ever remove. It
+// answers "this machine does not have that family" for a family the host does
+// have and the claimed machine does not, which is the same answer the platform
+// already gives for a family nobody has.
+//
+// A generic family is deliberately exempt. `serif`, `sans-serif`, `monospace`,
+// `cursive`, `fantasy`, `system-ui` and `math` are not host families at all:
+// they are a browser setting, the font selector resolves them through
+// FamilyNameFromSettings, and the concrete family behind one is frequently not
+// in a claimed machine's installed set (macOS resolves `cursive` to Apple
+// Chancery). Filtering them would leave ordinary pages with no font.
+bool ProfileHidesPageNamedFamily(const FontFamily& family) {
+  if (family.FamilyIsGeneric()) {
+    return false;
+  }
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->filters_font_enumeration()) {
+    return false;
+  }
+  return !profile->FontFamilyEnumerable(family.FamilyName().Utf8());
+}
+
+}  // namespace
+
