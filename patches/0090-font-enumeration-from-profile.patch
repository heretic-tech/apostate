 namespace blink {
 
+namespace {
+
+// Whether the profile hides the local face a src: local(<name>) source names.
+//
+// local() matches a PostScript or full font name rather than a family name, so
+// the allowlist cannot be consulted with the string as the page wrote it:
+// "ArialMT" is Arial and no list of families would spell it that way. The face
+// is resolved first and the family the platform actually produced is what
+// decides, so a page that asks for an allowlisted family by its PostScript
+// name still gets it, and a face belonging to a hidden family does not.
+bool ProfileHidesResolvedFace(const AtomicString& font_name,
+                              const SkTypeface* typeface) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->filters_font_enumeration()) {
+    return false;
+  }
+  if (profile->FontFamilyEnumerable(font_name.Utf8())) {
+    return false;
+  }
+  if (!typeface) {
+    return false;
+  }
+  SkString family;
+  typeface->getFamilyName(&family);
+  return !profile->FontFamilyEnumerable(
+      std::string_view(family.c_str(), family.size()));
+}
+
