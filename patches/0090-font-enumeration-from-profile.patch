+    if (const Value* raw_families = fonts->Find("enumeration_allowlist")) {
+      const ListValue* families = raw_families->GetIfList();
+      if (!families) {
+        LOG(ERROR) << "apostate: fonts.enumeration_allowlist must be an array";
+        return nullptr;
+      }
+      // An empty array would say the claimed machine has no installed fonts,
+      // which is not a machine. Rejecting it rather than treating it as "no
+      // filter" keeps a malformed profile from silently disabling the surface.
+      if (families->empty()) {
+        LOG(ERROR) << "apostate: fonts.enumeration_allowlist must not be empty";
+        return nullptr;
+      }
+      for (const auto& v : *families) {
+        const std::string* family = v.GetIfString();
+        if (!family || family->empty() || family->size() > 256 ||
+            family->find('\0') != std::string::npos) {
+          LOG(ERROR) << "apostate: invalid fonts.enumeration_allowlist entry";
+          return nullptr;
+        }
+        profile->font_enumeration_allowlist_.insert(ToLowerASCII(*family));
+      }
+    }
   }
 
   if (const DictValue* speech = dict->FindDict("speech")) {
@@ -686,4 +712,11 @@
   return profile.release();
 }
 
+bool Profile::FontFamilyEnumerable(std::string_view family) const {
+  if (font_enumeration_allowlist_.empty()) {
+    return true;
+  }
+  return font_enumeration_allowlist_.contains(ToLowerASCII(family));
+}
+
 }  // namespace base::apostate
