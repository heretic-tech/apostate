+// Windows maps the unified Han script through the content, accept and system
+// locale before the table above is consulted, because the same codepoint gets
+// a different family in a Simplified, Traditional or Japanese context. Blink
+// already carries that policy in LayoutLocale.
+UScriptCode HanScriptForDescription(const FontDescription& description) {
   const LayoutLocale* locale = LayoutLocale::LocaleForHan(description.Locale());
   if (!locale) {
     locale = &LayoutLocale::GetSystem();
   }
-  return locale->GetScriptForHan() == USCRIPT_SIMPLIFIED_HAN;
+  return locale->GetScriptForHan();
 }
 
+base::span<const char* const> WindowsFallbackFamilies(
+    const FontDescription& description,
+    UChar32 character) {
+  const auto* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->ua_platform() ||
+      *profile->ua_platform() != "Windows") {
+    return {};
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  UScriptCode script = uscript_getScript(character, &error);
+  if (U_FAILURE(error)) {
+    return {};
+  }
+  // Unassigned, common and inherited characters carry no script to look up.
+  // Recover the same way font_fallback_win.cc's GetScript() does.
+  if (script <= USCRIPT_INHERITED) {
+    script = Character::GetScriptBasedOnUnicodeBlock(character);
+  }
+  if (script == USCRIPT_HAN) {
+    script = HanScriptForDescription(description);
+  }
+  for (const auto& entry : kWindowsScriptFallback) {
+    if (entry.script == script) {
+      return entry.families;
+    }
+  }
+  return {};
+}
+
+// A family the profile declares un-enumerable must not be reachable through
+// character fallback either. Patch 0090 filters enumeration, CSS family
+// matching and src:local(), but not this path, which asks FontCache directly.
+// Without this check a persona whose pack omits Microsoft YaHei, on a host
+// that has it, reports the family absent to document.fonts and then measures a
+// Han run with it -- one launch describing a machine that cannot exist.
+bool FamilyIsEnumerable(const base::apostate::Profile* profile,
+                        const char* family) {
+  return !profile || !profile->filters_font_enumeration() ||
+         profile->FontFamilyEnumerable(family);
+}
