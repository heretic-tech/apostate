+#ifndef BASE_APOSTATE_MEDIA_DEVICES_H_
+#define BASE_APOSTATE_MEDIA_DEVICES_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/base_export.h"
+
+namespace base::apostate {
+
+// A capture device the profile claims and the host does not have.
+//
+// The identifiers are raw: MediaDevicesDispatcherHost replaces both with a
+// per-origin HMAC before either reaches a renderer, so neither string is
+// observable and neither needs to imitate a platform's naming. The label is
+// observable once a capture permission is granted, which is why it comes from
+// the profile's topology rather than from this file.
+struct BASE_EXPORT SyntheticMediaDevice {
+  std::string id;
+  std::string label;
+  // Devices sharing a profile `group` share this, so a page that pairs a
+  // microphone with a camera by groupId sees the pairing the profile claims.
+  std::string group_id;
+};
+
+// The devices to append when the host already reports `host_device_count` of
+// that kind. Empty when no profile is configured, when the profile carries no
+// count, or when the host already has at least as many as the profile claims.
+//
+// The profile sets a floor rather than an exact count for the reason patch 0020
+// gives: removing a device a machine really has, to make a number match, breaks
+// capture on a machine that can actually capture.
+BASE_EXPORT std::vector<SyntheticMediaDevice> SyntheticAudioInputDevices(
+    size_t host_device_count);
+BASE_EXPORT std::vector<SyntheticMediaDevice> SyntheticVideoInputDevices(
+    size_t host_device_count);
+
+// Whether an identifier names one of the devices above. Both prefixes are
+// namespaced so they cannot collide with a platform identifier, and neither is
+// "default" or "communications", which are special-cased downstream.
+BASE_EXPORT bool IsSyntheticAudioInputId(std::string_view id);
+BASE_EXPORT bool IsSyntheticVideoInputId(std::string_view id);
+
+// The format a synthetic microphone reports and delivers.
+//
+// A page reads all three: sampleRate and channelCount directly from
+// MediaStreamTrack.getSettings(), and latency as frames over rate. They are
+// fixed rather than taken from the host, because the device is not the host's
+// and a claimed microphone that inherits the host's odd rate says so. 48 kHz
+// mono at 10 ms is what every built-in laptop microphone Chromium opens
+// reports, and is what the macOS reference host measured.
+inline constexpr int kSyntheticAudioInputSampleRate = 48000;
+inline constexpr int kSyntheticAudioInputChannels = 1;
+inline constexpr int kSyntheticAudioInputBufferFrames =
+    kSyntheticAudioInputSampleRate / 100;
+
+// A stable 64-bit value for a synthetic device, derived from the profile
+// identity and the device identifier.
+//
+// It selects what the device's frames and samples look like. It is a function
+// of the seed, not of the call, so two launches of the same profile capture the
+// same scene and two reads within one launch never disagree.
+BASE_EXPORT uint64_t SyntheticDeviceSeed(std::string_view device_id);
+
+}  // namespace base::apostate
+
+#endif  // BASE_APOSTATE_MEDIA_DEVICES_H_
