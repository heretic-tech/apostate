+namespace media {
+
+namespace {
+
+// What a built-in laptop camera offers. A page reads the maxima of this list
+// as MediaStreamTrack.getCapabilities() and the negotiated entry as
+// getSettings(), so a claim of 1920x1080 here is a claim the device then has
+// to honour. It does: AllocateAndStart() paints at the negotiated size.
+//
+// 30 fps throughout. A built-in camera that claims 60 at 1080p is a webcam
+// almost nobody has, and the claim is checkable by counting delivered frames.
+constexpr struct {
+  int width;
+  int height;
+} kSupportedSizes[] = {
+    {320, 240}, {640, 360}, {640, 480}, {1280, 720}, {1920, 1080},
+};
+constexpr float kFrameRate = 30.0f;
+
+uint64_t NextRandom(uint64_t state) {
+  // xorshift64. Cheap, deterministic, and only ever used to pick grain.
+  state ^= state << 13;
+  state ^= state >> 7;
+  state ^= state << 17;
+  return state;
+}
+
+// A value in [lo, hi] chosen by the seed. Consumes and advances `state`.
+int Pick(uint64_t* state, int lo, int hi) {
+  *state = NextRandom(*state);
+  return lo + static_cast<int>((*state >> 11) % (hi - lo + 1));
+}
+
+const VideoCaptureFormat& ClosestFormat(const VideoCaptureFormats& formats,
+                                        const VideoCaptureFormat& requested) {
+  // Area distance, then frame-rate distance. Constraint resolution upstream
+  // has already decided what it wants; this only has to land on the entry a
+  // real camera would have picked.
+  const VideoCaptureFormat* best = &formats.front();
+  int64_t best_distance = std::numeric_limits<int64_t>::max();
+  for (const auto& format : formats) {
+    const int64_t dw = format.frame_size.width() - requested.frame_size.width();
+    const int64_t dh =
+        format.frame_size.height() - requested.frame_size.height();
+    const int64_t distance = dw * dw + dh * dh;
+    if (distance < best_distance) {
+      best_distance = distance;
+      best = &format;
+    }
+  }
+  return *best;
+}
+
+}  // namespace
+
+// static
+VideoCaptureFormats ApostateVideoCaptureDevice::SupportedFormats() {
+  VideoCaptureFormats formats;
+  for (const auto& size : kSupportedSizes) {
+    formats.emplace_back(gfx::Size(size.width, size.height), kFrameRate,
+                         PIXEL_FORMAT_I420);
+  }
+  return formats;
+}
+
+ApostateVideoCaptureDevice::ApostateVideoCaptureDevice(
+    VideoCaptureFormats supported_formats,
+    uint64_t seed)
+    : supported_formats_(std::move(supported_formats)), seed_(seed) {}
+
+ApostateVideoCaptureDevice::~ApostateVideoCaptureDevice() = default;
+
+void ApostateVideoCaptureDevice::AllocateAndStart(
+    const VideoCaptureParams& params,
+    std::unique_ptr<Client> client) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+
+  format_ = ClosestFormat(supported_formats_, params.requested_format);
+  const size_t allocation =
+      VideoFrame::AllocationSize(PIXEL_FORMAT_I420, format_.frame_size);
+  scene_ = base::HeapArray<uint8_t>::Uninit(allocation);
+  frame_ = base::HeapArray<uint8_t>::Uninit(allocation);
+
+  const int width = format_.frame_size.width();
+  const int height = format_.frame_size.height();
+  const size_t luma_size = static_cast<size_t>(width) * height;
+
+  // The scene. A real camera pointed at an ordinary indoor surface delivers a
+  // low-contrast image dominated by low spatial frequencies, with the corners
+  // darker than the centre because every lens vignettes. That is what this
+  // paints. It is deliberately not a recognisable image: there is nothing a
+  // detector can match a template against, and nothing that looks like a test
+  // card.
+  uint64_t state = seed_ | 1;
+  const int base_luma = Pick(&state, 54, 112);
+  // Magnitude and sign separately, so no seed can draw a tilt of nearly zero
+  // in both axes and leave a frame that is flat apart from the vignette. Real
+  // scenes are lit from somewhere.
+  const int tilt_x = Pick(&state, 6, 18) * (Pick(&state, 0, 1) ? 1 : -1);
+  const int tilt_y = Pick(&state, 6, 18) * (Pick(&state, 0, 1) ? 1 : -1);
+  const int vignette = Pick(&state, 14, 34);
+  const int chroma_u = Pick(&state, 120, 136);
+  const int chroma_v = Pick(&state, 120, 136);
+
+  base::span<uint8_t> scene = scene_.as_span();
+  for (int y = 0; y < height; ++y) {
+    // Normalised to [-1024, 1024] so the whole thing stays in integers.
+    const int ny = (2 * y - height) * 1024 / std::max(height, 1);
+    for (int x = 0; x < width; ++x) {
+      const int nx = (2 * x - width) * 1024 / std::max(width, 1);
+      const int radial = (nx * nx + ny * ny) >> 20;
+      const int value = base_luma + (tilt_x * nx >> 10) + (tilt_y * ny >> 10) -
+                        (vignette * radial >> 1);
+      scene[static_cast<size_t>(y) * width + x] =
+          static_cast<uint8_t>(std::clamp(value, 4, 235));
+    }
+  }
+  // Chroma is a constant cast, close to neutral: a room has a colour
+  // temperature and a camera's white balance never lands exactly on it. It
+  // never changes, so it is written into the delivered frame once here rather
+  // than on every capture.
+  const size_t chroma_size = static_cast<size_t>((width + 1) / 2) *
+                             static_cast<size_t>((height + 1) / 2);
+  base::span<uint8_t> frame = frame_.as_span();
+  std::ranges::fill(frame.subspan(luma_size, chroma_size),
+                    static_cast<uint8_t>(chroma_u));
+  std::ranges::fill(frame.subspan(luma_size + chroma_size, chroma_size),
+                    static_cast<uint8_t>(chroma_v));
+
+  client_ = std::move(client);
+  frame_index_ = 0;
+  first_frame_time_ = base::TimeTicks::Now();
+  client_->OnStarted();
+  CaptureFrame();
+}
+
+void ApostateVideoCaptureDevice::StopAndDeAllocate() {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  weak_factory_.InvalidateWeakPtrs();
+  client_.reset();
+  scene_ = base::HeapArray<uint8_t>();
+  frame_ = base::HeapArray<uint8_t>();
+}
+
+void ApostateVideoCaptureDevice::PaintFrame(uint64_t frame_index) {
+  const int width = format_.frame_size.width();
+  const int height = format_.frame_size.height();
+
+  // Auto-exposure breathing: a slow global brightness walk of a couple of
+  // levels. Without it the luma histogram is identical on every frame, which
+  // no camera with an exposure loop produces.
+  const double phase = static_cast<double>(frame_index) / (kFrameRate * 6.4);
+  const int drift = static_cast<int>(
+      std::lround(2.5 * std::sin(2.0 * std::numbers::pi * phase)));
+
+  base::span<const uint8_t> scene = scene_.as_span();
+  base::span<uint8_t> frame = frame_.as_span();
+  for (int y = 0; y < height; ++y) {
+    const size_t row = static_cast<size_t>(y) * width;
+    // Grain is sensor read noise: low amplitude, zero mean, uncorrelated
+    // between frames. It is what makes two successive frames differ, which
+    // every real capture does and a still image does not.
+    uint64_t state = (seed_ ^ (frame_index * 0x9E3779B97F4A7C15ull) ^
+                      (static_cast<uint64_t>(y) << 32)) |
+                     1;
+    uint64_t bits = 0;
+    for (int x = 0; x < width; ++x) {
+      if ((x & 7) == 0) {
+        state = NextRandom(state);
+        bits = state;
+      }
+      const int byte = static_cast<int>((bits >> ((x & 7) * 8)) & 0xF);
+      const int grain = (byte & 3) - ((byte >> 2) & 3);
+      frame[row + x] = static_cast<uint8_t>(
+          std::clamp(scene[row + x] + drift + grain, 0, 255));
+    }
+  }
+}
+
+void ApostateVideoCaptureDevice::CaptureFrame() {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  if (!client_) {
+    return;
+  }
+
+  PaintFrame(frame_index_);
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  VideoFrameMetadata metadata;
+  metadata.source_size = format_.frame_size;
+  metadata.device_scale_factor = 1.0f;
+  client_->OnIncomingCapturedData(
+      frame_.data(), static_cast<int>(frame_.size()), format_,
+      gfx::ColorSpace::CreateREC601(), /*clockwise_rotation=*/0,
+      /*flip_y=*/false, now, now - first_frame_time_,
+      /*capture_begin_timestamp=*/std::nullopt, metadata);
+
+  // Scheduled against the start time rather than against now, so the frame
+  // rate a page measures is the frame rate the device claims and does not
+  // drift with how long painting took.
+  ++frame_index_;
+  const base::TimeTicks next =
+      first_frame_time_ + base::Seconds(frame_index_ / kFrameRate);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ApostateVideoCaptureDevice::CaptureFrame,
+                     weak_factory_.GetWeakPtr()),
+      std::max(next - base::TimeTicks::Now(), base::TimeDelta()));
+}
+
+void ApostateVideoCaptureDevice::GetPhotoState(GetPhotoStateCallback callback) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  // The base class drops this callback, which leaves ImageCapture's promise
+  // pending forever. A real camera resolves it, and a promise that never
+  // settles is a clearer signal than any value could be.
+  mojom::PhotoStatePtr state = mojo::CreateEmptyPhotoState();
+  state->width = mojom::Range::New();
+  state->width->current = format_.frame_size.width();
+  state->width->min = kSupportedSizes[0].width;
+  state->width->max = kSupportedSizes[std::size(kSupportedSizes) - 1].width;
+  state->width->step = 1.0;
+  state->height = mojom::Range::New();
+  state->height->current = format_.frame_size.height();
+  state->height->min = kSupportedSizes[0].height;
+  state->height->max = kSupportedSizes[std::size(kSupportedSizes) - 1].height;
+  state->height->step = 1.0;
+  std::move(callback).Run(std::move(state));
+}
+
+void ApostateVideoCaptureDevice::SetPhotoOptions(
+    mojom::PhotoSettingsPtr settings,
+    SetPhotoOptionsCallback callback) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  // Nothing here is adjustable, which is also true of most built-in cameras.
+  std::move(callback).Run(true);
+}
+
+void ApostateVideoCaptureDevice::TakePhoto(TakePhotoCallback callback) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  if (!client_) {
+    return;
+  }
+  std::move(callback).Run(RotateAndBlobify(
+      frame_.data(), static_cast<uint32_t>(frame_.size()), format_, 0));
+}
+
+ApostateVideoCaptureDeviceFactory::ApostateVideoCaptureDeviceFactory(
+    std::unique_ptr<VideoCaptureDeviceFactory> platform_factory)
+    : platform_factory_(std::move(platform_factory)) {}
+
+ApostateVideoCaptureDeviceFactory::~ApostateVideoCaptureDeviceFactory() =
+    default;
+
+VideoCaptureErrorOrDevice ApostateVideoCaptureDeviceFactory::CreateDevice(
+    const VideoCaptureDeviceDescriptor& device_descriptor) {
+  if (base::apostate::IsSyntheticVideoInputId(device_descriptor.device_id)) {
+    return VideoCaptureErrorOrDevice(
+        std::make_unique<ApostateVideoCaptureDevice>(
+            ApostateVideoCaptureDevice::SupportedFormats(),
+            base::apostate::SyntheticDeviceSeed(device_descriptor.device_id)));
+  }
+  return platform_factory_->CreateDevice(device_descriptor);
+}
+
+void ApostateVideoCaptureDeviceFactory::GetDevicesInfo(
+    GetDevicesInfoCallback callback) {
+  platform_factory_->GetDevicesInfo(base::BindOnce(
+      &ApostateVideoCaptureDeviceFactory::OnPlatformDevicesInfo,
+      weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void ApostateVideoCaptureDeviceFactory::OnPlatformDevicesInfo(
+    GetDevicesInfoCallback callback,
+    std::vector<VideoCaptureDeviceInfo> devices_info) {
+  for (const auto& synthetic :
+       base::apostate::SyntheticVideoInputDevices(devices_info.size())) {
+    VideoCaptureDeviceDescriptor descriptor(
+        synthetic.label, synthetic.id, /*model_id=*/std::string(),
+#if BUILDFLAG(IS_MAC)
+        VideoCaptureApi::MACOSX_AVFOUNDATION,
+#elif BUILDFLAG(IS_WIN)
+        VideoCaptureApi::WIN_MEDIA_FOUNDATION,
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+        VideoCaptureApi::LINUX_V4L2_SINGLE_PLANE,
+#else
+        VideoCaptureApi::UNKNOWN,
+#endif
+        // No pan, tilt or zoom: a built-in camera has none, and the reference
+        // macOS capture reports none.
+        VideoCaptureControlSupport(),
+        VideoCaptureTransportType::APPLE_USB_OR_BUILT_IN,
+        // Not front or back. facingMode is populated on Android and ChromeOS;
+        // the reference macOS camera reports an empty facingMode list, and a
+        // desktop camera that claims "user" contradicts every desktop camera a
+        // detector has seen.
+        VideoFacingMode::MEDIA_VIDEO_FACING_NONE);
+    VideoCaptureDeviceInfo info(descriptor);
+    info.supported_formats = ApostateVideoCaptureDevice::SupportedFormats();
+    devices_info.push_back(std::move(info));
+  }
+  std::move(callback).Run(std::move(devices_info));
+}
+
+#if BUILDFLAG(IS_WIN)
+scoped_refptr<DXGIDeviceManager>
+ApostateVideoCaptureDeviceFactory::GetDxgiDeviceManager() {
+  return platform_factory_->GetDxgiDeviceManager();
+}
+
+void ApostateVideoCaptureDeviceFactory::OnGpuInfoUpdate(
+    const CHROME_LUID& luid) {
+  platform_factory_->OnGpuInfoUpdate(luid);
+}
+#endif
