+// Microphones the profile claims and the host does not have.
+//
+// Here, rather than where enumerateDevices() answers, because this is the list
+// the audio service itself works from: the same descriptions feed the
+// browser's device cache, device-change notifications and the parameters
+// lookup that runs before a stream is opened. A device added above this layer
+// is a device the audio service has never heard of, which is how a device can
+// enumerate and then fail to open.
+void AppendProfileInputDevices(AudioDeviceDescriptions* descriptions) {
+  // The virtual "default" and "communications" entries are not hardware, so
+  // they do not count towards what the host really has.
+  size_t host_devices = 0;
+  for (const auto& description : *descriptions) {
+    if (!AudioDeviceDescription::IsDefaultDevice(description.unique_id) &&
+        !AudioDeviceDescription::IsCommunicationsDevice(description.unique_id)) {
