+// What a microphone in a quiet room delivers.
+//
+// Not digital silence: a real analogue-to-digital converter always has a noise
+// floor, and an all-zero buffer is three lines of WebAudio away from being
+// noticed. Not a tone either — BeepingSource, which this replaces outside
+// explicit test mode, emits a 400 Hz burst twice a second, which is both
+// perfectly periodic and nothing a room does.
+//
+// So: a low-level broadband hiss, low-passed twice so its spectrum falls with
+// frequency the way room tone and preamp noise do rather than being flat. The
+// level is the level the reference host's own built-in microphone delivers in
+// a quiet room.
+class RoomToneSource : public AudioOutputStream::AudioSourceCallback {
+ public:
+  // One-pole coefficient, applied twice. Below 0.3 the spectrum has a clear
+  // downward tilt across the audible band, which is what room tone looks like
+  // on an analyser; at 1.0 it would be flat white noise, which does not.
+  static constexpr float kCutoff = 0.22f;
+  // Delivers an RMS of 0.0030 and a peak of 0.0114 over a second, against
+  // 0.0032 and 0.0111 measured from the reference host's built-in microphone.
+  static constexpr float kLevel = 0.021f;
+
+  explicit RoomToneSource(uint64_t seed) : state_(seed | 1) {}
+
+  RoomToneSource(const RoomToneSource&) = delete;
+  RoomToneSource& operator=(const RoomToneSource&) = delete;
+
+  ~RoomToneSource() override = default;
+
+  int OnMoreData(base::TimeDelta /*delay*/,
+                 base::TimeTicks /*timestamp*/,
+                 const AudioGlitchInfo& /*glitch_info*/,
+                 AudioBus* dest) override {
+    for (float& sample : dest->channel(0)) {
+      state_ ^= state_ << 13;
+      state_ ^= state_ >> 7;
+      state_ ^= state_ << 17;
+      const float white =
+          static_cast<float>(static_cast<int32_t>(state_ >> 32)) /
+          2147483648.0f;
+      low_ += kCutoff * (white - low_);
+      lower_ += kCutoff * (low_ - lower_);
+      sample = kLevel * lower_;
+    }
+    // Every channel of a built-in microphone sees the same room, so the
+    // channels are correlated. Independent noise per channel is what a
+    // synthesiser produces and not what a room does, and the difference
+    // survives a two-channel correlation.
+    for (int channel = 1; channel < dest->channels(); ++channel) {
+      std::ranges::copy(dest->channel(0), dest->channel(channel).begin());
+    }
+    return dest->frames();
+  }
+
+  void OnError(ErrorType /*type*/) override {}
+
+ private:
+  uint64_t state_;
+  float low_ = 0.0f;
+  float lower_ = 0.0f;
+};
