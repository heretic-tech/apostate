+// A camera the profile claims and the host does not have.
+//
+// Delivers I420 frames at the negotiated format. The frames are a dim,
+// low-contrast scene: a smooth luma gradient with a vignette, a slow exposure
+// drift and a low-amplitude grain, all derived from the profile seed. They are
+// deliberately not Chromium's fake-device pattern, which is a recognisable
+// sprite and timestamp burn-in; not a constant image, which no real sensor
+// produces; and not black, which a real sensor does not produce either.
+class CAPTURE_EXPORT ApostateVideoCaptureDevice : public VideoCaptureDevice {
+ public:
+  ApostateVideoCaptureDevice(VideoCaptureFormats supported_formats,
+                             uint64_t seed);
+
+  ApostateVideoCaptureDevice(const ApostateVideoCaptureDevice&) = delete;
+  ApostateVideoCaptureDevice& operator=(const ApostateVideoCaptureDevice&) =
+      delete;
+
+  ~ApostateVideoCaptureDevice() override;
+
+  // The formats every synthetic camera offers. A page reads the maxima of this
+  // list through MediaStreamTrack.getCapabilities(), and the negotiated entry
+  // through getSettings(), so the list is what makes the two agree.
+  static VideoCaptureFormats SupportedFormats();
+
+  // VideoCaptureDevice:
+  void AllocateAndStart(const VideoCaptureParams& params,
+                        std::unique_ptr<Client> client) override;
+  void StopAndDeAllocate() override;
+  void GetPhotoState(GetPhotoStateCallback callback) override;
+  void SetPhotoOptions(mojom::PhotoSettingsPtr settings,
+                       SetPhotoOptionsCallback callback) override;
+  void TakePhoto(TakePhotoCallback callback) override;
+
+ private:
+  void CaptureFrame();
+  void PaintFrame(uint64_t frame_index);
+
+  const VideoCaptureFormats supported_formats_;
+  const uint64_t seed_;
+
+  VideoCaptureFormat format_;
+  std::unique_ptr<Client> client_;
+  // The scene without exposure drift or grain, painted once per allocation.
+  base::HeapArray<uint8_t> scene_;
+  // The frame handed to the client.
+  base::HeapArray<uint8_t> frame_;
+  base::TimeTicks first_frame_time_;
+  uint64_t frame_index_ = 0;
+
+  base::ThreadChecker thread_checker_;
+  base::WeakPtrFactory<ApostateVideoCaptureDevice> weak_factory_{this};
+};
+
+// Wraps the platform factory and adds the cameras the profile claims.
+//
+// This is the layer the whole browser agrees on: the same GetDevicesInfo()
+// result feeds enumerateDevices(), device-change events and getUserMedia's
+// device selection, and CreateDevice() is reached with a descriptor from that
+// same list. A camera added anywhere above this is one that enumerates and
+// then fails to open, which is what this patch exists to fix.
+class CAPTURE_EXPORT ApostateVideoCaptureDeviceFactory
+    : public VideoCaptureDeviceFactory {
+ public:
+  explicit ApostateVideoCaptureDeviceFactory(
+      std::unique_ptr<VideoCaptureDeviceFactory> platform_factory);
+
+  ApostateVideoCaptureDeviceFactory(const ApostateVideoCaptureDeviceFactory&) =
+      delete;
+  ApostateVideoCaptureDeviceFactory& operator=(
+      const ApostateVideoCaptureDeviceFactory&) = delete;
+
+  ~ApostateVideoCaptureDeviceFactory() override;
+
+  // VideoCaptureDeviceFactory:
+  VideoCaptureErrorOrDevice CreateDevice(
+      const VideoCaptureDeviceDescriptor& device_descriptor) override;
+  void GetDevicesInfo(GetDevicesInfoCallback callback) override;
+
+#if BUILDFLAG(IS_WIN)
+  scoped_refptr<DXGIDeviceManager> GetDxgiDeviceManager() override;
+  void OnGpuInfoUpdate(const CHROME_LUID& luid) override;
+#endif
+
+ private:
+  void OnPlatformDevicesInfo(GetDevicesInfoCallback callback,
+                             std::vector<VideoCaptureDeviceInfo> devices_info);
+
+  const std::unique_ptr<VideoCaptureDeviceFactory> platform_factory_;
+  base::WeakPtrFactory<ApostateVideoCaptureDeviceFactory> weak_factory_{this};
+};
