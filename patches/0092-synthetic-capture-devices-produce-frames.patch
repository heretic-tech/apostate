+// Copyright 2026 The Apostate Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "base/apostate/media_devices.h"
+
+#include <algorithm>
+
+#include "base/apostate/profile.h"
+#include "base/hash/hash.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace base::apostate {
+
+namespace {
+
+constexpr char kAudioInputPrefix[] = "apostate-audioinput-";
+constexpr char kVideoInputPrefix[] = "apostate-videoinput-";
+
+// A device the profile claims but does not name gets no label, and a device it
+// names beyond the first of its kind gets the catalogue label with an index.
+// Two identical built-in cameras on one machine is not a case the catalogue
+// describes, and inventing a second vendor string would be inventing evidence.
+std::string LabelForIndex(const std::vector<Profile::MediaDevice>& devices,
+                          std::string_view kind,
+                          size_t index) {
+  size_t seen = 0;
+  std::string last;
+  for (const auto& device : devices) {
+    if (device.kind != kind) {
+      continue;
+    }
+    if (seen == index) {
+      return device.label;
+    }
+    last = device.label;
+    ++seen;
+  }
+  if (last.empty()) {
+    return std::string();
+  }
+  return StrCat({last, " (", NumberToString(index - seen + 2), ")"});
+}
+
+// The pairing key, not the label. Devices the profile puts in one group get one
+// group id, so a page pairing a microphone with a camera sees what the profile
+// claims. Namespaced so it cannot equal a platform group id.
+std::string GroupForIndex(const std::vector<Profile::MediaDevice>& devices,
+                          std::string_view kind,
+                          size_t index,
+                          std::string_view fallback_prefix) {
+  size_t seen = 0;
+  for (const auto& device : devices) {
+    if (device.kind != kind) {
+      continue;
+    }
+    if (seen == index) {
+      return StrCat({"apostate-group-", device.group});
+    }
+    ++seen;
+  }
+  return StrCat({fallback_prefix, NumberToString(index), "-group"});
+}
+
+std::vector<SyntheticMediaDevice> Build(const Profile& profile,
+                                        std::optional<int> wanted,
+                                        std::string_view kind,
+                                        std::string_view prefix,
+                                        size_t host_device_count) {
+  std::vector<SyntheticMediaDevice> result;
+  if (!wanted.has_value() || *wanted <= 0) {
+    return result;
+  }
+  const size_t claimed = static_cast<size_t>(*wanted);
+  for (size_t i = host_device_count; i < claimed; ++i) {
+    result.push_back(SyntheticMediaDevice{
+        StrCat({prefix, NumberToString(i)}),
+        LabelForIndex(profile.media_devices(), kind, i),
+        GroupForIndex(profile.media_devices(), kind, i, prefix)});
+  }
+  return result;
+}
+
+}  // namespace
+
+std::vector<SyntheticMediaDevice> SyntheticAudioInputDevices(
+    size_t host_device_count) {
+  const Profile* profile = Profile::Get();
+  if (!profile) {
+    return {};
+  }
+  return Build(*profile, profile->media_audioinput_count(), "audioinput",
+               kAudioInputPrefix, host_device_count);
+}
+
+std::vector<SyntheticMediaDevice> SyntheticVideoInputDevices(
+    size_t host_device_count) {
+  const Profile* profile = Profile::Get();
+  if (!profile) {
+    return {};
+  }
+  return Build(*profile, profile->media_videoinput_count(), "videoinput",
+               kVideoInputPrefix, host_device_count);
+}
+
+bool IsSyntheticAudioInputId(std::string_view id) {
+  return id.starts_with(kAudioInputPrefix);
+}
+
+bool IsSyntheticVideoInputId(std::string_view id) {
+  return id.starts_with(kVideoInputPrefix);
+}
+
+uint64_t SyntheticDeviceSeed(std::string_view device_id) {
+  const Profile* profile = Profile::Get();
+  const std::string material =
+      StrCat({profile ? profile->source_id() : std::string(), "/", device_id});
+  // PersistentHash is stable across builds and processes, which matters
+  // because the same profile has to produce the same scene on the next
+  // launch. It selects a scene; it protects nothing.
+  return (static_cast<uint64_t>(PersistentHash(material)) << 32) |
+         PersistentHash(StrCat({material, "/2"}));
+}
+
+}  // namespace base::apostate
