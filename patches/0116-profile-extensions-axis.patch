Subject: [PATCH] profile: an extensions.externally_connectable field

The profile carries extensions.externally_connectable, a boolean drawn
by seed and usually false. It says whether some installed extension lets
web pages connect to it, which on real Chrome decides whether
chrome.runtime appears on ordinary pages. The field is parsed and shown
by --fingerprint-explain but has no reader in the renderer, so no page
sees a difference from this patch. It names no extension id, since a
fixed id would link every launch that carries it.

--- a/base/apostate/profile.h
+++ b/base/apostate/profile.h
@@ -725,6 +725,31 @@
   }
   std::optional<uint32_t> css_highlight_text_argb() const {
     return css_highlight_text_argb_;
+  }
+
+  // Whether some installed extension's `externally_connectable` manifest key
+  // matches an ordinary http/https page.
+  //
+  // That one boolean is the entire gate on `chrome.runtime` and
+  // `window.browser` existing on a web page:
+  // CanWebpageContextConnectExternally walks the renderer's extension set and
+  // returns true on the first manifest whose matches cover the context URL,
+  // and UpdateBindingsForContext installs the `runtime` accessor and the
+  // `browser` object from that answer alone.
+  //
+  // nullopt is not false. False is a claim -- fresh Chrome, measured: window
+  // .chrome is exactly loadTimes/csi/app and chrome.runtime is undefined --
+  // and it is what a composed profile carries when the axis drew absent.
+  // nullopt means no profile described the surface at all, so the host's own
+  // extension set decides it, which is the only correct answer for
+  // --fingerprint=host.
+  //
+  // What this must never become is an extension list. A fixed extension id is
+  // a cross-instance correlator that survives every other axis, so nothing
+  // here names or installs one; the true state reproduces the observable
+  // consequence through the real binding path and nothing else.
+  std::optional<bool> extensions_externally_connectable() const {
+    return extensions_externally_connectable_;
   }
 
   // Identifier of the capture this profile was derived from, for diagnostics.
@@ -804,6 +829,7 @@
   std::optional<bool> has_hover_;
   std::optional<uint32_t> css_highlight_argb_;
   std::optional<uint32_t> css_highlight_text_argb_;
+  std::optional<bool> extensions_externally_connectable_;
   std::string source_id_;
   std::optional<ProxyCredentials> proxy_credentials_;
 };
--- a/base/apostate/profile.cc
+++ b/base/apostate/profile.cc
@@ -1050,6 +1050,23 @@
         }
         profile->font_enumeration_allowlist_.insert(ToLowerASCII(*family));
       }
+    }
+  }
+
+  if (const DictValue* extensions = dict->FindDict("extensions")) {
+    // Presence-only, and deliberately not a list of extensions. The renderer
+    // gate this feeds -- CanWebpageContextConnectExternally -- asks one
+    // question of the whole installed set, so one boolean reproduces its
+    // answer exactly, while a list would have to name ids, and a fixed
+    // extension id is a cross-instance correlator no other axis can undo.
+    if (const Value* raw = extensions->Find("externally_connectable")) {
+      const std::optional<bool> connectable = raw->GetIfBool();
+      if (!connectable) {
+        LOG(ERROR) << "apostate: extensions.externally_connectable must be "
+                      "boolean";
+        return nullptr;
+      }
+      profile->extensions_externally_connectable_ = *connectable;
     }
   }
 
--- a/base/apostate/compose_unittest.cc
+++ b/base/apostate/compose_unittest.cc
@@ -145,6 +145,26 @@
 constexpr DispersionAxis kExtraAxis = {
     "extra", "extra", {}, Selection::kSingle, Servability::kNone,
     span<const DispersionOptionSet>(kExtraSets),
+};
+
+// ---- extensions: single / none, unconditioned, boolean-valued ----
+//
+// The only axis whose whole value is one boolean, which is why it is written
+// out here rather than folded into one of the axes above: a table author can
+// write `0` where a page needs `false`, and the loader refuses a non-boolean,
+// so the serialised shape is part of this axis's contract.
+constexpr DispersionOption kExtensionsOptions[] = {
+    {"absent", 75, "physical-ground-truth", "", PackKind::kNotAPack, nullptr,
+     R"({"extensions":{"externally_connectable":false}})"},
+    {"externally-connectable", 25, "catalogue-value", "", PackKind::kNotAPack,
+     nullptr, R"({"extensions":{"externally_connectable":true}})"},
+};
+constexpr DispersionOptionSet kExtensionsSets[] = {
+    {{}, span<const DispersionOption>(kExtensionsOptions)},
+};
+constexpr DispersionAxis kExtensionsAxis = {
+    "extensions", "extensions", {}, Selection::kSingle, Servability::kNone,
+    span<const DispersionOptionSet>(kExtensionsSets),
 };
 
 // ---- voices: single / none, conditioned on languages ----
@@ -535,6 +555,65 @@
   // persona selects the anchor now, so a fixture with no anchor for the
   // persona makes that line compare "(absent)" with itself and pass.
   EXPECT_NE("(absent)", ChosenId(*after, "anchor"));
+
+// The chrome.runtime persona. Absence is the common state and it is a CLAIM,
+// not a silence: fresh Chrome has no chrome.runtime on a web page, so a
+// composed launch says false rather than leaving the host's extension set to
+// answer. What that costs is one property nothing else in this file covers --
+// the section has to serialise as a JSON boolean, because the loader refuses
+// anything else and a table author writing 0 would compose a profile the
+// binary then drops on the floor with one log line.
+TEST(ApostateComposeTest, TheExtensionsAxisComposesABooleanAndOnlyWhenOffered) {
+  constexpr DispersionAxis kWith[] = {kOsReleaseAxis, kExtensionsAxis};
+  constexpr DispersionAxis kWithout[] = {kOsReleaseAxis};
+  const HostCapability host = CapableHost();
+
+  // Not offered: no section at all, so the host's own extension set decides
+  // the surface. An empty `extensions` object here would be worse than
+  // absence -- it is a section that claims nothing while looking composed.
+  const std::optional<Composition> without =
+      Compose(RequestFor("ext-seed", kWithout, host));
+  ASSERT_TRUE(without.has_value());
+  EXPECT_EQ(nullptr, without->profile.FindDict("extensions"));
+  EXPECT_EQ("(absent)", ChosenId(*without, "extensions"));
+
+  // Offered: both states are reachable across seeds, each seed always lands
+  // on the same one, and the value is a boolean in the bytes a launch carries.
+  int present = 0;
+  int absent = 0;
+  for (int seed = 0; seed < 24; ++seed) {
+    const std::string label = "ext-" + NumberToString(seed);
+    const std::optional<Composition> first =
+        Compose(RequestFor(label, kWith, host));
+    const std::optional<Composition> again =
+        Compose(RequestFor(label, kWith, host));
+    ASSERT_TRUE(first.has_value());
+    ASSERT_TRUE(again.has_value());
+    EXPECT_EQ(ChosenId(*first, "extensions"), ChosenId(*again, "extensions"))
+        << "seed " << label << " drew two different extension states";
+
+    const DictValue* extensions = first->profile.FindDict("extensions");
+    ASSERT_NE(nullptr, extensions);
+    const std::optional<bool> connectable =
+        extensions->FindBool("externally_connectable");
+    ASSERT_TRUE(connectable.has_value())
+        << "externally_connectable did not survive as a boolean";
+    *connectable ? ++present : ++absent;
+    EXPECT_NE(std::string::npos,
+              ProfileJson(*first).find(
+                  *connectable ? R"("externally_connectable":true)"
+                               : R"("externally_connectable":false)"));
+
+    const SurfaceRecord* record = Record(*first, "extensions");
+    ASSERT_NE(nullptr, record);
+    EXPECT_EQ("dispersion", record->layer);
+    EXPECT_EQ(*connectable ? "catalogue-value" : "physical-ground-truth",
+              record->evidence);
+  }
+  EXPECT_GT(absent, 0);
+  EXPECT_GT(present, 0)
+      << "no seed in 24 drew the minority state, so the weights are not live";
+}
 }
 
