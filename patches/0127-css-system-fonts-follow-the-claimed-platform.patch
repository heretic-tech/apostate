+// Apostate: the shell's non-client metrics answer menu, small-caption and
+// status-bar only when no profile claims another platform. Real macOS and
+// Linux Chrome report the default GUI font at the default size for all six
+// keywords, so a profile claiming either gets that here too.
+static bool ServesNonClientMetrics() {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  return !profile || !profile->ua_platform() ||
+         *profile->ua_platform() == "Windows";
+}
+
 // static
 const AtomicString& LayoutThemeFontProvider::SystemFontFamily(
     CSSValueID system_font_id) {
+  if (!ServesNonClientMetrics()) {
+    return DefaultGUIFont();
+  }
   switch (system_font_id) {
     case CSSValueID::kSmallCaption:
       return FontCache::SmallCaptionFontFamily();
@@ -57,6 +71,12 @@
 // static
 float LayoutThemeFontProvider::SystemFontSize(CSSValueID system_font_id,
                                               const Document* document) {
+  if (!ServesNonClientMetrics() &&
