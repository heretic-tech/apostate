 // That is a compile-time platform gate, so a Linux build claiming Windows
 // cannot reach the right answer by any runtime path: the code that would have
-// produced it is not in the binary. The profile carries the resolved values and
-// this provider serves them, which keeps one file correct for any claimed
-// platform instead of compiling in a second per-platform table.
+// produced it is not in the binary. So this provider serves the profile's
+// values when it carries them, and the claimed platform's otherwise.
 //
-// Measured against the reference Windows machine: menu, small-caption and
-// status-bar are "Segoe UI" at 12px while caption, icon and message-box are
-// Arial at 16px — the same three that Chromium's Windows provider special-cases
-// and the same three we were getting wrong.
+// On every Windows capture we hold, menu, small-caption and status-bar are
+// "Segoe UI" at 12px while caption, icon and message-box are Arial at 16px,
+// the same three that Chromium's Windows provider special-cases. macOS and
+// Linux report Arial at 16px for all six, which is this provider's own answer.
 
 const char* ApostateFontKey(CSSValueID id) {
   switch (id) {
@@ -99,6 +98,21 @@
   return table;
 }
 
+constexpr char kWindowsNonClientFamily[] = "Segoe UI";
+constexpr float kWindowsNonClientSizePx = 12;
+
+// Whether `id` is one of the three keywords Windows answers from the shell's
+// non-client metrics, for a profile that claims Windows.
+bool IsWindowsNonClientFont(CSSValueID id) {
+  const base::apostate::Profile* profile = base::apostate::Profile::Get();
+  if (!profile || !profile->ua_platform() ||
+      *profile->ua_platform() != "Windows") {
+    return false;
+  }
+  return id == CSSValueID::kMenu || id == CSSValueID::kSmallCaption ||
+         id == CSSValueID::kStatusBar;
+}
+
 }  // namespace
 
