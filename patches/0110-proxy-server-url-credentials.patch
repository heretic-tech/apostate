+// `--proxy-server`, spelled out rather than included. The two headers that
+// declare it -- chrome/common/chrome_switches.h and headless/public/switches.h
+// -- are both above base/ in the dependency order. The name is upstream
+// Chromium's and is not ours to change.
+constexpr char kProxyServerSwitch[] = "proxy-server";
 
+// The proxy URI schemes that can carry a credential, lowercase. Matches
+// net::GetSchemeFromUriScheme minus the two that authenticate nothing:
+// `direct://` has no peer to authenticate to, and `quic://` is Chromium's own
+// MASQUE path, which this fork does not touch. `socks` is SOCKS5 in URI form.
+// A scheme-less URI defaults to HTTP, which is Chromium's rule, so the empty
+// string is in the set. `socks5h://` is deliberately absent: Chromium does not
+// accept it, so a value spelling it is already broken before userinfo enters
+// the picture.
+constexpr std::string_view kAuthenticableSchemes[] = {
+    "", "http", "https", "socks", "socks4", "socks5",
+};
+
+// The mutable side of AdoptedProxyCredentials().
+//
+// Written once, in the browser, from the startup hook -- before any child
+// command line is built and before any thread pool exists -- and only read
+// after that, so no lock is needed. A child process never writes it and always
+// reads it empty; its credentials arrive inside the payload it was given.
+std::optional<ProxyCredentials>& MutableAdoptedProxyCredentials() {
+  static NoDestructor<std::optional<ProxyCredentials>> credentials;
+  return *credentials;
+}
+
+// RFC 3986 §2.1 percent-decoding, strict: an incomplete or non-hex escape is
+// an error rather than a literal '%'.
+//
+// Hand-rolled rather than base::UnescapeBinaryURLComponent, which passes a
+// malformed escape through untouched and would turn `%z` in a password into a
+// silently different password. decodeURIComponent, which the Node launcher
+// applies to this same field, throws on it; so does this.
+bool PercentDecode(std::string_view in, std::string* out) {
+  out->clear();
+  out->reserve(in.size());
+  for (size_t i = 0; i < in.size(); ++i) {
+    if (in[i] != '%') {
+      out->push_back(in[i]);
+      continue;
+    }
+    if (i + 2 >= in.size() || !IsHexDigit(in[i + 1]) ||
+        !IsHexDigit(in[i + 2])) {
+      return false;
+    }
+    out->push_back(static_cast<char>(HexDigitToInt(in[i + 1]) * 16 +
+                                     HexDigitToInt(in[i + 2])));
+    i += 2;
+  }
+  return true;
+}
+
+// The bounds the envelope loader already enforces on a credential, applied to
+// one half of a decoded userinfo. Same limits, so one proxy URL is accepted or
+// refused identically whichever channel carried it.
+//
+// The UTF-8 test is the one that allows noncharacters, which is "structurally
+// valid UTF-8" and nothing more. A credential out of an envelope came through
+// JSONReader and is valid by construction, so applying this to that channel
+// changes nothing there; a credential out of percent-decoded userinfo is raw
+// bytes and can be any of them, and one that cannot be written back into JSON
+// would fail the child's payload rather than the launch. Stricter than that
+// would refuse a byte sequence the proxy operator is entitled to issue.
+bool CredentialHalfIsUsable(const std::string& value) {
+  return value.size() <= 4096 && value.find('\0') == std::string::npos &&
+         IsStringUTF8AllowingNoncharacters(value);
+}
+
+// Reads `proxy_credentials` out of a decoded payload, applying the loader's
+// own validation. Returns false, having logged, when the block is present but
+// unusable.
+bool ReadCredentialsBlock(const DictValue& block, ProxyCredentials* out) {
+  const std::string* username = block.FindString("username");
+  const std::string* password = block.FindString("password");
+  if (!username || !password || !CredentialHalfIsUsable(*username) ||
+      !CredentialHalfIsUsable(*password)) {
+    LOG(ERROR) << "apostate: invalid proxy credentials; ignoring";
+    return false;
+  }
+  *out = ProxyCredentials{*username, *password};
+  return true;
+}
+
+// The `proxy_credentials` block for `credentials`.
+DictValue CredentialsBlock(const ProxyCredentials& credentials) {
+  DictValue block;
+  block.Set("username", credentials.username);
+  block.Set("password", credentials.password);
+  return block;
+}
+
+// A payload serialised the way the compositor serialises one.
+//
+// OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION for the reason
+// PayloadWithSuppliedCredentials carries: base::Value has no 64-bit integer
+// type, six real profile fields are held as doubles, and the default writer
+// would append ".0" to each and emit a profile that fails the schema the
+// packages validate against. Base64EncodeEarlyStartup because this runs before
+// FeatureList exists and the ordinary entry point consults a base::Feature.
+std::optional<std::string> EncodePayload(const DictValue& payload) {
+  const std::optional<std::string> json = WriteJsonWithOptions(
+      payload, JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION);
+  if (!json) {
+    return std::nullopt;
+  }
+  return Base64EncodeEarlyStartup(as_byte_span(*json));
+}
+
 }  // namespace
 
+const std::optional<ProxyCredentials>& AdoptedProxyCredentials() {
+  return MutableAdoptedProxyCredentials();
+}
+
 Profile::Profile() = default;
 Profile::~Profile() = default;
 
