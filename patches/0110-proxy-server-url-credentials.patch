+// The syntax the defect was about, across the schemes that can authenticate
+// and the shapes the proxy-rules grammar allows. In every row the endpoint is
+// what Chromium would have accepted had the operator written it by hand.
+TEST(ApostateProxyCredentialsTest, SeparatesTheCredentialFromTheEndpoint) {
+  struct Case {
+    std::string_view value;
+    std::string_view endpoint;
+    std::string_view username;
+    std::string_view password;
+    std::string_view why;
+  };
+  static const auto kCases = std::to_array<Case>({
+      {"socks5://user:pass@host:1080", "socks5://host:1080", "user", "pass",
+       "the reported case"},
+      {"http://user:pass@host:8080", "http://host:8080", "user", "pass",
+       "an HTTP proxy"},
+      {"https://user:pass@host:8443", "https://host:8443", "user", "pass",
+       "an HTTPS proxy"},
+      {"socks4://user@host:1080", "socks4://host:1080", "user", "",
+       "SOCKS4, which has no password field at all"},
+      {"socks://user:pass@host:1080", "socks://host:1080", "user", "pass",
+       "`socks`, which Chromium reads as SOCKS5 in URI form"},
+      {"user:pass@host:8080", "host:8080", "user", "pass",
+       "the scheme-less form, which Chromium defaults to HTTP"},
+      {"SOCKS5://user:pass@host:1080", "SOCKS5://host:1080", "user", "pass",
+       "an upper-case scheme"},
+      {"socks5://user:pass@[2001:db8::1]:1080", "socks5://[2001:db8::1]:1080",
+       "user", "pass", "an IPv6 literal host"},
+      {"http=http://user:pass@host:8080", "http=http://host:8080", "user",
+       "pass", "the per-URL-scheme form"},
+      {"http=http://u:p@one:8080;https=http://u:p@two:8443",
+       "http=http://one:8080;https=http://two:8443", "u", "p",
+       "one credential written twice, which is one credential"},
+      {"socks5://u:p@one:1080,socks5://two:1080",
+       "socks5://one:1080,socks5://two:1080", "u", "p",
+       "a fallback list where only the first proxy authenticates"},
+      {" socks5://user:pass@host:1080 ", " socks5://host:1080 ", "user",
+       "pass", "whitespace Chromium trims, preserved around the removal"},
+      {"socks5://@host:1080", "socks5://host:1080", "", "",
+       "an empty userinfo, which is a stray @ and not a credential"},
+  });
+
+  for (const Case& test : kCases) {
+    const Profile::ProxyServerValue parsed =
+        Profile::ParseProxyServerValue(test.value);
+    EXPECT_TRUE(parsed.refusal.empty()) << test.why << ": " << parsed.refusal;
+    EXPECT_EQ(test.endpoint, parsed.endpoint) << test.why;
+    if (test.username.empty() && test.password.empty()) {
+      EXPECT_FALSE(parsed.credentials.has_value()) << test.why;
+      continue;
+    }
+    ASSERT_TRUE(parsed.credentials.has_value()) << test.why;
+    EXPECT_EQ(test.username, parsed.credentials->username) << test.why;
+    EXPECT_EQ(test.password, parsed.credentials->password) << test.why;
+  }
+}
