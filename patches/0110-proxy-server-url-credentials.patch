+// Percent-decoding per RFC 3986, and the URL Standard's delimiter rules, which
+// are what the Node launcher's `new URL()` applies to the same field. A
+// residential proxy password is a generated string and reserved characters in
+// it are ordinary; a password that decoded differently here than in the
+// launcher would authenticate from one entry point and not the other.
+TEST(ApostateProxyCredentialsTest, DecodesReservedCharactersLikeTheLauncher) {
+  struct Case {
+    std::string_view value;
+    std::string_view username;
+    std::string_view password;
+    std::string_view why;
+  };
+  static const auto kCases = std::to_array<Case>({
+      {"socks5://user:pa%40ss@host:1080", "user", "pa@ss", "an escaped @"},
+      {"socks5://user:pa%3Ass@host:1080", "user", "pa:ss", "an escaped :"},
+      {"socks5://user:pa%2Fss@host:1080", "user", "pa/ss", "an escaped /"},
+      {"socks5://user:pa%25ss@host:1080", "user", "pa%ss", "an escaped %"},
+      {"socks5://user:pa%20ss@host:1080", "user", "pa ss", "an escaped space"},
+      {"socks5://us%2Ber:pass@host:1080", "us+er", "pass", "an escaped +"},
+      {"socks5://user:pa%3ass@host:1080", "user", "pa:ss",
+       "a lower-case hex escape"},
+      {"socks5://user:pa+ss@host:1080", "user", "pa+ss",
+       "a literal +, which is not a space outside a query string"},
+      {"socks5://user:pa@ss@host:1080", "user", "pa@ss",
+       "an unescaped @, where the last one delimits"},
+      {"socks5://user:pa:ss@host:1080", "user", "pa:ss",
+       "an unescaped :, where the first one delimits"},
+      {"socks5://user:@host:1080", "user", "",
+       "an empty password, which is still a credential"},
+      {"socks5://user@host:1080", "user", "",
+       "no password field at all"},
+      {"socks5://:pass@host:1080", "", "pass",
+       "an empty username, which SOCKS5 permits"},
+      // The shape a residential provider issues: a long underscore-and-hyphen
+       // username encoding session options, and a UUID-ish secret. Synthetic
+       // values -- a real credential must never reach a file in this
+       // repository, not even a fragment of one.
+      {"socks5://vendor_ab12CD-type-residential-os-windows:"
+       "00000000-1111-2222-3333-444444444444@host:12000",
+       "vendor_ab12CD-type-residential-os-windows",
+       "00000000-1111-2222-3333-444444444444",
+       "the shape a residential provider issues"},
+  });
+
+  for (const Case& test : kCases) {
+    const Profile::ProxyServerValue parsed =
+        Profile::ParseProxyServerValue(test.value);
+    EXPECT_TRUE(parsed.refusal.empty()) << test.why << ": " << parsed.refusal;
+    ASSERT_TRUE(parsed.credentials.has_value()) << test.why;
+    EXPECT_EQ(test.username, parsed.credentials->username) << test.why;
+    EXPECT_EQ(test.password, parsed.credentials->password) << test.why;
+    // Whatever the userinfo was, none of it survives into the endpoint.
+    EXPECT_EQ(std::string::npos, parsed.endpoint.find('@')) << test.why;
+  }
+}
