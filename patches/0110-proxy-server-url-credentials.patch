+// The envelope half of the same boundary. A payload's credentials come off the
+// command line for the same reason the URL's do, and what is left behind must
+// still be the payload the compositor and the loader expect.
+TEST(ApostateProxyCredentialsTest, LiftsCredentialsOutOfAPayload) {
+  std::optional<ProxyCredentials> credentials;
+
+  // The envelope form the launcher sends.
+  const std::string envelope = Base64Encode(
+      R"({"device_profile":{"screen":{"width":1710}},)"
+      R"("proxy_credentials":{"password":"p","username":"u"}})");
+  std::optional<std::string> stripped =
+      Profile::PayloadWithoutCredentials(envelope, &credentials);
+  ASSERT_TRUE(stripped.has_value());
+  ASSERT_TRUE(credentials.has_value());
+  EXPECT_EQ("u", credentials->username);
+  EXPECT_EQ("p", credentials->password);
+  std::string json;
+  ASSERT_TRUE(Base64Decode(*stripped, &json));
+  EXPECT_EQ(R"({"device_profile":{"screen":{"width":1710}}})", json);
+
+  // The credentials-only envelope, which claims no device and must still claim
+  // none once the credentials are gone, or an authenticated proxy would start
+  // suppressing composition again.
+  const std::string credentials_only = Base64Encode(
+      R"({"device_profile":{},)"
+      R"("proxy_credentials":{"password":"p","username":"u"}})");
+  stripped = Profile::PayloadWithoutCredentials(credentials_only, &credentials);
+  ASSERT_TRUE(stripped.has_value());
+  EXPECT_TRUE(credentials.has_value());
+  EXPECT_FALSE(Profile::PayloadDescribesDevice(*stripped));
+
+  // The bare form written by hand, whose only key is the credentials.
+  stripped = Profile::PayloadWithoutCredentials(
+      Base64Encode(R"({"proxy_credentials":{"password":"p","username":"u"}})"),
+      &credentials);
+  ASSERT_TRUE(stripped.has_value());
+  EXPECT_TRUE(credentials.has_value());
+  ASSERT_TRUE(Base64Decode(*stripped, &json));
+  EXPECT_EQ("{}", json);
+
+  // A payload with no credentials in it is left alone entirely, so an
+  // ordinary launch rewrites no switch.
+  EXPECT_FALSE(Profile::PayloadWithoutCredentials(
+                   Base64Encode(R"({"screen":{"width":1710}})"), &credentials)
+                   .has_value());
+  EXPECT_FALSE(credentials.has_value());
+
+  // A malformed payload is left alone too: the loader refuses it by itself,
+  // with a message that names the mistake, and masking that here would turn a
+  // refusal into a silently different launch.
+  EXPECT_FALSE(
+      Profile::PayloadWithoutCredentials("not base64", &credentials)
+          .has_value());
+
+  // A present-but-unusable block is removed even though it is not adopted.
+  // Ignoring it is the loader's long-standing behaviour; leaving it on the
+  // command line would leave a secret in everything that serialises one.
+  stripped = Profile::PayloadWithoutCredentials(
+      Base64Encode(R"({"device_profile":{},)"
+                   R"("proxy_credentials":{"username":"u"}})"),
+      &credentials);
+  ASSERT_TRUE(stripped.has_value());
+  EXPECT_FALSE(credentials.has_value());
+  ASSERT_TRUE(Base64Decode(*stripped, &json));
+  EXPECT_EQ(R"({"device_profile":{}})", json);
+}
+
+// What a child process is given. The network stack that spends the credentials
+// runs in the network service, and the envelope is the only channel it has.
+TEST(ApostateProxyCredentialsTest, CarriesCredentialsToAChildPayload) {
+  const ProxyCredentials credentials{"u", "p"};
+  std::string json;
+
+  // Nothing composed -- host mode, or a catalogue that could not serve this
+  // launch. The empty device half is the shape the launcher sends for exactly
+  // this case, and it must still claim no device so the child inherits the
+  // host rather than being handed an empty profile as a device.
+  std::optional<std::string> payload =
+      Profile::PayloadWithCredentials(std::string(), credentials);
+  ASSERT_TRUE(payload.has_value());
+  ASSERT_TRUE(Base64Decode(*payload, &json));
+  EXPECT_EQ(R"({"device_profile":{},)"
+            R"("proxy_credentials":{"password":"p","username":"u"}})",
+            json);
+  EXPECT_FALSE(Profile::PayloadDescribesDevice(*payload));
+
+  // A composed device, which is the ordinary case. The block goes beside the
+  // envelope, and the payload still claims a device so the child does not
+  // recompose one.
+  payload = Profile::PayloadWithCredentials(
+      Base64Encode(R"({"device_profile":{"screen":{"width":1710}}})"),
+      credentials);
+  ASSERT_TRUE(payload.has_value());
+  ASSERT_TRUE(Base64Decode(*payload, &json));
+  EXPECT_EQ(R"({"device_profile":{"screen":{"width":1710}},)"
+            R"("proxy_credentials":{"password":"p","username":"u"}})",
+            json);
+  EXPECT_TRUE(Profile::PayloadDescribesDevice(*payload));
+
+  // A bare profile, which is what an operator writes by hand. ParseOrNull
+  // reads the block before it unwraps an envelope, so the bare form carries it
+  // too and does not need wrapping.
+  payload = Profile::PayloadWithCredentials(
+      Base64Encode(R"({"screen":{"width":1710}})"), credentials);
+  ASSERT_TRUE(payload.has_value());
+  ASSERT_TRUE(Base64Decode(*payload, &json));
+  EXPECT_EQ(R"({"proxy_credentials":{"password":"p","username":"u"},)"
+            R"("screen":{"width":1710}})",
+            json);
+  EXPECT_TRUE(Profile::PayloadDescribesDevice(*payload));
+
+  EXPECT_FALSE(
+      Profile::PayloadWithCredentials("not base64", credentials).has_value());
+}
