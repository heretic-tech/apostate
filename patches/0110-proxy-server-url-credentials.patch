+// An over-long credential is refused, not truncated. Half a password
+// authenticates nothing while looking like it should.
+TEST(ApostateProxyCredentialsTest, RefusesAnOverlongCredential) {
+  const std::string long_password(4097, 'p');
+  const Profile::ProxyServerValue parsed = Profile::ParseProxyServerValue(
+      "socks5://user:" + long_password + "@host:1080");
+  EXPECT_FALSE(parsed.refusal.empty());
+  EXPECT_FALSE(parsed.credentials.has_value());
+
+  // One byte under the bound is the envelope loader's own limit and is served.
+  const std::string at_bound(4096, 'p');
+  const Profile::ProxyServerValue accepted = Profile::ParseProxyServerValue(
+      "socks5://user:" + at_bound + "@host:1080");
+  EXPECT_TRUE(accepted.refusal.empty());
+  ASSERT_TRUE(accepted.credentials.has_value());
+  EXPECT_EQ(at_bound, accepted.credentials->password);
+}
