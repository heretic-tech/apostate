+      "http=proxy.example:8080;https=secure.example:8443",
+      "socks5://one.example:1080,socks5://two.example:1080",
+      "http://proxy.example:8080,direct://",
+      "socks5://[2001:db8::1]:1080",
+      "socks=socks4://proxy.example:1080",
+      "",
+  });
+
+  for (const std::string_view value : kValues) {
+    const Profile::ProxyServerValue parsed =
+        Profile::ParseProxyServerValue(value);
+    EXPECT_TRUE(parsed.refusal.empty()) << value;
