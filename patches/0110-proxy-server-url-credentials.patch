+// The endpoint is the string Chromium's proxy URI parser is handed, and the
+// credential is what the network stack spends. Both come out of one function,
+// because the whole point of the boundary is that the two halves of a proxy
+// URL cannot drift apart: a credential that survives into the endpoint is a
+// secret in every NetLog and pool key, and an endpoint that keeps its `@` is
+// ERR_NO_SUPPORTED_PROXIES on every request.
+
+// A refusal is reported, never approximated. Each of these is a value where a
+// reasonable-looking guess exists and taking it would authenticate as somebody
+// the operator did not name.
+TEST(ApostateProxyCredentialsTest, RefusesRatherThanGuessing) {
+  struct Case {
+    std::string_view value;
+    // A distinctive phrase from the message this value must produce. Asserted
+    // because the message is half the feature: the defect this patch fixes
+    // presented as ERR_NO_SUPPORTED_PROXIES with nothing said, and a refusal
+    // that does not say which of these five things went wrong would leave the
+    // operator exactly where they started.
+    std::string_view says;
+    std::string_view why;
+  };
+  static constexpr auto kCases = std::to_array<Case>({
+      {"socks5://user:pa%zzss@host:1080", "percent-encoding is malformed",
+       "a non-hex escape"},
+      {"socks5://user:pass%@host:1080", "percent-encoding is malformed",
+       "a truncated escape"},
+      {"socks5://user:pas%4@host:1080", "percent-encoding is malformed",
+       "a one-digit escape"},
+      {"socks5://user:pa%00ss@host:1080", "no NUL in it",
+       "a NUL in the password"},
+      {"socks5://us%00er:pass@host:1080", "no NUL in it",
+       "a NUL in the username"},
+      {"socks5://user:pa%ffss@host:1080", "bytes of UTF-8",
+       "a non-UTF-8 byte"},
+      {"direct://user:pass@host:1080", "cannot authenticate",
+       "a scheme with no peer to authenticate"},
+      {"quic://user:pass@host:443", "MASQUE", "Chromium's own MASQUE path"},
+      {"ftp://user:pass@host:21", "cannot authenticate",
+       "a scheme the proxy parser does not know"},
+      {"http=http://a:b@one:8080;https=http://c:d@two:8080",
+       "more than one credential", "two different credentials for one launch"},
+      {"socks5://a:b@one:1080,socks5://c:d@two:1080",
+       "more than one credential",
+       "two different credentials in one fallback list"},
+  });
+
+  for (const Case& test : kCases) {
+    const Profile::ProxyServerValue parsed =
+        Profile::ParseProxyServerValue(test.value);
+    ASSERT_FALSE(parsed.refusal.empty()) << test.why << ": " << test.value;
+    EXPECT_NE(std::string::npos, parsed.refusal.find(test.says))
+        << test.why << ": said \"" << parsed.refusal << "\"";
+    // Every refusal names the switch, so the operator knows which of their
+    // arguments to look at.
+    EXPECT_NE(std::string::npos, parsed.refusal.find("--proxy-server"))
+        << test.why;
+    // A refused value yields nothing usable, so a caller that ignored the
+    // refusal could not accidentally launch with half of it.
+    EXPECT_FALSE(parsed.credentials.has_value()) << test.why;
+    EXPECT_TRUE(parsed.endpoint.empty()) << test.why;
+  }
+}
