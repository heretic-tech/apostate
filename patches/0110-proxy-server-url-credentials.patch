+// The acceptance criterion, asserted on the object every leak path reads.
+//
+// chrome://version, chrome://gpu, a net-export capture's clientInfo block,
+// DevTools SystemInfo.getInfo and the crash-key switch list all serialise this
+// process's command line verbatim. None of them is patched, and none of them
+// needs to be: after adoption the secret is not on the command line for them
+// to find.
+TEST(ApostateProxyCredentialsTest, AdoptionEmptiesTheCommandLine) {
+  test::ScopedCommandLine scoped;
+  CommandLine* command_line = scoped.GetProcessCommandLine();
+  command_line->RemoveSwitch("proxy-server");
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  command_line->AppendSwitchASCII(
+      "proxy-server", "socks5://tenant-42:s3cr%40t@proxy.example:1080");
+
+  Profile::AdoptLaunchProxyCredentials();
+
+  const std::string shown = command_line->GetCommandLineString();
+  EXPECT_EQ(std::string::npos, shown.find("tenant-42")) << shown;
+  EXPECT_EQ(std::string::npos, shown.find("s3cr")) << shown;
+  EXPECT_EQ(std::string::npos, shown.find("s3cr%40t")) << shown;
+  EXPECT_EQ("socks5://proxy.example:1080",
+            command_line->GetSwitchValueASCII("proxy-server"));
+  // Nothing was moved into the payload either: the browser's own envelope
+  // stays credential-free, which is what keeps it out of the five paths above.
+  EXPECT_FALSE(command_line->HasSwitch(::switches::kApostateProfile));
+
+  // A child does get them, because the code that spends them runs there.
+  CommandLine child(CommandLine::NO_PROGRAM);
+  Profile::AppendLaunchProxyCredentials(&child);
+  ASSERT_TRUE(child.HasSwitch(::switches::kApostateProfile));
+  std::string json;
+  ASSERT_TRUE(Base64Decode(
+      child.GetSwitchValueASCII(::switches::kApostateProfile), &json));
+  EXPECT_EQ(R"({"device_profile":{},)"
+            R"("proxy_credentials":{"password":"s3cr@t","username":"tenant-42"}})",
+            json);
+
+  // Leave the process-wide store as it was found. Adoption assigns it from
+  // whatever the command line then holds, so a command line with neither
+  // switch on it clears it.
+  command_line->RemoveSwitch("proxy-server");
+  Profile::AdoptLaunchProxyCredentials();
+  CommandLine unaffected(CommandLine::NO_PROGRAM);
+  Profile::AppendLaunchProxyCredentials(&unaffected);
+  EXPECT_FALSE(unaffected.HasSwitch(::switches::kApostateProfile));
+}
+
+// A stray `@` with no credential behind it still has to come off the switch.
+// Found by running the browser: `socks5://:@host:12000` -- which is what a
+// shell produces from an unset variable -- left the value byte-identical
+// because no credential was found, Chromium's proxy URI parser failed on the
+// `@`, and every request ended ERR_NO_SUPPORTED_PROXIES with nothing said. The
+// stripped endpoint was already computed; not installing it was the bug.
+TEST(ApostateProxyCredentialsTest, StripsAStrayAtWithNoCredentialBehindIt) {
+  for (const std::string_view value : {"socks5://@proxy.example:1080",
+                                       "socks5://:@proxy.example:1080"}) {
+    test::ScopedCommandLine scoped;
+    CommandLine* command_line = scoped.GetProcessCommandLine();
+    command_line->RemoveSwitch("proxy-server");
+    command_line->RemoveSwitch(::switches::kApostateProfile);
+    command_line->AppendSwitchASCII("proxy-server", std::string(value));
+
+    Profile::AdoptLaunchProxyCredentials();
+
+    EXPECT_EQ("socks5://proxy.example:1080",
+              command_line->GetSwitchValueASCII("proxy-server")) << value;
+    // No credential was carried, so none is adopted and a child gets none.
+    CommandLine child(CommandLine::NO_PROGRAM);
+    Profile::AppendLaunchProxyCredentials(&child);
+    EXPECT_FALSE(child.HasSwitch(::switches::kApostateProfile)) << value;
+
+    command_line->RemoveSwitch("proxy-server");
+    Profile::AdoptLaunchProxyCredentials();
+  }
+}
+
+// An empty userinfo must not shadow a credential the envelope did supply.
+TEST(ApostateProxyCredentialsTest, AStrayAtDoesNotShadowTheEnvelope) {
+  test::ScopedCommandLine scoped;
+  CommandLine* command_line = scoped.GetProcessCommandLine();
+  command_line->RemoveSwitch("proxy-server");
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  command_line->AppendSwitchASCII("proxy-server", "socks5://@proxy.example:1080");
+  command_line->AppendSwitchASCII(
+      ::switches::kApostateProfile,
+      Base64Encode(R"({"device_profile":{},)"
+                   R"("proxy_credentials":{"password":"p","username":"u"}})"));
+
+  Profile::AdoptLaunchProxyCredentials();
+
+  EXPECT_EQ("socks5://proxy.example:1080",
+            command_line->GetSwitchValueASCII("proxy-server"));
+  CommandLine child(CommandLine::NO_PROGRAM);
+  Profile::AppendLaunchProxyCredentials(&child);
+  std::string json;
+  ASSERT_TRUE(Base64Decode(
+      child.GetSwitchValueASCII(::switches::kApostateProfile), &json));
+  EXPECT_EQ(R"({"device_profile":{},)"
+            R"("proxy_credentials":{"password":"p","username":"u"}})",
+            json);
+
+  command_line->RemoveSwitch("proxy-server");
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  Profile::AdoptLaunchProxyCredentials();
+}
+
+// An unusable envelope block is ignored, which is the loader's long-standing
+// behaviour, and ignoring it is not the same as leaving it behind. This was a
+// real bug: the URL branch returned before the payload was reinstalled, so a
+// launch with a URL credential and a malformed envelope block kept the block,
+// and the one switch nothing was supposed to be able to read still held one.
+TEST(ApostateProxyCredentialsTest, StripsAnUnusableBlockBesideAURLCredential) {
+  test::ScopedCommandLine scoped;
+  CommandLine* command_line = scoped.GetProcessCommandLine();
+  command_line->RemoveSwitch("proxy-server");
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  command_line->AppendSwitchASCII("proxy-server",
+                                  "socks5://tenant-42:s3cret@proxy.example:1080");
+  // A block with no password: present, unusable, and carrying a username that
+  // must not survive on the command line regardless.
+  command_line->AppendSwitchASCII(
+      ::switches::kApostateProfile,
+      Base64Encode(R"({"device_profile":{"screen":{"width":1710}},)"
+                   R"("proxy_credentials":{"username":"stale-tenant"}})"));
+
+  Profile::AdoptLaunchProxyCredentials();
+
+  const std::string shown = command_line->GetCommandLineString();
+  EXPECT_EQ(std::string::npos, shown.find("stale-tenant")) << shown;
+  EXPECT_EQ(std::string::npos, shown.find("s3cret")) << shown;
+  EXPECT_EQ("socks5://proxy.example:1080",
+            command_line->GetSwitchValueASCII("proxy-server"));
+
+  // The URL's credential is the one adopted, and the device half of the
+  // payload survives the strip untouched.
+  std::string json;
+  ASSERT_TRUE(Base64Decode(
+      command_line->GetSwitchValueASCII(::switches::kApostateProfile), &json));
+  EXPECT_EQ(R"({"device_profile":{"screen":{"width":1710}}})", json);
+
+  CommandLine child(CommandLine::NO_PROGRAM);
+  Profile::AppendLaunchProxyCredentials(&child);
+  ASSERT_TRUE(Base64Decode(
+      child.GetSwitchValueASCII(::switches::kApostateProfile), &json));
+  EXPECT_EQ(R"({"device_profile":{},)"
+            R"("proxy_credentials":{"password":"s3cret","username":"tenant-42"}})",
+            json);
+
+  command_line->RemoveSwitch("proxy-server");
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  Profile::AdoptLaunchProxyCredentials();
+}
+
+// The same invariant for the envelope channel, which had it the other way
+// round until now: the launcher's credentials used to ride the browser's
+// command line for the whole session.
+TEST(ApostateProxyCredentialsTest, AdoptionEmptiesASuppliedEnvelope) {
+  test::ScopedCommandLine scoped;
+  CommandLine* command_line = scoped.GetProcessCommandLine();
+  command_line->RemoveSwitch("proxy-server");
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  command_line->AppendSwitchASCII(
+      ::switches::kApostateProfile,
+      Base64Encode(R"({"device_profile":{"screen":{"width":1710}},)"
+                   R"("proxy_credentials":{"password":"p4ss","username":"tenant-42"}})"));
+
+  Profile::AdoptLaunchProxyCredentials();
+
+  const std::string shown = command_line->GetCommandLineString();
+  EXPECT_EQ(std::string::npos, shown.find("p4ss")) << shown;
+  EXPECT_EQ(std::string::npos, shown.find("tenant-42")) << shown;
+  std::string json;
+  ASSERT_TRUE(Base64Decode(
+      command_line->GetSwitchValueASCII(::switches::kApostateProfile), &json));
+  EXPECT_EQ(R"({"device_profile":{"screen":{"width":1710}}})", json);
+
+  CommandLine child(CommandLine::NO_PROGRAM);
+  child.AppendSwitchASCII(::switches::kApostateProfile,
+                          command_line->GetSwitchValueASCII(
+                              ::switches::kApostateProfile));
+  Profile::AppendLaunchProxyCredentials(&child);
+  ASSERT_TRUE(Base64Decode(
+      child.GetSwitchValueASCII(::switches::kApostateProfile), &json));
+  EXPECT_EQ(R"({"device_profile":{"screen":{"width":1710}},)"
+            R"("proxy_credentials":{"password":"p4ss","username":"tenant-42"}})",
+            json);
+
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  Profile::AdoptLaunchProxyCredentials();
+}
