+
+// static
+Profile::ProxyServerValue Profile::ParseProxyServerValue(
+    std::string_view value) {
+  ProxyServerValue result;
+  result.endpoint.reserve(value.size());
+
+  // Every URI in the value, in the order ProxyRules::ParseFromString reads
+  // them: `;` separates entries, an entry may be prefixed `url_scheme=`, and
+  // `,` separates the URIs of one entry's list. Only spans that turn out to be
+  // userinfo are dropped from `endpoint`; everything else is copied byte for
+  // byte, including whitespace, so a value with no userinfo comes back
+  // unchanged.
+  const auto emit = [&result](std::string_view text) {
+    result.endpoint.append(text);
+  };
+
+  const auto uri = [&](std::string_view token) {
+    // Chromium's parser trims whitespace off a URI, so a credential may sit
+    // behind it. The trimmed view locates the userinfo; the untrimmed token is
+    // what gets copied around it, so the value comes back with its own
+    // whitespace intact. `lead` is derived from the trimmed view rather than
+    // searched for again, because the two must agree on what whitespace is.
+    const std::string_view core = TrimWhitespaceASCII(token, TRIM_ALL);
+    if (core.empty()) {
+      emit(token);
+      return;
+    }
+    const size_t lead = static_cast<size_t>(core.data() - token.data());
+
+    // The scheme, and where the authority starts. No `://` means a bare
+    // `host:port`, which Chromium reads with the caller's default scheme --
+    // HTTP for a plain value, so the empty scheme is authenticable.
+    const size_t separator = core.find("://");
+    const std::string_view scheme =
+        separator == std::string_view::npos ? std::string_view()
+                                            : core.substr(0, separator);
+    const std::string_view authority =
+        separator == std::string_view::npos
+            ? core
+            : core.substr(separator + 3);
+
+    // A proxy URI has no path, but stopping at the first delimiter keeps a
+    // stray one from pulling `@` out of a path and into the authority.
+    const size_t authority_end =
+        std::min(authority.size(), authority.find_first_of("/?#"));
+    const size_t at = authority.substr(0, authority_end).rfind('@');
+    if (at == std::string_view::npos) {
+      emit(token);
+      return;
+    }
+
+    // The token with the `userinfo@` span removed, emitted before the checks
+    // below rather than after. `lead` and the authority offset are both
+    // measured from the token's own start, so the arithmetic stays in the
+    // token's coordinates. Unconditional because the `@` has to go whatever
+    // the userinfo turns out to be -- Chromium's parser fails on it either
+    // way -- and because a refusal discards `endpoint` wholesale.
+    const size_t authority_offset =
+        lead + (separator == std::string_view::npos ? 0 : separator + 3);
+    emit(token.substr(0, authority_offset));
+    emit(token.substr(authority_offset + at + 1));
+
+    const std::string_view userinfo = authority.substr(0, at);
+    const size_t colon = userinfo.find(':');
+    std::string username;
+    std::string password;
+    if (!PercentDecode(userinfo.substr(0, colon), &username) ||
+        !PercentDecode(colon == std::string_view::npos
+                           ? std::string_view()
+                           : userinfo.substr(colon + 1),
+                       &password)) {
+      if (result.refusal.empty()) {
+        result.refusal =
+            "--proxy-server carries a credential whose percent-encoding is "
+            "malformed, so the username or password it decodes to is not the "
+            "one you meant. Every % must be followed by two hex digits: a "
+            "literal % is %25, @ is %40 and : is %3A.";
+      }
+      return;
+    }
+
+    // `scheme://@host:port`: an empty userinfo is not a credential. The `@`
+    // is gone, which is what made the value unparseable, and nothing is
+    // adopted -- offering RFC 1929 with two empty strings would authenticate
+    // as somebody, badly, where the launch asked to authenticate as nobody.
+    // A username with an empty password is a credential: SOCKS4 has no
+    // password field at all and HTTP Basic accepts an empty one.
+    if (username.empty() && password.empty()) {
+      return;
+    }
+
+    if (!CredentialHalfIsUsable(username) ||
+        !CredentialHalfIsUsable(password)) {
+      if (result.refusal.empty()) {
+        result.refusal =
+            "--proxy-server carries a credential this launch cannot use: each "
+            "of the username and the password must decode to at most 4096 "
+            "bytes of UTF-8 with no NUL in it. Nothing is truncated, because "
+            "half a password authenticates nothing while looking like it "
+            "should.";
+      }
+      return;
+    }
+
+    if (!std::ranges::contains(kAuthenticableSchemes,
+                               ToLowerASCII(scheme))) {
+      if (result.refusal.empty()) {
+        result.refusal =
+            "--proxy-server carries a credential on a scheme that cannot "
+            "authenticate. HTTP, HTTPS, SOCKS4 and SOCKS5 can; direct:// has "
+            "no peer to authenticate to and quic:// is Chromium's own MASQUE "
+            "path. Remove the credential or name a proxy that takes one.";
+      }
+      return;
+    }
+
+    if (result.credentials && (result.credentials->username != username ||
+                               result.credentials->password != password)) {
+      if (result.refusal.empty()) {
+        result.refusal =
+            "--proxy-server names more than one credential. Launch-only "
+            "credentials are held once, for the whole launch, so a per-proxy "
+            "credential cannot be honoured and is refused rather than "
+            "silently applied to every proxy in the value.";
+      }
+      return;
+    }
+    result.credentials =
+        ProxyCredentials{std::move(username), std::move(password)};
+  };
+
+  const auto uri_list = [&](std::string_view list) {
+    while (true) {
+      const size_t comma = list.find(',');
+      if (comma == std::string_view::npos) {
+        uri(list);
+        return;
+      }
+      uri(list.substr(0, comma));
+      emit(",");
+      list = list.substr(comma + 1);
+    }
+  };
+
+  std::string_view rest = value;
+  while (true) {
+    const size_t semicolon = rest.find(';');
+    std::string_view entry =
+        semicolon == std::string_view::npos ? rest : rest.substr(0, semicolon);
+
+    // `url_scheme=<list>`. The scheme half names a URL scheme, never a proxy,
+    // so it is copied through and only the list is examined. Split at the
+    // first `=` rather than tokenised: a later `=` can only appear inside a
+    // list Chromium itself would discard, and this way the bytes it discards
+    // are still the bytes it was given.
+    const size_t equals = entry.find('=');
+    if (equals != std::string_view::npos) {
+      emit(entry.substr(0, equals + 1));
+      entry = entry.substr(equals + 1);
+    }
+    uri_list(entry);
+
+    if (semicolon == std::string_view::npos) {
+      break;
+    }
+    emit(";");
+    rest = rest.substr(semicolon + 1);
+  }
+
+  if (!result.refusal.empty()) {
+    result.endpoint.clear();
+    result.credentials.reset();
+  }
+  return result;
+}
+
+// static
+std::optional<std::string> Profile::PayloadWithoutCredentials(
+    const std::string& encoded,
+    std::optional<ProxyCredentials>* credentials) {
+  credentials->reset();
+
+  std::string json;
+  if (!Base64Decode(encoded, &json)) {
+    return std::nullopt;
+  }
+  std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+  // wiring-exempt: proxy_credentials - kept out of the device-profile schema.
+  const DictValue* block = dict->FindDict("proxy_credentials");
+  if (!block) {
+    return std::nullopt;
+  }
+
+  ProxyCredentials read;
+  if (ReadCredentialsBlock(*block, &read)) {
+    *credentials = std::move(read);
+  }
+  // Removed whether or not it was usable. An unusable block is ignored, which
+  // is what it has always been, but leaving it on the command line would leave
+  // a secret in everything that serialises one.
+  // wiring-exempt: proxy_credentials - kept out of the device-profile schema.
+  dict->Remove("proxy_credentials");
+  return EncodePayload(*dict);
+}
+
+// static
+std::optional<std::string> Profile::PayloadWithCredentials(
+    const std::string& encoded,
+    const ProxyCredentials& credentials) {
+  DictValue payload;
+  if (encoded.empty()) {
+    // Nothing composed and nothing authored: host mode, or a catalogue that
+    // could not serve this launch. The empty device half is what the launcher
+    // sends for the same case, and PayloadDescribesDevice answers "no device"
+    // for it, so the child inherits the host on every axis and the
+    // credentials still reach the network stack.
+    // wiring-exempt: device_profile - the switch envelope, not a profile field.
+    payload.Set("device_profile", DictValue());
+  } else {
+    std::string json;
+    if (!Base64Decode(encoded, &json)) {
+      return std::nullopt;
+    }
+    std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+    if (!dict) {
+      return std::nullopt;
+    }
+    payload = std::move(*dict);
+  }
+  // Beside whatever the payload already is, envelope or bare profile, because
+  // ParseOrNull reads this key before it unwraps an envelope.
+  // wiring-exempt: proxy_credentials - kept out of the device-profile schema.
+  payload.Set("proxy_credentials", CredentialsBlock(credentials));
+  return EncodePayload(payload);
+}
+
+// static
+void Profile::AdoptLaunchProxyCredentials() {
+  CommandLine* command_line = CommandLine::ForCurrentProcess();
+
+  // Both sources are read before anything is written, so a conflict refuses
+  // before the command line has been touched.
+  std::string proxy_server;
+  std::optional<ProxyServerValue> from_url;
+  if (command_line->HasSwitch(kProxyServerSwitch)) {
+    proxy_server = command_line->GetSwitchValueASCII(kProxyServerSwitch);
+    ProxyServerValue parsed = ParseProxyServerValue(proxy_server);
+    if (!parsed.refusal.empty()) {
+      RefuseLaunch(parsed.refusal);
+    }
+    // Kept whenever the parse changed the value, not only when it found a
+    // credential. `scheme://@host:port` and `scheme://:@host:port` carry no
+    // credential but do carry the `@` that Chromium's proxy URI parser fails
+    // on, so leaving those byte-identical would leave the proxy unusable for
+    // every request with nothing to show for it. The endpoint is already in
+    // hand; hand it over.
+    if (parsed.endpoint != proxy_server) {
+      from_url = std::move(parsed);
+    }
+  }
+
+  std::optional<ProxyCredentials> from_envelope;
+  std::optional<std::string> stripped_payload;
+  const bool carried = command_line->HasSwitch(::switches::kApostateProfile);
+  if (carried) {
+    stripped_payload = PayloadWithoutCredentials(
+        command_line->GetSwitchValueASCII(::switches::kApostateProfile),
+        &from_envelope);
+  }
+
+  if (from_url && from_url->credentials && from_envelope) {
+    RefuseLaunch(
+        "a proxy credential was supplied twice, once in --proxy-server's "
+        "userinfo and once in the --apostate-profile envelope, and this "
+        "launch holds one. Picking either would authenticate with a "
+        "credential you did not name, so it stops here instead. Pass the "
+        "credential in the proxy URL and leave proxy_credentials out of the "
+        "envelope, or the other way round.");
+  }
+
+  // The stripped payload is installed whether or not its block was usable, and
+  // whether or not the URL carried a credential too. An unusable block is
+  // ignored rather than adopted -- which is what the loader has always done
+  // with one -- but ignoring it is not the same as leaving it on the command
+  // line, where everything that serialises one would still find it.
+  if (stripped_payload) {
+    command_line->RemoveSwitch(::switches::kApostateProfile);
+    command_line->AppendSwitchASCII(::switches::kApostateProfile,
+                                    *stripped_payload);
+  }
+
+  if (from_url) {
+    command_line->RemoveSwitch(kProxyServerSwitch);
+    command_line->AppendSwitchASCII(kProxyServerSwitch, from_url->endpoint);
+    // `credentials` is empty when the value carried only a stray `@`. Adopting
+    // it unconditionally is what makes that case fall through to the envelope
+    // rather than shadowing it with nothing.
+    if (from_url->credentials) {
+      MutableAdoptedProxyCredentials() = std::move(from_url->credentials);
+      return;
+    }
+    // Said out loud, because silence is what made the original defect hard:
+    // the operator wrote something that looks like a credential, got none,
+    // and the only symptom used to be that every request failed. WARNING
+    // rather than ERROR -- by the time this logs, the launch has been
+    // repaired and the proxy will be used, just without authentication.
+    LOG(WARNING) << "apostate: --proxy-server carried an empty credential "
+                    "(a bare '@' with no username or password behind it), "
+                    "which authenticates nothing. It has been removed so the "
+                    "proxy is usable; if you meant to authenticate, the form "
+                    "is --proxy-server=scheme://user:pass@host:port and an "
+                    "unset shell variable is the usual cause of this.";
+  }
+  MutableAdoptedProxyCredentials() = std::move(from_envelope);
 }
 
 // static
+void Profile::AppendLaunchProxyCredentials(CommandLine* command_line) {
+  const std::optional<ProxyCredentials>& adopted = AdoptedProxyCredentials();
+  if (!adopted) {
+    return;
+  }
+  const std::optional<std::string> payload = PayloadWithCredentials(
+      command_line->GetSwitchValueASCII(::switches::kApostateProfile),
+      *adopted);
+  if (!payload) {
+    // The browser installed the value this is reading, so this is
+    // unreachable short of a bug. Said out loud rather than swallowed: the
+    // consequence is a child that cannot authenticate to the proxy.
+    LOG(ERROR) << "apostate: could not carry proxy credentials to a child "
+                  "process; it will not authenticate to the proxy";
+    return;
+  }
+  // Removed rather than shadowed: AppendSwitchASCII writes the map entry but
+  // leaves both copies in argv_, and argv is what `ps` shows.
+  command_line->RemoveSwitch(::switches::kApostateProfile);
+  command_line->AppendSwitchASCII(::switches::kApostateProfile, *payload);
+}
