+// ---------------------------------------------------------------------------
+// The locale environment
+// ---------------------------------------------------------------------------
+
+// The regression this exists for, stated as the report: a composed launch that
+// names no locale presents a *defined* application locale rather than the
+// operator's shell. Before the artifact shipped the full pak set, an operator
+// in Bangkok composing a Windows persona served Thai `navigator.languages` and
+// a Buddhist calendar through LANG, and every validator in the tree was green.
+TEST(ApostateComposeTest, AnUnnamedLocaleResolvesToTheComposedDefault) {
+  constexpr DispersionAxis kAxes[] = {kOsReleaseAxis};
+  const std::optional<Composition> composition =
+      Compose(RequestFor("locale-seed", kAxes, CapableHost()));
+  ASSERT_TRUE(composition.has_value());
+
+  const SurfaceRecord* application =
+      Record(*composition, "locale.application");
+  ASSERT_TRUE(application);
+  EXPECT_EQ(kComposedDefaultLocale, application->value);
+  // Not "host-inherited": the value is neither the operator's choice nor the
+  // host's, and labelling it either is how a leak ships looking healthy.
+  EXPECT_EQ("composed-default", application->layer);
+
+  // And absence of a *profile* field is preserved, which is patch 0111's
+  // mechanism: nothing is invented into the profile just because the
+  // environment is pinned.
+  EXPECT_FALSE(composition->profile.contains("locale"));
+}
+
+// Precedence, the half an operator can see: an explicit --fingerprint-locale
+// decides the application locale, and the report says the command line decided
+// it rather than the default.
+TEST(ApostateComposeTest, AnExplicitLocaleDecidesTheApplicationLocale) {
+  constexpr DispersionAxis kAxes[] = {kOsReleaseAxis};
+  ComposeRequest request = RequestFor("locale-seed", kAxes, CapableHost());
+  request.overrides.accept_languages = "de-DE,de,en-US,en";
+  const std::optional<Composition> composition = Compose(request);
+  ASSERT_TRUE(composition.has_value());
+
+  const SurfaceRecord* application =
+      Record(*composition, "locale.application");
+  ASSERT_TRUE(application);
+  // The first tag of the list, not the list: this is one locale, and the three
+  // LC_* variables take one value.
+  EXPECT_EQ("de-DE", application->value);
+  EXPECT_EQ("command-line", application->layer);
+
+  // The list itself still lands in the profile whole, because the
+  // Accept-Language pref is a different producer that wants all of it.
+  const DictValue* locale = composition->profile.FindDict("locale");
+  ASSERT_TRUE(locale);
+  ASSERT_TRUE(locale->FindString("accept_languages"));
+  EXPECT_EQ("de-DE,de,en-US,en", *locale->FindString("accept_languages"));
+}
+
+// The two pure conversions, because the launchers implement the same two and a
+// disagreement between them is a launch that presents one locale through the
+// package and another through the binary.
+TEST(ApostateComposeTest, TheLocaleTagAndItsPosixFormMatchTheLaunchers) {
+  EXPECT_EQ("de-DE", ComposedLocaleTag("de-DE,de,en-US,en"));
+  EXPECT_EQ("de-DE", ComposedLocaleTag("  de-DE , de "));
+  EXPECT_EQ("en-US", ComposedLocaleTag(""));
+  EXPECT_EQ("en-US", ComposedLocaleTag("   ,fr-FR"));
+
+  EXPECT_EQ("de_DE.UTF-8", PosixLocaleForTag("de-DE"));
+  // A tag with no region stays region-free rather than acquiring an invented
+  // one. `th.UTF-8` is not generated on most hosts, which is exactly why
+  // LANGUAGE carries the tag as written and does not need it to be.
+  EXPECT_EQ("th.UTF-8", PosixLocaleForTag("th"));
+  // Only the first separator converts, so a script subtag survives instead of
+  // being truncated away with the region behind it.
+  EXPECT_EQ("zh_Hans-CN.UTF-8", PosixLocaleForTag("zh-Hans-CN"));
+}
+
+// The authored-payload branch. --fingerprint-locale is inert there, so the
+// payload's own list is the only thing that can name the locale, and reading
+// it out of the wrong form would silently stomp an authored locale with the
+// default.
+TEST(ApostateComposeTest, AnAuthoredPayloadsLocaleIsReadFromEitherForm) {
+  const auto encode = [](std::string_view json) {
+    return Base64Encode(as_byte_span(json));
+  };
+
+  EXPECT_EQ("fr-FR,fr",
+            Profile::AcceptLanguagesInPayload(encode(
+                R"({"locale":{"accept_languages":"fr-FR,fr"}})")));
+  EXPECT_EQ("fr-FR,fr",
+            Profile::AcceptLanguagesInPayload(encode(
+                R"({"device_profile":{"locale":{"accept_languages":)"
+                R"("fr-FR,fr"}},"proxy_credentials":{"username":"u",)"
+                R"("password":"p"}})")));
+
+  // Absent, wrong-typed and undecodable all answer "nothing named one", which
+  // ComposedLocaleTag turns into the composed default. A payload that cannot
+  // be decoded is refused separately and loudly by Profile::Get(); answering
+  // anything else here would be a second opinion on the same bytes.
+  EXPECT_EQ("", Profile::AcceptLanguagesInPayload(
+                    encode(R"({"cpu":{"logical_cores":8}})")));
+  EXPECT_EQ("", Profile::AcceptLanguagesInPayload(
+                    encode(R"({"locale":{"accept_languages":7}})")));
+  EXPECT_EQ("", Profile::AcceptLanguagesInPayload("not base64 at all!!"));
+  EXPECT_EQ("en-US", ComposedLocaleTag(Profile::AcceptLanguagesInPayload(
+                         encode(R"({"cpu":{"logical_cores":8}})"))));
+}
+
+// The fix itself: all four variables, because each one moves the application
+// locale on its own and the operator may have set any subset. Three of them
+// take the POSIX form and LANGUAGE takes the tag, which is the split that
+// makes a locale the host has not generated still work.
+TEST(ApostateComposeTest, TheLocaleEnvironmentIsWrittenToAllFourVariables) {
+  std::unique_ptr<Environment> environment = Environment::Create();
+
+  // Stand the operator's shell up first, so that what this asserts is that
+  // each variable was *overwritten* and not merely that it now holds the
+  // composed value because nothing ever set it.
+  const std::optional<std::string> language = environment->GetVar("LANGUAGE");
+  const std::optional<std::string> all = environment->GetVar("LC_ALL");
+  const std::optional<std::string> messages =
+      environment->GetVar("LC_MESSAGES");
+  const std::optional<std::string> lang = environment->GetVar("LANG");
+  environment->SetVar("LANGUAGE", "th");
+  environment->SetVar("LC_ALL", "th_TH.UTF-8");
+  environment->SetVar("LC_MESSAGES", "th_TH.UTF-8");
+  environment->SetVar("LANG", "th_TH.UTF-8");
+
+  InstallComposedLocaleEnvironment("de-DE");
+
+  // All four, because each one moves the application locale on its own: the
+  // host decides through whichever of them it happened to set, so leaving any
+  // one behind lets it win through a variable nobody wrote. LANGUAGE takes the
+  // tag as written -- it is a list of language names, not locale names, and
+  // needs nothing generated on the host -- and the other three take the POSIX
+  // form setlocale expects.
+  EXPECT_EQ("de-DE", environment->GetVar("LANGUAGE"));
+  EXPECT_EQ("de_DE.UTF-8", environment->GetVar("LC_ALL"));
+  EXPECT_EQ("de_DE.UTF-8", environment->GetVar("LC_MESSAGES"));
+  EXPECT_EQ("de_DE.UTF-8", environment->GetVar("LANG"));
+
+  const auto restore = [&environment](cstring_view name,
+                                      const std::optional<std::string>& was) {
+    if (was) {
+      environment->SetVar(name, *was);
+    } else {
+      environment->UnSetVar(name);
+    }
+  };
+  restore("LANGUAGE", language);
+  restore("LC_ALL", all);
+  restore("LC_MESSAGES", messages);
+  restore("LANG", lang);
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
+  // Put the C library back where the test found it, since the call above
+  // changed process-global state that later tests in this binary read.
+  std::setlocale(LC_ALL, "");
+  std::setlocale(LC_NUMERIC, "C");
+#endif
+}
