+// static
+std::string Profile::AcceptLanguagesInPayload(const std::string& encoded) {
+  std::string json;
+  if (!Base64Decode(encoded, &json)) {
+    return std::string();
+  }
+  std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!dict) {
+    return std::string();
+  }
+
+  // The envelope is unwrapped in place, exactly the way ParseOrNull unwraps
+  // it: the launchers send `{device_profile, proxy_credentials}`, a bare
+  // profile is the hand-written form, and both have to answer. Unwrapping
+  // rather than branching on the two shapes leaves one lookup against one
+  // dictionary below, which is also the form the wiring check can follow.
+  // wiring-exempt: device_profile - the switch envelope, not a profile field.
+  if (const DictValue* envelope = dict->FindDict("device_profile")) {
+    DictValue unwrapped = envelope->Clone();
+    *dict = std::move(unwrapped);
+  }
+
+  if (const DictValue* locale = dict->FindDict("locale")) {
+    if (const std::string* list = locale->FindString("accept_languages")) {
+      return *list;
+    }
+  }
+  return std::string();
+}
