+std::string ComposedLocaleTag(std::string_view accept_languages) {
+  const std::string_view first =
+      accept_languages.substr(0, accept_languages.find(','));
+  const std::string_view tag = TrimWhitespaceASCII(first, TRIM_ALL);
+  return tag.empty() ? std::string(kComposedDefaultLocale) : std::string(tag);
+}
+
+std::string PosixLocaleForTag(std::string_view tag) {
+  std::string out(tag);
+  const size_t dash = out.find('-');
+  if (dash != std::string::npos) {
+    out[dash] = '_';
+  }
+  return out + ".UTF-8";
+}
+
+void InstallComposedLocaleEnvironment(std::string_view tag) {
+  const std::string language(tag);
+  const std::string posix = PosixLocaleForTag(tag);
+
+  // All four, listed in the precedence order glib reads them, because each one
+  // moves the application locale on its own and the operator may have set any
+  // subset. LANGUAGE takes the BCP-47 tag as written -- it is a list of
+  // language *names*, not locale names, and needs nothing generated on the
+  // host -- while LC_ALL, LC_MESSAGES and LANG take the POSIX form setlocale
+  // expects.
+  std::unique_ptr<Environment> environment = Environment::Create();
+  environment->SetVar("LANGUAGE", language);
+  environment->SetVar("LC_ALL", posix);
+  environment->SetVar("LC_MESSAGES", posix);
+  environment->SetVar("LANG", posix);
+
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
+  // Writing the variables is necessary and not sufficient.
+  // content/app/content_main.cc runs setlocale(LC_ALL, "") before any embedder
+  // hook exists, so the C library has already adopted the operator's
+  // environment by the time this is reached. glib's application-locale lookup
+  // reads LANGUAGE from the environment live -- which the writes above
+  // therefore do fix -- but falls back to setlocale(LC_MESSAGES, nullptr) when
+  // LANGUAGE is unset, and every other consumer of the C locale keeps the
+  // operator's value regardless. Measured on the shipped linux-x64 artifact's
+  // host: with LANG=en_US.UTF-8 inherited and the composed environment
+  // written, LC_MESSAGES was still en_US.UTF-8.
+  //
+  // So the sequence a launcher-set environment produces is reproduced here
+  // exactly: "C", which is the locale a fresh process starts in, then the two
+  // calls content makes. That also reproduces the failure mode honestly -- if
+  // this host has not generated the composed locale, setlocale refuses it and
+  // the C library stays at "C" rather than falling back to the operator's,
+  // while LANGUAGE still carries the tag and still decides the application
+  // locale.
+  //
+  // Single-threaded by construction: this runs from PreSandboxStartup in the
+  // browser, which is where content itself writes FC_FONTATIONS "before
+  // creating threads".
+  std::setlocale(LC_ALL, "C");
+  std::setlocale(LC_ALL, "");
+  std::setlocale(LC_NUMERIC, "C");
+#endif
+}
