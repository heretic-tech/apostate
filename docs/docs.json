              "testing/run",
              "testing/fingerprintjs"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/switches",
              "reference/python-api",
              "reference/node-api",
              "reference/cli",
              "reference/environment-variables",
              "reference/profile-schema",
              "reference/gpu-models",
              "reference/font-lists",
